# en-US: only the messages whose words differ from the house English (en-GB).
# Everything else falls back to English.

# Words that float beside the i of the eye dropper's window.
screenshot-eye-help = Press the eye dropper, then click anywhere on the screen to take the color under the pointer. Escape gives up. Each color is copied as a hex code straight away and kept in the list below, newest first, so it can be copied again later.

# Name of the main button that takes a colour.
screenshot-eye-take = Take a color

# Sentence under the title while no colour has been taken.
screenshot-eye-none = Take a color from anywhere on the screen.

# Sentence under the title once colours have been taken.
screenshot-eye-taken =
    { $n ->
        [one] One color taken: { $newest }.
       *[other] { $n } colors taken; the newest is { $newest }.
    }

# Shown in the big card while no colour has been taken.
screenshot-eye-latest-empty = The color you take shows here, large, ready to copy.

# Name of the card that holds the latest colour.
screenshot-eye-latest = Latest color

# Head of the card with the list of colours taken.
screenshot-eye-list = Colors taken

# Shown in the list card while no colour has been taken.
screenshot-eye-list-empty = Colors taken with the eye dropper are kept here, newest first.

# What the saved list of colours is called when it is found damaged and set aside.
screenshot-eye-damaged = Eye dropper colors

# Label and name of the choice of colour, and the choice for colour.
screenshot-print-colour = Color

