# en-US: only the messages whose words differ from the house English (en-GB).
# Everything else falls back to English.

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = favorites favorites launcher edge click hot corner voice speech windows open windows clipboard copy paste history forget notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Your favorites sit round the middle of the ring. They are chosen on the ring itself: right-click any app in the ring to add or remove it, and drag a favorite onto another's place to change the order.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } favorite
       *[other] { $n } favorites
    }

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Move the pointer to the edge of the screen and double-click, or press the Super key, and the ring opens. Your favorites sit round the middle of the ring, and your open windows in a ring round them: click one to bring it forward, or right-click it for its buttons. Right-click any app in the ring to add or remove it.

