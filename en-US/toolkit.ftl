# en-US: only the messages whose words differ from the house English (en-GB).
# Everything else falls back to English.

# Fault in a theme file the person is trying: a setting that should be a colour is not one Trindle can read. $name is the setting's name.
kit-theme-not-colour = --{ $name } is not a color Trindle can read.

# The name a screen reader gives the painted square of a colour picker.
kit-colour-square = Color, saturation and brightness

# The name a screen reader gives the swatch showing the colour chosen. $colour is its hex code.
kit-colour-swatch = Chosen color { $colour }

kit-look-highlight = Highlight color

kit-look-highlight-help = The color of the main action and of what is chosen.

## A title bar the program draws, where the compositor draws none
kit-frame-minimise = Minimize

kit-frame-maximise = Maximize

