# machine translated (Hindi), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = रूप-रंग

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = रंग रंगों हाइलाइट थीम रूप स्किन शीशा गहरा हल्का मोड धूप चमकदार आइकन फ़ॉन्ट कर्सर पॉइंटर स्क्रीन रीडर नेत्रहीन ज़ोर से पढ़ना सुगम्यता लेबल सुझाव नाम colour color accent theme dark light icons font cursor

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = हल्का या गहरा रूप, रंग, आइकन, फ़ॉन्ट, पॉइंटर और स्क्रीन को ज़ोर से पढ़ना। कुछ प्रोग्राम दोबारा खुलने पर ही बदलाव देखते हैं।

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = यह रूप रखें?

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = Escape दबाने पर अभी पहले जैसा हो जाएगा।

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = गहरा

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = हल्का

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = गहरा

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = हल्का

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }, { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = { $name } कैसी दिखती है, { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = { $look } रूप।

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = Trindle का अपना रूप, क्योंकि { $theme } थीम इस्तेमाल नहीं हो सकती। { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = { $theme } थीम, { $look } रूप, { $accent } हाइलाइट और { $shape } आइकन के साथ।

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = { $theme } थीम, { $accent } हाइलाइट और { $shape } आइकन के साथ।

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look }, { $accent } हाइलाइट और { $shape } आइकन के साथ।

# Shape of the icons in the top sentence.
settings-appearance-shape-round = गोल

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = Trindle पीला

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = स्क्रीन पर जो है और जो आप टाइप करते हैं, वह बोलकर बताता है। Super, Alt और S एक साथ दबाने से भी यह चालू या बंद होता है।

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = आइकन दोबारा नहीं बन सके, इसलिए कुछ अपना पुराना आकार रखते हैं। दोबारा कोशिश करने के लिए सेट फिर से चुनें।

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = कुछ रंग पढ़ने में आसान बनाए गए।

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
        [one] { $theme } थीम आज़माई जा रही है। रखें दबाए बिना { $seconds } सेकंड में पहले वाला रूप लौट आएगा। Escape दबाने पर अभी लौट जाएगा।
       *[other] { $theme } थीम आज़माई जा रही है। रखें दबाए बिना { $seconds } सेकंड में पहले वाला रूप लौट आएगा। Escape दबाने पर अभी लौट जाएगा।
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = { $theme } थीम रख ली गई।

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = समय पूरा होने पर पहले वाला रूप लौट आएगा।

# Said aloud when the look from before is back.
settings-appearance-aloud-back = पहले वाला रूप लौट आया।

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = थीम चुनें

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = थीम

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = { $name } ऊपर की सूची में है। इस्तेमाल करने के लिए उसे दबाएँ।

# Red words under the Theme line when a theme could not be removed.
settings-appearance-not-removed = थीम हटाई नहीं जा सकी।

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = { $theme } थीम इस्तेमाल नहीं हो सकती। { $why }

# Heading of the line saying a theme is tried first.
settings-appearance-tried-first = थीम पहले आज़माई जाती है

# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
        [one] खिड़की के नीचे { $seconds } सेकंड तक रखने के लिए पूछा जाता है।
       *[other] खिड़की के नीचे { $seconds } सेकंड तक रखने के लिए पूछा जाता है।
    }

# Name of the bin button that removes one of the person's own themes.
# SAFETY: needs a human review before it ships
settings-appearance-remove-theme = यह थीम हटाएँ

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = { $name } इस्तेमाल करें

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = रचयिता: { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = थीम जोड़ें

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = थीम खोजी जा रही हैं

# Title of the Theme card.
settings-appearance-theme-card = थीम

# Words behind the i of the Theme card.
settings-appearance-theme-about = थीम एक फ़ाइल में पूरा रूप होती है: रंग, कोने, आकार और जगह। किसी को आज़माने के लिए दबाएँ: हर Trindle खिड़की एक साथ बदल जाती है, और रखें दबाए बिना 30 सेकंड में पहले वाला रूप अपने आप लौट आता है, इसलिए न पढ़ी जा सकने वाली थीम कभी टिकती नहीं। जिस थीम में गहरा और हल्का दोनों रूप हों, उसकी तस्वीर के पास गहरा और हल्का बटन होते हैं; तेज़ धूप में हल्का रूप देखना आसान है, और Apps से आए ऐप अगली बार खुलने पर इसे अपनाते हैं। एक रूप वाली थीम में ऐसे बटन नहीं होते। आपका हाइलाइट रंग हर थीम में आपका ही रहता है। आपकी जोड़ी हुई थीम केवल पढ़ी जाती है, चलाई नहीं जाती, और जो शब्द पढ़ने में कठिन होते, उन्हें साफ़ बना दिया जाता है। टर्मिनल से trindle-settings --theme default हमेशा Trindle का अपना रूप लौटा देता है।

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = थीम

# Small words under that line.
settings-appearance-theme-line-about = पूरा रूप। दोनों रूप वाली थीम के पास गहरा या हल्का चुना जाता है।

# Small words under the Add a theme line.
settings-appearance-add-theme-about = एक .css फ़ाइल, जैसे किसी की साझा की हुई।

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = थीम फ़ाइल में क्या होता है

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = 0-9 और a-f में से छह अक्षर, जैसे #fbc711।

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = टाइप किया गया रंग

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = हेक्स कोड

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = कोई भी रंग, हेक्स कोड में, जैसे #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = कोई भी रंग

# Small words under that line.
settings-appearance-any-colour-about = छह या आठ अंक, जैसे #fbc711।

# Title of the Colour card.
settings-appearance-colour-title = रंग

# Words behind the i of the Colour card.
settings-appearance-colour-about = हाइलाइट बटन, स्विच, भरती हुई रिंग और आप कहाँ हैं, यह दिखाता है। Trindle की अपनी खिड़कियाँ तुरंत बदलती हैं; रिंग अगली बार खुलने पर। कार्ड पर देखने के लिए बहुत गहरे रंग को तब तक हल्का किया जाता है जब तक वह पढ़ा न जा सके, और हल्के रूप में बहुत फीके रंग को गहरा किया जाता है। गहरा या हल्का रूप थीम के अपने टाइल पर, थीम के नीचे चुना जाता है।

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = हाइलाइट

# Small words under that line.
settings-appearance-highlight-about = बटन, स्विच और आप कहाँ हैं।

# Small words under the read the screen aloud switch when a screen reader is installed.
settings-appearance-reader-on = Super, Alt और S से भी यह चालू या बंद होता है।

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = स्क्रीन को ज़ोर से पढ़ें

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = पॉइंट करते समय लेबल रखें

# Small words under that line.
settings-appearance-labels-about = जब तक आप बटन पर पॉइंट करें, उसका नाम बना रहता है।

# Title of the Reading the screen card.
settings-appearance-reading-title = स्क्रीन पढ़ना

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } बटन का नाम आम तौर पर डेढ़ सेकंड बाद चला जाता है; रखने पर वह तब तक रहता है जब तक पॉइंटर उस पर है। स्क्रीन ज़ोर से पढ़ी जाने के दौरान हर बटन के नीचे उसका नाम दिखता है।

# Name of the set of round icons.
settings-appearance-icons-circles = गोले

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = आइकन बदले जा रहे हैं

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = बदल गए

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = { $name } आइकन

# Heading of the line for the shape of the icons.
settings-appearance-shape = आकार

# Small words under that line.
settings-appearance-shape-about = Trindle आइकन, गोल या चौकोर।

# Title of the Icons card.
settings-appearance-icons-title = आइकन

# Words behind the i of the Icons card.
settings-appearance-icons-about = Trindle आइकन गोल या चौकोर आते हैं। जिस ऐप का आइकन उनमें नहीं है, उसके लिए मेल खाता आइकन बनाया जाता है, और रिंग तथा पैनल नए आकार में दोबारा बनते हैं।

# Name of the list of font families, and heading of the font line.
settings-appearance-font = फ़ॉन्ट

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = डिफ़ॉल्ट

# Name of the list of font sizes.
settings-appearance-font-size = फ़ॉन्ट का आकार

# Small words under the font line.
settings-appearance-font-about = प्रोग्रामों की खिड़कियों के शब्द।

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = फ़ॉन्ट जोड़ें

# Small words under the Add fonts line.
settings-appearance-add-fonts-about = एक .ttf या .otf फ़ाइल, या उनकी ज़िप।

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = फ़ाइल में क्या होना चाहिए

# Title of the Text card.
settings-appearance-text-title = पाठ

# Words behind the i of the Text card.
settings-appearance-text-about = प्रोग्राम अपने शब्दों के लिए जो फ़ॉन्ट इस्तेमाल करते हैं, और उसका आकार। यहाँ जोड़े गए फ़ॉन्ट, यानी .ttf या .otf फ़ाइल या उनकी ज़िप, केवल आपके लिए फ़ॉन्ट सूची में जुड़ते हैं; कुछ प्रोग्राम दोबारा खुलने पर ही इन्हें देखते हैं।

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = फ़ॉन्ट चुनें

# Red words when a font could not be replaced; { $name } is the file name.
settings-appearance-font-not-replaced = { $name } बदला नहीं जा सका।

# Green words after one font took the place of the one there; { $name } is the file name.
settings-appearance-font-replaced-one = { $name } बदल दिया गया। अब से शुरू होने वाले प्रोग्राम इसे इस्तेमाल करेंगे।

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
settings-appearance-font-replaced-some = { $total } में से { $n } बदले गए। अब से शुरू होने वाले प्रोग्राम इन्हें इस्तेमाल करेंगे।

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
        [one] { $n } फ़ॉन्ट ऊपर की सूची में है। उसे ऊपर से चुनें।
       *[other] { $n } फ़ॉन्ट ऊपर की सूची में हैं। उन्हें ऊपर से चुनें।
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = वे फ़ॉन्ट पहले से सूची में हैं।

# Choice in the list of cursor sizes: the normal size.
settings-appearance-cursor-normal = सामान्य

# Choice in the list of cursor sizes: a large size.
settings-appearance-cursor-large = बड़ा

# Choice in the list of cursor sizes: the largest size.
settings-appearance-cursor-larger = और बड़ा

# Spoken name of a picture of a cursor size; { $size } is its name, such as Large.
settings-appearance-pointer-spoken = { $size } पॉइंटर

# Name of the standard cursor theme (the one every system has).
settings-appearance-cursor-standard = मानक

# Name of the list of cursor themes, and heading of its line.
settings-appearance-cursor = कर्सर

# Name of the list of cursor sizes, and heading of its line.
settings-appearance-cursor-size = कर्सर का आकार

# Small words under the cursor line.
settings-appearance-cursor-about = पॉइंटर कैसे बनाया जाता है।

# Small words under the cursor size line.
settings-appearance-cursor-size-about = बड़ा ढूँढना आसान है।

# Title of the Pointer card.
settings-appearance-pointer-title = पॉइंटर
