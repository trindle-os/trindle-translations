# machine translated (Hindi), not yet reviewed by a person.

# Name of the Settings page about default apps, in the list and as its heading.
settings-default-apps-title = डिफ़ॉल्ट ऐप

# Words a person might type into the Settings search to find the default apps page; separate them with spaces.
settings-default-apps-keywords = ब्राउज़र मेल ईमेल फ़ाइलें चित्र संगीत वीडियो pdf कैलेंडर इसमें खोलें टर्मिनल

# Introduction under the heading of the default apps page, and the words behind the page i.
settings-default-apps-help = कौन-सा प्रोग्राम वेब लिंक, ईमेल, चित्र, कैलेंडर और बाकी चीज़ें खोलता है। टर्मिनल ~/.config/xdg-terminals.list में चुना जाता है; कुछ न चुना हो तो Trindle पहले स्थापित टर्मिनल का उपयोग करता है।

