# Title of a card on the default apps page.
settings-default-apps-card-internet = इंटरनेट

# Words behind the i of a card on the default apps page.
settings-default-apps-card-internet-about = वह प्रोग्राम जो कहीं भी क्लिक किया गया वेब लिंक खोलता है, जो ईमेल पते पर क्लिक करने पर ईमेल लिखने के लिए खुलता है, और जो कैलेंडर का निमंत्रण खोलता है।

# Title of a card on the default apps page.
settings-default-apps-card-files = फ़ाइलें और दस्तावेज़

# Words behind the i of a card on the default apps page.
settings-default-apps-card-files-about = वह प्रोग्राम जो फ़ोल्डर, सादी टेक्स्ट फ़ाइल और PDF दस्तावेज़ को खोलता है, जब आप उसे Folders, डेस्कटॉप या किसी दूसरे ऐप से खोलते हैं।

# Title of a card on the default apps page.
settings-default-apps-card-media = चित्र और ध्वनि

# Words behind the i of a card on the default apps page.
settings-default-apps-card-media-about = वह प्रोग्राम जो चित्र, संगीत या वीडियो खोलने पर उसे खोलता है।

# Sentence at the top of the page when every kind has a program; { $web } is the program that opens web links.
settings-default-apps-all-set-web = हर चीज़ को खोलने के लिए एक प्रोग्राम है; वेब लिंक { $web } खोलता है।

# Sentence at the top of the page when every kind has a program and the one for web links is not known.
settings-default-apps-all-set = हर चीज़ को खोलने के लिए एक प्रोग्राम है।

# Sentence at the top of the page when one kind has no program chosen; { $kind } is its name in lower case.
settings-default-apps-one-missing = { $kind } खोलने के लिए अभी कुछ चुना नहीं गया है।

# Sentence at the top of the page when several kinds have no program chosen; { $kinds } is their names as a list joined with "or".
settings-default-apps-many-missing = { $kinds } खोलने के लिए अभी कुछ चुना नहीं गया है।

# Small words under a kind that no installed program can open.
settings-default-apps-none-installed = स्थापित कोई भी प्रोग्राम इन्हें अभी नहीं खोल सकता।

# First choice in a list when no program is chosen for that kind yet.
settings-default-apps-not-chosen = अभी चुना नहीं गया

# Small words under a kind with a program list; { $n } is how many programs can open it.
settings-default-apps-can-open =
    { $n ->
        [one] केवल एक प्रोग्राम इन्हें खोल सकता है।
       *[other] { $n } प्रोग्राम इन्हें खोल सकते हैं।
    }

# Said in green under a kind's list after the choice was kept.
settings-default-apps-saved = सहेजा गया

