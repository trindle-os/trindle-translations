# machine translated (Hindi), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = AI प्रोग्राम

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = एआई प्रोग्राम बाड़ निजी फ़ोल्डर साझा कुंजी टोकन ai programs claude codex cursor gemini aider agent fence sandbox private folders share ssh keys token sudo

# Help line at the foot of the AI programs page.
settings-ai-help = AI कोडिंग प्रोग्राम एक ऐसी बाड़ में चलते हैं जो आपकी निजी फ़ाइलें छिपा देती है। केवल वही फ़ोल्डर साझा करें जो उन्हें चाहिए।

# Headline of the AI programs page.
settings-ai-note = यह रोज़ के इस्तेमाल में AI प्रोग्रामों को आपकी निजी फ़ाइलों से दूर रखता है, जैसे अगर किसी को बहकाकर आपके बैंक स्टेटमेंट इकट्ठा करवाए और बाहर भिजवाए जाएँ। यह सीमित सुरक्षा है, गारंटी नहीं: कोई अड़ा हुआ प्रोग्राम, कंप्यूटर के सॉफ़्टवेयर की कोई खामी, या आपका किसी अनुरोध को मंज़ूर करना या फ़ोल्डर साझा करना, फिर भी कुछ बाहर जाने दे सकता है।

# Note under the headline of the AI programs page.
settings-ai-inside = AI प्रोग्राम जो कुछ भी शुरू करता है, जैसे इंस्टॉल किए प्रोग्राम, स्क्रिप्ट और दूसरे प्रोग्राम, वह उसके साथ बाड़ के अंदर ही रहता है।

# Red words when a change to the fence could not be made.
settings-ai-not-changed = इसे बदला नहीं जा सका।

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = सहेजा गया

# Title of the window for choosing a folder to share with AI programs.
settings-ai-choose-folder = AI प्रोग्रामों के साथ साझा करने के लिए फ़ोल्डर चुनें

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = कुंजी बनाई नहीं जा सकी।

# Label of the switch that limits the network of AI programs, and heading of its line.
settings-ai-limit-net = नेटवर्क को यहाँ दी गई साइटों तक सीमित करें

# Under the Limit the network heading.
settings-ai-limit-net-sub = बंद: नेटवर्क खुला है। चालू: केवल नीचे की साइटें।

# Tip of the button that removes a site from the list AI programs may reach.
settings-ai-stop-site = AI प्रोग्रामों को इस साइट तक पहुँचने से रोकें

# Example in the box for typing a site AI programs may reach.
settings-ai-eg-site = जैसे api.anthropic.com

# Tip of the button that adds a site AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-let-site = AI प्रोग्रामों को इस साइट तक पहुँचने दें

# Heading of the line for adding a site.
settings-ai-add-site = साइट जोड़ें

# Under the Add a site heading.
settings-ai-add-site-sub = इसका नाम, या इसके नीचे के हर नाम के लिए *.example.com।

# Heading of the card that limits the network of AI programs.
settings-ai-network = नेटवर्क

# Help text of the Network card (the information button).
settings-ai-network-about = उन्नत। बंद होने पर AI प्रोग्राम नेटवर्क को वैसे ही इस्तेमाल करते हैं जैसे आप। चालू होने पर वे केवल नीचे की साइटों तक, सुरक्षित (https) कनेक्शन से, पहुँच सकते हैं, और बाड़ का अपना कोई नेटवर्क नहीं होता। किसी प्रोग्राम के औज़ारों को वही प्रॉक्सी सेटिंग्स इस्तेमाल करनी होंगी जो उन्हें दी गई हैं। AI सेवा की साइट जोड़ें, और किसी इंस्टॉल के लिए जो पैकेज स्रोत चाहिए उसकी भी।

# Label of the switch that keeps AI programs inside the fence, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-keep-inside = AI प्रोग्रामों को बाड़ के अंदर रखें

# Under the fence switch when it is on.
settings-ai-hides-home = आपका होम फ़ोल्डर छिपाता है, सिवाय नीचे साझा किए फ़ोल्डरों के।

# Under the fence switch when it is off.
# SAFETY: needs a human review before it ships
settings-ai-fence-off = बाड़ बंद है। AI प्रोग्राम अब वह सब देख सकते हैं जो आप देख सकते हैं।

# Heading of the card with the fence switch.
settings-ai-the-fence = बाड़

# Help text of The fence card (the information button).
settings-ai-fence-about = सिस्टम AI प्रोग्रामों को दिखता और इस्तेमाल के लायक रहता है। आपके होम फ़ोल्डर की जगह एक खाली निजी होम होता है जो वे हर बार चलने के बीच रखते हैं, जिसमें केवल वे फ़ोल्डर होते हैं जो आप साझा करते हैं। वे आपके दूसरे प्रोग्राम, आपका सत्र, आपकी कुंजियाँ या आपके पासवर्ड नहीं देख सकते। इस सूची में दिए नाम के अलावा किसी और तरीक़े से शुरू किया गया प्रोग्राम बाड़ में नहीं होता। अगर आपने असिस्टेंट कनेक्शन (trindle-mcp) इंस्टॉल किया है, तो जुड़ा हुआ असिस्टेंट आपसे पूछे बिना ये पढ़ सकता है: आपकी खुली विंडो के शीर्षक और उनके पीछे के ऐप, आपके इंस्टॉल किए ऐप, चल रहे प्रोग्राम और उनकी मेमोरी का उपयोग, मेमोरी, डिस्क, बैटरी, अपटाइम और नेटवर्क की स्थिति, आपकी Trindle सेटिंग, किसी भी सेवा की सिस्टम जर्नल की 500 पंक्तियाँ तक, आपके ताज़ा क्रैश नोट, और आपके साउंड डिवाइस, पेयर किए गए Bluetooth डिवाइस, पास के Wi-Fi नेटवर्क और ड्राइव के नाम। कोई भी बदलाव करने से पहले वह हमेशा आपसे पूछता है।

# Label of the switch that fences one AI program: its name is { $name }.
settings-ai-fence-name = { $name } को बाड़ में रखें

# Tip of the button that takes one program off the list: its name is { $name }.
settings-ai-take-off = { $name } को सूची से हटाएँ

# Label of the switch for using a program's existing settings folder: its name is { $name }.
settings-ai-own-for = { $name } के लिए मेरा मौजूदा सेटिंग्स फ़ोल्डर इस्तेमाल करें

# Heading of the line with the switch for using a program's existing settings folder.
settings-ai-own = मेरा मौजूदा सेटिंग्स फ़ोल्डर इस्तेमाल करें

# Under the existing settings folder heading.
settings-ai-own-sub = इसमें इस प्रोग्राम की पिछली बातचीतें हैं।

# Example in the box for typing the name of an AI program.
settings-ai-eg-program = जैसे claude

# Tip of the button that adds an AI program, and heading of its line.
settings-ai-add-program = प्रोग्राम जोड़ें

# Under the Add a program heading.
settings-ai-add-program-sub = वह नाम लिखें जिससे आप इसे शुरू करते हैं।

# Help text of the AI programs card (the information button).
settings-ai-programs-about = ये नाम बाड़ के अंदर शुरू होते हैं। मेरा मौजूदा सेटिंग्स फ़ोल्डर इस्तेमाल करें: बंद होने पर प्रोग्राम एक नए निजी फ़ोल्डर के साथ शुरू होता है। प्रोग्राम अंदर अपने-आप साइन इन करते हैं: आपका अपना साइन-इन साझा नहीं किया जाता।

# Heading of the line shown when no folder is shared with AI programs.
settings-ai-nothing-shared = कुछ भी साझा नहीं है

# Under the Nothing is shared heading.
settings-ai-none-seen = AI प्रोग्राम आपका कोई फ़ोल्डर नहीं देखते।

# Label of the switch that lets AI programs only read a shared folder.
settings-ai-only-read = इसे केवल इस फ़ोल्डर को पढ़ने दें

# Tip of the button that stops sharing a folder with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-make-private = इस फ़ोल्डर को फिर से निजी करें

# Under a shared folder's path, beside the switch that makes it read only.
settings-ai-only-read-short = केवल पढ़ने दें

# Tip of the button that shares a folder, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-share-folder = फ़ोल्डर साझा करें

# Under the Share a folder heading.
settings-ai-share-folder-sub = उसी जगह दिखता है, पढ़ने और लिखने के लिए।

# Heading of the card listing folders shared with AI programs.
settings-ai-shared = AI प्रोग्रामों के साथ साझा

# Help text of the shared folders card (the information button).
settings-ai-shared-about = आपके होम फ़ोल्डर में बाकी सब कुछ AI प्रोग्रामों से निजी रखा जाता है। छिपे फ़ोल्डर, और जिनमें कुंजियाँ, पासवर्ड या मेल रखे हैं, वे कभी साझा नहीं किए जा सकते। यहाँ साझा किया फ़ोल्डर प्रोग्राम के अगली बार शुरू होने पर वहाँ होता है।

# Tip of the button that removes a computer from the list AI programs may reach by ssh.
settings-ai-stop-computer = AI प्रोग्रामों को इस कंप्यूटर तक पहुँचने से रोकें

# Example in the box for typing a computer AI programs may reach by ssh.
settings-ai-eg-computer = जैसे nas.local

# Tip of the button that adds a computer AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-let-computer = AI प्रोग्रामों को इस कंप्यूटर तक पहुँचने दें

# Heading of the line for adding a computer.
settings-ai-add-computer = कंप्यूटर जोड़ें

# Under the Add a computer heading.
settings-ai-add-computer-sub = इसका नाम लिखें।

# Note showing the public key to put on each computer: the key is { $key }.
settings-ai-put-key = यह कुंजी हर कंप्यूटर पर रखें: { $key }

# Tip of the button that makes a key for AI programs.
settings-ai-make-key = कुंजी बनाएँ

# Heading of the line for making a key for AI programs.
settings-ai-make-key-for = AI प्रोग्रामों के लिए कुंजी बनाएँ

# Under the Make a key heading.
settings-ai-make-key-sub = एक अलग कुंजी, जो उनके देखे जा सकने वाले फ़ोल्डरों से बाहर रखी जाती है।

# Heading of the card listing computers AI programs may reach by ssh.
settings-ai-ssh = जिन कंप्यूटरों तक वे ssh से पहुँच सकते हैं

# Help text of the ssh card (the information button).
settings-ai-ssh-about = बाड़ के अंदर ssh, Trindle से पूछता है, जो अपनी एक कुंजी इस्तेमाल करता है और केवल यहाँ दिए कंप्यूटरों के लिए। आपकी अपनी कुंजियाँ AI प्रोग्रामों को कभी नहीं दिखाई जातीं।

# Tip of the button that stops giving AI programs a key.
settings-ai-stop-key = AI प्रोग्रामों को यह कुंजी देना बंद करें

# Under the name of a key that AI programs are given.
settings-ai-given = AI प्रोग्रामों को दी गई

# Example in the box for typing a key to give AI programs: a name, an equals sign and the value.
settings-ai-eg-key = NAME=value

# Tip of the button that gives AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-give-key = AI प्रोग्रामों को यह कुंजी दें

# Heading of the line for adding a key.
settings-ai-add-key = कुंजी जोड़ें

# Under the Add a key heading.
settings-ai-add-key-sub = NAME=value के रूप में लिखें।

# Heading of the card listing keys given to AI programs.
settings-ai-keys = AI प्रोग्रामों को दी गई कुंजियाँ

# Help text of the keys card (the information button).
settings-ai-keys-about = आपके सत्र की कुंजियाँ और टोकन AI प्रोग्रामों तक कभी नहीं पहुँचते। यहाँ लिखी कुंजी उन्हें दी जाती है, और केवल यहीं से।
