
# machine translated (Hindi), not yet reviewed by a person.

# The card's heading.
settings-words-heading = आपके अपने शब्द

# Under the heading.
settings-words-about = Trindle जो भी शब्द दिखाता है उसे किसी भी भाषा में बदलें, और शब्द-सूची को फ़ाइल के रूप में साझा करें।

# The first line of the card: what is locked, in plain words.
settings-words-rule = जिस शीट में आख़िरी कॉलम के अलावा कहीं और बदलाव हो, या जो Trindle की अपनी न हो, उसे पूरा अस्वीकार कर दिया जाता है।

# The line that picks which language the boxes are for.
settings-words-language = भाषा

# Under the language line.
settings-words-language-sub = यह सूची इस भाषा की है।

# The name of the language list for the screen reader.
settings-words-language-tip = सूची की भाषा

# The line that exports the sheet, and its button's tip.
settings-words-export = शीट डाउनलोड करें

# Under the export line.
settings-words-export-sub = बाईं ओर अंग्रेज़ी, उसके पास आपकी भाषा। दाईं ओर का हिस्सा बदलें।

# Title of the window that asks where to save the sheet.
settings-words-export-title = शब्द-सूची सहेजें

# The line that imports a sheet, and its button's tip.
settings-words-import = शीट अपलोड करें

# Under the import line.
settings-words-import-sub = पहले पूरी जाँची जाती है। कोई भी अंतर हो तो कुछ भी इंस्टॉल नहीं होता।

# Title of the window that asks which sheet to open.
settings-words-import-title = शब्द-सूची खोलें

# Under the import button when a sheet was installed.
settings-words-imported = इंस्टॉल हो गई

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = सहेजा नहीं जा सका

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = अस्वीकृत: फ़ाइल बहुत बड़ी है

# Under the import button: the file is not text.
settings-words-not-text = अस्वीकृत: सादा पाठ नहीं है

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = अस्वीकृत: छिपे या नियंत्रण वर्ण हैं

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = अस्वीकृत: एक पंक्ति बहुत लंबी है

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = अस्वीकृत: यह Trindle की शब्द-सूची नहीं है

# Under the import button: the sheet is of another version.
settings-words-version = अस्वीकृत: सूची का संस्करण अलग है

# Under the import button: the language tag is not usable.
settings-words-bad-language = अस्वीकृत: भाषा मान्य नहीं है

# Under the import button: the notes at the top were changed.
settings-words-notes = अस्वीकृत: सूची का ऊपरी भाग बदला गया

# Under the import button: lines are missing or extra.
settings-words-count = अस्वीकृत: पंक्तियाँ कम या ज़्यादा हैं

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = अस्वीकृत: { $key } की कुंजी बदली गई

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = अस्वीकृत: { $key } का अंग्रेज़ी पाठ बदला गया

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = अस्वीकृत: { $key } की पंक्ति सही रूप में नहीं है

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = अस्वीकृत: { $key } के शब्द बहुत लंबे हैं

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = अस्वीकृत: { $key } के शब्दों में छिपे वर्ण हैं

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = अस्वीकृत: { $key } के शब्दों में मार्कअप, लिंक या पथ है

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = अस्वीकृत: { $key } के प्लेसहोल्डर अलग हैं

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = अस्वीकृत: फ़ाइल पढ़ी नहीं जा सकी

# Under the rule on the card: when changed words appear.
settings-words-next-start = आपके शब्द किसी प्रोग्राम के अगली बार शुरू होने पर दिखेंगे।

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = अस्वीकृत: जाँच मान मेल नहीं खाता

settings-words-reset = Trindle के शब्दों पर वापस

settings-words-reset-sub = इस भाषा को वैसा ही कर देता है जैसी वह आई थी। आपके शब्द एक बैकअप फ़ाइल में रखे जाते हैं।

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = अपनी शीट पेश करें

# Under the offer button: who can send and why.
settings-words-offer-sub = एक पेज खुलता है जहाँ आप Buildmorphic में साइन इन करके इसे भेजते हैं। Trindle इसे आपके लिए कभी नहीं भेजता।

# The line that starts a language of your own, and its button's tip.
settings-words-start = अपनी खुद की भाषा शुरू करें

# Under the start line.
settings-words-start-sub = उसे नाम दें, असली या मनगढ़ंत। वह अंग्रेज़ी के रूप में शुरू होती है और आपकी अपनी के रूप में दिखती है।

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = आपकी भाषा का नाम

# Beside the start line when the language was made.
settings-words-started = शुरू की गई

# Under the start line: the name is empty or too long.
settings-words-name-length = 1 से 30 अक्षर इस्तेमाल करें

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = केवल अक्षर: कोई मार्कअप, पाथ या छिपे अक्षर नहीं

# Under the start line: another language of your own has this name.
settings-words-name-taken = इस नाम की भाषा आपके पास पहले से है

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (आपकी अपनी)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = आपकी इस अपनी भाषा को हटाता है। इसके शब्द एक बैकअप फ़ोल्डर में रखे जाते हैं।

