# machine translated (Hindi), not yet reviewed by a person.

# Name of the Date and time page, in the page list and as its heading.
settings-datetime-title = तारीख़ और समय

# Words people may search for to find the Date and time page, separated by spaces.
settings-datetime-keywords = समय क्षेत्र टाइम ज़ोन घड़ी तारीख़ दिनांक time zone clock date

# Help line at the foot of the Date and time page.
settings-datetime-help = समय क्षेत्र और अपने-आप समय के लिए एडमिनिस्ट्रेटर का पासवर्ड चाहिए।

# Spoken name of the picture of the clock at the top of the page.
settings-datetime-time-now = अभी का समय

# Name of a way to write the ring's clock: hours 00 to 23.
settings-datetime-24 = 24 घंटे

# Name of a way to write the ring's clock: hours 1 to 12 with am or pm.
settings-datetime-12 = 12 घंटे

# Name of a way to write the ring's clock: hours 00 to 23 with seconds.
settings-datetime-24s = 24 घंटे, सेकंड के साथ

# Name of the box for the day when the date is set by hand.
settings-datetime-day = दिन

# Name of the box for the month when the date is set by hand.
settings-datetime-month = महीना

# Name of the box for the year when the date is set by hand.
settings-datetime-year = साल

# Name of the box for the hour when the time is set by hand.
settings-datetime-hour = घंटा

# Name of the box for the minute when the time is set by hand.
settings-datetime-minute = मिनट

# Red words when the time could not be set.
settings-datetime-no-time = समय सेट नहीं किया जा सका।

# Red words when the time was set by hand while automatic time is on.
settings-datetime-keeps-right = घड़ी अभी अपने-आप सही रहती है। ऊपर उसे बंद करें, फिर समय हाथ से सेट करें।

# Red words when the system's message bus could not be reached.
settings-datetime-no-bus = सिस्टम बस तक पहुँचा नहीं जा सका।

# Red words when the time service does not answer.
settings-datetime-not-answering = समय सेवा जवाब नहीं दे रही।

# Red words when automatic time could not be turned on.
settings-datetime-ntp-on-failed = घड़ी को अपने-आप सही रहने के लिए नहीं कहा जा सका।

# Red words when automatic time could not be turned off.
settings-datetime-ntp-off-failed = अपने-आप समय बंद नहीं किया जा सका।

# Red words when the time zone could not be changed.
settings-datetime-zone-failed = समय क्षेत्र बदला नहीं जा सका।

# Red words when the date typed by hand is not a real date.
settings-datetime-not-real = यह असली तारीख़ नहीं है।

# Headline of the page before the time service has answered: { $time } is the time and { $date } the date.
settings-datetime-it-is = { $date } को { $time } हुए हैं।

# Headline of the page when the time service is not answering.
settings-datetime-service-down = समय सेवा जवाब नहीं दे रही, इसलिए घड़ी यहाँ बदली नहीं जा सकती।

# Headline of the page when the clock is automatic and in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-right = { $date } को { $time } हुए हैं, और घड़ी अपने-आप सही रहती है।

# Headline of the page when the clock is automatic but not yet in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-checks = { $date } को { $time } हुए हैं। इंटरनेट मिलते ही घड़ी खुद को जाँच लेगी।

# Headline of the page when the clock is set by hand: { $time } is the time and { $date } the date.
settings-datetime-it-is-hand = { $date } को { $time } हुए हैं। घड़ी हाथ से सेट की गई है।

# A city and how far its time is from Greenwich.
settings-datetime-city-offset = { $city }, { $offset }

# A city, its part of the world and how far its time is from Greenwich.
settings-datetime-city-region-offset = { $city }, { $region }, { $offset }

# Spoken name of the clock picture: the time, the date and the place.
settings-datetime-tip = { $date } को { $time } हुए हैं, { $zone }।

# Help text of the clock card when the time service is not answering or not yet read.
settings-datetime-ring-about = रिंग के बीच की घड़ी 24 या 12 घंटे में, सेकंड के साथ या बिना, लिखी जाती है। केवल रिंग की घड़ी इसे मानती है; प्रोग्रामों में तारीख़ें और समय क्षेत्र और भाषा में चुने गए प्रारूपों के अनुसार दिखते हैं।

# Heading of the card with the clock settings.
settings-datetime-the-clock = घड़ी

# Heading of the line shown when the time service is not answering.
settings-datetime-service-down-line = समय सेवा जवाब नहीं दे रही

# Under Set the time automatically when the internet can be used.
settings-datetime-from-internet = इंटरनेट से, जुड़े होने पर।

# Under Set the time automatically when the time service is not installed.
settings-datetime-needs-timesyncd = systemd-timesyncd इंस्टॉल होना चाहिए।

# Label of the switch for automatic time, and heading of its line.
settings-datetime-set-auto = समय अपने-आप सेट करें

# Name of the list of time zones, and heading of its line.
settings-datetime-time-zone = समय क्षेत्र

# Tip of the button that sets the date and time typed by hand.
settings-datetime-set-date-time = तारीख़ और समय सेट करें

# Heading of the line for setting the time by hand.
settings-datetime-by-hand = समय हाथ से सेट करें

# Under the Set the time by hand heading.
settings-datetime-by-hand-sub = पहले अपने-आप समय बंद करें, जैसा अभी है।

# Help text of the clock card (the information button) when the time service can keep the time from the internet.
settings-datetime-about = अपने-आप सेट होने पर, कंप्यूटर के जुड़े रहते घड़ी को इंटरनेट के टाइम सर्वरों से मिलाया जाता है और वह खुद सही रहती है। बंद होने पर तारीख़ और समय हाथ से लिखे जाते हैं। समय क्षेत्र नाइट लाइट को भी बताता है कि सूरज कब डूबता है। दोनों के लिए एडमिनिस्ट्रेटर का पासवर्ड चाहिए। रिंग के बीच की घड़ी 24 या 12 घंटे में, सेकंड के साथ या बिना, लिखी जाती है। केवल रिंग की घड़ी इसे मानती है; प्रोग्रामों में तारीख़ें और समय क्षेत्र और भाषा में चुने गए प्रारूपों के अनुसार दिखते हैं।

# Help text of the clock card (the information button) when the time service is not installed.
settings-datetime-about-no-ntp = अपने-आप सेट होने पर, कंप्यूटर के जुड़े रहते घड़ी को इंटरनेट के टाइम सर्वरों से मिलाया जाता है और वह खुद सही रहती है। बंद होने पर तारीख़ और समय हाथ से लिखे जाते हैं। समय क्षेत्र नाइट लाइट को भी बताता है कि सूरज कब डूबता है। दोनों के लिए एडमिनिस्ट्रेटर का पासवर्ड चाहिए। इंटरनेट से समय सही रखने के लिए systemd-timesyncd चाहिए: sudo apt install systemd-timesyncd रिंग के बीच की घड़ी 24 या 12 घंटे में, सेकंड के साथ या बिना, लिखी जाती है। केवल रिंग की घड़ी इसे मानती है; प्रोग्रामों में तारीख़ें और समय क्षेत्र और भाषा में चुने गए प्रारूपों के अनुसार दिखते हैं।

# An item in the list of ways to write the ring's clock: { $time } is the time written that way and { $what } its name.
settings-datetime-clock-option = { $time }  ({ $what })

# Name of the list of ways to write the ring's clock.
settings-datetime-show-as = इस रूप में दिखाएँ

# Heading of the line for the ring's clock.
settings-datetime-rings-clock = रिंग की घड़ी

# Under The ring's clock heading.
settings-datetime-rings-clock-sub = रिंग समय कैसे लिखती है।
