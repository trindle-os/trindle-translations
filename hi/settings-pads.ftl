# machine translated (Hindi), not yet reviewed by a person.


# The page's name in the side bar.
settings-pads-title = गेम कंट्रोलर

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = बदलने के लिए कंट्रोलर का कोई बटन दबाएँ।

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = अब { $name } के लिए कुंजी दबाएँ।

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = कोई जुड़ा नहीं है

# Small words under that line.
settings-pads-none-about = एक जोड़ें और उसके बटन यहाँ दिखेंगे।

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = कौन सा कंट्रोलर

# What the picture is, for the screen reader.
settings-pads-picture = { $title } की तस्वीर, जिसमें दबाया गया हर बटन रोशन होता है

# Title of the card of the controller's buttons.
settings-pads-buttons-title = बटन

# Words behind the i of that card.
settings-pads-buttons-about = हर बटन, ट्रिगर और स्टिक व d-pad की हर दिशा। जो आपने आखिर में दबाया वह सबसे ऊपर है। कुंजी में बदला गया बटन ऐसे गेम में वही कुंजी टाइप करता है जिसमें कंट्रोलर का समर्थन नहीं है।

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = { $name } को कुंजी में बदलें

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = { $name } को बदलना रोकें

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = { $name } क्या बनेगा

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = कोई कुंजी दबाएँ या कोई बटन चुनें

# The next choice in that list: the Escape key.
settings-pads-escape = Escape कुंजी

# The next choice in that list: nothing at all.
settings-pads-nothing = कुछ नहीं

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = डी-पैड { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = { $stick } स्टिक { $way }

settings-pads-left = बाएँ

settings-pads-right = दाएँ

settings-pads-up = ऊपर

settings-pads-down = नीचे

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = बायाँ

settings-pads-stick-right = दायाँ

# Title of the card of the ready-made changes.
settings-pads-quick-title = बने-बनाए बदलाव

# Title of the card of changes that are not one button into another.
settings-pads-other-title = दूसरे बदलाव

# Words behind the i of that card.
settings-pads-other-about = घुमाई गई स्टिक, अदला-बदली की गई स्टिक और डेड ज़ोन। इसे इस तरह लिखें: Left Stick dead zone = 10%, या Right Stick Y = inverted।


# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = कीबोर्ड: { $what }

settings-pads-on-mouse = माउस: { $what }

settings-pads-on-pad = गेम कंट्रोलर: { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = बायाँ क्लिक

settings-pads-right-click = दायाँ क्लिक

settings-pads-middle-click = बीच का क्लिक



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = प्रोफ़ाइल

# Words behind the i of that card.
settings-pads-profiles-about = प्रोफ़ाइल बदलावों का एक समूह है। मानक कुछ नहीं बदलता, इसलिए जिस गेम में अपना कंट्रोलर सपोर्ट है, वह कंट्रोलर को जैसा है वैसा देखता है। हर Steam गेम मानक इस्तेमाल करता है, जब तक आप यहाँ उसके लिए कोई प्रोफ़ाइल न चुनें, और वह गेम शुरू होते ही प्रोफ़ाइल अपने आप बदल जाती है। कोई और गेम उन गेम के लिए है जिन्हें Steam ने शुरू नहीं किया।

# The one switch that turns every controller change off at once.
settings-pads-changes = कंट्रोलर के बदलाव

settings-pads-changes-sub = बंद होने पर हर कंट्रोलर जैसा है वैसा रहता है।

# The game whose profile is shown.
settings-pads-game = गेम

settings-pads-other-game = कोई और गेम

settings-pads-game-running = { $name } (चल रहा है)

settings-pads-game-number = Steam गेम { $n }

# The profile the shown game uses.
settings-pads-profile = प्रोफ़ाइल

settings-pads-standard = मानक

settings-pads-standard-sub = कोई बदलाव नहीं।

settings-pads-profile-add = प्रोफ़ाइल जोड़ें

settings-pads-profile-remove = { $name } हटाएँ

settings-pads-profile-name = प्रोफ़ाइल का नाम

# The name a new profile is given.
settings-pads-profile-new = प्रोफ़ाइल { $n }

settings-pads-profile-empty = प्रोफ़ाइल को एक नाम चाहिए।

settings-pads-profile-standard = मानक नाम पहले से लिया हुआ है।

settings-pads-profile-taken = यह नाम पहले से लिया हुआ है।

settings-pads-profile-gone = वह प्रोफ़ाइल अब नहीं है।

settings-pads-not-a-game = यह Steam ऐप नंबर नहीं है।

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = मानक कुछ नहीं बदलता। पहले एक प्रोफ़ाइल जोड़ें।

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = मानक: कंट्रोलर जैसा है वैसा।

settings-pads-top-off = कंट्रोलर के बदलाव बंद हैं।

