# machine translated (Hindi), not yet reviewed by a person.

# Time since the lists were fetched, when it was under a minute ago.
settings-blocking-ago-now = अभी-अभी

# Time since the lists were fetched, in minutes.
settings-blocking-ago-minutes =
    { $n ->
        [one] { $n } मिनट पहले
       *[other] { $n } मिनट पहले
    }

# Time since the lists were fetched, in hours.
settings-blocking-ago-hours =
    { $n ->
        [one] { $n } घंटा पहले
       *[other] { $n } घंटे पहले
    }

# Time since the lists were fetched, in days.
settings-blocking-ago-days =
    { $n ->
        [one] { $n } दिन पहले
       *[other] { $n } दिन पहले
    }

# Shown beside the Block adverts and bad sites switch while the person is asked for the password.
settings-blocking-waiting = पासवर्ड का इंतज़ार है...

# Shown beside the switch after blocking is turned on.
settings-blocking-done-on = रोक चालू है

# Shown beside the switch after blocking is turned off.
settings-blocking-done-off = रोक बंद है

# Shown beside a control after a change to blocking was saved.
settings-blocking-saved = सहेजा गया

# Red words under the Add a site box when what was typed is not a site name.
settings-blocking-bad-site = किसी साइट का नाम लिखें, जैसे example.com।

# Headline of the page when blocking is off.
settings-blocking-top-off = रोक बंद है। लुकअप पहले की तरह आपके नेटवर्क के अपने सर्वरों के पास जाते हैं।

# Headline of the page while blocking is starting.
settings-blocking-top-starting = रोक शुरू हो रही है।

# Headline of the page when blocking works and lookups go privately to the chosen server.
settings-blocking-top-private = विज्ञापन और खराब साइटें रोकी जा रही हैं, और लुकअप निजी तौर पर { $provider } के पास जाते हैं।

# Headline of the page when the private server cannot be reached on this network.
settings-blocking-top-fallback = इस नेटवर्क पर निजी सर्वर तक पहुँचा नहीं जा सकता, इसलिए अभी आपके नेटवर्क के अपने सर्वर इस्तेमाल हो रहे हैं। रोक फिर भी काम करती है।

# Headline of the page when lookups go to the network's own servers.
settings-blocking-top-network = विज्ञापन और खराब साइटें रोकी जा रही हैं। लुकअप आपके नेटवर्क के अपने सर्वरों के पास जाते हैं, जो उन्हें देख सकते हैं।

# Headline of the page when lookups go through the VPN.
settings-blocking-top-vpn = विज्ञापन और खराब साइटें रोकी जा रही हैं। लुकअप VPN के ज़रिए आपके VPN के अपने सर्वरों के पास जाते हैं।

# Headline of the page when blocking is on and the lookups are still being set up.
settings-blocking-top-on = विज्ञापन और खराब साइटें रोकी जा रही हैं।

# Small word in the two tiles while blocking is starting.
settings-blocking-tile-starting = शुरू हो रही है

# Small word in the two tiles while blocking is off.
settings-blocking-tile-off = बंद

# Line under the two tiles while blocking is starting.
settings-blocking-tile-starting-note = रोक शुरू हो रही है

# Line under the two tiles while blocking is off.
settings-blocking-tile-off-note = रोक बंद है

# Name of the tile that counts the lookups blocked today.
settings-blocking-tile-today = आज रोके गए

# Line under the count of lookups blocked today.
settings-blocking-tile-today-note = आज रोके गए लुकअप

# Name of the tile about the lists of sites.
settings-blocking-tile-lists = सूचियाँ

# Number of the lists tile while the lists are being fetched.
settings-blocking-tile-fetching = लाई जा रही हैं

# Number of the lists tile when no list has been fetched yet.
settings-blocking-tile-none = अभी तक नहीं

# Line under the lists tile when no list has been fetched yet.
settings-blocking-tile-lists-note = साइटों की सूचियाँ

# Line under the lists tile: how many sites are listed and how long ago they were fetched.
settings-blocking-tile-listed-note = साइटें सूची में हैं, { $ago } लाई गईं

# Line in the Recently blocked card when nothing has been blocked.
settings-blocking-nothing = अभी तक कुछ नहीं रोका गया

# Small line under "Nothing blocked yet".
settings-blocking-nothing-sub = साइटें यहाँ दिखेंगी, सबसे नई सबसे ऊपर।

# Tip of the plus button on a blocked site, and beside the Add a site box: lets the site through.
# SAFETY: needs a human review before it ships
settings-blocking-let-through = इस साइट को हमेशा जाने दें

# Heading of the card that lists recently blocked sites.
settings-blocking-recent = हाल में रोकी गईं

# Help text (i button) of the Recently blocked card.
settings-blocking-recent-about = साइटें रोके जाते ही यहाँ दिखती हैं, सबसे नई सबसे ऊपर। प्लस किसी एक को अब से जाने देता है। यहाँ केवल रोकी गई साइटें दिखती हैं। जिन साइटों को जाने दिया गया उन्हें कभी रखा नहीं जाता।

# Shown on the Recently blocked card while blocking is off.
settings-blocking-recent-waits = यह देखने के लिए कि क्या रोका जाता है, रोक चालू करें।

# Placeholder of the box where a site name is typed.
settings-blocking-site-placeholder = जैसे example.com

# Heading of the line with the box for adding a site.
settings-blocking-add = साइट जोड़ें

# Small line under "Add a site".
settings-blocking-add-sub = इसे और इसके सभी सबडोमेन को कभी नहीं रोका जाता।

# Tip of the minus button on a site that is let through: blocks it again.
settings-blocking-block-again = इस साइट को फिर से रोकें

# Heading of the card that lists the sites that are let through.
settings-blocking-allowed = हमेशा जाने दें

# Help text (i button) of the Always let through card.
settings-blocking-allowed-about = यहाँ दी गई साइटों और उनके सभी सबडोमेन को कभी नहीं रोका जाता, चाहे वे सूचियों में हों। माइनस किसी एक को फिर से रोकता है।

# Name of the page in the list of settings pages and its heading.
settings-blocking-title = रोक

# Words the settings search looks for on this page (not shown).
settings-blocking-keywords = रोक ब्लॉक विज्ञापन ट्रैकर मैलवेयर धोखाधड़ी डीएनएस निजी लुकअप अनुमति block adverts ads trackers malware scams dns private lookups quad9 mullvad cloudflare allow

# Help text at the top of the page.
settings-blocking-help = इस कंप्यूटर के हर ब्राउज़र और ऐप के लिए विज्ञापन, ट्रैकर और जानी-पहचानी खराब साइटें रोकता है, और नामों के लुकअप एन्क्रिप्टेड कनेक्शन से भेजता है, ताकि आप जिस नेटवर्क पर हैं वह उन्हें पढ़ या बदल न सके।

# Text of the switch that turns blocking on or off.
settings-blocking-switch = विज्ञापन और खराब साइटें रोकें

# Tip of the dropdown that picks where lookups go.
settings-blocking-where = लुकअप कहाँ जाएँ

# Help text (i button) of the Blocking card.
settings-blocking-card-about = HaGeZi की विज्ञापनों, ट्रैकरों और जानी-पहचानी खराब साइटों की सूचियाँ इस्तेमाल करता है, जो दिन में एक बार लाई जाती हैं। इसके बंद रहने पर कुछ नहीं चलता। नामों के लुकअप एन्क्रिप्टेड कनेक्शन से यहाँ चुने निजी सर्वर के पास जाते हैं। Quad9 इसका कोई रिकॉर्ड नहीं रखता कि किसने पूछा। "आपका नेटवर्क" फिर भी रोकता है, पर निजी नहीं है: आपके नेटवर्क के अपने सर्वर हर लुकअप देखते हैं।

# Small line under the Block adverts and bad sites switch.
settings-blocking-switch-sub = HaGeZi की सूचियाँ, दिन में एक बार लाई जाती हैं।

# Heading of the line with the private server dropdown.
settings-blocking-private = निजी सर्वर

# Small line under Private server.
settings-blocking-private-sub = Quad9 कोई रिकॉर्ड नहीं रखता कि किसने पूछा।

# Name of the choice in Private server that uses the network's own servers.
settings-blocking-provider-network = आपका नेटवर्क
