
# machine translated (Hindi), not yet reviewed by a person.

# Name of the Permissions page, in the page list and as its heading.
settings-permissions-title = अनुमतियाँ

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = permissions allow privacy flatpak flathub sandbox internet network files sound microphone camera bluetooth notifications plugins deb x11 xwayland older programs steam wine java screen terminal computer thunderbolt usb4 dock devices अनुमतियाँ अनुमति गोपनीयता इंटरनेट फ़ाइलें ध्वनि माइक्रोफ़ोन कैमरा सूचनाएँ प्लगइन पुराने प्रोग्राम स्क्रीन उपकरण

# SAFETY: needs a human review before it ships
# Help line at the foot of the Permissions page.
settings-permissions-help = हर ऐप क्या इस्तेमाल कर सकता है। Flathub के ऐप, अपने फ़ोल्डर में इंस्टॉल किए प्रोग्राम और प्लगइन, सब अपने-अपने फ़ोल्डर में इंस्टॉल होते हैं और शुरू में सीमित रहते हैं। भरा हुआ आइकन यानी अनुमति है; बदलने के लिए उस पर क्लिक करें। Flathub ऐप में बदलाव उसके अगली बार शुरू होने पर लागू होता है। जिन Thunderbolt और USB4 उपकरणों को अनुमति दी गई है, वे बिना पूछे हमेशा जुड़ जाते हैं; दोबारा पूछे जाने के लिए किसी को भुला दें।

# SAFETY: needs a human review before it ships
# Red words when a permission could not be changed and nothing more is known.
settings-permissions-not-changed = इसे बदला नहीं जा सका।

# SAFETY: needs a human review before it ships
# Words beside a plugin when its change was saved but the plugin could not be started again.
settings-permissions-plugin-not-restarted = सहेजा गया, पर प्लगइन फिर से शुरू नहीं हो सका। बदलाव उसके अगली बार शुरू होने पर लागू होगा।

# Said beside an app, plugin or switch once a permission change is saved.
settings-permissions-saved = सहेजा गया

# SAFETY: needs a human review before it ships
# Help text of the AppImages card (the information button).
settings-permissions-loose-images = हर AppImage अपने अलग डिब्बे में चलता है, जिसका होम निजी होता है। भरा हुआ आइकन यानी अनुमति है; बदलने के लिए उस पर क्लिक करें। बदलाव AppImage के अगली बार शुरू होने पर लागू होता है।

# SAFETY: needs a human review before it ships
# Help text of the Started from Folders card (the information button).
settings-permissions-loose-programs = Folders से शुरू किया गया हर प्रोग्राम अपने अलग डिब्बे में चलता है, जिसका होम निजी होता है। भरा हुआ आइकन यानी अनुमति है; बदलने के लिए उस पर क्लिक करें। बदलाव प्रोग्राम के अगली बार शुरू होने पर लागू होता है।

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# SAFETY: needs a human review before it ships
# Under the Allow older programs switch.
settings-permissions-older-why = हर एक बाकी से अलग रखा जाता है। बंद होने पर वे नहीं खुलते।

# Heading of the card with the switch for older programs.
