# machine translated (Hindi), not yet reviewed by a person.

# Name of the Region and language page, in the page list and as its heading.
settings-region-title = क्षेत्र और भाषा

# Words people may search for to find the Region and language page, separated by spaces.
settings-region-keywords = भाषा लोकेल देश प्रारूप तारीख़ मुद्रा language locale country formats date currency

# Help line at the foot of the Region and language page.
settings-region-help = भाषा और प्रारूप अगली बार लॉग इन करने पर लागू होते हैं।

# Said beside the Language and Formats lists once a choice is saved.
settings-region-later = देखने के लिए लॉग आउट करके फिर लॉग इन करें।

# Shown while the page reads the computer.
settings-region-looking = देख रहा है…

# Under Money and paper: the paper and measures the chosen formats use (paper is a4, letter or other; measures is imperial or metric).
settings-region-paper-measures =
    { $paper ->
        [a4] A4 कागज़
        [letter] Letter कागज़
       *[other] कागज़
    }, { $measures ->
        [imperial] इंच और पाउंड
       *[other] मीट्रिक माप
    }

# Under Money and paper: { $money } is the money sign and { $paper } the paper and measures.
settings-region-money-and-paper = { $money }, { $paper }

# Under A date and a number: a date and a number written the way the formats chosen write them.
settings-region-date-and-number = { $date } और { $number }

# Said beside the Add a language line once a language is installed.
settings-region-installed-done = इंस्टॉल हो गई

# Headline when the language and the formats are the same: { $lang } is the language's name.
settings-region-everything-in = सब कुछ { $lang } में है।

# Headline when the formats differ from the language: the names are { $lang } and { $fmt }.
settings-region-menus-in = मेनू { $lang } में हैं; तारीख़ें और संख्याएँ { $fmt } की तरह लिखी जाती हैं।

# Headline when a change is saved but waits for the next login: { $words } is the sentence so far.
settings-region-with-wait = { $words } बदलाव देखने के लिए लॉग आउट करके फिर लॉग इन करें।

# Said beside the Install another line while a language is made.
settings-region-installing = इंस्टॉल हो रही है

# Name of the list of languages for menus and messages, heading of its line and of the card.
settings-region-language = भाषा

# Name of the list of formats and heading of its line.
settings-region-formats = प्रारूप

# Help text of the Language card (the information button).
settings-region-language-about = भाषा वह है जिसमें मेनू और संदेश होते हैं। प्रारूप बताते हैं कि तारीख़, समय, संख्याएँ, मुद्रा, माप और कागज़ का आकार कैसे लिखे जाते हैं, और ये किसी दूसरे देश के तरीक़े भी हो सकते हैं। दोनों अगली बार लॉग इन करने पर लागू होते हैं।

# Under the Language heading.
settings-region-language-sub = मेनू और संदेश, अगले लॉगिन से।

# Under the Formats heading.
settings-region-formats-sub = तारीख़ें, संख्याएँ, मुद्रा और कागज़ का आकार।

# Heading of the line that shows a date and a number in the chosen formats.
settings-region-date-number = एक तारीख़ और एक संख्या

# Heading of the line that shows the money and paper of the chosen formats.
settings-region-money-paper = मुद्रा और कागज़

# Heading of the line that shows the language now in use.
settings-region-in-use = अभी इस्तेमाल में

# Heading of the card for installing another language.
settings-region-add = भाषा जोड़ें

# Help text of the Add a language card (the information button).
settings-region-add-about = एक और भाषा इंस्टॉल करता है, ताकि उसे मेनू या प्रारूपों के लिए चुना जा सके। एक बनाने में थोड़ा समय लगता है और एडमिनिस्ट्रेटर का पासवर्ड चाहिए।

# Heading of the line shown when every language is already installed.
settings-region-all-installed = हर भाषा पहले से इंस्टॉल है

# Heading of the line saying how many languages are installed.
settings-region-installed = इंस्टॉल हैं

# Under the Installed heading: how many languages are installed.
settings-region-count =
    { $n ->
        [one] { $n } भाषा इंस्टॉल है।
       *[other] { $n } भाषाएँ इंस्टॉल हैं।
    }

# Name of the list of languages that can be installed, and heading of its line.
settings-region-install-another = और इंस्टॉल करें

# Tip of the button that installs the chosen language.
settings-region-install-this = यह भाषा इंस्टॉल करें (पासवर्ड माँगता है)

# Under the Install another heading.
settings-region-needs-password = एडमिनिस्ट्रेटर का पासवर्ड चाहिए।

# Heading of the line saying how many more languages can be made.
settings-region-ready = जोड़ने के लिए तैयार

# Under the Ready to add heading: how many more languages can be made.
settings-region-more =
    { $n ->
        [one] { $n } और भाषा जो यह कंप्यूटर बना सकता है।
       *[other] { $n } और भाषाएँ जो यह कंप्यूटर बना सकता है।
    }

settings-region-removing = हटाया जा रहा है

settings-region-removed-done = हटा दी गई

settings-region-remove-language = यह भाषा हटाएँ

settings-region-kept = इस कंप्यूटर की भाषाएँ

settings-region-kept-about = यहाँ इंस्टॉल की गई सभी भाषाएँ। जिन्हें आप इस्तेमाल नहीं करते, उन्हें हटा दें; जो भाषा आप इस्तेमाल कर रहे हैं वह रहेगी। एडमिनिस्ट्रेटर पासवर्ड माँगता है।

settings-region-in-use-stays = उपयोग में है, इसलिए रहेगी

