# machine translated (Hindi), not yet reviewed by a person.

# Name of the Crash reports page, in the page list and as its heading.
settings-crash-title = क्रैश रिपोर्ट

# Words people may search for to find the Crash reports page, separated by spaces.
settings-crash-keywords = क्रैश रिपोर्ट त्रुटि बग खराबी भेजना गोपनीयता crash reports errors bugs faults send sent privacy telemetry buildmorphic

# Help line at the foot of the Crash reports page.
settings-crash-help = जब Trindle का कोई प्रोग्राम क्रैश होता है, तो क्रैश रिपोर्ट ऐड-ऑन इस कंप्यूटर पर एक छोटा नोट रख लेता है। जब तक आप उसका भेजने का कमांड न चलाएँ और हर रिपोर्ट के लिए हाँ न कहें, वह कुछ नहीं भेजता; कमांड पहले पूरी रिपोर्ट दिखाता है। आपका नाम और GitHub नाम तभी जाते हैं जब आपने उन्हें यहाँ लिखा हो। कभी कोई संदेश, फ़ाइल का नाम, आप कहाँ हैं या दूसरे प्रोग्रामों के बारे में कुछ नहीं। ऐड-ऑन हटाने से सब रुक जाता है।

# Heading and label of the switch for sending crashes.
settings-crash-crashes = क्रैश

# Under the Crashes switch.
settings-crash-crashes-short = Trindle के कोड में कहाँ क्रैश हुआ।

# Part of the help text of the What is sent card: what Crashes sends.
settings-crash-crashes-long = क्रैश में प्रोग्राम, उसका संस्करण, क्रैश का प्रकार और Trindle के कोड में वह कहाँ हुआ, यह भेजा जाता है।

# Heading and label of the switch for sending errors.
settings-crash-errors = त्रुटियाँ

# Under the Errors switch.
settings-crash-errors-short = त्रुटि का तय नाम, और कहाँ।

# Part of the help text of the What is sent card: what Errors sends.
settings-crash-errors-long = त्रुटियों में प्रोग्राम, उसका संस्करण, Trindle का त्रुटि को दिया तय नाम और उसके कोड में कहाँ, यह भेजा जाता है।

# Heading and label of the switch for sending facts about the computer.
settings-crash-computer = इस कंप्यूटर के बारे में

# Under the About this computer switch.
settings-crash-computer-short = Linux, प्रोसेसर, मेमोरी, ग्राफ़िक्स, स्क्रीन।

# Part of the help text of the What is sent card: what About this computer adds.
settings-crash-computer-long = इस कंप्यूटर के बारे में हर रिपोर्ट में यह जोड़ता है: कौन-सा Linux चल रहा है, प्रोसेसर का प्रकार, नीचे की ओर गोल की गई मेमोरी, Wayland या X11, ग्राफ़िक्स किसने बनाए, और कितनी स्क्रीन हैं।

# Heading of the card with the switches for what is sent.
settings-crash-what-is-sent = क्या भेजा जाता है

# Help text of the What is sent card: { $switches } is what each switch sends.
settings-crash-what-about = { $switches } रिपोर्ट में कोई नाम नहीं होता, जब तक आप नीचे के बॉक्स में अपना Buildmorphic यूज़रनेम न लिखें, जिससे आपको केवल श्रेय मिलता है।

# Red words when a setting could not be changed: the reason is { $why }.
settings-crash-nothing-changed-because = कुछ नहीं बदला, क्योंकि { $why }।

# Red words when the file that keeps the switches was not written by Trindle.
settings-crash-file-not-as-wrote = कुछ नहीं बदला, क्योंकि इसे रखने वाली फ़ाइल वैसी नहीं है जैसी Trindle ने लिखी थी।

# Red words when there is no folder to keep the settings in.
settings-crash-no-settings-folder = कोई सेटिंग्स फ़ोल्डर नहीं।

# Red words when the folder for the settings could not be made.
settings-crash-folder-not-made = सेटिंग्स फ़ोल्डर बनाया नहीं जा सका।

# Red words when a setting could not be written to its file.
settings-crash-not-written = सेटिंग लिखी नहीं जा सकी।

# Name of a sent report that was a crash: the signal is { $signal } and the program { $program }.
settings-crash-what-crash = { $program } में क्रैश ({ $signal })

# Name of a sent report that was an error: the error is { $code } and the program { $program }.
settings-crash-what-error = { $program } में त्रुटि { $code }

# In the list of sent reports: the report was taken.
settings-crash-taken = ले ली गई

# In the list of sent reports: the report was not sent because the bug tracker is closed.
settings-crash-tracker-closed = नहीं भेजी गई: ट्रैकर बंद है

# In the list of sent reports: the report was not sent because it was too big.
settings-crash-too-big = नहीं भेजी गई: बहुत बड़ी

# In the list of sent reports: the report was not sent because it was refused.
settings-crash-refused = नहीं भेजी गई: अस्वीकार हुई

# In the list of sent reports: the report was not sent because too many came at once.
settings-crash-too-many = नहीं भेजी गई: एक साथ बहुत ज़्यादा

# In the list of sent reports: the report was not sent, no reason known.
settings-crash-not-sent = नहीं भेजी गई

# Said beside the link line once it is saved.
settings-crash-saved = सहेजा गया

# Tip of the button that clears the list of sent reports.
settings-crash-clear = सूची साफ़ करें

# Red words when the list of sent reports could not be cleared.
settings-crash-not-cleared = सूची साफ़ नहीं की जा सकी।

# Said beside the list of sent reports once it is cleared.
settings-crash-removed = हटा दी गई

# Heading of the line that holds the clear button.
settings-crash-kept-here = केवल इसी कंप्यूटर पर रखी जाती है

# Under the Kept on this computer only heading.
settings-crash-newest-first = सबसे नई पहले, पचास तक।

# Heading of the line shown when no report has been sent.
settings-crash-nothing-yet = अभी कुछ नहीं

# Under the Nothing yet heading.
settings-crash-listed-here = हर रिपोर्ट यहाँ सूची में होती है, ठीक वैसी जैसी भेजी गई थी।

# Tip of the button that shows exactly what one report held.
settings-crash-show-sent = ठीक वही दिखाएँ जो भेजा गया

# Under a sent report: { $when } is the time, { $n } is how many times it happened (0 when once) and { $answer } how it went.
settings-crash-sent-sub =
    { $n ->
        [0] { $when }: { $answer }
        [one] { $when }, { $n } बार: { $answer }
       *[other] { $when }, { $n } बार: { $answer }
    }

# Heading of the card listing reports that were sent.
settings-crash-sent-so-far = अब तक भेजी गईं

# Help text of the Sent so far card (the information button).
settings-crash-sent-about = हर रिपोर्ट ठीक वैसी ही सूची में है जैसी भेजी गई थी, सबसे नई पहले, और केवल इसी कंप्यूटर पर रखी जाती है। "ले ली गई" का मतलब है कि Buildmorphic के पास है। "नहीं भेजी गई: ट्रैकर बंद है" का मतलब है कि Trindle का बग ट्रैकर रिपोर्ट नहीं ले रहा; "अस्वीकार हुई" का मतलब है कि गलत बनी होने के कारण मना कर दी गई; "बहुत ज़्यादा" का मतलब है कि एक साथ बहुत ज़्यादा आईं।

# Headline of the page when the add-on is not installed and the person is asked after a crash.
settings-crash-sum-asked = क्रैश के बाद आपसे पूछा जाता है, पूरी रिपोर्ट दिखाकर, कि भेजें या नहीं।

# Headline of the page when nothing is sent and the person is not asked.
settings-crash-sum-nothing = कुछ नहीं भेजा जाता, और क्रैश के बाद आपसे नहीं पूछा जाता।

# Headline of the page when both crashes and errors are turned off.
settings-crash-sum-none = कुछ नहीं भेजा जाता: क्रैश और त्रुटियाँ दोनों बंद हैं।

# Headline of the page: what is reported (crashes, errors or both) and under whose name (named, linked or anonymous) in { $which }, and the Buildmorphic name in { $name }.
settings-crash-sum-reported =
    { $which ->
        [errors] Trindle के प्रोग्रामों की त्रुटियाँ गुमनाम रूप से रिपोर्ट की जाती हैं।
        [both] Trindle के प्रोग्रामों के क्रैश और त्रुटियाँ गुमनाम रूप से रिपोर्ट किए जाते हैं।
       *[crashes] Trindle के प्रोग्रामों के क्रैश गुमनाम रूप से रिपोर्ट किए जाते हैं।
    }

# Label of the switch for asking about problems and sharing reports, and heading of its line.
settings-crash-ask = समस्याओं और रिपोर्ट साझा करने के बारे में पूछें

# Under the Ask about problems heading.
settings-crash-ask-sub = बंद करने पर यह सब छिप जाता है और रुकी हुई रिपोर्ट मिट जाती हैं।

# Said beside the Ask switch when it is turned off and no reports were waiting.
settings-crash-off-none = बंद। कोई रिपोर्ट रुकी हुई नहीं थी।

# Said beside the Ask switch when it is turned off: how many waiting reports were deleted.
settings-crash-off-deleted =
    { $n ->
        [one] बंद। { $n } रुकी हुई रिपोर्ट मिटा दी गई।
       *[other] बंद। { $n } रुकी हुई रिपोर्ट मिटा दी गईं।
    }

# Tip of the button that opens the community page.
settings-crash-about-community = समुदाय के बारे में

# Heading of the line with the community button.
settings-crash-go-to-bm = रिपोर्ट Buildmorphic को जाती हैं

# Under the Reports go to Buildmorphic heading.
settings-crash-community = वह समुदाय जो Trindle बनाने में मदद करता है।

# Placeholder of the box for the Buildmorphic username.
settings-crash-username = उपयोगकर्ता नाम

# Heading of the line with the username box.
settings-crash-your-username = आपका Buildmorphic उपयोगकर्ता नाम

# Under the username heading.
settings-crash-username-sub = वैकल्पिक। कभी ईमेल पता नहीं।

# Heading of a line about joining with an email address.
settings-crash-join = केवल ईमेल पते से जुड़ें

# Under the Join heading.
settings-crash-join-sub = जिन समस्याओं की रिपोर्ट आप सबसे पहले करें उनके लिए श्रेय और स्तर पाएँ।

# Heading of a line saying a report holds only a fixed list.
settings-crash-fixed = रिपोर्ट में केवल एक तय सूची होती है

# Under the fixed list heading.
settings-crash-fixed-sub = आप इसे पहले देखते हैं, और आपके दबाए बिना कुछ नहीं जाता।

# Heading of the card for reports the person sends.
settings-crash-reports-you-send = जो रिपोर्ट आप भेजते हैं

# Help text of the Reports you send card (the information button).
settings-crash-reports-about = जब Trindle का कोई प्रोग्राम क्रैश होता है, तो एक विंडो खुलकर पूछ सकती है कि रिपोर्ट भेजें या नहीं। वह पहले ठीक वही टेक्स्ट दिखाती है: आपके शब्द, कंप्यूटर का मॉडल और ग्राफ़िक्स, त्रुटि और ठीक पहले का लॉग। फ़ाइलें, पासवर्ड और वाई-फ़ाई के नाम कभी नहीं पढ़े जाते, और नाम और पते मिटा दिए जाते हैं। आप यही विंडो रिंग के "समस्या बताएँ" बटन से कभी भी खोल सकते हैं।

# Spoken name of the box where the GitHub name is typed.
settings-crash-github-name = github नाम

# Heading of the line where the person can give their GitHub name.
settings-crash-github-line = आपका GitHub नाम

# Small words under that heading.
settings-crash-github-about = वैकल्पिक। "रिपोर्ट करने वाला" के रूप में दिखाया जाता है।

