# machine translated (Hindi), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = रिंग

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = पसंदीदा लॉन्चर किनारा क्लिक कोना आवाज़ बोलना विंडो खुली क्लिपबोर्ड कॉपी पेस्ट इतिहास भूलना सूचनाएँ favourites favorites launcher edge click hot corner voice speech windows open windows clipboard copy paste history forget notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = आपके पसंदीदा रिंग के बीच के चारों ओर रहते हैं। उन्हें रिंग में ही चुना जाता है: जोड़ने या हटाने के लिए रिंग में किसी भी ऐप पर राइट-क्लिक करें, और क्रम बदलने के लिए किसी पसंदीदा को दूसरे की जगह पर खींचें।

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = रिंग स्क्रीन के किनारे पर खुलती है, और आपकी खुली विंडो उसमें रहती हैं।

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = चीज़ें कहाँ खुलती हैं

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = स्क्रीन के किनारे पर क्लिक करें

# Small words under that line about the Super key.
settings-ring-open-super = Super कुंजी भी इसे खोलती है।

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } पसंदीदा
       *[other] { $n } पसंदीदा
    }

# Small words under the favourites line.
settings-ring-favourites-about = जोड़ने के लिए रिंग में किसी ऐप पर राइट-क्लिक करें।

# Title of the card about opening the ring.
settings-ring-opening = रिंग खोलना

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = पॉइंटर को स्क्रीन के किनारे पर ले जाकर क्लिक करें, या Super कुंजी दबाएँ, और रिंग खुल जाती है। आपके पसंदीदा रिंग के बीच के चारों ओर रहते हैं, और आपकी खुली विंडो उनके चारों ओर एक घेरे में: किसी को आगे लाने के लिए उस पर क्लिक करें, या उसके बटनों के लिए राइट-क्लिक करें। जोड़ने या हटाने के लिए रिंग में किसी भी ऐप पर राइट-क्लिक करें।

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = आते ही दिखाएँ

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = बंद: वे फिर भी रिंग में जमा होती हैं।

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = कितनी देर रहें

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = ज़रूरी वाली बंद किए जाने तक रुकी रहती हैं।

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = कहाँ दिखें

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = जिस कोने से वे ढेर लगाती हैं।

# Title of the card about notifications.
settings-ring-notify-title = सूचनाएँ

# Words behind the i of the card about notifications.
settings-ring-notify-about = जब किसी प्रोग्राम को आपको कुछ बताना होता है, तो वह कुछ सेकंड के लिए दिखता है और फिर चला जाता है। बंद करने पर कुछ नहीं दिखता, और सब कुछ फिर भी रिंग के सूचना वाले गोले में जमा रहता है। जो भी यहाँ चुना जाए, ज़रूरी सूचना बंद किए जाने तक रुकी रहती है, ताकि कोई चेतावनी पढ़े जाने से पहले ही गायब न हो जाए।

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = कॉपी किया हुआ कब भूलें

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = पिन की हुई पंक्तियाँ रखी जाती हैं।

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = अभी कॉपी की हुई

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n } पंक्ति, { $pinned } पिन की हुई।
       *[other] { $n } पंक्तियाँ, { $pinned } पिन की हुई।
    }

# Title of the card about the clipboard.
settings-ring-clip-title = क्लिपबोर्ड

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = रिंग का क्लिपबोर्ड वाला गोला वह रखता है जो आप कॉपी करते हैं, ताकि आप पहले का कुछ पेस्ट कर सकें। यहाँ जो भी चुना जाए, पिन की हुई पंक्तियाँ हमेशा रखी जाती हैं।

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = आवाज़ जोड़ी जा रही है; तब तक आप अपना काम करते रहें।

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = बिल्ड टूल हटाए जा रहे हैं।

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = आवाज़ हटाई जा रही है।

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = आवाज़ से नियंत्रण

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = चालू

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = बंद

# Small words under the voice switch.
settings-ring-voice-about = केवल इसी कंप्यूटर पर समझा जाता है।

# Heading of the line, and the name of its button, that removes voice.
settings-ring-voice-remove = आवाज़ हटाएँ

# Small words under the line that removes voice.
settings-ring-voice-remove-about = लगभग 150 MB खाली होते हैं।

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = आवाज़ तैयार है। बिल्ड टूल रखे हैं।

# Name of the button that removes the build tools voice left behind.
settings-ring-voice-tools-remove = बिल्ड टूल हटाएँ

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = आवाज़ से नियंत्रण जोड़ें (लगभग 150 MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = वैकल्पिक; जोड़ने में लगभग 150 MB।

# Title of the card about voice.
settings-ring-voice-title = आवाज़

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = क्लिक करने के बजाय किसी ऐप का नाम, “तेज़” या “वाई-फ़ाई सेटिंग्स” बोलें। रिंग के बीच में टैप करके बोलें; आपके रुकते ही वह सुनना बंद कर देती है। बोली इसी कंप्यूटर पर समझी जाती है और कहीं कुछ नहीं भेजा जाता। इसे जोड़ने में लगभग 150 MB और कुछ मिनट लगते हैं, और तब तक आप अपना काम करते रह सकते हैं; हटाने पर बोली समझने वाला इंजन और उसका मॉडल हट जाते हैं।

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = आवाज़ जोड़ी जा रही है

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = बिल्ड टूल हटाए जा रहे हैं

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = आवाज़ हटाई जा रही है

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = हर बार कंप्यूटर रीस्टार्ट होने पर

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = एक दिन बाद

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = एक हफ़्ते बाद

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = दो हफ़्ते बाद

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = कभी नहीं

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = इशारा करने पर शीर्षक दिखाएँ

# Small words under that switch.
settings-ring-names-about = बंद: केवल स्नैपशॉट। स्क्रीन रीडर को शीर्षक फिर भी मिलता है।
