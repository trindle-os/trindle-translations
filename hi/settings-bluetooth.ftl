# machine translated (Hindi), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth चालू नहीं किया जा सका।

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth बंद नहीं किया जा सका।

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth चालू नहीं है।

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
settings-bluetooth-cause-auth-failed = { $could_not } PIN या संख्या स्वीकार नहीं हुई। फिर कोशिश करें।

# Said in red when the pairing was turned down; the first sentence says what could not be done.
settings-bluetooth-cause-turned-down = { $could_not } इसे यहाँ या दूसरे डिवाइस पर अस्वीकार कर दिया गया।

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } दूसरे डिवाइस ने समय पर जवाब नहीं दिया। उसे पेयरिंग मोड में रखें, फिर कोशिश करें।

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } यह पहले से हो रहा है। थोड़ा रुकें।

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } डिवाइस ने जवाब नहीं दिया। देखें कि वह चालू और पास है, फिर कोशिश करें।

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } डिवाइस इस्तेमाल के लिए तैयार नहीं है। उसे पेयरिंग मोड में रखें, फिर कोशिश करें।

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = सिस्टम बस

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Bluetooth खोजा जा रहा है…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = इस कंप्यूटर पर Bluetooth चल नहीं रहा।

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth बंद है।

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth कंप्यूटर पर ही बंद किया गया है।

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = इस कंप्यूटर में Bluetooth नहीं है।

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = चालू है, आस-पास के डिवाइस खोज रहा है…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = चालू है, अभी कुछ जुड़ा नहीं है।

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] चालू है, और { $names } जुड़ा है।
       *[other] चालू है, और { $names } जुड़े हैं।
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = स्विच इस कंप्यूटर का Bluetooth चालू या बंद करता है; उसके नीचे एडैप्टर का नाम है। जब तक "दूसरे डिवाइस को दिखे" चालू है, आस-पास के डिवाइस इस कंप्यूटर को खोज सकते हैं।

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = बंद किया गया है।

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
settings-bluetooth-visible = दूसरे डिवाइस को दिखे

# Small line under the Visible to other devices switch.
settings-bluetooth-visible-sub = आस-पास के डिवाइस इस कंप्यूटर को खोज सकते हैं।

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = कंप्यूटर पर ही बंद किया गया है

# Small line under it.
settings-bluetooth-hard-line-sub = किसी स्विच या कुंजी से। पहले उसे चालू करें।

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = कोई Bluetooth एडैप्टर नहीं

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = इस कंप्यूटर में कोई Bluetooth एडैप्टर नहीं मिला। USB सॉकेट में लगने वाला एडैप्टर लगाते ही यहाँ दिख जाता है।

# Line in that card.
settings-bluetooth-none-found = कोई नहीं मिला

# Small line under it.
settings-bluetooth-none-found-sub = USB वाला लगाते ही यहाँ दिखता है।

# Shown beside the Bluetooth switch while the password is asked for.
settings-bluetooth-waiting = पासवर्ड का इंतज़ार है...

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = इस कंप्यूटर को दूसरे डिवाइस को दिखाया नहीं जा सका।

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = इस कंप्यूटर को दूसरे डिवाइस से छिपाया नहीं जा सका।

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = इन्हें इस्तेमाल करने के लिए Bluetooth चालू करें।

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = अभी कोई पेयर नहीं है

# Small line under it.
settings-bluetooth-none-paired-sub = पेयर करने के लिए डिवाइस खोजें।

# Heading of the card that lists paired devices.
settings-bluetooth-mine = मेरे डिवाइस

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = इस कंप्यूटर से पेयर किए डिवाइस, जहाँ बताया जाता है वहाँ उनकी बैटरी के साथ। पेज खुलते समय जुड़े हुए पहले आते हैं, और पेज खुला रहने तक कोई पंक्ति अपनी जगह पर रहती है। गोल बटन एक को जोड़ते या अलग करते हैं; कूड़ेदान उसे भुला देता है, इसलिए उसे फिर पेयर करना पड़ता है।

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = डिवाइस खोजे जा रहे हैं...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = खोजना बंद करें

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = डिवाइस खोजें

# Small line under it.
settings-bluetooth-look-sub = पहले दूसरे डिवाइस को पेयरिंग मोड में रखें।

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = आस-पास

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = "डिवाइस खोजें" दबाएँ, दूसरे डिवाइस को पेयरिंग मोड में रखें, फिर उसके पास "पेयर करें" दबाएँ। पेज खुलते समय आस-पास के डिवाइस सबसे मज़बूत सिग्नल वाले पहले सूचीबद्ध होते हैं, और हर नया मिला डिवाइस अंत में जुड़ता है। कुछ एक संख्या दिखाते हैं जिसे यहाँ की संख्या से मिलाना है, और कुछ PIN माँगते हैं, जो अक्सर उनके निर्देशों में होता है, या 0000।

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = डिवाइस खोजना बंद नहीं किया जा सका।

# Said in red when the search could not be started.
settings-bluetooth-start-failed = डिवाइस खोजे नहीं जा सके।

# Small line of a device that is connected.
settings-bluetooth-connected = जुड़ा हुआ

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = जुड़ा नहीं है

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = बैटरी { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
settings-bluetooth-pair = पेयर करें

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = अलग करें

# Tip of the button that connects a device.
settings-bluetooth-connect = जोड़ें

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = इस डिवाइस को भुला दें

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = इसे अलग नहीं किया जा सका।

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = इसे भुलाया नहीं जा सका।

# Shown under a device while it is being paired.
settings-bluetooth-pairing = पेयर हो रहा है...

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = इसे पेयर नहीं किया जा सका।

# Shown under a device while it is being connected.
settings-bluetooth-connecting = जुड़ रहा है...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = इसे जोड़ा नहीं जा सका।

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = जुड़ गया, पर इसे अगली बार अपने-आप जुड़ने के लिए सेट नहीं किया जा सका। जब चाहिए, यहाँ से जोड़ें।

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = डिवाइस पर { $code } लिखें, फिर उस पर Enter दबाएँ।

# Question under a device that shows a number to compare with the one on this computer.
settings-bluetooth-compare = क्या दूसरा डिवाइस { $code } दिखा रहा है?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = नहीं

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = हाँ, मेल खाता है

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = इस डिवाइस से पेयर करें?

# Placeholder of the box where a device's PIN is typed.
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = रद्द करें

# Help line above the box where a device's PIN is typed.
settings-bluetooth-pin-help = इस डिवाइस का PIN लिखें। यह अक्सर उसके निर्देशों में होता है, या 0000।

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = हेडफ़ोन माउस कीबोर्ड पेयर डिवाइस वायरलेस headphones mouse keyboard pair devices wireless

# Help text at the top of the page.
settings-bluetooth-help = "खोजें" दबाएँ, दूसरे डिवाइस को पेयरिंग मोड में रखें, फिर उसके पास "पेयर करें" दबाएँ।

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Bluetooth की आवाज़ फिर शुरू नहीं की जा सकी, इसलिए अगली बार लॉग इन करने तक हेडफ़ोन साधारण गुणवत्ता पर चल सकते हैं। { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Bluetooth बंद करके फिर चालू करने के बाद हेडफ़ोन साधारण क्यों सुनाई देते हैं


# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } यह डिवाइस अब पहचाना नहीं जा रहा। उसे फिर से खोजें।

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } सहेजी हुई जोड़ी अब स्वीकार नहीं हो रही। डिवाइस को भुला दें और फिर से पेयर करें।

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = यह जुड़ा, फिर कट गया। सहेजी हुई जोड़ी पुरानी हो सकती है।

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = भुलाकर फिर से पेयर करें

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = भुला दिया गया। उसे पेयरिंग मोड में रखें, फिर नीचे दिखने पर "पेयर करें" दबाएँ।

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = इसके बारे में और जानें

