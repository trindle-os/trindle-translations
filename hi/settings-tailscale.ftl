
# machine translated (Hindi), not yet reviewed by a person.

# What a device runs, shown in a device's small line, when it is an iPhone or iPad.
settings-tailscale-system-ios = iPhone या iPad

# In a device's small line: the device is on the network now.
settings-tailscale-online = अभी ऑनलाइन

# In a device's small line: the device has never been seen.
settings-tailscale-not-seen = अभी तक दिखा नहीं

# In a device's small line: when the device was last online; the date is already written.
settings-tailscale-last-online = आख़िरी बार ऑनलाइन: { $day }

# SAFETY: needs a human review before it ships
# Shown beside the Use Tailscale switch while the password is asked for, when Tailscale is already installed.
settings-tailscale-waiting = पासवर्ड का इंतज़ार है...

# SAFETY: needs a human review before it ships
# Shown beside the Use Tailscale switch while the password is asked for, before Tailscale is installed.
settings-tailscale-waiting-install = पासवर्ड का इंतज़ार है, फिर Tailscale इंस्टॉल होगा...

# Shown beside the switch after Tailscale is turned on.
settings-tailscale-done-on = Tailscale चालू

# Shown beside the switch after Tailscale is turned off.
settings-tailscale-done-off = Tailscale बंद

# Shown under the Sign in line once the browser is being opened.
settings-tailscale-opening = आपके ब्राउज़र में साइन-इन पेज खुल रहा है...

# Red words under the Sign in line when Tailscale could not be started.
settings-tailscale-not-started = Tailscale शुरू नहीं हो सका।

# Red words under the Sign out line when signing out did not work.
settings-tailscale-sign-out-failed = Tailscale साइन आउट नहीं हुआ।

# Headline of the page while Tailscale is being asked how it is.
settings-tailscale-top-asking = Tailscale से पूछा जा रहा है…

# Headline of the page when Tailscale is off and not installed.
settings-tailscale-top-not-installed = Tailscale इंस्टॉल नहीं है। इंस्टॉल करने के लिए नीचे इसे चालू करें।

# Headline of the page when Tailscale is installed but off.
settings-tailscale-top-off = Tailscale बंद है, इसलिए यह मेमोरी नहीं लेता।

# Headline of the page when Tailscale is on but does not answer.
settings-tailscale-top-silent = Tailscale जवाब नहीं दे रहा। हो सकता है यह अभी शुरू हो रहा हो।

# Headline of the page when connected: the name of the private network and of this computer.
settings-tailscale-top-connected = { $name } के रूप में { $network } से जुड़े हैं।

# Name used in the headline for the private network when it has no name of its own.
settings-tailscale-network-fallback = Tailscale

# Headline of the page when Tailscale is on and has to be signed in to.
settings-tailscale-top-sign-in = Tailscale चालू है। अपने निजी नेटवर्क से जुड़ने के लिए नीचे साइन इन करें।

# Headline of the page for any other state; the state is already written in lower case.
settings-tailscale-top-state = Tailscale की स्थिति: { $state }।

# Name of the page in the list of settings pages.
settings-tailscale-title = Tailscale

# Words the settings search looks for on this page (not shown).
settings-tailscale-keywords = tailscale vpn private network devices remote tailnet निजी नेटवर्क डिवाइस रिमोट

# Help text at the top of the page.
settings-tailscale-help = Tailscale आपके अपने कंप्यूटर और फ़ोन को, वे जहाँ भी हों, एक निजी नेटवर्क में जोड़ता है। इसे चालू करने तक इसका कुछ भी इंस्टॉल नहीं होता, और बंद रहने पर यह मेमोरी नहीं लेता।

# Small line under the Use Tailscale switch before Tailscale is installed.
settings-tailscale-switch-sub-first = इसे Tailscale के अपने स्रोत से इंस्टॉल करता है।

# Small line under the Use Tailscale switch once Tailscale is installed.
settings-tailscale-switch-sub = बंद: रुका हुआ, कंप्यूटर के साथ शुरू नहीं होता।

# Text of the switch that turns Tailscale on or off, and heading of its line.
settings-tailscale-switch = Tailscale इस्तेमाल करें

# SAFETY: needs a human review before it ships
# Help text (i button) of the Tailscale card when Tailscale is off or has not answered.
settings-tailscale-about-plain = पहली बार चालू करने पर Tailscale, Tailscale के अपने सॉफ़्टवेयर स्रोत से इंस्टॉल होता है, फिर शुरू होता है। इसकी बैकग्राउंड सेवा चालू रहने पर मेमोरी लेती है, इसलिए यह तभी चलती है जब यह चालू हो। बंद रहने पर Tailscale रुका रहता है और कंप्यूटर के साथ शुरू नहीं होता। फ़ायरवॉल आपके अपने Tailscale डिवाइस को अंदर आने देता है, और बाकी सब को पहले की तरह बाहर रखता है।

# Help text (i button) of the Tailscale card when Tailscale is on but not yet connected.
settings-tailscale-about-sign-in = { settings-tailscale-about-plain } साइन इन करने पर आपके ब्राउज़र में Tailscale का साइन-इन पेज खुलता है। अपने हर डिवाइस पर एक ही खाता इस्तेमाल करें।

# Help text (i button) of the Tailscale card when connected.
settings-tailscale-about-connected = { settings-tailscale-about-plain } साइन आउट करने पर यह कंप्यूटर आपके निजी नेटवर्क से हट जाता है, जब तक आप फिर साइन इन न करें।

# Line in the devices card when there are no other devices.
settings-tailscale-no-devices = अभी कोई और डिवाइस नहीं

# Small line under "No other devices yet".
settings-tailscale-no-devices-sub = किसी दूसरे पर उसी खाते से साइन इन करें।

# Shown on the devices card while Tailscale is off.
settings-tailscale-waits-off = अपने डिवाइस देखने के लिए Tailscale चालू करें।

# Shown on the devices card while Tailscale has not answered.
settings-tailscale-waits-looking = आपके डिवाइस खोजे जा रहे हैं…

# Shown on the devices card when Tailscale needs signing in to.
settings-tailscale-waits-sign-in = अपने डिवाइस देखने के लिए साइन इन करें।

# Shown on the devices card when Tailscale is on but not connected.
settings-tailscale-waits-connect = अपने डिवाइस देखने के लिए कनेक्ट करें।

# Small line under this computer when it has no address yet.
settings-tailscale-no-address = अभी कोई पता नहीं।

# Small line under this computer: its address on the private network.
settings-tailscale-address = आपके निजी नेटवर्क पर { $address }।

# Name of this computer's line when Tailscale gives it no name.
settings-tailscale-this-computer = यह कंप्यूटर

# Heading of the line that signs in to Tailscale, and tip of its round button.
settings-tailscale-sign-in = साइन इन

# Small line under the Sign in line.
settings-tailscale-sign-in-sub = आपके ब्राउज़र में साइन-इन पेज खोलता है।

# Heading of the line that joins the private network again, and tip of its round button.
settings-tailscale-connect = कनेक्ट करें

# Small line under the Connect line.
settings-tailscale-connect-sub = आपके निजी नेटवर्क से फिर जुड़ता है।

# SAFETY: needs a human review before it ships
# Heading of the line that says the firewall lets the person's own devices in.
settings-tailscale-firewall = आपके अपने डिवाइस अंदर आ सकते हैं

# SAFETY: needs a human review before it ships
# Small line under that heading.
settings-tailscale-firewall-sub = बाकी सब को पहले की तरह बाहर रखा जाता है।

# Heading of the line that signs out, and tip of its button.
settings-tailscale-sign-out = साइन आउट

# Small line under the Sign out line.
settings-tailscale-sign-out-sub = आपके निजी नेटवर्क से बाहर निकलता है।

# Heading of the card with the Tailscale switch.
settings-tailscale-card = Tailscale

# Heading of the card that lists the person's devices.
settings-tailscale-devices = आपके डिवाइस

# Help text (i button) of the Your devices card.
settings-tailscale-devices-about = आपके निजी नेटवर्क में साइन इन हर डिवाइस, उस पर उसके पते, वह क्या चलाता है और आख़िरी बार कब ऑनलाइन था, के साथ। नया डिवाइस जोड़ने के लिए अपने फ़ोन या किसी दूसरे कंप्यूटर पर Tailscale इंस्टॉल करें और उसी खाते से साइन इन करें।
