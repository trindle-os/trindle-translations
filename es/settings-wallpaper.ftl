
# machine translated (Spanish), not yet reviewed by a person.

# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Fondo de pantalla

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = fondo imagen presentación foto wallpaper

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Un color liso, una imagen o una carpeta para que la imagen cambie sola a la hora que indiques.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 segundos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 segundos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = 1 minuto

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 minutos

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = 1 hora

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = 1 día

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Llenar la pantalla

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Ajustar, imagen completa

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = Centrar, tamaño real

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Estirar

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Mosaico

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = Al azar

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = Por nombre de archivo

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = No se pudo cambiar el fondo: su programa no se inició.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] { $used } de { $all } imagen
       *[other] { $used } de { $all } imágenes
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = { $folder } no tiene imágenes

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] { $used } de { $all } imagen que viene con Trindle
       *[other] { $used } de { $all } imágenes que vienen con Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] { $used } de { $all } imagen de { $folder }
       *[other] { $used } de { $all } imágenes de { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, una de las imágenes que vienen con Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Un color liso, definido abajo.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Ya no hay nada ahí. Elige una imagen o una carpeta.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Un color liso, sin imagen.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Una imagen nueva cada { $every }, usando { $used } de la { $all } imagen que viene con Trindle.{ $extra }
       *[other] Una imagen nueva cada { $every }, usando { $used } de las { $all } imágenes que vienen con Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Una imagen nueva cada { $every }, usando { $used } de la { $all } imagen de { $folder }.{ $extra }
       *[other] Una imagen nueva cada { $every }, usando { $used } de las { $all } imágenes de { $folder }.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = La carpeta { $folder } no tiene imágenes. Elige otra.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = La carpeta contiene más de lo que Trindle revisa, así que algunas imágenes pueden quedar fuera.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }, una de las imágenes que vienen con Trindle.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = Una sola imagen, { $name }, todo el tiempo.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = No se usa la imagen. { $why } Se muestra la propia de Trindle.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = La imagen ya no está. Elige una imagen o una carpeta.

# Said in green under a line after its choice was kept.
