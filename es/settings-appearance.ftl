
# machine translated (Spanish), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = Apariencia

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = colour colours color colors accent theme themes look skin glass dark light mode sunshine bright icons font cursor pointer screen reader blind read aloud accessibility labels tooltips names pointing colores acento tema temas aspecto oscuro claro modo iconos fuente tipografía puntero lector de pantalla leer en voz alta accesibilidad etiquetas nombres

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = Claro u oscuro, colores, iconos, tipografías, el puntero y la lectura de la pantalla en voz alta. Algunos programas solo lo notan al volver a abrirse.

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = ¿Conservar este aspecto?

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = Escape vuelve atrás ahora.

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = Oscuro

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = Claro

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = oscuro

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = claro

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }, { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = Cómo se ve { $name }, { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = El aspecto { $look }.

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = El aspecto propio de Trindle, porque no se puede usar el tema { $theme }. { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = El tema { $theme }, { $look }, con el resalte { $accent } e iconos { $shape }.

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = El tema { $theme }, con el resalte { $accent } e iconos { $shape }.

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look }, con el resalte { $accent } e iconos { $shape }.

# Shape of the icons in the top sentence.
settings-appearance-shape-round = redondos

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = Amarillo Trindle

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = Dice lo que hay en la pantalla y lo que escribes. Super, Alt y S juntas también lo activan y desactivan.

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = No se pudieron rehacer los iconos, así que algunos conservan su forma anterior. Elige el conjunto otra vez para intentarlo de nuevo.

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = Algunos colores se han aclarado para leerse mejor.

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
        [one] Probando el tema { $theme }. El aspecto que tenías vuelve en { $seconds } segundo si no pulsas Conservar. Escape vuelve atrás ahora.
        [many] Probando el tema { $theme }. El aspecto que tenías vuelve en { $seconds } segundos si no pulsas Conservar. Escape vuelve atrás ahora.
       *[other] Probando el tema { $theme }. El aspecto que tenías vuelve en { $seconds } segundos si no pulsas Conservar. Escape vuelve atrás ahora.
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = Se conserva el tema { $theme }.

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = El aspecto que tenías vuelve cuando se acabe el tiempo.

# Said aloud when the look from before is back.
settings-appearance-aloud-back = El aspecto que tenías ha vuelto.

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = Elegir un tema

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = Temas

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = { $name } está en la lista de arriba. Púlsalo para usarlo.

# SAFETY: needs a human review before it ships
# Red words under the Theme line when a theme could not be removed.
settings-appearance-not-removed = No se pudo eliminar el tema.

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = No se puede usar el tema { $theme }. { $why }

# Heading of the line saying a theme is tried first.
settings-appearance-tried-first = Primero se prueba el tema

# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
        [one] Al pie de la ventana se pregunta si conservarlo durante { $seconds } segundo.
        [many] Al pie de la ventana se pregunta si conservarlo durante { $seconds } segundos.
       *[other] Al pie de la ventana se pregunta si conservarlo durante { $seconds } segundos.
    }

# SAFETY: needs a human review before it ships
# Name of the bin button that removes one of the person's own themes.
settings-appearance-remove-theme = Eliminar este tema

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = Usar { $name }

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = De { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = Añadir un tema

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = Buscando temas

# Title of the Theme card.
settings-appearance-theme-card = Tema

# Words behind the i of the Theme card.
settings-appearance-theme-about = Un tema es un aspecto completo en un archivo: colores, esquinas, tamaños y espacio. Pulsa uno para probarlo: todas las ventanas de Trindle cambian a la vez, y el aspecto que tenías vuelve solo en 30 segundos si no pulsas Conservar, así que un tema que no se puede leer nunca se queda. Un tema con aspecto oscuro y claro tiene Oscuro y Claro junto a su imagen; Claro se ve mejor con mucho sol, y las aplicaciones de Aplicaciones lo toman la próxima vez que se abran. Un tema con un solo aspecto no tiene esos botones. Tu color de resalte sigue siendo tuyo en todos los temas. Un tema que añades solo se lee, nunca se ejecuta, y las palabras que haría difíciles de leer se aclaran. Desde una terminal, trindle-settings --theme default siempre recupera el aspecto propio de Trindle.

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = Tema

# Small words under that line.
settings-appearance-theme-line-about = El aspecto completo. Oscuro o Claro aparece junto a un tema que tiene ambos.

# Small words under the Add a theme line.
settings-appearance-add-theme-about = Un archivo .css, como uno que alguien haya compartido.

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = Qué contiene un archivo de tema

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = Seis caracteres entre 0-9 y a-f, como #fbc711.

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = El color escrito

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = Código hexadecimal

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = Cualquier color, como código hexadecimal, por ejemplo #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = Cualquier color

# Small words under that line.
settings-appearance-any-colour-about = Seis u ocho dígitos, como #fbc711.

# Title of the Colour card.
settings-appearance-colour-title = Color

# Words behind the i of the Colour card.
settings-appearance-colour-about = El resalte marca los botones, los interruptores, el anillo que se llena y dónde estás. Las ventanas propias de Trindle cambian al instante; el anillo, la próxima vez que se abra. Un color demasiado oscuro para verse en una tarjeta se aclara hasta que pueda leerse, y en un aspecto claro uno demasiado pálido se oscurece. Oscuro o Claro se elige en la ficha propia de un tema, en Tema.

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = Resalte

# Small words under that line.
settings-appearance-highlight-about = Botones, interruptores y dónde estás.

# Small words under the read the screen aloud switch when a screen reader is installed.
settings-appearance-reader-on = Super, Alt y S también lo activan y desactivan.

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = Leer la pantalla en voz alta

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = Mantener las etiquetas al apuntar

# Small words under that line.
settings-appearance-labels-about = El nombre de un botón se queda mientras apuntas a él.

# Title of the Reading the screen card.
settings-appearance-reading-title = Lectura de la pantalla

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } El nombre de un botón suele desaparecer tras un segundo y medio; si se mantiene, se queda mientras el puntero esté encima. Mientras se lee la pantalla en voz alta, cada botón muestra su nombre debajo.

# Name of the set of round icons.
settings-appearance-icons-circles = Círculos

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = Cambiando los iconos

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = Cambiados

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = Iconos { $name }

# Heading of the line for the shape of the icons.
settings-appearance-shape = Forma

# Small words under that line.
settings-appearance-shape-about = Los iconos de Trindle, redondos o cuadrados.

# Title of the Icons card.
settings-appearance-icons-title = Iconos

# Words behind the i of the Icons card.
settings-appearance-icons-about = Los iconos de Trindle son redondos o cuadrados. A una aplicación que no dibujan se le crea uno a juego, y el anillo y el panel se redibujan con la forma nueva.

# Name of the list of font families, and heading of the font line.
settings-appearance-font = Tipografía

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = Predeterminada

# Name of the list of font sizes.
settings-appearance-font-size = Tamaño de la tipografía

# Small words under the font line.
settings-appearance-font-about = Las palabras de las ventanas de los programas.

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = Añadir tipografías

# Small words under the Add fonts line.
settings-appearance-add-fonts-about = Un archivo .ttf u .otf, o un zip con ellos.

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = Qué debe contener el archivo

# Title of the Text card.
settings-appearance-text-title = Texto

# Words behind the i of the Text card.
settings-appearance-text-about = La tipografía que usan los programas para sus palabras, y su tamaño. Las tipografías que añadas aquí, un archivo .ttf u .otf o un zip con ellos, se unen a la lista solo para ti; algunos programas solo lo notan al volver a abrirse.

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = Elegir tipografías

# Red words when a font could not be replaced; { $name } is the file name.
settings-appearance-font-not-replaced = No se pudo reemplazar { $name }.

# Green words after one font took the place of the one there; { $name } is the file name.
settings-appearance-font-replaced-one = Se reemplazó { $name }. Los programas que se inicien desde ahora la usan.

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
settings-appearance-font-replaced-some = Se reemplazaron { $n } de { $total }. Los programas que se inicien desde ahora las usan.

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
        [one] { $n } tipografía está en la lista de arriba. Elígela arriba.
        [many] { $n } tipografías están en la lista de arriba. Elígelas arriba.
       *[other] { $n } tipografías están en la lista de arriba. Elígelas arriba.
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = Esas tipografías ya están en la lista.

# Choice in the list of cursor sizes: the normal size.
settings-appearance-cursor-normal = Normal

# Choice in the list of cursor sizes: a large size.
settings-appearance-cursor-large = Grande

# Choice in the list of cursor sizes: the largest size.
settings-appearance-cursor-larger = Más grande

# Spoken name of a picture of a cursor size; { $size } is its name, such as Large.
settings-appearance-pointer-spoken = Puntero { $size }

# Name of the standard cursor theme (the one every system has).
settings-appearance-cursor-standard = Estándar

# Name of the list of cursor themes, and heading of its line.
settings-appearance-cursor = Cursor

# Name of the list of cursor sizes, and heading of its line.
settings-appearance-cursor-size = Tamaño del cursor

# Small words under the cursor line.
settings-appearance-cursor-about = Cómo se dibuja el puntero.

# Small words under the cursor size line.
settings-appearance-cursor-size-about = Más grande es más fácil de encontrar.

# Title of the Pointer card.
settings-appearance-pointer-title = Puntero

