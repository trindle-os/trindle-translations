# Said when Copy is pressed with an empty replacement.
snippets-copy-empty = El texto de reemplazo está vacío, así que no hay nada que copiar.

# Said after an import was cancelled.
snippets-imported-nothing = No se importó nada.

# Said after the snippet files were read again.
snippets-read-again = Snippets ha vuelto a cargar los archivos de fragmentos.

# In the list when there are no snippets.
