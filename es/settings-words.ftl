
# machine translated (Spanish), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Tus propias palabras

# Under the heading.
settings-words-about = Cambia cualquier palabra que muestra Trindle, en cualquier idioma, y comparte la hoja como archivo.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Una hoja cambiada en cualquier sitio salvo su última columna, o que no sea de Trindle, se rechaza entera.

# The line that picks which language the boxes are for.
settings-words-language = Idioma

# Under the language line.
settings-words-language-sub = La hoja es para este idioma.

# The name of the language list for the screen reader.
settings-words-language-tip = Idioma de la hoja

# The line that exports the sheet, and its button's tip.
settings-words-export = Descargar la hoja

# Under the export line.
settings-words-export-sub = Inglés a la izquierda, tu idioma al lado. Cambia la parte de la derecha.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Guardar la hoja de palabras

# The line that imports a sheet, and its button's tip.
settings-words-import = Subir la hoja

# Under the import line.
settings-words-import-sub = Se comprueba entera antes. Cualquier diferencia no instala nada.

# Title of the window that asks which sheet to open.
settings-words-import-title = Abrir una hoja de palabras

# Under the import button when a sheet was installed.
settings-words-imported = Instalada

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = No se pudo guardar

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Rechazada: el archivo es demasiado grande

# Under the import button: the file is not text.
settings-words-not-text = Rechazada: no es texto sin formato

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Rechazada: caracteres ocultos o de control

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Rechazada: una línea es demasiado larga

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Rechazada: no es una hoja de palabras de Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Rechazada: es otra versión de la hoja

# Under the import button: the language tag is not usable.
settings-words-bad-language = Rechazada: el idioma no es válido

# Under the import button: the notes at the top were changed.
settings-words-notes = Rechazada: se cambió el comienzo de la hoja

# Under the import button: lines are missing or extra.
settings-words-count = Rechazada: faltan líneas o sobran

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Rechazada: se cambió la clave en { $key }

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Rechazada: se cambió el inglés de { $key }

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Rechazada: la fila de { $key } no tiene la forma correcta

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Rechazada: las palabras de { $key } son demasiado largas

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Rechazada: las palabras de { $key } contienen caracteres ocultos

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Rechazada: las palabras de { $key } contienen marcado, un enlace o una ruta

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Rechazada: los marcadores de { $key } son distintos

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Rechazada: no se pudo leer el archivo

# Under the rule on the card: when changed words appear.
settings-words-next-start = Tus palabras se verán la próxima vez que se inicie un programa.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Rechazado: el valor de comprobación no coincide

settings-words-reset = Volver a las palabras de Trindle

settings-words-reset-sub = Deja este idioma como vino. Tus palabras se guardan en un archivo de copia.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Ofrecer tu hoja

# Under the offer button: who can send and why.
settings-words-offer-sub = Abre una página donde inicias sesión en Buildmorphic y la envías. Trindle nunca la envía por ti.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Empezar un idioma propio

# Under the start line.
settings-words-start-sub = Ponle nombre, real o inventado. Empieza como inglés y aparece como tuyo.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Nombre de tu idioma

# Beside the start line when the language was made.
settings-words-started = Empezado

# Under the start line: the name is empty or too long.
settings-words-name-length = Usa de 1 a 30 letras

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Solo letras: sin marcado, rutas ni caracteres ocultos

# Under the start line: another language of your own has this name.
settings-words-name-taken = Ya tienes un idioma con ese nombre

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (propio)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Quita este idioma propio. Sus palabras se guardan en una carpeta de copia.

