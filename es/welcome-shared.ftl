

# Red words under the search box when nothing that was dropped on the window is a kind Apps takes.
store-left-minute = queda aproximadamente un minuto

# How long is left, in minutes.
store-left-minutes = quedan aproximadamente { $n } minutos

# How long is left, in hours.
store-left-hours =
    { $n ->
        [one] queda aproximadamente 1 hora
       *[other] quedan aproximadamente { $n } horas
    }

