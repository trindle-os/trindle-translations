
# machine translated (Spanish), not yet reviewed by a person.

# Name of the Settings page about power, in the list and as its heading.
settings-power-title = Energía

# Words a person might type into the Settings search to find the power page; separate them with spaces.
settings-power-keywords = batería suspender suspensión dormir apagar reiniciar cerrar sesión pantalla apagada inactividad atenuar bloquear contraseña pin teclado cafeína mantener activo carga cargando límite 80 salud de la batería

# Introduction under the heading of the power page, and the words behind the page i.
settings-power-help = Batería, modo de energía, y cuándo la pantalla se atenúa, se bloquea y se apaga, en un portátil por separado para su batería y para el cargador. La taza de la pestaña mantiene la pantalla encendida. Bloquear, reiniciar y apagar también están aquí.

# Choice in a list of how long to wait.
settings-power-time-never = Nunca

# Choice in a list of how long to wait.
settings-power-time-1m = 1 minuto

# Choice in a list of how long to wait.
settings-power-time-2m = 2 minutos

# Choice in a list of how long to wait.
settings-power-time-5m = 5 minutos

# Choice in a list of how long to wait.
settings-power-time-10m = 10 minutos

# Choice in a list of how long to wait.
settings-power-time-15m = 15 minutos

# Choice in a list of how long to wait.
settings-power-time-30m = 30 minutos

# Choice in a list of how long to wait.
settings-power-time-45m = 45 minutos

# Choice in a list of how long to wait.
settings-power-time-1h = 1 hora

# Choice in a list of how long to wait.
settings-power-time-90m = 1½ horas

# Choice in a list of how long to wait.
settings-power-time-2h = 2 horas

# Choice in the lock after list: lock at no other time than when the computer sleeps.
settings-power-time-only-sleep = Solo cuando se suspende

# Heading of the line, and name of its round button, that suspends the computer.
settings-power-suspend = Suspender

# SAFETY: needs a human review before it ships
# Heading of the line, and name of its round button, that restarts the computer.
settings-power-restart = Reiniciar

# SAFETY: needs a human review before it ships
# Heading of the line, and name of its round button, that shuts the computer down.
settings-power-shut-down = Apagar

# Choice in the list of what closing the lid does: the computer sleeps.
settings-power-lid-sleep = Suspender

# Choice in the list of what closing the lid does: the computer hibernates.
settings-power-lid-hibernate = Hibernar

# Choice in the list of what closing the lid does: the screen locks.
settings-power-lid-lock = Bloquear la pantalla

# Choice in the list of what closing the lid does: nothing.
settings-power-lid-nothing = Nada

# SAFETY: needs a human review before it ships
# Choice in the list of what closing the lid does: the computer shuts down.
settings-power-lid-shut-down = Apagar

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-dim = Atenuar la pantalla después de

# Small words under an idle timer line.
settings-power-timer-dim-about = Cualquier movimiento devuelve el brillo.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-clock = Mostrar el reloj en movimiento después de

# Small words under an idle timer line.
settings-power-timer-clock-about = Solo la hora, moviéndose despacio por la pantalla.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-off = Apagar la pantalla después de

# Small words under an idle timer line.
settings-power-timer-off-about = Cualquier tecla o movimiento la vuelve a encender.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-suspend = Suspender después de

# Small words under an idle timer line.
settings-power-timer-suspend-about = Si se deja sin tocar este tiempo, se duerme.

# Red words under the keep the screen awake switch when turning it on could not be saved.
settings-power-no-awake = No se pudo mantener la pantalla encendida: no se pudo guardar la elección.

# Red words under the keep the screen awake switch when turning it off could not be saved.
settings-power-no-sleep = No se pudo dejar de mantener la pantalla encendida: no se pudo guardar la elección.

# Name of the power mode that saves the battery.
settings-power-profile-saver = Ahorro de batería

# Name of the balanced power mode.
settings-power-profile-balanced = Equilibrado

# Name of the power mode that favours speed.
settings-power-profile-performance = Rendimiento

# What the battery is doing: charging.
settings-power-state-charging = Cargando

# What the battery is doing: running on its own charge.
settings-power-state-battery = Con batería

# What the battery is doing: empty.
settings-power-state-empty = Vacía

# What the battery is doing: full.
settings-power-state-full = Llena

# What the battery is doing: the charger is in but it is not charging.
settings-power-state-plugged = Enchufado, sin cargar

# Time left on the battery; { $h } hours and { $m } minutes. The h and min are short for hours and minutes.
settings-power-hours-minutes = { $h } h { $m } min

# Time left on the battery when under an hour; { $m } minutes. The min is short for minutes.
settings-power-minutes = { $m } min

# Sentence at the top of the page on a computer with no battery.
settings-power-top-no-battery = Enchufado: este equipo no tiene batería que cuidar.

# Sentence at the top of the page on a computer with no battery; { $mode } is the power mode.
settings-power-top-no-battery-mode = Enchufado, en modo { $mode }: sin batería que cuidar.

# Sentence at the top of the page while charging; { $percent } is how full.
settings-power-top-charging = Cargando, { $percent }%.

# Sentence at the top of the page while charging; { $percent } is how full and { $left } how long until full.
settings-power-top-charging-left = Cargando, { $percent }%, llena en { $left }.

# Sentence at the top of the page when the battery is full.
settings-power-top-full = La batería está llena.

# Sentence at the top of the page when plugged in but not charging; { $percent } is how full.
settings-power-top-plugged = Enchufado al { $percent }%, sin cargar.

# Sentence at the top of the page on battery; { $percent } is how full.
settings-power-top-battery = Batería al { $percent }%.

# Sentence at the top of the page on battery; { $percent } is how full and { $left } how long is left.
settings-power-top-battery-left = Batería al { $percent }%, quedan unos { $left }.

# Sentence at the top of the page while the battery is being read.
settings-power-top-looking = Mirando la batería…

# Red words under the power mode line when the mode could not be changed.
settings-power-mode-failed = No se pudo cambiar el modo de energía.

# Heading of the power mode line, and the name of its list.
settings-power-mode = Modo de energía

# Small words under the power mode line.
settings-power-mode-about = El ahorro va más fresco; el rendimiento, más rápido.

# Said in green under a line after its choice was kept.
settings-power-saved = Guardado

# Name of the list of battery levels to warn at.
settings-power-warn-name = Avisar cuando la batería baje a

# Heading of the line for the battery warning.
settings-power-warn = Avisar cuando baje a

# Small words under the battery warning line.
settings-power-warn-about = Una vez, en medio de la pantalla.

# Choice in the list of battery levels: never warn.
settings-power-never = Nunca

# Heading of the line, and name of its switch, for stopping charging at 80%.
settings-power-limit = Dejar de cargar al 80%

# Small words under the charge limit line.
settings-power-limit-about = Más amable con una batería que casi siempre está enchufada.

# Title of the battery card on a laptop.
settings-power-card-battery = Batería

# Title of the battery card when there is no battery picture and no power modes.
settings-power-card-looking-after = Cuidar la batería

# Words behind the i of the battery card.
settings-power-battery-about = El ahorro de batería va más fresco y hace que la batería dure más; el rendimiento va más rápido; el equilibrado queda entre los dos. El aviso aparece una vez en medio de la pantalla mientras la batería se gasta. Parar al 80% es más amable con la batería de un portátil que casi siempre está enchufado: carga hasta el 80% y no más, y dura más años. Desactívalo antes de pasar un día lejos de un enchufe.

# Words under the charge limit line while the password window is open.
settings-power-limit-waiting = Esperando la contraseña...

# Green words under the charge limit line after charging was limited to 80%.
settings-power-limit-on = Se detiene al 80%

# Green words under the charge limit line after the limit was removed.
settings-power-limit-off = Carga hasta llenarse

# Heading of the keep the screen awake line, and name of its switch.
settings-power-awake = Mantener la pantalla encendida

# Small words under the keep the screen awake line.
settings-power-awake-about = La taza de la pestaña hace lo mismo.

# Title of the card about dimming and the moving clock.
settings-power-screen-title = Pantalla

# Words behind the i of the Screen card.
settings-power-screen-about = Mientras Mantener la pantalla encendida esté activado, no ocurre nada de esto; la taza de la pestaña también lo activa y desactiva. Atenuado: cualquier movimiento devuelve el brillo; solo se atenúan las pantallas con brillo propio, como la de un portátil. El reloj en movimiento: la pantalla se oscurece con solo la hora, moviéndose despacio, y cualquier tecla o movimiento lo devuelve todo. En un portátil cada tiempo se fija dos veces, para su batería y para el cargador.

# Title of the card about turning the screen off and sleeping.
settings-power-sleep-title = Pantalla apagada y suspensión

# Words behind the i of the Screen off and sleep card.
settings-power-sleep-about = Cualquier tecla o movimiento vuelve a encender la pantalla. Suspender pone el equipo a dormir hasta que lo despiertes. En un portátil cada tiempo se fija dos veces, para su batería y para el cargador. Con una segunda pantalla conectada, cerrar la tapa no hace nada, para que puedas seguir con la pantalla más grande.

# Heading of the line for what closing the lid does.
settings-power-lid = Al cerrar la tapa

# Small words under that line.
settings-power-lid-about = No pasa nada con una segunda pantalla conectada.

# Caption above a list that applies while the laptop runs on its battery.
settings-power-when-battery = Con batería

# Caption above a list that applies while the laptop is plugged in.
settings-power-when-charger = Enchufado

# Name of a list that applies on battery; { $title } is the name of its line.
settings-power-named-battery = { $title }: con batería

# Name of a list that applies while plugged in; { $title } is the name of its line.
settings-power-named-charger = { $title }: enchufado

# Heading of the lock the screen line, and name of its switch.
settings-power-lock = Bloquear la pantalla

# Small words under the lock the screen line.
settings-power-lock-about = Tu contraseña o un PIN te devuelve al escritorio.

# Heading of the lock after line, and the name of its list.
settings-power-lock-after-name = Bloquear después de

# Small words under the lock after line.
settings-power-lock-after-about = Si se deja sin tocar este tiempo, sea cual sea el resto de ajustes.

# Heading of the line, and name of its switch, for locking when the computer sleeps.
settings-power-lock-sleep = Bloquear cuando el equipo se suspende

# Small words under that line.
settings-power-lock-sleep-about = Así siempre despierta bloqueado.

# Heading of the line, and name of its button, that locks the screen now.
settings-power-lock-now = Bloquear ahora

# Small words under the lock now line.
settings-power-lock-now-about = También Super y L a la vez.

# Red words under the lock now line when the lock screen would not start.
settings-power-lock-now-failed = No se pudo bloquear la pantalla: la pantalla de bloqueo no se inició.

# Title of the locking card.
settings-power-lock-title = Bloqueo

# Words behind the i of the locking card.
settings-power-lock-card-about = Cuando estás ausente, la pantalla se bloquea, y tu contraseña, o un PIN de cuatro dígitos si eliges uno, te devuelve al escritorio. No se muestra nada en la pantalla hasta entonces. Iniciar sesión siempre necesita tu contraseña. Bloquear después de es cuánto tiempo se deja el equipo sin tocar antes de bloquearse, sean cuales sean los tiempos de pantalla y suspensión; hasta entonces, volver no necesita PIN. Desactivar el bloqueo también olvida el PIN. Cuatro dígitos se escriben más rápido que tu contraseña: pasado el tiempo elegido para el PIN, o tras cinco intentos fallidos, se necesita tu contraseña. La papelera deja de usar un PIN.

# SAFETY: needs a human review before it ships
# Heading of the line for adding a PIN.
settings-power-pin-add = Desbloquear también con un PIN

# Small words under that line.
settings-power-pin-add-about = Cuatro dígitos, más rápido que tu contraseña.

# Heading of the line, and name of its list, for how long a PIN works after the screen locks.
settings-power-pin-works-name = El PIN funciona durante

# Small words under that line.
settings-power-pin-works-about = Después se necesita tu contraseña.

# SAFETY: needs a human review before it ships
# Name of the bin button that stops using a PIN.
settings-power-pin-stop = Dejar de usar un PIN

# Heading of the line shown when a PIN is kept.
settings-power-pin-kept = Hay un PIN guardado

# Small words under that line.
settings-power-pin-kept-about = Escribe cuatro dígitos nuevos para cambiarlo.

# Placeholder of the box for typing a new PIN.
settings-power-pin-new = PIN nuevo

# SAFETY: needs a human review before it ships
# Name of the button that keeps the PIN typed.
settings-power-pin-keep = Conservar este PIN

# Red words under the PIN line when the PIN could not be removed.
settings-power-pin-not-removed = No se pudo eliminar el PIN, así que todavía desbloquea la pantalla.

# Red words under the PIN box when it is not the right length; { $n } is how many digits a PIN has.
settings-power-pin-digits =
    { $n ->
        [one] Un PIN tiene { $n } dígito.
        [many] Un PIN tiene { $n } dígitos.
       *[other] Un PIN tiene { $n } dígitos.
    }

# SAFETY: needs a human review before it ships
# Heading of the log out line, and name of its round button.
settings-power-log-out = Cerrar sesión

# Small words under the log out line.
settings-power-log-out-about = Vuelve a la pantalla de inicio de sesión.

# Title of the card with log out, suspend, restart and shut down.
settings-power-session-title = Sesión

# Words behind the i of the session card.
settings-power-session-about = Cerrar sesión cierra todas las ventanas y vuelve a la pantalla de inicio de sesión. Suspender pone el equipo a dormir hasta que lo despiertes. Cada botón pregunta dos veces, igual que la opción de energía del anillo, así que un descuido no hace nada.

# Red words under a session button when the system bus is not there.
settings-power-no-bus = El bus del sistema no está disponible.

# Red words under a session button when the computer would not do it.
settings-power-would-not = El equipo no quiso hacer eso.

# Spoken description of the battery picture while the battery is being read.
settings-power-art-looking-tip = Mirando la batería.

# Spoken description of the battery picture; { $percent } is how full and { $state } what it is doing, such as Charging.
settings-power-art-tip = Batería al { $percent }%. { $state }

# Word drawn in the empty battery picture while the battery is being read.
settings-power-art-looking = Mirando

# Word drawn under the battery figure when its state is not known.
settings-power-art-battery = Batería

# Words drawn in the battery picture: { $left } is the time left and { $state } is either empty or full.
settings-power-art-left =
    { $state ->
        [empty] { $left } para vaciarse
       *[full] { $left } para llenarse
    }

# Spoken description of the battery range bar when there is no warning; { $top } is the percent it charges to.
settings-power-limits-tip = Carga hasta el { $top }%; sin aviso.

# Spoken description of the battery range bar; { $top } is the percent it charges to and { $warn } where a warning comes.
settings-power-limits-tip-warn = Carga hasta el { $top }%; un aviso al { $warn }%.

# A length of time in the list of how long a PIN works, in minutes; { $n } is the number.
settings-power-pin-minutes =
    { $n ->
        [one] { $n } minuto
        [many] { $n } minutos
       *[other] { $n } minutos
    }

# A length of time in the list of how long a PIN works, in whole hours; { $n } is the number.
settings-power-pin-hours =
    { $n ->
        [one] { $n } hora
        [many] { $n } horas
       *[other] { $n } horas
    }

# A length of time in the list of how long a PIN works, in hours and minutes; { $hours } and { $minutes } are the two parts already written out, such as 1 hour and 15 minutes.
settings-power-pin-hours-minutes = { $hours } { $minutes }

