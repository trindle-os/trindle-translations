
# machine translated (Spanish), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Sonidos

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = sonido sonidos campana inicio arranque sesión entrar salir cerrar apagar cargador enchufado desenchufado batería alerta pitido silencio propio personalizado añadir archivo wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = El sonido de cada momento. Al elegir uno se reproduce, y Desactivado deja ese momento en silencio. Se pueden añadir sonidos propios y elegirlos como cualquier otro.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Desactivado

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Todo en silencio: ningún momento suena.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Todos los momentos tienen su sonido.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
        [one] { $n } de los { $total } momentos suena; los demás están en silencio.
        [many] { $n } de los { $total } momentos suenan; los demás están en silencio.
       *[other] { $n } de los { $total } momentos suenan; los demás están en silencio.
    }

