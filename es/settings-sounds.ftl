# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Escucharlo

# Name of the button that opens a window to add sound files.
settings-sounds-add = Añadir archivos de sonido

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Abrir la carpeta donde se guardan

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = No se pudo abrir la carpeta.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = No se pudo crear la carpeta para tus sonidos.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Escuchar el que se añade

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Escuchar el que ya estaba

# Heading of the line for adding sounds.
settings-sounds-add-heading = Añadir sonidos

# Small words under the add sounds line, listing the kinds of file that can be added.
settings-sounds-add-formats = WAV, OGG, Opus, FLAC o MP3.

# SAFETY: needs a human review before it ships
# Name of the bin button that removes a sound added by the person.
settings-sounds-remove = Eliminar este sonido

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Aún no se ha añadido ninguno

# Small words under that line.
settings-sounds-none-yet-about = Añade uno para elegirlo en cualquier momento.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Ese sonido ya no está en este equipo. Elige otro.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = El sonido no se reprodujo. Comprueba los altavoces en Audio.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Elegir archivos de sonido

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Sonidos

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } no es un tipo de sonido que Trindle pueda reproducir.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = No se pudo copiar { $name }.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = Añadidos: { $n }. Elígelo junto a un momento de arriba.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = No se pudo reemplazar { $name }.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = Se reemplazó { $name }.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = Se reemplazaron { $n } de { $total }.

# Red words under a sound's line when it could not be removed.
settings-sounds-not-removed = No se pudo eliminar.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Se eliminó su sonido, y no se pudo volver a poner el suyo propio.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Llegada y salida

# Words behind the i of that card.
settings-sounds-coming-about = Al elegir un sonido se reproduce, y Desactivado deja ese momento en silencio. El botón redondo junto a cada uno reproduce el sonido elegido ahora. Cada volumen va de 0 a 100 de diez en diez y suena una vez al soltar.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Energía

# Words behind the i of that card.
settings-sounds-power-about = Los sonidos de enchufar y desenchufar el cargador, y de la batería baja. El volumen va de 0 a 100 de diez en diez y suena una vez al soltar.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Tus propios sonidos

# Words behind the i of that card.
settings-sounds-own-about = WAV, OGG, Opus, FLAC o MP3. Se copian a tu propia carpeta, así que los originales se pueden mover o borrar, y luego se eligen junto a cualquier momento como los demás. Al eliminar uno, cualquier momento que lo usara vuelve a su propio sonido.

