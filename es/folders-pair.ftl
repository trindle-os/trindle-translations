
# machine translated (Spanish), not yet reviewed by a person.

# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Nada de aquí se diferencia del otro panel por nombre, tamaño o fecha. Las subcarpetas solo se comparan por nombre.
        [one] 1 elemento de aquí falta en el otro panel o se diferencia en tamaño o fecha. Las subcarpetas solo se comparan por nombre.
       *[other] { $n } elementos de aquí faltan en el otro panel o se diferencian en tamaño o fecha. Las subcarpetas solo se comparan por nombre.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Esto necesita los dos paneles. Pulsa F3 para mostrarlos.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Los resultados de una búsqueda no se pueden mostrar en el otro panel.

