
# machine translated (Spanish), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = Folders solo puede girar imágenes JPEG, PNG, WebP y BMP

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = Folders no pudo leer la imagen

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = Folders no puede guardar este tipo de imagen

# Why a link to a picture is not turned.
folders-imaging-no-turn-link = esto es un enlace, así que gira en su lugar la imagen a la que apunta

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = Folders no gira las imágenes animadas, porque solo se conservaría el primer fotograma
