
# machine translated (Spanish), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = solo se pueden girar imágenes JPEG, PNG, WebP y BMP

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = no se pudo leer la imagen

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = Carpetas no escribe este tipo de imagen


# Why a link to a picture is not turned.
folders-imaging-no-turn-link = un enlace no se gira; gira la imagen a la que apunta

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = una imagen en movimiento no se gira, porque solo se conservaría su primer fotograma

