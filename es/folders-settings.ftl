# machine translated (Spanish), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Ajustes de Carpetas

# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = No se pudo guardar.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = No se pudo guardar. No se cambió nada, porque { $why }.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = No se pudieron leer los ajustes de Carpetas, así que se muestran las respuestas habituales, y no se puede cambiar nada aquí hasta que se puedan leer: { $why }.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Las unidades las abre el anillo de Trindle, que no está en este equipo.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = Al abrir Carpetas

# Choice on the settings card: the part about the list.
folders-settings-page-list = La lista

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Unidades

# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Inicios de sesión guardados

# Note on the Kept logins part of the settings card.
folders-settings-logins-about = Un inicio de sesión que elegiste recordar solo se envía a una dirección en la que lo usaste en los últimos 90 días. Olvidar permite soltar uno.

# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = No hay ningún inicio de sesión guardado.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Consultando el llavero…

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Inicio y Recientes

# One line under that choice.
folders-settings-start-usual-sub = Inicio a la izquierda, Recientes a la derecha.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Donde se dejó cada panel

# One line under that choice.
folders-settings-start-last-sub = Cada panel se abre en la carpeta en la que estaba.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Lugares fijados aquí

# One line under that choice.
folders-settings-start-chosen-sub = Eliges un lugar para cada panel más abajo.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Recientes

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Inicio

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Documentos

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Descargas

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Imágenes

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Papelera

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Panel izquierdo

# One line under the left pane setting.
folders-settings-left-pane-sub = Dónde empieza el panel izquierdo.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Panel derecho

# One line under the right pane setting.
folders-settings-right-pane-sub = Dónde empieza el panel derecho.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Elige dónde empieza el panel

# Button of that folder chooser that accepts the folder.
folders-settings-choose-accept = Elegir

# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = No se pudo olvidar { $server }: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Elegir otra carpeta

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Carpetas se abre con { $left } a la izquierda y { $right } a la derecha.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Carpetas abre cada panel donde se dejó.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Carpetas se abre con Inicio a la izquierda y Recientes a la derecha.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Parte de los ajustes de Carpetas

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Carpetas lee esto cada vez que se abre. Se abre con un solo panel que muestra el lugar de la izquierda; el interruptor Simple y Doble de su barra de herramientas muestra ambos.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Cuánto se acercan las filas

# Name of the setting for how close the rows sit.
folders-settings-density = Filas

# One line under the rows setting.
folders-settings-density-sub = Cuánto se acercan los elementos, en todas las vistas.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Casillas para seleccionar

# One line under the tick boxes setting.
folders-settings-ticks-sub = Una casilla pequeña en cada elemento lo añade a la selección.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Mostrar las extensiones de archivo

# One line under the file endings setting.
folders-settings-endings-sub = Desactivado, informe.pdf se muestra como informe.

# Note under the settings of the list part.
folders-settings-list-note = Con las extensiones desactivadas, se omite la última extensión de un nombre, salvo cuando eso induciría a error: un nombre con dos extensiones, un programa o un archivo que no es lo que dice su extensión. Con las casillas activadas, la casilla del encabezado Nombre selecciona todo o nada.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
folders-settings-forget = Olvidar { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Abrir las unidades al conectarlas

# One line under the drives setting.
folders-settings-drives-sub = Una unidad USB se abre al conectarla.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = En cualquier caso está en la barra lateral, y el anillo avisa de que está ahí.


# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Recursos compartidos

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Volver a conectar los recursos compartidos al iniciar sesión

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Desactivado hasta que lo elijas: conectar un recurso compartido pide la contraseña del administrador cada vez, y uno que requiere inicio de sesión espera a que pulses Volver a conectar.
