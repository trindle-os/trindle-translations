# How to add the games drive in Steam.
settings-games-drive-steam = Añádela en Steam

# Under that.
settings-games-drive-steam-sub = En Steam: Ajustes, Almacenamiento, Añadir unidad.

# Why a Windows-formatted drive cannot be used.
