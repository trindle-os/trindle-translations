
# machine translated (Spanish), not yet reviewed by a person.

# Reason given when a file to read or change is a link, not the file itself.
folders-meta-link = esto es un enlace, no un archivo

# Reason given when a photo's notes cannot be read; the cause follows, already written out.
folders-meta-damaged = los datos de la cámara de la foto están dañados porque { $why }

# Cause of damaged photo notes: a block points outside the notes.
folders-meta-bad-out-of-reach = una parte apunta fuera de ellos

# Cause of damaged photo notes: a block goes beyond the end.
folders-meta-bad-block-past-end = una parte se pasa de su final

# Cause of damaged photo notes: the notes have no TIFF header.
folders-meta-bad-no-tiff = falta su cabecera TIFF

# Cause of damaged photo notes: the notes are much too large.
folders-meta-bad-too-big = son demasiado grandes

# Cause of damaged photo notes: the parts of a JPEG photo do not line up.
folders-meta-bad-jpeg-parts = las partes del JPEG no encajan

# Cause of damaged photo notes: a part of a JPEG photo goes beyond the end.
folders-meta-bad-jpeg-past-end = una parte del JPEG se pasa del final del archivo

# Cause of damaged photo notes: a part of a PNG photo goes beyond the end.
folders-meta-bad-png-past-end = una parte del PNG se pasa del final del archivo

# Cause of damaged photo notes: a PNG file holds no picture.
folders-meta-bad-png-empty = el PNG no tiene imagen

# Reason a photo's date taken is refused: it is not written like the example.
folders-meta-refuse-date = la fecha de la toma debe escribirse así: 2026:01:02 03:04:05

# Reason a photo's note is refused: it holds a nul character.
folders-meta-refuse-nul = una nota no puede contener un carácter nulo

# Reason a photo's way-up setting is refused: it is not from 1 to 8.
folders-meta-refuse-way-up = el ajuste de orientación debe ser un número del 1 al 8

# Reason a photo's notes are refused: they are too long to fit in a JPEG.
folders-meta-refuse-too-long = los datos de la cámara son demasiado largos para caber en un JPEG

# Reason notes cannot be changed in a file that is not a JPEG or PNG photo.
folders-meta-only-jpeg-png = los datos de la cámara solo se pueden cambiar en fotos JPEG y PNG

# Reason a change to a song or photo was not begun: the drive has no room for the copy.
folders-meta-no-room = no queda espacio en la unidad

# Reason a song's tag is refused: the tag is too big.
folders-meta-tag-too-big = los datos de la canción son demasiado grandes

