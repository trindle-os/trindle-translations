
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Vòng tròn

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = yêu thích ưa thích trình khởi chạy cạnh nhấp góc nóng giọng nói lời nói cửa sổ mở cửa sổ bộ nhớ tạm sao chép dán lịch sử quên thông báo

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Các mục yêu thích nằm quanh giữa vòng tròn. Bạn chọn chúng ngay trên vòng tròn: nhấp chuột phải vào ứng dụng bất kỳ trong vòng để thêm hoặc bớt, và kéo một mục yêu thích sang vị trí của mục khác để đổi thứ tự.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = Vòng tròn mở ra ở cạnh màn hình, và các cửa sổ đang mở nằm trong đó.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Nơi mọi thứ mở ra

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Nhấp ở cạnh màn hình

# Small words under that line about the Super key.
settings-ring-open-super = Phím Super cũng mở được nó.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
       *[other] { $n } mục yêu thích
    }

# Small words under the favourites line.
settings-ring-favourites-about = Nhấp chuột phải vào ứng dụng trong vòng để thêm.

# Title of the card about opening the ring.
settings-ring-opening = Mở vòng tròn

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Di chuyển con trỏ tới cạnh màn hình rồi nhấp, hoặc nhấn phím Super, vòng tròn sẽ mở ra. Các mục yêu thích nằm quanh giữa vòng, và các cửa sổ đang mở nằm trong một vòng bao quanh chúng: nhấp vào một cửa sổ để đưa lên trước, hoặc nhấp chuột phải để xem các nút của nó. Nhấp chuột phải vào ứng dụng bất kỳ trong vòng để thêm hoặc bớt.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Hiện khi thông báo đến

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Tắt: chúng vẫn tụ lại trong vòng tròn.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Hiện trong bao lâu

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Thông báo khẩn chờ đến khi được đóng.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Hiện ở đâu

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Góc mà chúng xếp chồng ra xa.

# Title of the card about notifications.
settings-ring-notify-title = Thông báo

# Words behind the i of the card about notifications.
settings-ring-notify-about = Khi một chương trình có điều cần báo, nó hiện vài giây rồi biến mất. Khi tắt, không có gì hiện ra, và mọi thứ vẫn được gom trong vòng thông báo trên vòng tròn. Thông báo khẩn luôn chờ đến khi được đóng bất kể chọn gì ở đây, nên cảnh báo không thể tự mất đi trước khi được đọc.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
# SAFETY: needs a human review before it ships
settings-ring-clip-forget = Quên những gì đã sao chép

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Các dòng đã ghim được giữ lại.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Đã sao chép hiện tại

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
       *[other] { $n } dòng, { $pinned } đã ghim.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Bộ nhớ tạm

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Vòng bộ nhớ tạm trên vòng tròn giữ những gì bạn sao chép, để bạn dán lại thứ từ trước đó. Các dòng đã ghim luôn được giữ, bất kể chọn gì ở đây.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Đang thêm giọng nói; bạn cứ làm việc khác trong lúc này.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Đang gỡ công cụ xây dựng.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Đang gỡ giọng nói.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Điều khiển bằng giọng nói

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = Bật

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Tắt

# Small words under the voice switch.
settings-ring-voice-about = Chỉ được nhận biết ngay trên máy tính này.

# Heading of the line, and the name of its button, that removes voice.
# SAFETY: needs a human review before it ships
settings-ring-voice-remove = Gỡ giọng nói

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Giải phóng khoảng 150 MB.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Giọng nói đã sẵn sàng. Công cụ xây dựng được giữ lại.

# Name of the button that removes the build tools voice left behind.
# SAFETY: needs a human review before it ships
settings-ring-voice-tools-remove = Gỡ công cụ xây dựng

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Thêm điều khiển bằng giọng nói (khoảng 150 MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = Tùy chọn; cần khoảng 150 MB để thêm.

# Title of the card about voice.
settings-ring-voice-title = Giọng nói

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Hãy nói tên một ứng dụng, “to hơn” hoặc “cài đặt Wi-Fi” thay vì nhấp chuột. Chạm vào giữa vòng tròn rồi nói; nó ngừng nghe khi bạn ngừng. Giọng nói được nhận biết ngay trên máy tính này và không gửi đi đâu cả. Việc thêm cần khoảng 150 MB và vài phút, bạn cứ làm việc khác trong lúc đó; gỡ đi sẽ xóa bộ máy nhận dạng giọng nói và mô hình của nó.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Đang thêm giọng nói

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Đang gỡ công cụ xây dựng

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Đang gỡ giọng nói

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = Mỗi lần máy tính khởi động lại

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Sau một ngày

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Sau một tuần

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = Sau hai tuần

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Không bao giờ

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = Hiện tiêu đề khi trỏ vào

# Small words under that switch.
settings-ring-names-about = Tắt: chỉ hiện ảnh chụp. Trình đọc màn hình vẫn nhận được tiêu đề.

