
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Âm thanh

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = âm thanh chuông khởi động đăng nhập đăng xuất tắt máy sạc cắm rút pin cảnh báo bíp tắt yên lặng riêng tuỳ chọn thêm tệp wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Âm thanh cho từng thời điểm. Chọn một âm thanh sẽ phát nó, và Tắt giữ thời điểm đó im lặng. Bạn có thể thêm âm thanh của riêng mình rồi chọn như các âm thanh khác.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Tắt

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Hoàn toàn yên lặng: không thời điểm nào phát âm thanh.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Thời điểm nào cũng có âm thanh.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
       *[other] { $n } trong { $total } thời điểm có phát âm thanh; các thời điểm còn lại yên lặng.
    }

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-open = Trindle mở

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-close = Trindle đóng

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunrise = Bình minh

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunset = Hoàng hôn

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-rising = Lên cao

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-falling = Xuống thấp

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-alert = Cảnh báo

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-bell = Chuông

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-glass = Ly thuỷ tinh

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-pop = Bụp

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-login = Đăng nhập

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-logout = Đăng xuất, khởi động lại và tắt máy

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-plug = Cắm sạc

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-unplug = Rút sạc

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-battery = Pin yếu

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-notification = Có thông báo hiện ra

# Heading of the logging out line.
settings-sounds-moment-logout-short = Đăng xuất

# Heading of the notifications line.
settings-sounds-moment-notification-short = Thông báo

# Small words under the logging in line.
settings-sounds-moment-login-about = Khi màn hình desktop hiện ra.

# Small words under the logging out line.
settings-sounds-moment-logout-about = Cả khi khởi động lại và tắt máy.

# Small words under the charger plugged in line.
settings-sounds-moment-plug-about = Khi cắm sạc vào.

# Small words under the charger unplugged line.
settings-sounds-moment-unplug-about = Khi rút sạc ra.

# Small words under the battery low line.
settings-sounds-moment-battery-about = Khi đến lúc cần sạc.

# Small words under the notifications line.
settings-sounds-moment-notification-about = Khi có thông báo hiện ra.

# Heading and slider name for the volume of the logging in and out sounds.
settings-sounds-volume-coming = Âm lượng khi vào và ra

# Heading and slider name for the volume of notification sounds.
settings-sounds-volume-notifications = Âm lượng thông báo

# Heading and slider name for the volume of the charger and battery sounds.
settings-sounds-volume-power = Âm lượng âm thanh nguồn điện

# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Nghe thử

# Name of the button that opens a window to add sound files.
settings-sounds-add = Thêm tệp âm thanh

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Mở thư mục lưu chúng

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = Không mở được thư mục.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = Không tạo được thư mục cho âm thanh của bạn.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Nghe mục đang được đưa vào

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Nghe mục đã có sẵn

# Heading of the line for adding sounds.
settings-sounds-add-heading = Thêm âm thanh

# Small words under the add sounds line, listing the kinds of file that can be added.
settings-sounds-add-formats = WAV, OGG, Opus, FLAC hoặc MP3.

# Name of the bin button that removes a sound added by the person.
# SAFETY: needs a human review before it ships
settings-sounds-remove = Xoá âm thanh này

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Chưa thêm gì

# Small words under that line.
settings-sounds-none-yet-about = Hãy thêm một âm thanh để chọn cho bất kỳ thời điểm nào.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Âm thanh đó không còn trên máy này. Hãy chọn âm thanh khác.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Không phát được âm thanh. Hãy kiểm tra loa trong Audio.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Chọn tệp âm thanh

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Âm thanh

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } không phải loại âm thanh mà Trindle phát được.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = Không sao chép được { $name }.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = Đã thêm { $n }. Hãy chọn nó bên cạnh một thời điểm ở trên.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-sounds-not-replaced = Không thay thế được { $name }.

# Green words after one sound took the place of the one there; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-sounds-replaced-one = Đã thay thế { $name }.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
# SAFETY: needs a human review before it ships
settings-sounds-replaced-some = Đã thay thế { $n } trong { $total }.

# Red words under a sound's line when it could not be removed.
settings-sounds-not-removed = Không xoá được.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Âm thanh của nó đã bị xoá, và không đặt lại được âm thanh gốc.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Vào và ra

# Words behind the i of that card.
settings-sounds-coming-about = Chọn một âm thanh sẽ phát nó, và Tắt giữ thời điểm đó im lặng. Nút tròn bên cạnh phát âm thanh đang chọn. Mỗi âm lượng đi từ 0 đến 100 theo bước 10 và phát một lần khi bạn thả ra.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Nguồn điện

# Words behind the i of that card.
settings-sounds-power-about = Âm thanh khi cắm và rút sạc, và khi pin yếu. Âm lượng đi từ 0 đến 100 theo bước 10 và phát một lần khi bạn thả ra.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Âm thanh của bạn

# Words behind the i of that card.
# SAFETY: needs a human review before it ships
settings-sounds-own-about = WAV, OGG, Opus, FLAC hoặc MP3. Chúng được sao chép vào thư mục riêng của bạn, nên có thể di chuyển hoặc xoá bản gốc, rồi chọn bên cạnh bất kỳ thời điểm nào như các âm thanh khác. Xoá một âm thanh sẽ đưa mọi thời điểm đang dùng nó về âm thanh gốc.
