# Said when Copy is pressed with an empty replacement.
snippets-copy-empty = Nội dung thay thế đang trống, nên không có gì để sao chép.

# Said after an import was cancelled.
snippets-imported-nothing = Chưa nhập gì cả.

# Said after the snippet files were read again.
snippets-read-again = Snippets đã tải lại các tệp đoạn mẫu.

# In the list when there are no snippets.
