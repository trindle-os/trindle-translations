# Why a snippet is shown but not edited.
snippets-y-deep = Các giá trị của nó lồng nhau quá sâu để Snippets có thể sửa.

# Why a snippet is shown but not edited.
snippets-y-list = Nó có một danh sách mà Snippets không đọc được.

# Why a snippet is shown but not edited.
snippets-y-after-quote = Có văn bản sau dấu nháy đóng.

# Why a snippet is shown but not edited.
snippets-y-escape = Nó có một mã thoát mà Snippets không nhận ra.

# Why a snippet is shown but not edited.
snippets-y-open-quote = Thiếu một dấu nháy đóng.

# Why a snippet is shown but not edited.
snippets-y-colon = Nó có một dấu hai chấm mà YAML hiểu là phần bắt đầu của một tên.

# Why a snippet is shown but not edited.
snippets-y-comment = Có một chú thích ở giữa văn bản của nó.

# Why a snippet is shown but not edited.
snippets-y-block-header = Snippets không thể sửa phần đầu khối này.

# Why a snippet is shown but not edited.
snippets-y-block-indent = Snippets không hỗ trợ cách thụt dòng trong khối này.

# Why a file is left alone.
snippets-y-first-indent = Dòng đầu tiên bị thụt vào. Snippets không thể sửa các tệp có bố cục này.

# Why a file is left alone.
snippets-y-not-named = Một tệp đoạn mẫu cần các giá trị có tên, nhưng tệp này không có.

# Why a file is left alone.
snippets-y-matches-twice = Tệp có hai phần matches.

# Why a file is left alone.
snippets-y-bom = Tệp bắt đầu bằng dấu thứ tự byte (BOM). Snippets không thể sửa các tệp có dấu này.

# Why a file is left alone.
snippets-y-tabs = Tệp này dùng ký tự tab để thụt dòng, điều mà YAML không cho phép.

# Why a file is left alone.
snippets-y-directive = Tệp bắt đầu bằng một chỉ thị YAML. Snippets không thể sửa các tệp có chỉ thị.

# Why a file is left alone.
snippets-y-documents = Tệp chứa nhiều hơn một tài liệu.

# Why a file is left alone.
snippets-y-one-line = Các đoạn mẫu được viết trên một dòng. Snippets không thể sửa bố cục này.

# Why a file is left alone.
snippets-y-matches-not-list = Mục matches phải là một danh sách.

# Why a snippet is shown but not edited.
snippets-y-empty = Nó đang trống.

# Why a snippet is shown but not edited.
snippets-y-item-indent = Snippets không hỗ trợ cách thụt dòng của các giá trị này.

# Why a snippet is shown but not edited.
snippets-y-item-not-named = Mục này không có giá trị có tên.

# Why a snippet is shown but not edited.
snippets-y-item-twice = Mục này có cùng một tên hai lần.

# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
       *[other] { $count } đoạn mẫu
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
       *[other] { $shown } trên { $all } đoạn mẫu
    }

# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Snippets không cập nhật được tính năng mở rộng khi gõ: { $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Snippets đã bỏ qua { $file }. { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = Nếu dùng với Espanso, { $files } sẽ chạy lệnh trên máy tính này. Bạn có muốn nhập không?

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } nữa

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
       *[other] Đã nhập { $count } tệp.
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Snippets không tạo được { $path }: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Snippets không đọc được { $file }. { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Chưa lưu gì cả, vì Snippets không tạo được bản sao dự phòng của tệp: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Snippets không ghi được { $path }: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = Snippets không đọc được tệp: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = Snippets không mở được tệp: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Snippets không lưu được đoạn mẫu: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = Snippets có thể hiển thị đoạn mẫu này nhưng không thể sửa nó, vì nó dùng { $names }.

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name } quá lớn nên không thể nhập làm tệp đoạn mẫu.

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Snippets không hỗ trợ cách thụt dòng ở dòng { $line }.

