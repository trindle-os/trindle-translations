# machine translated (Vietnamese), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Từ ngữ của riêng bạn

# Under the heading.
settings-words-about = Đổi bất kỳ từ nào Trindle hiển thị, trong bất kỳ ngôn ngữ nào, và chia sẻ bảng từ dưới dạng tệp.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Bảng bị sửa ở bất kỳ chỗ nào ngoài cột cuối, hoặc không phải của chính Trindle, sẽ bị từ chối toàn bộ.

# The line that picks which language the boxes are for.
settings-words-language = Ngôn ngữ

# Under the language line.
settings-words-language-sub = Bảng từ này dành cho ngôn ngữ đó.

# The name of the language list for the screen reader.
settings-words-language-tip = Ngôn ngữ của bảng từ

# The line that exports the sheet, and its button's tip.
settings-words-export = Tải bảng xuống

# Under the export line.
settings-words-export-sub = Tiếng Anh ở bên trái, ngôn ngữ của bạn bên cạnh. Hãy sửa phần bên phải.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Lưu bảng từ

# The line that imports a sheet, and its button's tip.
settings-words-import = Tải bảng lên

# Under the import line.
settings-words-import-sub = Được kiểm tra toàn bộ trước. Có bất kỳ khác biệt nào thì sẽ không cài gì cả.

# Title of the window that asks which sheet to open.
settings-words-import-title = Mở bảng từ

# Under the import button when a sheet was installed.
settings-words-imported = Đã cài

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Không lưu được

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Bị từ chối: tệp quá lớn

# Under the import button: the file is not text.
settings-words-not-text = Bị từ chối: không phải văn bản thuần

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Bị từ chối: có ký tự ẩn hoặc ký tự điều khiển

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Bị từ chối: có một dòng quá dài

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Bị từ chối: không phải bảng từ của Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Bị từ chối: bảng từ thuộc phiên bản khác

# Under the import button: the language tag is not usable.
settings-words-bad-language = Bị từ chối: ngôn ngữ không hợp lệ

# Under the import button: the notes at the top were changed.
settings-words-notes = Bị từ chối: phần đầu của bảng từ đã bị sửa

# Under the import button: lines are missing or extra.
settings-words-count = Bị từ chối: thiếu hoặc thừa dòng

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Bị từ chối: khóa tại { $key } đã bị đổi

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Bị từ chối: tiếng Anh của { $key } đã bị sửa

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Bị từ chối: dòng của { $key } không đúng dạng

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Bị từ chối: từ ngữ cho { $key } quá dài

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Bị từ chối: từ ngữ cho { $key } có ký tự ẩn

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Bị từ chối: từ ngữ cho { $key } có mã đánh dấu, liên kết hoặc đường dẫn

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Bị từ chối: các chỗ giữ chỗ của { $key } khác nhau

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Bị từ chối: không đọc được tệp

# Under the rule on the card: when changed words appear.
settings-words-next-start = Từ ngữ của bạn sẽ hiện ra vào lần tới khi một chương trình khởi động.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Bị từ chối: giá trị kiểm tra không khớp

settings-words-reset = Về từ ngữ gốc của Trindle

settings-words-reset-sub = Đưa ngôn ngữ này về như ban đầu. Từ ngữ của bạn được giữ trong một tệp sao lưu.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Gửi tặng bảng của bạn

# Under the offer button: who can send and why.
settings-words-offer-sub = Mở một trang để bạn đăng nhập Buildmorphic và gửi bảng. Trindle không bao giờ gửi thay bạn.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Tạo ngôn ngữ riêng của bạn

# Under the start line.
settings-words-start-sub = Đặt tên cho nó, thật hay bịa đều được. Nó bắt đầu như tiếng Anh và được liệt kê là của bạn.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Tên ngôn ngữ của bạn

# Beside the start line when the language was made.
settings-words-started = Đã tạo

# Under the start line: the name is empty or too long.
settings-words-name-length = Dùng từ 1 đến 30 chữ cái

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Chỉ chữ cái: không có đánh dấu, đường dẫn hay ký tự ẩn

# Under the start line: another language of your own has this name.
settings-words-name-taken = Bạn đã có một ngôn ngữ tên này

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (của bạn)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Gỡ ngôn ngữ riêng này. Từ ngữ của nó được giữ trong một thư mục sao lưu.

