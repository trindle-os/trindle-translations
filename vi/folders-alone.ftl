# Note when a Windows share is opened and Trindle's own helper is not on this computer.
folders-alone-no-mount = Mở thư mục chia sẻ Windows cần trình hỗ trợ riêng của Trindle, nhưng máy tính này chưa có trình đó.

# Note when an NFS export is opened and Trindle's own helper is not on this computer.
folders-alone-no-nfs = Mở thư mục xuất NFS cần trình hỗ trợ riêng của Trindle, nhưng máy tính này chưa có trình đó.

# Red note when the wallpaper is set from Folders and Trindle's wallpaper program is not on this computer.
folders-alone-no-wallpaper = Đặt hình nền cần chương trình hình nền của Trindle, nhưng máy tính này chưa có chương trình đó.

# Red note when a folder is opened as administrator and the program that asks for the administrator password is not on this computer.
# SAFETY: needs a human review before it ships
folders-alone-no-root = Mở thư mục với quyền quản trị cần pkexec, nhưng máy tính này chưa có.

# Red note when a folder is shared with AI programs and Trindle's program for that is not on this computer.
folders-alone-no-ai = Chia sẻ với các chương trình AI cần chương trình riêng của Trindle, nhưng máy tính này chưa có chương trình đó.

# Red note when a folder is opened in a terminal and none is installed.
folders-alone-no-terminal = Chưa cài terminal nào để mở thư mục này.
