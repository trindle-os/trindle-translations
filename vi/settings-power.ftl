
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Settings page about power, in the list and as its heading.
settings-power-title = Nguồn điện

# Words a person might type into the Settings search to find the power page; separate them with spaces.
settings-power-keywords = pin tạm ngừng ngủ tắt máy khởi động lại đăng xuất tắt màn hình nhàn rỗi mờ khóa mật khẩu pin mã bàn phím caffeine giữ thức sạc đang sạc giới hạn 80 sức khỏe pin

# Introduction under the heading of the power page, and the words behind the page i.
settings-power-help = Pin, chế độ nguồn, và lúc nào màn hình mờ đi, khóa và tắt, trên máy tính xách tay thì đặt riêng cho pin và cho sạc. Chiếc cốc trên thẻ giữ màn hình luôn sáng. Khóa, khởi động lại và tắt máy cũng ở đây.

# Choice in a list of how long to wait.
settings-power-time-never = Không bao giờ

# Choice in a list of how long to wait.
settings-power-time-1m = 1 phút

# Choice in a list of how long to wait.
settings-power-time-2m = 2 phút

# Choice in a list of how long to wait.
settings-power-time-5m = 5 phút

# Choice in a list of how long to wait.
settings-power-time-10m = 10 phút

# Choice in a list of how long to wait.
settings-power-time-15m = 15 phút

# Choice in a list of how long to wait.
settings-power-time-30m = 30 phút

# Choice in a list of how long to wait.
settings-power-time-45m = 45 phút

# Choice in a list of how long to wait.
settings-power-time-1h = 1 giờ

# Choice in a list of how long to wait.
settings-power-time-90m = 1,5 giờ

# Choice in a list of how long to wait.
settings-power-time-2h = 2 giờ

# Choice in the lock after list: lock at no other time than when the computer sleeps.
settings-power-time-only-sleep = Chỉ khi máy ngủ

# Heading of the line, and name of its round button, that suspends the computer.
# SAFETY: needs a human review before it ships
settings-power-suspend = Tạm ngừng

# Heading of the line, and name of its round button, that restarts the computer.
# SAFETY: needs a human review before it ships
settings-power-restart = Khởi động lại

# Heading of the line, and name of its round button, that shuts the computer down.
# SAFETY: needs a human review before it ships
settings-power-shut-down = Tắt máy

# Choice in the list of what closing the lid does: the computer sleeps.
settings-power-lid-sleep = Ngủ

# Choice in the list of what closing the lid does: the computer hibernates.
settings-power-lid-hibernate = Ngủ đông

# Choice in the list of what closing the lid does: the screen locks.
# SAFETY: needs a human review before it ships
settings-power-lid-lock = Khóa màn hình

# Choice in the list of what closing the lid does: nothing.
settings-power-lid-nothing = Không làm gì

# Choice in the list of what closing the lid does: the computer shuts down.
# SAFETY: needs a human review before it ships
settings-power-lid-shut-down = Tắt máy

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-dim = Làm mờ màn hình sau

# Small words under an idle timer line.
settings-power-timer-dim-about = Chỉ cần di chuyển là độ sáng trở lại.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-clock = Hiện đồng hồ di chuyển sau

# Small words under an idle timer line.
settings-power-timer-clock-about = Chỉ có giờ, từ từ trôi quanh màn hình.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-off = Tắt màn hình sau

# Small words under an idle timer line.
settings-power-timer-off-about = Bấm phím hoặc di chuyển sẽ bật lại.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-suspend = Tạm ngừng sau

# Small words under an idle timer line.
settings-power-timer-suspend-about = Để yên từng này thời gian, máy sẽ đi ngủ.

# Red words under the keep the screen awake switch when turning it on could not be saved.
settings-power-no-awake = Không thể giữ màn hình luôn sáng: không lưu được lựa chọn.

# Red words under the keep the screen awake switch when turning it off could not be saved.
settings-power-no-sleep = Không thể tắt chế độ giữ màn hình luôn sáng: không lưu được lựa chọn.

# Name of the power mode that saves the battery.
settings-power-profile-saver = Tiết kiệm pin

# Name of the balanced power mode.
settings-power-profile-balanced = Cân bằng

# Name of the power mode that favours speed.
settings-power-profile-performance = Hiệu năng

# What the battery is doing: charging.
settings-power-state-charging = Đang sạc

# What the battery is doing: running on its own charge.
settings-power-state-battery = Đang dùng pin

# What the battery is doing: empty.
settings-power-state-empty = Hết pin

# What the battery is doing: full.
settings-power-state-full = Đầy

# What the battery is doing: the charger is in but it is not charging.
settings-power-state-plugged = Đã cắm điện, không sạc

# Time left on the battery; { $h } hours and { $m } minutes. The h and min are short for hours and minutes.
settings-power-hours-minutes = { $h } giờ { $m } phút

# Time left on the battery when under an hour; { $m } minutes. The min is short for minutes.
settings-power-minutes = { $m } phút

# Sentence at the top of the page on a computer with no battery.
settings-power-top-no-battery = Đã cắm điện: máy tính này không có pin cần chăm sóc.

# Sentence at the top of the page on a computer with no battery; { $mode } is the power mode.
settings-power-top-no-battery-mode = Đã cắm điện, ở chế độ { $mode }: không có pin cần chăm sóc.

# Sentence at the top of the page while charging; { $percent } is how full.
settings-power-top-charging = Đang sạc, { $percent }%.

# Sentence at the top of the page while charging; { $percent } is how full and { $left } how long until full.
settings-power-top-charging-left = Đang sạc, { $percent }%, đầy sau { $left }.

# Sentence at the top of the page when the battery is full.
settings-power-top-full = Pin đã đầy.

# Sentence at the top of the page when plugged in but not charging; { $percent } is how full.
settings-power-top-plugged = Đã cắm điện ở mức { $percent }%, không sạc.

# Sentence at the top of the page on battery; { $percent } is how full.
settings-power-top-battery = Pin còn { $percent }%.

# Sentence at the top of the page on battery; { $percent } is how full and { $left } how long is left.
settings-power-top-battery-left = Pin còn { $percent }%, còn khoảng { $left }.

# Sentence at the top of the page while the battery is being read.
settings-power-top-looking = Đang xem pin…

# Red words under the power mode line when the mode could not be changed.
settings-power-mode-failed = Không thể đổi chế độ nguồn.

# Heading of the power mode line, and the name of its list.
settings-power-mode = Chế độ nguồn

# Small words under the power mode line.
settings-power-mode-about = Tiết kiệm chạy mát hơn; hiệu năng chạy nhanh hơn.

# Said in green under a line after its choice was kept.
settings-power-saved = Đã lưu

# Name of the list of battery levels to warn at.
settings-power-warn-name = Cảnh báo khi pin còn

# Heading of the line for the battery warning.
settings-power-warn = Cảnh báo khi còn

# Small words under the battery warning line.
settings-power-warn-about = Một lần, ở giữa màn hình.

# Choice in the list of battery levels: never warn.
settings-power-never = Không bao giờ

# Heading of the line, and name of its switch, for stopping charging at 80%.
settings-power-limit = Ngừng sạc ở mức 80%

# Small words under the charge limit line.
settings-power-limit-about = Tốt hơn cho pin khi phần lớn thời gian cắm điện.

# Title of the battery card on a laptop.
settings-power-card-battery = Pin

# Title of the battery card when there is no battery picture and no power modes.
settings-power-card-looking-after = Chăm sóc pin

# Words behind the i of the battery card.
settings-power-battery-about = Tiết kiệm pin chạy mát hơn và giúp pin dùng lâu hơn; hiệu năng chạy nhanh hơn; cân bằng nằm giữa hai chế độ. Cảnh báo hiện một lần ở giữa màn hình khi pin đang cạn. Ngừng sạc ở 80% tốt hơn cho pin của máy tính xách tay hay cắm điện: nó chỉ sạc đến 80% và dừng, nhờ vậy pin bền thêm nhiều năm. Hãy tắt nó trước khi đi cả ngày xa ổ điện.

# Words under the charge limit line while the password window is open.
# SAFETY: needs a human review before it ships
settings-power-limit-waiting = Đang chờ mật khẩu...

# Green words under the charge limit line after charging was limited to 80%.
settings-power-limit-on = Dừng ở 80%

# Green words under the charge limit line after the limit was removed.
settings-power-limit-off = Sạc đến đầy

# Heading of the keep the screen awake line, and name of its switch.
settings-power-awake = Giữ màn hình luôn sáng

# Small words under the keep the screen awake line.
settings-power-awake-about = Chiếc cốc trên thẻ cũng làm điều tương tự.

# Title of the card about dimming and the moving clock.
settings-power-screen-title = Màn hình

# Words behind the i of the Screen card.
settings-power-screen-about = Khi Giữ màn hình luôn sáng đang bật, không điều nào dưới đây xảy ra; chiếc cốc trên thẻ cũng bật tắt nó. Làm mờ: chỉ cần di chuyển là độ sáng trở lại; chỉ các màn hình có độ sáng riêng, như màn hình máy tính xách tay, mới mờ đi. Đồng hồ di chuyển: màn hình tối đi chỉ còn giờ, từ từ trôi quanh màn hình, và bấm phím hay di chuyển sẽ đưa mọi thứ trở lại. Trên máy tính xách tay, mỗi khoảng thời gian được đặt hai lần, cho pin và cho sạc.

# Title of the card about turning the screen off and sleeping.
settings-power-sleep-title = Tắt màn hình và ngủ

# Words behind the i of the Screen off and sleep card.
settings-power-sleep-about = Bấm phím hoặc di chuyển sẽ bật màn hình lại. Tạm ngừng đưa máy vào giấc ngủ cho đến khi bạn đánh thức. Trên máy tính xách tay, mỗi khoảng thời gian được đặt hai lần, cho pin và cho sạc. Khi cắm thêm màn hình thứ hai, đóng nắp không làm gì, để bạn tiếp tục dùng màn hình lớn hơn.

# Heading of the line for what closing the lid does.
settings-power-lid = Khi đóng nắp

# Small words under that line.
settings-power-lid-about = Không có gì xảy ra khi có màn hình thứ hai.

# Caption above a list that applies while the laptop runs on its battery.
settings-power-when-battery = Khi dùng pin

# Caption above a list that applies while the laptop is plugged in.
settings-power-when-charger = Khi cắm điện

# Name of a list that applies on battery; { $title } is the name of its line.
settings-power-named-battery = { $title }: khi dùng pin

# Name of a list that applies while plugged in; { $title } is the name of its line.
settings-power-named-charger = { $title }: khi cắm điện

# Heading of the lock the screen line, and name of its switch.
# SAFETY: needs a human review before it ships
settings-power-lock = Khóa màn hình

# Small words under the lock the screen line.
settings-power-lock-about = Mật khẩu hoặc mã PIN sẽ đưa bạn trở lại.

# Heading of the lock after line, and the name of its list.
settings-power-lock-after-name = Khóa sau

# Small words under the lock after line.
settings-power-lock-after-about = Để yên từng này thời gian, bất kể các thiết lập khác.

# Heading of the line, and name of its switch, for locking when the computer sleeps.
# SAFETY: needs a human review before it ships
settings-power-lock-sleep = Khóa khi máy ngủ

# Small words under that line.
settings-power-lock-sleep-about = Để máy luôn thức dậy trong trạng thái đã khóa.

# Heading of the line, and name of its button, that locks the screen now.
# SAFETY: needs a human review before it ships
settings-power-lock-now = Khóa ngay

# Small words under the lock now line.
settings-power-lock-now-about = Cũng có thể nhấn Super và L cùng lúc.

# Red words under the lock now line when the lock screen would not start.
settings-power-lock-now-failed = Không thể khóa màn hình: màn hình khóa không khởi động.

# Title of the locking card.
settings-power-lock-title = Khóa

# Words behind the i of the locking card.
# SAFETY: needs a human review before it ships
settings-power-lock-card-about = Khi bạn đi vắng, màn hình sẽ khóa, và mật khẩu của bạn, hoặc mã PIN bốn chữ số nếu bạn chọn, sẽ đưa bạn trở lại. Không có gì trên màn hình hiện ra cho đến lúc đó. Đăng nhập luôn cần mật khẩu của bạn. Khóa sau là thời gian máy được để yên trước khi khóa, bất kể thời gian màn hình và ngủ; cho đến lúc đó, quay lại không cần PIN. Tắt khóa cũng sẽ quên PIN. Bốn chữ số gõ nhanh hơn mật khẩu: sau thời gian chọn cho PIN, hoặc sau năm lần thử sai, sẽ cần mật khẩu của bạn thay thế. Nút thùng rác dừng dùng PIN.

# Heading of the line for adding a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-add = Mở khóa thêm bằng mã PIN

# Small words under that line.
settings-power-pin-add-about = Bốn chữ số, nhanh hơn mật khẩu.

# Heading of the line, and name of its list, for how long a PIN works after the screen locks.
settings-power-pin-works-name = PIN có hiệu lực trong

# Small words under that line.
settings-power-pin-works-about = Sau đó sẽ cần mật khẩu của bạn.

# Name of the bin button that stops using a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-stop = Ngừng dùng mã PIN

# Heading of the line shown when a PIN is kept.
settings-power-pin-kept = Đã lưu một mã PIN

# Small words under that line.
settings-power-pin-kept-about = Gõ bốn chữ số mới để thay đổi.

# Placeholder of the box for typing a new PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-new = PIN mới

# Name of the button that keeps the PIN typed.
# SAFETY: needs a human review before it ships
settings-power-pin-keep = Giữ mã PIN này

# Red words under the PIN line when the PIN could not be removed.
# SAFETY: needs a human review before it ships
settings-power-pin-not-removed = Không thể xóa mã PIN, nên nó vẫn mở khóa được màn hình.

# Red words under the PIN box when it is not the right length; { $n } is how many digits a PIN has.
# SAFETY: needs a human review before it ships
settings-power-pin-digits =
    { $n ->
       *[other] Mã PIN gồm { $n } chữ số.
    }

# Heading of the log out line, and name of its round button.
# SAFETY: needs a human review before it ships
settings-power-log-out = Đăng xuất

# Small words under the log out line.
settings-power-log-out-about = Trở về màn hình đăng nhập.

# Title of the card with log out, suspend, restart and shut down.
settings-power-session-title = Phiên làm việc

# Words behind the i of the session card.
# SAFETY: needs a human review before it ships
settings-power-session-about = Đăng xuất sẽ đóng mọi cửa sổ và trở về màn hình đăng nhập. Tạm ngừng đưa máy vào giấc ngủ cho đến khi bạn đánh thức. Mỗi nút hỏi hai lần, giống lựa chọn nguồn trong vòng tròn, nên bấm nhầm cũng không sao.

# Red words under a session button when the system bus is not there.
settings-power-no-bus = Bus hệ thống không khả dụng.

# Red words under a session button when the computer would not do it.
settings-power-would-not = Máy tính không thực hiện được việc đó.

# Spoken description of the battery picture while the battery is being read.
settings-power-art-looking-tip = Đang xem pin.

# Spoken description of the battery picture; { $percent } is how full and { $state } what it is doing, such as Charging.
settings-power-art-tip = Pin còn { $percent }%. { $state }

# Word drawn in the empty battery picture while the battery is being read.
settings-power-art-looking = Đang xem

# Word drawn under the battery figure when its state is not known.
settings-power-art-battery = Pin

# Words drawn in the battery picture: { $left } is the time left and { $state } is either empty or full.
settings-power-art-left =
    { $state ->
        [empty] { $left } đến khi hết pin
       *[full] { $left } đến khi đầy
    }

# Spoken description of the battery range bar when there is no warning; { $top } is the percent it charges to.
settings-power-limits-tip = Sạc đến { $top }%; không có cảnh báo.

# Spoken description of the battery range bar; { $top } is the percent it charges to and { $warn } where a warning comes.
settings-power-limits-tip-warn = Sạc đến { $top }%; cảnh báo ở mức { $warn }%.

# A length of time in the list of how long a PIN works, in minutes; { $n } is the number.
settings-power-pin-minutes =
    { $n ->
       *[other] { $n } phút
    }

# A length of time in the list of how long a PIN works, in whole hours; { $n } is the number.
settings-power-pin-hours =
    { $n ->
       *[other] { $n } giờ
    }

# A length of time in the list of how long a PIN works, in hours and minutes; { $hours } and { $minutes } are the two parts already written out, such as 1 hour and 15 minutes.
settings-power-pin-hours-minutes = { $hours } { $minutes }

