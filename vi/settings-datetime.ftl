# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Date and time page, in the page list and as its heading.
settings-datetime-title = Ngày và giờ

# Words people may search for to find the Date and time page, separated by spaces.
settings-datetime-keywords = múi giờ đồng hồ ngày giờ

# Help line at the foot of the Date and time page.
# SAFETY: needs a human review before it ships
settings-datetime-help = Múi giờ và giờ tự động cần mật khẩu của quản trị viên.

# Spoken name of the picture of the clock at the top of the page.
settings-datetime-time-now = Giờ hiện tại

# Name of a way to write the ring's clock: hours 00 to 23.
settings-datetime-24 = 24 giờ

# Name of a way to write the ring's clock: hours 1 to 12 with am or pm.
settings-datetime-12 = 12 giờ

# Name of a way to write the ring's clock: hours 00 to 23 with seconds.
settings-datetime-24s = 24 giờ, có giây

# Name of the box for the day when the date is set by hand.
settings-datetime-day = Ngày

# Name of the box for the month when the date is set by hand.
settings-datetime-month = Tháng

# Name of the box for the year when the date is set by hand.
settings-datetime-year = Năm

# Name of the box for the hour when the time is set by hand.
settings-datetime-hour = Giờ

# Name of the box for the minute when the time is set by hand.
settings-datetime-minute = Phút

# Red words when the time could not be set.
settings-datetime-no-time = Không đặt được giờ.

# Red words when the time was set by hand while automatic time is on.
settings-datetime-keeps-right = Đồng hồ hiện đang tự giữ cho đúng. Hãy tắt chế độ đó ở trên, rồi đặt giờ bằng tay.

# Red words when the system's message bus could not be reached.
settings-datetime-no-bus = Không kết nối được với bus hệ thống.

# Red words when the time service does not answer.
settings-datetime-not-answering = Dịch vụ giờ không phản hồi.

# Red words when automatic time could not be turned on.
settings-datetime-ntp-on-failed = Không thể bảo đồng hồ tự giữ cho đúng.

# Red words when automatic time could not be turned off.
settings-datetime-ntp-off-failed = Không tắt được giờ tự động.

# Red words when the time zone could not be changed.
settings-datetime-zone-failed = Không đổi được múi giờ.

# Red words when the date typed by hand is not a real date.
settings-datetime-not-real = Đó không phải ngày có thật.

# Headline of the page before the time service has answered: { $time } is the time and { $date } the date.
settings-datetime-it-is = Bây giờ là { $time }, ngày { $date }.

# Headline of the page when the time service is not answering.
settings-datetime-service-down = Dịch vụ giờ không phản hồi, nên không thể đổi đồng hồ ở đây.

# Headline of the page when the clock is automatic and in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-right = Bây giờ là { $time }, ngày { $date }, và đồng hồ tự giữ cho đúng.

# Headline of the page when the clock is automatic but not yet in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-checks = Bây giờ là { $time }, ngày { $date }. Đồng hồ sẽ tự kiểm tra khi có internet.

# Headline of the page when the clock is set by hand: { $time } is the time and { $date } the date.
settings-datetime-it-is-hand = Bây giờ là { $time }, ngày { $date }. Đồng hồ được đặt bằng tay.

# A city and how far its time is from Greenwich.
settings-datetime-city-offset = { $city }, { $offset }

# A city, its part of the world and how far its time is from Greenwich.
settings-datetime-city-region-offset = { $city }, { $region }, { $offset }

# Spoken name of the clock picture: the time, the date and the place.
settings-datetime-tip = Bây giờ là { $time }, ngày { $date }, { $zone }.

# Help text of the clock card when the time service is not answering or not yet read.
settings-datetime-ring-about = Đồng hồ ở giữa vòng được viết theo 24 hoặc 12 giờ, có hoặc không có giây. Chỉ đồng hồ của vòng theo cách này; ngày và giờ trong các chương trình theo định dạng đã chọn trong Vùng và ngôn ngữ.

# Heading of the card with the clock settings.
settings-datetime-the-clock = Đồng hồ

# Heading of the line shown when the time service is not answering.
settings-datetime-service-down-line = Dịch vụ giờ không phản hồi

# Under Set the time automatically when the internet can be used.
settings-datetime-from-internet = Lấy từ internet, khi có kết nối.

# Under Set the time automatically when the time service is not installed.
settings-datetime-needs-timesyncd = Cần cài systemd-timesyncd.

# Label of the switch for automatic time, and heading of its line.
settings-datetime-set-auto = Đặt giờ tự động

# Name of the list of time zones, and heading of its line.
settings-datetime-time-zone = Múi giờ

# Tip of the button that sets the date and time typed by hand.
settings-datetime-set-date-time = Đặt ngày và giờ

# Heading of the line for setting the time by hand.
settings-datetime-by-hand = Đặt giờ bằng tay

# Under the Set the time by hand heading.
settings-datetime-by-hand-sub = Hãy tắt giờ tự động trước, như hiện nay.

# Help text of the clock card (the information button) when the time service can keep the time from the internet.
settings-datetime-about = Khi đặt tự động, đồng hồ được đối chiếu với máy chủ giờ trên internet mỗi khi máy có kết nối, và tự giữ cho đúng. Khi tắt, ngày và giờ được nhập bằng tay. Múi giờ cũng cho chế độ ánh sáng đêm biết khi nào mặt trời lặn. Cả hai đều cần mật khẩu của quản trị viên. Đồng hồ ở giữa vòng được viết theo 24 hoặc 12 giờ, có hoặc không có giây. Chỉ đồng hồ của vòng theo cách này; ngày và giờ trong các chương trình theo định dạng đã chọn trong Vùng và ngôn ngữ.

# Help text of the clock card (the information button) when the time service is not installed.
settings-datetime-about-no-ntp = Khi đặt tự động, đồng hồ được đối chiếu với máy chủ giờ trên internet mỗi khi máy có kết nối, và tự giữ cho đúng. Khi tắt, ngày và giờ được nhập bằng tay. Múi giờ cũng cho chế độ ánh sáng đêm biết khi nào mặt trời lặn. Cả hai đều cần mật khẩu của quản trị viên. Để lấy giờ từ internet cần có systemd-timesyncd: sudo apt install systemd-timesyncd Đồng hồ ở giữa vòng được viết theo 24 hoặc 12 giờ, có hoặc không có giây. Chỉ đồng hồ của vòng theo cách này; ngày và giờ trong các chương trình theo định dạng đã chọn trong Vùng và ngôn ngữ.

# An item in the list of ways to write the ring's clock: { $time } is the time written that way and { $what } its name.
settings-datetime-clock-option = { $time }  ({ $what })

# Name of the list of ways to write the ring's clock.
settings-datetime-show-as = Hiển thị dạng

# Heading of the line for the ring's clock.
settings-datetime-rings-clock = Đồng hồ của vòng

# Under The ring's clock heading.
settings-datetime-rings-clock-sub = Cách vòng ghi giờ.

