# machine translated (Vietnamese), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Gỡ { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $value } trên { $max } sao

# The names of the three boxes of a duration entry.
kit-duration-hours = Giờ

kit-duration-minutes = Phút

kit-duration-seconds = Giây

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Bước { $n } trên { $count }

kit-step-back = Quay lại

kit-step-next = Tiếp

kit-step-finish = Hoàn tất

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Tìm

kit-find-previous = Kết quả trước

kit-find-next = Kết quả kế tiếp

kit-find-none = Không có kết quả

kit-find-count = { $at } trên { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
       *[other] Thêm { $n } người
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Dải chuyển màu có { $n } điểm dừng

kit-gradient-place = Vị trí của điểm dừng đã chọn

kit-gradient-add = Thêm một điểm dừng

kit-gradient-remove = Gỡ điểm dừng

# The "i" button that shows and hides a card's help.
kit-help-show = Hiện trợ giúp

kit-help-hide = Ẩn trợ giúp

