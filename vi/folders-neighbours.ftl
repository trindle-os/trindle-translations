# machine translated (Vietnamese), not yet reviewed by a person.

# Line on the empty Network page while Folders is still looking for computers.
folders-neighbours-looking = Đang tìm các máy tính chia sẻ thư mục trên mạng này.

# First line on the empty Network page when nothing was found.
folders-neighbours-none = Không tìm thấy máy tính nào chia sẻ thư mục trên mạng này.

# Line on the empty Network page saying which ways of looking were used; the variable is both, windows or other.
folders-neighbours-asked =
    { $ways ->
        [both] Folders đã hỏi theo cách của Windows, và theo cách của NAS, Mac hoặc Linux.
        [windows] Folders đã hỏi theo cách của Windows.
       *[other] Folders đã hỏi theo cách của NAS, Mac hoặc Linux.
    }

# Line on the empty Network page saying the Windows way could not be asked because Trindle's finder program is missing.
folders-neighbours-no-finder = Không thể hỏi theo cách của Windows: chương trình tìm của Trindle cho việc này (trindle-wsdd) chưa có trên máy.

# Line on the empty Network page saying the other way could not be asked because no network card is connected.
folders-neighbours-no-card = Không có card mạng nào dùng được đang kết nối; riêng VPN thì không chuyển được loại câu hỏi này.

# Line on the empty Network page saying the network refused the question; the variable is the reason the system gave.
folders-neighbours-refused = Mạng không nhận câu hỏi ({ $why }).

# Last line on the empty Network page: a quiet computer can still be opened by hand.
folders-neighbours-quiet = Máy nào im lặng hoặc nằm sau tường lửa vẫn có thể mở bằng tên hoặc địa chỉ của nó.

