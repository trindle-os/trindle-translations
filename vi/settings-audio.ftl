
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Settings page about sound, in the list and as its heading.
settings-audio-title = Âm thanh

# Words a person might type into the Settings search to find the audio page; separate them with spaces.
settings-audio-keywords = âm thanh âm lượng loa tai nghe micro mic tắt tiếng thử sound volume speakers headphones microphone mute test

# Introduction under the heading of the audio page, and the words behind the page i.
settings-audio-help = Chọn loa hoặc tai nghe nào phát âm thanh, và micro nào thu tiếng.

# Red sentence at the top of the page when PipeWire, the sound system, is not installed.
settings-audio-top-missing = Không có âm thanh: PipeWire chưa được cài.

# Red sentence at the top of the page when PipeWire is installed but not answering.
settings-audio-top-failed = Không có âm thanh: PipeWire không phản hồi.

# Red sentence at the top of the page when there are no speakers or headphones.
settings-audio-top-no-output = Không tìm thấy loa hoặc tai nghe nào.

# Plain sentence at the top of the page while the page is still finding out about sound.
settings-audio-top-listening = Đang dò âm thanh…

# Warning at the top of the page when sound is muted; { $device } is the speakers or headphones.
settings-audio-top-muted = Âm thanh đang tắt tiếng, nên { $device } im lặng.

# Warning at the top of the page when the volume is at nothing; { $device } is the speakers or headphones.
settings-audio-top-down = Âm lượng đang ở mức thấp nhất, nên { $device } im lặng.

# Sentence at the top of the page when all is well; { $device } is the speakers or headphones and { $percent } the volume.
settings-audio-top-playing = Âm thanh phát qua { $device } ở mức { $percent }%.

# Title of the card for speakers and headphones.
settings-audio-out-title = Loa và tai nghe

# Title of the card for microphones.
settings-audio-in-title = Micro

# Heading of the line shown when no speakers or headphones are found.
settings-audio-out-none = Không có thiết bị phát

# Heading of the line shown when no microphone is found.
settings-audio-in-none = Không có thiết bị thu

# Small words under that line for speakers.
settings-audio-out-plug = Hãy cắm loa hoặc tai nghe.

# Small words under that line for microphones.
settings-audio-in-plug = Hãy cắm micro hoặc tai nghe có micro.

# Heading of the line with the list of devices.
settings-audio-device = Thiết bị

# Small words under the device line for speakers.
settings-audio-out-device-about = Nơi âm thanh phát ra.

# Small words under the device line for microphones.
settings-audio-in-device-about = Thiết bị thu tiếng.

# Name of the list of speakers and headphones.
settings-audio-out-device-name = Nơi âm thanh phát ra

# Name of the list of microphones.
settings-audio-in-device-name = Thiết bị thu tiếng

# Heading of the volume line.
settings-audio-volume = Âm lượng

# Name of the volume slider for the speakers.
settings-audio-out-volume-name = Âm lượng của âm thanh

# Name of the volume slider for the microphone.
settings-audio-in-volume-name = Âm lượng của micro

# Heading of the mute line.
settings-audio-mute = Tắt tiếng

# Name of the switch that mutes the sound.
settings-audio-out-mute-name = Tắt tiếng âm thanh

# Name of the switch that mutes the microphone.
settings-audio-in-mute-name = Tắt tiếng micro

# Small words under the mute line for the speakers.
settings-audio-mute-out-about = Im lặng, vẫn giữ nguyên âm lượng.

# Small words under the mute line for the microphone.
settings-audio-mute-in-about = Khi bật sẽ không nghe thấy gì.

# Heading of the line that plays a test sound.
settings-audio-test = Thử

# Small words under the test line.
settings-audio-test-about = Phát một tiếng chuông ngắn qua thiết bị này.

# Name of the button that plays a test sound.
settings-audio-test-button = Phát âm thanh thử

# Words behind the i of the speakers card.
settings-audio-out-about = Chọn loa hoặc tai nghe nào phát âm thanh. Âm lượng và tắt tiếng ở đây giống với các phím trên bàn phím và vòng tròn âm thanh trong vòng tròn Trindle.

# Heading of the line with the microphone level bar.
settings-audio-level = Mức

# Small words under the level line.
settings-audio-level-about = Hãy nói và thanh sẽ động khi nghe thấy bạn.

# Words behind the i of the microphone card.
settings-audio-in-about = Chọn micro nào thu tiếng. Thanh mức theo dõi những gì nó nghe được khi trang này đang mở; không có gì được ghi âm hay lưu lại.

# Title of the card shown when PipeWire is not answering.
settings-audio-failed-title = Âm thanh

# Heading of the line in that card.
settings-audio-failed-heading = PipeWire không phản hồi

# Small words under that line.
settings-audio-failed-about = Âm thanh có thể chưa khởi động cho phiên này.

# Red words under the volume line when the volume could not be changed.
settings-audio-no-volume = Không thể đổi âm lượng. Âm thanh có thể chưa khởi động; hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.

# Red words under the mute line when the sound could not be muted.
settings-audio-no-mute = Không thể tắt tiếng. Âm thanh có thể chưa khởi động; hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.

# Red words under the mute line when the sound could not be turned back on.
settings-audio-no-unmute = Không thể bật lại âm thanh. Âm thanh có thể chưa khởi động; hãy đăng xuất rồi đăng nhập lại, sau đó thử lại.

# Red words under the device line when the device could not be chosen.
settings-audio-not-chosen = Không thể chọn thiết bị đó.

# Red words under the test line when the test sound would not play.
settings-audio-test-failed = Âm thanh thử không phát được qua thiết bị này.


# A device's name with what kind it is; { $name } is the device and { $kind } one of the kind words below.
settings-audio-with-kind = { $name } ({ $kind })

# Kind of output: a Bluetooth device.
settings-audio-kind-bluetooth = Bluetooth

# Kind of output: a screen or TV on a cable.
settings-audio-kind-hdmi = HDMI

# Kind of output: a device on a USB cable.
settings-audio-kind-usb = USB

# Kind of output: headphones or a headset on a cable.
settings-audio-kind-headphones = tai nghe

# Kind of output: the computer's own speakers.
settings-audio-kind-speakers = loa

# Heading of the line shown while Bluetooth plays the sound.
settings-audio-bt-now = Âm thanh đang đi tới Bluetooth

# Words under that heading.
settings-audio-bt-now-about = Chuyển sang loa; Bluetooth vẫn được kết nối.

# Tooltip of the button that moves the sound to the speakers; { $device } is the speakers, kind included.
settings-audio-use-speakers = Phát qua { $device }

# Heading of the line when Bluetooth devices are connected but have no sound output; { $names } lists them.
settings-audio-bt-silent = { $names }: đã kết nối nhưng không có đầu ra âm thanh.

# Words under that heading.
settings-audio-bt-silent-about = Hồ sơ âm thanh có thể đang tắt. Hãy ngắt kết nối rồi kết nối lại.

