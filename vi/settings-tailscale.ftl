
# machine translated (Vietnamese), not yet reviewed by a person.

# What a device runs, shown in a device's small line, when it is an iPhone or iPad.
settings-tailscale-system-ios = iPhone hoặc iPad

# In a device's small line: the device is on the network now.
settings-tailscale-online = đang trực tuyến

# In a device's small line: the device has never been seen.
settings-tailscale-not-seen = chưa thấy bao giờ

# In a device's small line: when the device was last online; the date is already written.
settings-tailscale-last-online = trực tuyến lần cuối { $day }

# Shown beside the Use Tailscale switch while the password is asked for, when Tailscale is already installed.
# SAFETY: needs a human review before it ships
settings-tailscale-waiting = Đang chờ mật khẩu...

# Shown beside the Use Tailscale switch while the password is asked for, before Tailscale is installed.
# SAFETY: needs a human review before it ships
settings-tailscale-waiting-install = Đang chờ mật khẩu, sau đó cài đặt Tailscale...

# Shown beside the switch after Tailscale is turned on.
settings-tailscale-done-on = Tailscale đã bật

# Shown beside the switch after Tailscale is turned off.
settings-tailscale-done-off = Tailscale đã tắt

# Shown under the Sign in line once the browser is being opened.
settings-tailscale-opening = Đang mở trang đăng nhập trong trình duyệt của bạn...

# Red words under the Sign in line when Tailscale could not be started.
settings-tailscale-not-started = Không thể khởi động Tailscale.

# Red words under the Sign out line when signing out did not work.
settings-tailscale-sign-out-failed = Tailscale không đăng xuất được.

# Headline of the page while Tailscale is being asked how it is.
settings-tailscale-top-asking = Đang hỏi Tailscale…

# Headline of the page when Tailscale is off and not installed.
settings-tailscale-top-not-installed = Tailscale chưa được cài đặt. Hãy bật nó ở bên dưới để cài đặt.

# Headline of the page when Tailscale is installed but off.
settings-tailscale-top-off = Tailscale đang tắt nên không dùng bộ nhớ.

# Headline of the page when Tailscale is on but does not answer.
settings-tailscale-top-silent = Tailscale không phản hồi. Có thể nó vẫn đang khởi động.

# Headline of the page when connected: the name of the private network and of this computer.
settings-tailscale-top-connected = Đã kết nối tới { $network } với tên { $name }.

# Name used in the headline for the private network when it has no name of its own.
settings-tailscale-network-fallback = Tailscale

# Headline of the page when Tailscale is on and has to be signed in to.
settings-tailscale-top-sign-in = Tailscale đang bật. Hãy đăng nhập bên dưới để vào mạng riêng của bạn.

# Headline of the page for any other state; the state is already written in lower case.
settings-tailscale-top-state = Tailscale đang { $state }.

# Name of the page in the list of settings pages.
settings-tailscale-title = Tailscale

# Words the settings search looks for on this page (not shown).
settings-tailscale-keywords = tailscale vpn mạng riêng thiết bị từ xa tailnet

# Help text at the top of the page.
settings-tailscale-help = Tailscale nối các máy tính và điện thoại của riêng bạn thành một mạng riêng, dù mỗi máy ở đâu. Không có gì được cài đặt cho đến khi bạn bật nó, và khi tắt thì nó không dùng bộ nhớ.

# Small line under the Use Tailscale switch before Tailscale is installed.
settings-tailscale-switch-sub-first = Cài đặt từ nguồn riêng của Tailscale.

# Small line under the Use Tailscale switch once Tailscale is installed.
settings-tailscale-switch-sub = Tắt: đã dừng, không khởi động cùng máy tính.

# Text of the switch that turns Tailscale on or off, and heading of its line.
settings-tailscale-switch = Dùng Tailscale

# Help text (i button) of the Tailscale card when Tailscale is off or has not answered.
# SAFETY: needs a human review before it ships
settings-tailscale-about-plain = Lần đầu bật, Tailscale được cài đặt từ nguồn phần mềm riêng của Tailscale, rồi được khởi động. Dịch vụ nền của nó dùng bộ nhớ khi bật, nên chỉ chạy khi mục này bật. Khi tắt, Tailscale dừng và không khởi động cùng máy tính. Tường lửa cho các thiết bị Tailscale của riêng bạn đi vào, và vẫn chặn mọi thứ khác như trước.

# Help text (i button) of the Tailscale card when Tailscale is on but not yet connected.
# SAFETY: needs a human review before it ships
settings-tailscale-about-sign-in = { settings-tailscale-about-plain } Đăng nhập sẽ mở trang đăng nhập của Tailscale trong trình duyệt. Hãy dùng cùng một tài khoản trên mọi thiết bị của bạn.

# Help text (i button) of the Tailscale card when connected.
# SAFETY: needs a human review before it ships
settings-tailscale-about-connected = { settings-tailscale-about-plain } Đăng xuất sẽ đưa máy tính này ra khỏi mạng riêng của bạn cho đến khi bạn đăng nhập lại.

# Line in the devices card when there are no other devices.
settings-tailscale-no-devices = Chưa có thiết bị nào khác

# Small line under "No other devices yet".
settings-tailscale-no-devices-sub = Hãy đăng nhập trên thiết bị khác bằng cùng tài khoản.

# Shown on the devices card while Tailscale is off.
settings-tailscale-waits-off = Hãy bật Tailscale để xem các thiết bị của bạn.

# Shown on the devices card while Tailscale has not answered.
settings-tailscale-waits-looking = Đang tìm các thiết bị của bạn…

# Shown on the devices card when Tailscale needs signing in to.
settings-tailscale-waits-sign-in = Hãy đăng nhập để xem các thiết bị của bạn.

# Shown on the devices card when Tailscale is on but not connected.
settings-tailscale-waits-connect = Hãy kết nối để xem các thiết bị của bạn.

# Small line under this computer when it has no address yet.
settings-tailscale-no-address = Chưa có địa chỉ.

# Small line under this computer: its address on the private network.
settings-tailscale-address = { $address } trong mạng riêng của bạn.

# Name of this computer's line when Tailscale gives it no name.
settings-tailscale-this-computer = Máy tính này

# Heading of the line that signs in to Tailscale, and tip of its round button.
settings-tailscale-sign-in = Đăng nhập

# Small line under the Sign in line.
settings-tailscale-sign-in-sub = Mở trang đăng nhập trong trình duyệt của bạn.

# Heading of the line that joins the private network again, and tip of its round button.
settings-tailscale-connect = Kết nối

# Small line under the Connect line.
settings-tailscale-connect-sub = Tham gia lại mạng riêng của bạn.

# Heading of the line that says the firewall lets the person's own devices in.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall = Thiết bị của riêng bạn được vào

# Small line under that heading.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall-sub = Mọi thứ khác vẫn bị chặn như trước.

# Heading of the line that signs out, and tip of its button.
settings-tailscale-sign-out = Đăng xuất

# Small line under the Sign out line.
settings-tailscale-sign-out-sub = Rời khỏi mạng riêng của bạn.

# Heading of the card with the Tailscale switch.
settings-tailscale-card = Tailscale

# Heading of the card that lists the person's devices.
settings-tailscale-devices = Thiết bị của bạn

# Help text (i button) of the Your devices card.
settings-tailscale-devices-about = Mọi thiết bị đã đăng nhập vào mạng riêng của bạn, kèm địa chỉ trên mạng, hệ điều hành chúng chạy và lần trực tuyến gần nhất. Để thêm một thiết bị, hãy cài Tailscale trên điện thoại hoặc máy tính khác và đăng nhập bằng cùng tài khoản.
