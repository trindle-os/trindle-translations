settings-games-split-done-on = Sửa giật đã bật

# After the split-lock switch is turned off.
settings-games-split-done-off = Sửa giật đã tắt

# The games drive card.
settings-games-drive-title = Ổ đĩa trò chơi

# What that card is for.
settings-games-drive-about = Một ổ đĩa thứ hai cho trò chơi, sẵn sàng ở mỗi lần khởi động.

# A drive with no name of its own.
settings-games-drive-unnamed = Ổ đĩa

# One drive in the list: its name, size and kind of filesystem.
settings-games-drive-name = { $name }, { $size }, { $fs }

# Under a drive that can be used for games.
settings-games-drive-ready = Sẵn sàng cho trò chơi

# The button that makes a drive the games drive.
settings-games-drive-use = Dùng cho trò chơi

# Under the drive in use for games.
settings-games-drive-in-use = Ổ đĩa trò chơi, tại { $place }

# The button that stops using a drive for games.
settings-games-drive-stop = Ngừng dùng cho trò chơi

