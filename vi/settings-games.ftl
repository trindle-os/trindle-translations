# The page's name in the side bar.
settings-games-title = Games

# Words a search finds the page by.
settings-games-keywords = games steam proton crackle stutter sound buffer drive library split lock game controller gamepad joystick pad buttons keys change remap swap stick trigger d-pad xbox playstation nintendo trò chơi tay cầm rè giật âm thanh bộ đệm ổ đĩa nút phím đổi

# What the page is for, in the help.
settings-games-help = Các cài đặt giúp trò chơi chạy tốt. Steam giữ cài đặt riêng của nó trong Steam. Nhấn một nút trên tay cầm và nó sẽ lên đầu danh sách, sáng lên trên hình. Rồi nhấn phím trên bàn phím mà nó sẽ trở thành. Một nút cũng có thể trở thành nút khác, hoặc không là gì, từ danh sách của nó. Mỗi tay cầm giữ các thay đổi riêng, theo hãng và kiểu máy, và trò chơi đọc tay cầm đã được đổi. Phím Escape sẽ dừng một thay đổi bạn đã bắt đầu.

# The sentence at the top of the page.
settings-games-top = Trợ giúp cho trò chơi bị rè âm, giật hoặc cần thêm chỗ.

# Shown beside a switch while the person is asked for the password.
settings-games-waiting = Đang chờ mật khẩu...

# The card holding the sound and split-lock switches.
settings-games-smooth = Trò chơi mượt hơn

# What that card is for.
settings-games-smooth-about = Các cách sửa cho trò chơi bị rè âm hoặc giật. Lúc đầu cả hai đều tắt.

# The sound switch.
settings-games-sound = Bộ đệm âm thanh lớn hơn

# Under the sound switch.
settings-games-sound-sub = Cho trò chơi có âm thanh bị rè. Âm thanh sẽ đến trễ hơn một chút.

# After the sound switch is turned on.
settings-games-sound-done-on = Bộ đệm lớn hơn đã bật

# After the sound switch is turned on, when the sound system could not be told at once.
settings-games-sound-next-login = Bật từ lần đăng nhập sau

# After the sound switch is turned off.
settings-games-sound-done-off = Bộ đệm lớn hơn đã tắt

# The split-lock switch.
settings-games-split = Sửa giật cho trò chơi cũ

