
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = Giao diện

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = màu sắc màu nhấn chủ đề giao diện kính tối sáng chế độ nắng biểu tượng phông chữ con trỏ trỏ chuột đọc màn hình người khiếm thị đọc to trợ năng nhãn chú thích tên

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = Sáng hoặc tối, màu sắc, biểu tượng, phông chữ, con trỏ và đọc to màn hình. Một số chương trình chỉ nhận thay đổi sau khi được mở lại.

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = Giữ giao diện này?

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = Nhấn Escape để hoàn lại ngay.

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = Tối

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = Sáng

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = tối

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = sáng

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }, { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = { $name } trông thế nào, { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = Giao diện { $look }.

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = Giao diện riêng của Trindle, vì không dùng được chủ đề { $theme }. { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = Chủ đề { $theme }, { $look }, với màu nhấn { $accent } và biểu tượng { $shape }.

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = Chủ đề { $theme }, với màu nhấn { $accent } và biểu tượng { $shape }.

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look }, với màu nhấn { $accent } và biểu tượng { $shape }.

# Shape of the icons in the top sentence.
settings-appearance-shape-round = tròn

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = Vàng Trindle

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = Đọc to những gì có trên màn hình và những gì bạn gõ. Nhấn Super, Alt và S cùng lúc cũng bật hoặc tắt tính năng này.

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = Không tạo lại được các biểu tượng, nên một số vẫn giữ hình dạng cũ. Hãy chọn lại bộ biểu tượng để thử một lần nữa.

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = Một số màu đã được làm rõ hơn để dễ đọc.

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
       *[other] Đang thử chủ đề { $theme }. Giao diện cũ sẽ quay lại sau { $seconds } giây trừ khi bạn nhấn Giữ. Nhấn Escape để hoàn lại ngay.
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = Đã giữ chủ đề { $theme }.

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = Giao diện cũ sẽ quay lại khi hết thời gian.

# Said aloud when the look from before is back.
settings-appearance-aloud-back = Giao diện cũ đã quay lại.

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = Chọn chủ đề

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = Chủ đề

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = { $name } đã có trong danh sách ở trên. Bấm vào để dùng.

# Red words under the Theme line when a theme could not be removed.
# SAFETY: needs a human review before it ships
settings-appearance-not-removed = Không gỡ được chủ đề.

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = Không dùng được chủ đề { $theme }. { $why }

# Heading of the line saying a theme is tried first.
settings-appearance-tried-first = Chủ đề được thử trước

# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
       *[other] Câu hỏi Giữ hiện ở cuối cửa sổ trong { $seconds } giây.
    }

# Name of the bin button that removes one of the person's own themes.
# SAFETY: needs a human review before it ships
settings-appearance-remove-theme = Gỡ chủ đề này

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = Dùng { $name }

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = Của { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = Thêm chủ đề

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = Đang tìm chủ đề

# Title of the Theme card.
settings-appearance-theme-card = Chủ đề

# Words behind the i of the Theme card.
settings-appearance-theme-about = Chủ đề là toàn bộ giao diện trong một tệp: màu sắc, góc bo, kích cỡ và khoảng cách. Bấm vào một chủ đề để thử: mọi cửa sổ Trindle đổi ngay lập tức, và giao diện cũ tự quay lại sau 30 giây trừ khi bạn nhấn Giữ, nên một chủ đề không đọc được sẽ không bao giờ ở lại. Chủ đề có cả giao diện tối và sáng sẽ có nút Tối và Sáng bên cạnh hình; Sáng dễ nhìn hơn dưới nắng chói, và các ứng dụng từ mục Ứng dụng sẽ áp dụng ở lần mở sau. Chủ đề chỉ có một giao diện thì không có các nút đó. Màu nhấn của bạn vẫn là của bạn trong mọi chủ đề. Chủ đề bạn thêm chỉ được đọc chứ không bao giờ được chạy, và chữ khó đọc sẽ được làm rõ hơn. Từ terminal, trindle-settings --theme default luôn đưa giao diện riêng của Trindle trở lại.

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = Chủ đề

# Small words under that line.
settings-appearance-theme-line-about = Toàn bộ giao diện. Chủ đề có cả hai thì có nút Tối hoặc Sáng bên cạnh.

# Small words under the Add a theme line.
settings-appearance-add-theme-about = Một tệp .css, chẳng hạn tệp ai đó đã chia sẻ.

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = Tệp chủ đề chứa gì

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = Sáu ký tự trong 0-9 và a-f, ví dụ #fbc711.

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = Màu đã nhập

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = Mã hex

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = Màu bất kỳ, dưới dạng mã hex như #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = Màu bất kỳ

# Small words under that line.
settings-appearance-any-colour-about = Sáu hoặc tám chữ số, ví dụ #fbc711.

# Title of the Colour card.
settings-appearance-colour-title = Màu sắc

# Words behind the i of the Colour card.
settings-appearance-colour-about = Màu nhấn đánh dấu các nút, công tắc, vòng tròn tiến độ và vị trí bạn đang ở. Các cửa sổ của Trindle đổi ngay; vòng tròn đổi ở lần mở sau. Màu quá tối để thấy trên thẻ sẽ được làm sáng lên cho đến khi đọc được, và ở giao diện sáng, màu quá nhạt sẽ được làm đậm. Tối hoặc Sáng được chọn trên ô của từng chủ đề, trong mục Chủ đề.

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = Màu nhấn

# Small words under that line.
settings-appearance-highlight-about = Nút, công tắc và vị trí bạn đang ở.

# Small words under the read the screen aloud switch when a screen reader is installed.
settings-appearance-reader-on = Nhấn Super, Alt và S cũng bật hoặc tắt.

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = Đọc to màn hình

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = Giữ nhãn khi trỏ chuột

# Small words under that line.
settings-appearance-labels-about = Tên của nút vẫn hiện khi bạn trỏ vào nó.

# Title of the Reading the screen card.
settings-appearance-reading-title = Đọc màn hình

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } Tên của nút thường biến mất sau một giây rưỡi; khi chọn giữ, nó ở lại chừng nào con trỏ còn trên nút. Khi màn hình được đọc to, mọi nút đều hiện tên bên dưới.

# Name of the set of round icons.
settings-appearance-icons-circles = Hình tròn

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = Đang đổi biểu tượng

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = Đã đổi

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = Biểu tượng { $name }

# Heading of the line for the shape of the icons.
settings-appearance-shape = Hình dạng

# Small words under that line.
settings-appearance-shape-about = Bộ biểu tượng Trindle, tròn hoặc vuông.

# Title of the Icons card.
settings-appearance-icons-title = Biểu tượng

# Words behind the i of the Icons card.
settings-appearance-icons-about = Bộ biểu tượng Trindle có dạng tròn hoặc vuông. Ứng dụng mà bộ này không vẽ sẽ được tạo một biểu tượng cho phù hợp, và vòng tròn cùng bảng điều khiển được vẽ lại theo hình dạng mới.

# Name of the list of font families, and heading of the font line.
settings-appearance-font = Phông chữ

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = Mặc định

# Name of the list of font sizes.
settings-appearance-font-size = Cỡ chữ

# Small words under the font line.
settings-appearance-font-about = Chữ trong cửa sổ của các chương trình.

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = Thêm phông chữ

# Small words under the Add fonts line.
settings-appearance-add-fonts-about = Một tệp .ttf hoặc .otf, hoặc tệp zip chứa chúng.

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = Tệp phải chứa gì

# Title of the Text card.
settings-appearance-text-title = Chữ

# Words behind the i of the Text card.
settings-appearance-text-about = Phông chữ mà các chương trình dùng cho chữ của chúng, và cỡ chữ. Phông chữ thêm ở đây, một tệp .ttf hoặc .otf hay tệp zip chứa chúng, chỉ được thêm vào danh sách phông chữ của riêng bạn; một số chương trình chỉ nhận thay đổi sau khi được mở lại.

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = Chọn phông chữ

# Red words when a font could not be replaced; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-appearance-font-not-replaced = Không thay thế được { $name }.

# Green words after one font took the place of the one there; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-appearance-font-replaced-one = Đã thay thế { $name }. Các chương trình khởi động từ giờ sẽ dùng nó.

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
# SAFETY: needs a human review before it ships
settings-appearance-font-replaced-some = Đã thay thế { $n } trong { $total }. Các chương trình khởi động từ giờ sẽ dùng chúng.

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
       *[other] Có { $n } phông chữ trong danh sách ở trên. Hãy chọn ở trên.
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = Các phông chữ đó đã có trong danh sách.

# Choice in the list of cursor sizes: the normal size.
settings-appearance-cursor-normal = Thường

# Choice in the list of cursor sizes: a large size.
settings-appearance-cursor-large = Lớn

# Choice in the list of cursor sizes: the largest size.
settings-appearance-cursor-larger = Lớn hơn

# Spoken name of a picture of a cursor size; { $size } is its name, such as Large.
settings-appearance-pointer-spoken = Con trỏ { $size }

# Name of the standard cursor theme (the one every system has).
settings-appearance-cursor-standard = Chuẩn

# Name of the list of cursor themes, and heading of its line.
settings-appearance-cursor = Con trỏ

# Name of the list of cursor sizes, and heading of its line.
settings-appearance-cursor-size = Cỡ con trỏ

# Small words under the cursor line.
settings-appearance-cursor-about = Cách vẽ con trỏ chuột.

# Small words under the cursor size line.
settings-appearance-cursor-size-about = Lớn hơn thì dễ tìm hơn.

# Title of the Pointer card.
settings-appearance-pointer-title = Con trỏ chuột
