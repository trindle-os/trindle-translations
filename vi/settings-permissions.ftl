
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the Permissions page, in the page list and as its heading.
# SAFETY: needs a human review before it ships
settings-permissions-title = Quyền

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = quyền cho phép riêng tư flatpak flathub hộp cát internet mạng tệp âm thanh micrô camera bluetooth thông báo plugin deb x11 xwayland chương trình cũ steam wine java màn hình terminal máy tính thunderbolt usb4 đế thiết bị

# Help line at the foot of the Permissions page.
# SAFETY: needs a human review before it ships
settings-permissions-help = Mỗi ứng dụng được dùng những gì. Ứng dụng từ Flathub, chương trình cài trong thư mục riêng và plugin đều được cài trong thư mục riêng của chúng, mặc định bị hạn chế. Biểu tượng đầy là được phép; nhấp vào để đổi. Thay đổi với ứng dụng Flathub có hiệu lực vào lần khởi động tiếp theo. Thiết bị Thunderbolt và USB4 đã được cho phép luôn kết nối mà không hỏi; hãy xóa khỏi danh sách để được hỏi lại.

# Red words when a permission could not be changed and nothing more is known.
# SAFETY: needs a human review before it ships
settings-permissions-not-changed = Không thể thay đổi.

# Words beside a plugin when its change was saved but the plugin could not be started again.
# SAFETY: needs a human review before it ships
settings-permissions-plugin-not-restarted = Đã lưu, nhưng không thể khởi động lại plugin. Thay đổi có hiệu lực vào lần khởi động tiếp theo.

# Said beside an app, plugin or switch once a permission change is saved.
# SAFETY: needs a human review before it ships
settings-permissions-saved = Đã lưu

# Help text of the AppImages card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-images = Mỗi AppImage chạy trong một hộp riêng, với thư mục nhà riêng. Biểu tượng đầy là được phép; nhấp vào để đổi. Thay đổi có hiệu lực vào lần AppImage khởi động tiếp theo.

# Help text of the Started from Folders card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-programs = Mỗi chương trình khởi động từ Folders chạy trong một hộp riêng, với thư mục nhà riêng. Biểu tượng đầy là được phép; nhấp vào để đổi. Thay đổi có hiệu lực vào lần chương trình khởi động tiếp theo.

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# Under the Allow older programs switch.
# SAFETY: needs a human review before it ships
settings-permissions-older-why = Mỗi chương trình được tách biệt với phần còn lại. Khi tắt, chúng không mở được.

# Heading of the card with the switch for older programs.
settings-permissions-older = Chương trình cũ

# Label and tip of the switch that lets older programs open.
# SAFETY: needs a human review before it ships
settings-permissions-allow-older = Cho phép chương trình cũ

# Help text on the Thunderbolt and USB4 card when the ports only carry screens.
settings-permissions-lets-in-screens = Các cổng này chỉ truyền màn hình, nên không thiết bị nào truy cập được bộ nhớ của máy tính này và không có gì để hỏi.

# Help text on the Thunderbolt and USB4 card when the ports only carry USB and screens.
settings-permissions-lets-in-usb = Các cổng này chỉ truyền USB và màn hình, nên không thiết bị nào truy cập được bộ nhớ của máy tính này và không có gì để hỏi.

# Help text on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-lets-in-all = Các cổng này cho mọi thiết bị tự kết nối, nên không có gì để hỏi. Điều này được đặt trong phần sụn của máy tính.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry screens.
settings-permissions-short-screens = Các cổng này chỉ truyền màn hình.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry USB and screens.
settings-permissions-short-usb = Các cổng này chỉ truyền USB và màn hình.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the firmware lets every device in.
settings-permissions-short-firmware = Phần sụn cho mọi thiết bị kết nối.

# Under a package's name: its version number is { $v }.
settings-permissions-version = Phiên bản { $v }

# Under a plugin's name when it asks for nothing: its version number is { $v }.
settings-permissions-version-asks-nothing = Phiên bản { $v }. Không yêu cầu gì.

# Under a plugin's name: the words so far are { $sub }, then the ports it listens on in { $detail }.
settings-permissions-sub-listen = { $sub }. { $detail }

# Red words when a Thunderbolt or USB4 device could not be forgotten.
# SAFETY: needs a human review before it ships
settings-permissions-not-forgotten = Không thể xóa khỏi danh sách.

# Heading of the Thunderbolt and USB4 card.
settings-permissions-thunder = Thunderbolt và USB4

# Help text of the Thunderbolt and USB4 card: { $about } is a further sentence, or nothing.
# SAFETY: needs a human review before it ships
settings-permissions-thunder-about = Thiết bị Thunderbolt và USB4 đã được cho phép luôn kết nối mà không hỏi; hãy xóa khỏi danh sách để được hỏi lại. { $about }

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-ports = Các cổng

# Under The ports while the Thunderbolt and USB4 card is read.
settings-permissions-reading-ports = Đang đọc những gì chúng cho vào…

# Heading of a line on the Thunderbolt and USB4 card.
# SAFETY: needs a human review before it ships
settings-permissions-devices-allowed = Thiết bị được cho phép

# Under a line of the Thunderbolt and USB4 card while it is read.
settings-permissions-reading = Đang đọc…

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-memory-apart = Bộ nhớ được tách biệt

# Heading of the line on the Thunderbolt and USB4 card when the computer has no such ports.
settings-permissions-no-ports = Không có cổng Thunderbolt hay USB4

# Under the heading when the computer has no Thunderbolt or USB4 ports.
settings-permissions-nothing-to-ask = Nên không có gì để hỏi.

# Under Devices allowed when the computer has no Thunderbolt or USB4 ports.
settings-permissions-none-plug = Không có: không có gì cắm theo cách này.

# Heading of the line on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-nothing-ask = Không có gì để hỏi

# Under Devices allowed when the ports let every device in themselves.
settings-permissions-every-one = Tất cả, do chính các cổng cho phép.

# Help text of the Thunderbolt and USB4 card when the computer keeps devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-iommu = Máy tính này cũng giữ thiết bị tránh xa vùng bộ nhớ không được cấp, nên rủi ro nhỏ hơn. Xóa một thiết bị khỏi danh sách vẫn để nó kết nối cho đến khi được rút ra.

# Help text of the Thunderbolt and USB4 card when the computer does not keep devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-no-iommu = Xóa một thiết bị khỏi danh sách vẫn để nó kết nối cho đến khi được rút ra; lần sau sẽ được hỏi lại.

# Heading of the line on the Thunderbolt and USB4 card that lists the devices.
# SAFETY: needs a human review before it ships
settings-permissions-asked-before = Hỏi trước khi thiết bị mới kết nối

# Under the heading above.
settings-permissions-forget-one = Xóa một thiết bị khỏi danh sách để được hỏi lại.

# Red words when the list of allowed Thunderbolt devices could not be read: the reason is { $why }.
settings-permissions-devices-not-read = Không đọc được các thiết bị được cho phép: { $why }

# Shown when no Thunderbolt or USB4 device has been allowed always.
# SAFETY: needs a human review before it ships
settings-permissions-no-device = Chưa có thiết bị nào được kết nối mà không hỏi.

# Tip of the button that forgets an allowed Thunderbolt or USB4 device.
# SAFETY: needs a human review before it ships
settings-permissions-forget-device = Xóa thiết bị này khỏi danh sách

# Name given to a Thunderbolt or USB4 device that has none.
settings-permissions-a-device = Một thiết bị Thunderbolt

# Under an allowed device's name when its maker is not known.
# SAFETY: needs a human review before it ships
settings-permissions-may-always = Luôn được kết nối

# Under an allowed device's name: the maker is { $vendor }.
# SAFETY: needs a human review before it ships
settings-permissions-made-by = Do { $vendor } sản xuất. Luôn được kết nối.

# Headline while the list of apps is being read.
settings-permissions-reading-apps = Đang đọc những gì mỗi ứng dụng được dùng…

# Headline while Flatpak is still answering: how many apps are listed.
settings-permissions-reading-each =
    { $n ->
       *[other] Đang đọc những gì mỗi ứng dụng trong { $n } ứng dụng được dùng…
    }

# Headline when no app or plugin is kept in a box of its own.
settings-permissions-no-apps = Chưa cài ứng dụng hay plugin nào được giữ trong hộp riêng.

# Headline when exactly one app is kept in a box of its own.
settings-permissions-one-app = Một ứng dụng được giữ trong hộp riêng và chỉ dùng những gì được cho phép ở đây.

# Headline: how many apps and plugins are kept in a box of their own.
settings-permissions-many-apps =
    { $n ->
       *[other] { $n } ứng dụng và plugin, mỗi cái được giữ trong hộp riêng, chỉ dùng những gì được cho phép ở đây.
    }

# Heading of the card for apps from Flathub.
settings-permissions-flathub-apps = Ứng dụng Flathub

# Heading of the card for programs installed in their own folder.
settings-permissions-own-folder = Trong thư mục riêng

# Heading of the card for plugins.
settings-permissions-plugins = Plugin

# Heading of the card for AppImages.
settings-permissions-appimages = AppImage

# Heading of the card for programs started from Folders.
settings-permissions-from-folders = Khởi động từ Folders

# Under a kind of app on the Permissions page when none is installed.
settings-permissions-none-installed = Chưa cài cái nào.

# Under a kind of app on the Permissions page when none has been run.
settings-permissions-none-run = Chưa chạy cái nào.

# Help text of the Flathub apps card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-flathub-about = Mỗi ứng dụng từ Flathub được giữ trong một hộp riêng và chỉ dùng những gì được cho phép ở đây. Biểu tượng đầy là được phép; nhấp vào để đổi. Thay đổi có hiệu lực vào lần ứng dụng khởi động tiếp theo.

# Help text of the In their own folder card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-debs-about = Chương trình cài trong thư mục riêng mặc định bị hạn chế. Biểu tượng đầy là được phép; nhấp vào để đổi.

# Help text of the Plugins card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-plugins-about = Plugin mặc định bị hạn chế và chỉ có thể được cho phép những gì chúng yêu cầu. Plugin đang chạy nền sẽ khởi động lại ngay khi có thay đổi.

# Typing codes card: every short code Trindle swaps for words as you type.
settings-permissions-codes = Mã gõ tắt

# SAFETY: needs a human review before it ships
settings-permissions-codes-about = Các mã ngắn mà Trindle đổi thành chữ khi bạn gõ, kèm plugin sở hữu mã đó. Tắt mã của một plugin bằng biểu tượng tròn của nó.

settings-permissions-codes-none = Không có mã nào đang hoạt động

# SAFETY: needs a human review before it ships
settings-permissions-codes-none-sub = Plugin được phép mở rộng mã sẽ hiện ở đây.

# Button on a plugin's row: stops that plugin's codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-off = Tắt mã của { $name }

settings-permissions-codes-count =
    { $n ->
       *[other] { $n } mã, { $id }
    }

# A code's second line: what it types and who owns it.
settings-permissions-code-types = Gõ "{ $words }" cho { $name }

settings-permissions-codes-more =
    { $n ->
       *[other] Còn { $n } mã nữa đang hoạt động
    }

# Line on the typing codes card when the plugins folder could not be read: the list may be missing codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread-line = Không đọc được thư mục plugin

# Red words under that line.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread = Không đọc được thư mục plugin, nên có thể thiếu một số mã.

settings-permissions-not-added = Chạy từ Folders, không thêm vào Apps

settings-permissions-kind-tip = Loại ứng dụng



# Heading of the card for programs that are not in a box.
settings-outside-heading = Chương trình ngoài hộp

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = Trindle xem vài giây một lần và báo cho bạn. Nó không thể chặn các chương trình này, và có thể bỏ sót một chương trình chạy nhanh. Chương trình trong hộp thì bị chính hộp của nó giữ lại.

# Label of the switch for the notice about the network.
settings-outside-network = Báo khi một chương trình kết nối mạng

# Label of the switch for the notice about the person's files.
settings-outside-files = Báo khi một chương trình đang mở tệp của bạn

# Under those two switches.
settings-outside-once = Một lần cho mỗi chương trình.

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = Báo lại cho { $name }

# Under a program marked fine for the network.
settings-outside-fine-network = Việc kết nối mạng là bình thường.

# Under a program marked fine for the person's files.
settings-outside-fine-files = Việc mở tệp của bạn là bình thường.

# The line in the card when no program is marked fine.
settings-outside-no-fine = Chưa có chương trình nào được đánh dấu là bình thường.

# Heading of the card for downloaded files.
settings-downloads-heading = Tệp đã tải về

# Help text of that card (the information button).
settings-downloads-about = Tệp từ internet là tệp trong Tải xuống, hoặc tệp mà trình duyệt đã đánh dấu. Chương trình mở nó chỉ nhận được đúng tệp đó, chỉ để đọc, không có internet và không có thư mục nào của bạn. Điều này không áp dụng cho nút Mở của chính trình duyệt, vì nút đó tự khởi chạy chương trình.

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = Mở tệp đã tải về trong một hộp

# Under that switch.
settings-downloads-box-sub = Không có internet, và chỉ có tệp đó, chỉ để đọc.

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = Mở tệp { $kind } như bình thường

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = Tệp { $kind }

# Under a file type's switch.
settings-downloads-normal-sub = Bật: mở như bình thường, có internet.

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = Chưa có loại nào. Một loại sẽ được liệt kê khi một tệp đã tải về được mở trong hộp.

