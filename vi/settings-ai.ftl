
# machine translated (Vietnamese), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = Chương trình AI

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = ai chương trình claude codex cursor gemini aider tác nhân hàng rào cách ly sandbox riêng tư thư mục chia sẻ ssh khóa token sudo

# Help line at the foot of the AI programs page.
settings-ai-help = Các chương trình lập trình AI chạy trong một hàng rào che giấu tệp cá nhân của bạn. Chỉ chia sẻ những thư mục chúng cần.

# Headline of the AI programs page.
# SAFETY: needs a human review before it ships
settings-ai-note = Việc này giữ các chương trình AI tránh xa tệp cá nhân của bạn khi dùng hằng ngày, ví dụ khi một chương trình bị lừa đi gom sao kê ngân hàng của bạn rồi gửi ra ngoài. Đây là sự bảo vệ có giới hạn, không phải lời đảm bảo: một chương trình quyết tâm, lỗi trong phần mềm của máy tính, hoặc việc bạn chấp thuận một yêu cầu hay chia sẻ một thư mục vẫn có thể để lọt thứ gì đó.

# Note under the headline of the AI programs page.
settings-ai-inside = Mọi thứ một chương trình AI khởi chạy, như chương trình đã cài, tập lệnh và các chương trình khác, đều ở trong hàng rào cùng với nó.

# Red words when a change to the fence could not be made.
settings-ai-not-changed = Không thể thay đổi.

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = Đã lưu

# Title of the window for choosing a folder to share with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-choose-folder = Chọn thư mục để chia sẻ với các chương trình AI

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = Không thể tạo khóa.

# Label of the switch that limits the network of AI programs, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-limit-net = Giới hạn mạng vào các trang được liệt kê ở đây

# Under the Limit the network heading.
# SAFETY: needs a human review before it ships
settings-ai-limit-net-sub = Tắt: mạng mở. Bật: chỉ các trang bên dưới.

# Tip of the button that removes a site from the list AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-stop-site = Ngừng cho các chương trình AI truy cập trang này

# Example in the box for typing a site AI programs may reach.
settings-ai-eg-site = ví dụ api.anthropic.com

# Tip of the button that adds a site AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-let-site = Cho các chương trình AI truy cập trang này

# Heading of the line for adding a site.
settings-ai-add-site = Thêm một trang

# Under the Add a site heading.
settings-ai-add-site-sub = Tên của trang, hoặc *.example.com cho mọi tên con bên dưới.

# Heading of the card that limits the network of AI programs.
settings-ai-network = Mạng

# Help text of the Network card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-network-about = Nâng cao. Khi tắt, các chương trình AI dùng mạng như bạn. Khi bật, chúng chỉ truy cập được các trang bên dưới, qua kết nối bảo mật (https), và hàng rào không có mạng riêng. Các công cụ của chương trình phải dùng thiết lập proxy được cấp cho chúng. Hãy thêm trang của dịch vụ AI, và của mọi nguồn gói mà việc cài đặt cần.

# Label of the switch that keeps AI programs inside the fence, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-keep-inside = Giữ các chương trình AI trong hàng rào

# Under the fence switch when it is on.
# SAFETY: needs a human review before it ships
settings-ai-hides-home = Ẩn thư mục chính của bạn, trừ các thư mục được chia sẻ bên dưới.

# Under the fence switch when it is off.
# SAFETY: needs a human review before it ships
settings-ai-fence-off = Hàng rào đang tắt. Các chương trình AI giờ thấy được mọi thứ bạn thấy.

# Heading of the card with the fence switch.
settings-ai-the-fence = Hàng rào

# Help text of The fence card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-fence-about = Hệ thống vẫn hiện ra và dùng được với các chương trình AI. Thư mục chính của bạn được thay bằng một thư mục chính riêng trống mà chúng giữ lại giữa các lần chạy, chỉ có các thư mục bạn chia sẻ. Chúng không thấy được các chương trình khác, phiên làm việc, khóa hay mật khẩu của bạn. Chương trình được khởi động theo cách khác với tên trong danh sách này sẽ không nằm trong hàng rào. Nếu bạn đã cài kết nối trợ lý (trindle-mcp), một trợ lý được kết nối có thể đọc những thứ sau mà không hỏi bạn: tiêu đề các cửa sổ đang mở và ứng dụng đằng sau chúng, các ứng dụng đã cài, các chương trình đang chạy và mức dùng bộ nhớ của chúng, bộ nhớ, ổ đĩa, pin, thời gian bật máy và trạng thái mạng, các cài đặt Trindle của bạn, tối đa 500 dòng nhật ký hệ thống của bất kỳ dịch vụ nào, các ghi chú sự cố mới nhất, cùng tên các thiết bị âm thanh, thiết bị Bluetooth đã ghép đôi, mạng Wi-Fi gần đó và ổ đĩa. Trợ lý luôn hỏi bạn trước khi thay đổi bất cứ điều gì.

# Label of the switch that fences one AI program: its name is { $name }.
# SAFETY: needs a human review before it ships
settings-ai-fence-name = Đặt { $name } trong hàng rào

# Tip of the button that takes one program off the list: its name is { $name }.
settings-ai-take-off = Bỏ { $name } khỏi danh sách

# Label of the switch for using a program's existing settings folder: its name is { $name }.
settings-ai-own-for = Dùng thư mục cài đặt hiện có của tôi cho { $name }

# Heading of the line with the switch for using a program's existing settings folder.
settings-ai-own = Dùng thư mục cài đặt hiện có của tôi

# Under the existing settings folder heading.
settings-ai-own-sub = Nó chứa các cuộc trò chuyện trước đây của chương trình này.

# Example in the box for typing the name of an AI program.
settings-ai-eg-program = ví dụ claude

# Tip of the button that adds an AI program, and heading of its line.
settings-ai-add-program = Thêm một chương trình

# Under the Add a program heading.
settings-ai-add-program-sub = Nhập tên bạn dùng để khởi động nó.

# Help text of the AI programs card (the information button).
settings-ai-programs-about = Các tên này được khởi động trong hàng rào. Dùng thư mục cài đặt hiện có của tôi: khi tắt, chương trình bắt đầu với một thư mục riêng mới. Các chương trình tự đăng nhập bên trong: thông tin đăng nhập của bạn không được chia sẻ.

# Heading of the line shown when no folder is shared with AI programs.
settings-ai-nothing-shared = Chưa chia sẻ gì

# Under the Nothing is shared heading.
settings-ai-none-seen = Các chương trình AI không thấy thư mục nào của bạn.

# Label of the switch that lets AI programs only read a shared folder.
settings-ai-only-read = Chỉ cho phép đọc thư mục này

# Tip of the button that stops sharing a folder with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-make-private = Đặt lại thư mục này ở chế độ riêng tư

# Under a shared folder's path, beside the switch that makes it read only.
settings-ai-only-read-short = Chỉ cho phép đọc

# Tip of the button that shares a folder, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-share-folder = Chia sẻ một thư mục

# Under the Share a folder heading.
# SAFETY: needs a human review before it ships
settings-ai-share-folder-sub = Hiện ở cùng vị trí, để đọc và ghi.

# Heading of the card listing folders shared with AI programs.
settings-ai-shared = Chia sẻ với các chương trình AI

# Help text of the shared folders card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-shared-about = Riêng tư với các chương trình AI là quy tắc cho mọi thứ khác trong thư mục chính của bạn. Thư mục ẩn, và thư mục chứa khóa, mật khẩu hoặc thư điện tử, không bao giờ được chia sẻ. Thư mục được chia sẻ ở đây sẽ có sẵn vào lần chương trình khởi động tiếp theo.

# Tip of the button that removes a computer from the list AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-stop-computer = Ngừng cho các chương trình AI truy cập máy tính này

# Example in the box for typing a computer AI programs may reach by ssh.
settings-ai-eg-computer = ví dụ nas.local

# Tip of the button that adds a computer AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-let-computer = Cho các chương trình AI truy cập máy tính này

# Heading of the line for adding a computer.
settings-ai-add-computer = Thêm một máy tính

# Under the Add a computer heading.
settings-ai-add-computer-sub = Nhập tên của máy tính.

# Note showing the public key to put on each computer: the key is { $key }.
settings-ai-put-key = Hãy đặt khóa này lên từng máy tính: { $key }

# Tip of the button that makes a key for AI programs.
settings-ai-make-key = Tạo khóa

# Heading of the line for making a key for AI programs.
settings-ai-make-key-for = Tạo khóa cho các chương trình AI

# Under the Make a key heading.
settings-ai-make-key-sub = Một khóa riêng biệt, được giữ ngoài các thư mục chúng thấy được.

# Heading of the card listing computers AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-ssh = Các máy tính chúng được truy cập qua ssh

# Help text of the ssh card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-ssh-about = Bên trong hàng rào, ssh sẽ hỏi Trindle, dùng một khóa riêng và chỉ cho các máy tính được liệt kê ở đây. Khóa của riêng bạn không bao giờ được hiển thị cho các chương trình AI.

# Tip of the button that stops giving AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-stop-key = Ngừng cấp khóa này cho các chương trình AI

# Under the name of a key that AI programs are given.
settings-ai-given = Đã cấp cho các chương trình AI

# Example in the box for typing a key to give AI programs: a name, an equals sign and the value.
settings-ai-eg-key = TÊN=giá trị

# Tip of the button that gives AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-give-key = Cấp khóa này cho các chương trình AI

# Heading of the line for adding a key.
settings-ai-add-key = Thêm một khóa

# Under the Add a key heading.
settings-ai-add-key-sub = Viết dưới dạng TÊN=giá trị.

# Heading of the card listing keys given to AI programs.
# SAFETY: needs a human review before it ships
settings-ai-keys = Khóa cấp cho các chương trình AI

# Help text of the keys card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-keys-about = Khóa và token trong phiên làm việc của bạn không bao giờ đến được các chương trình AI. Khóa nhập ở đây sẽ được cấp cho chúng, và chỉ ở đây.
