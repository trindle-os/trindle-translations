# One line under that choice.
folders-settings-start-last-sub = Mỗi ngăn mở ở thư mục nó đã ở lần trước.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Nơi đặt ở đây

# One line under that choice.
folders-settings-start-chosen-sub = Bạn chọn một nơi cho mỗi ngăn ở bên dưới.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Gần đây

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Thư mục chính

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Tài liệu

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Tải về

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Ảnh

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Thùng rác

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Ngăn trái

# One line under the left pane setting.
folders-settings-left-pane-sub = Nơi ngăn trái bắt đầu.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Ngăn phải

# One line under the right pane setting.
folders-settings-right-pane-sub = Nơi ngăn phải bắt đầu.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Chọn nơi ngăn bắt đầu

# Button of that folder chooser that accepts the folder.
folders-settings-choose-accept = Chọn

# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = Không quên được { $server }: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Chọn thư mục khác

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Folders mở với { $left } bên trái và { $right } bên phải.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Folders mở mỗi ngăn ở nơi nó đã dừng lại.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Folders mở với Thư mục chính bên trái và Gần đây bên phải.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Một phần của cài đặt Folders

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Folders đọc mục này mỗi lần mở. Nó mở với một ngăn hiển thị nơi bên trái; công tắc Đơn và Đôi trên thanh công cụ sẽ hiển thị cả hai.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Các dòng sát nhau đến mức nào

# Name of the setting for how close the rows sit.
folders-settings-density = Dòng

# One line under the rows setting.
folders-settings-density-sub = Mọi thứ sát nhau đến mức nào, trong mọi kiểu xem.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Ô đánh dấu để chọn

# One line under the tick boxes setting.
folders-settings-ticks-sub = Một ô nhỏ trên mỗi mục giúp thêm mục đó vào phần đã chọn.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Hiện đuôi tệp

# One line under the file endings setting.
folders-settings-endings-sub = Khi tắt, report.pdf được hiển thị là report.

# Note under the settings of the list part.
folders-settings-list-note = Khi tắt đuôi tệp, đuôi cuối của tên sẽ được ẩn, trừ khi việc đó gây hiểu lầm: tên có hai đuôi, một chương trình, hoặc tệp không đúng như đuôi của nó. Khi bật ô đánh dấu, ô ở tiêu đề Tên sẽ chọn tất cả hoặc bỏ chọn tất cả.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = Quên { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Mở ổ đĩa khi cắm vào

# One line under the drives setting.
folders-settings-drives-sub = Ổ USB được mở khi cắm vào.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Dù thế nào nó cũng nằm trong thanh bên, và vòng tròn cho biết nó ở đó.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Chia sẻ

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Kết nối lại các thư mục chia sẻ khi tôi đăng nhập

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Tắt cho đến khi bạn chọn: mỗi lần kết nối một thư mục chia sẻ đều hỏi mật khẩu quản trị viên, và thư mục cần đăng nhập sẽ chờ bạn nhấn Kết nối lại.
