folders-settings-start-usual = Thư mục chính và Gần đây

# One line under that choice.
folders-settings-start-usual-sub = Thư mục chính bên trái, Gần đây bên phải.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
