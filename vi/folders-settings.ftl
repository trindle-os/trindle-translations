folders-settings-endings-sub = Khi tắt, report.pdf hiển thị là report.

# Note under the settings of the list part.
folders-settings-list-note = Khi ẩn đuôi tệp, Folders vẫn hiện đuôi của chương trình, tên có hai đuôi, và tệp không đúng như đuôi của nó. Khi bật ô đánh dấu, ô ở tiêu đề Tên sẽ chọn tất cả hoặc bỏ chọn tất cả.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = Quên { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Mở ổ đĩa khi cắm vào

# One line under the drives setting.
folders-settings-drives-sub = Dành cho ổ USB.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Dù bật hay tắt, ổ đĩa vẫn hiện trong thanh bên và vòng tròn cho biết nó đang ở đó.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Chia sẻ

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Kết nối lại các thư mục chia sẻ khi bạn đăng nhập

