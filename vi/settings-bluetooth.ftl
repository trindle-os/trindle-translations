# machine translated (Vietnamese), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Không bật được Bluetooth.

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Không tắt được Bluetooth.

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth chưa được bật.

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
settings-bluetooth-cause-auth-failed = { $could_not } Mã PIN hoặc số không được chấp nhận. Hãy thử lại.

# Said in red when the pairing was turned down; the first sentence says what could not be done.
settings-bluetooth-cause-turned-down = { $could_not } Yêu cầu đã bị từ chối, ở đây hoặc trên thiết bị kia.

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } Thiết bị kia không trả lời kịp. Hãy đưa nó vào chế độ ghép nối rồi thử lại.

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Việc đó đang được thực hiện. Hãy đợi giây lát.

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } Thiết bị không trả lời. Hãy kiểm tra nó đã bật và ở gần, rồi thử lại.

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } Thiết bị chưa sẵn sàng để dùng. Hãy đưa nó vào chế độ ghép nối rồi thử lại.

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = Bus hệ thống

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Đang tìm Bluetooth…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = Bluetooth không chạy trên máy này.

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth đang tắt.

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth đã bị tắt ngay trên máy.

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = Máy này không có Bluetooth.

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = Đang bật, đang tìm thiết bị ở gần…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = Đang bật, hiện chưa kết nối gì.

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
       *[other] Đang bật, và { $names } đã kết nối.
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = Công tắc bật hoặc tắt Bluetooth của máy này; bên dưới là tên bộ điều hợp. Khi "Hiển thị với thiết bị khác" đang bật, các thiết bị ở gần có thể tìm thấy máy này.

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = Đã tắt.

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
settings-bluetooth-visible = Hiển thị với thiết bị khác

# Small line under the Visible to other devices switch.
settings-bluetooth-visible-sub = Các thiết bị ở gần có thể tìm thấy máy này.

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = Đã tắt ngay trên máy

# Small line under it.
settings-bluetooth-hard-line-sub = Bằng công tắc hoặc phím. Hãy bật nó trước.

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Không có bộ điều hợp Bluetooth

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = Không tìm thấy bộ điều hợp Bluetooth nào trong máy này. Loại cắm vào cổng USB sẽ hiện ở đây ngay khi được cắm.

# Line in that card.
settings-bluetooth-none-found = Không tìm thấy

# Small line under it.
settings-bluetooth-none-found-sub = Loại USB sẽ hiện ở đây khi được cắm.

# Shown beside the Bluetooth switch while the password is asked for.
settings-bluetooth-waiting = Đang chờ mật khẩu...

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = Không thể làm cho máy này hiển thị với thiết bị khác.

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = Không thể ẩn máy này khỏi thiết bị khác.

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = Hãy bật Bluetooth để dùng các mục này.

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = Chưa ghép nối thiết bị nào

# Small line under it.
settings-bluetooth-none-paired-sub = Hãy tìm thiết bị để ghép nối.

# Heading of the card that lists paired devices.
settings-bluetooth-mine = Thiết bị của tôi

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = Các thiết bị đã ghép nối với máy này, kèm mức pin nếu có. Thiết bị đang kết nối khi trang mở sẽ nằm trước, và mỗi dòng giữ nguyên vị trí khi trang còn mở. Nút tròn để kết nối hoặc ngắt kết nối; thùng rác để quên thiết bị, khi đó phải ghép nối lại.

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = Đang tìm thiết bị...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = Ngừng tìm

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = Tìm thiết bị

# Small line under it.
settings-bluetooth-look-sub = Hãy đưa thiết bị kia vào chế độ ghép nối trước.

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = Ở gần

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = Nhấn Tìm thiết bị, đưa thiết bị kia vào chế độ ghép nối, rồi nhấn Ghép nối bên cạnh nó. Khi trang mở, thiết bị ở gần được xếp theo tín hiệu mạnh nhất trước, và mỗi thiết bị mới tìm thấy được thêm vào cuối. Một số hiện một con số để đối chiếu với số ở đây, một số hỏi mã PIN, thường có trong hướng dẫn của chúng, hoặc là 0000.

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Không ngừng tìm thiết bị được.

# Said in red when the search could not be started.
settings-bluetooth-start-failed = Không tìm thiết bị được.

# Small line of a device that is connected.
settings-bluetooth-connected = Đã kết nối

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = Chưa kết nối

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = pin { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
settings-bluetooth-pair = Ghép nối

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = Ngắt kết nối

# Tip of the button that connects a device.
settings-bluetooth-connect = Kết nối

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = Quên thiết bị này

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = Không ngắt kết nối được.

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = Không quên được thiết bị.

# Shown under a device while it is being paired.
settings-bluetooth-pairing = Đang ghép nối...

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = Không ghép nối được.

# Shown under a device while it is being connected.
settings-bluetooth-connecting = Đang kết nối...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = Không kết nối được.

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = Đã kết nối, nhưng không thể đặt để tự kết nối lần sau. Hãy kết nối nó tại đây khi cần.

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = Hãy nhập { $code } trên thiết bị, rồi nhấn Enter trên đó.

# Question under a device that shows a number to compare with the one on this computer.
settings-bluetooth-compare = Thiết bị kia có hiện { $code } không?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = Không

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = Có, khớp

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = Ghép nối với thiết bị này?

# Placeholder of the box where a device's PIN is typed.
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = Hủy

# Help line above the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin-help = Nhập mã PIN của thiết bị này. Mã thường có trong hướng dẫn của nó, hoặc là 0000.

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = tai nghe chuột bàn phím ghép nối thiết bị không dây

# Help text at the top of the page.
settings-bluetooth-help = Nhấn Tìm, đưa thiết bị kia vào chế độ ghép nối, rồi nhấn Ghép nối bên cạnh nó.

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Không khởi động lại được âm thanh Bluetooth, nên tai nghe có thể dùng chất lượng cơ bản cho đến khi bạn đăng nhập lại. { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Vì sao tai nghe nghe chất lượng cơ bản sau khi tắt rồi bật lại Bluetooth



# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } Thiết bị không còn được nhận ra. Hãy tìm lại.

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } Lần ghép nối đã lưu không còn được chấp nhận. Hãy quên thiết bị rồi ghép nối lại.

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = Thiết bị đã kết nối rồi bị ngắt. Lần ghép nối đã lưu có thể đã cũ.

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = Quên và ghép nối lại

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = Đã quên. Hãy đưa thiết bị vào chế độ ghép nối, rồi nhấn Ghép nối khi nó hiện ở bên dưới.

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = Tìm hiểu thêm

