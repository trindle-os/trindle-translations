
# machine translated (Vietnamese), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = Folders chỉ xoay được ảnh JPEG, PNG, WebP và BMP

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = Folders không đọc được ảnh

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = Folders không thể lưu loại ảnh này

# Why a link to a picture is not turned.
folders-imaging-no-turn-link = đây là liên kết, nên hãy xoay ảnh mà nó trỏ tới

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = Folders không xoay ảnh động, vì chỉ khung hình đầu tiên được giữ lại
