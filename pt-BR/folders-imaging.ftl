
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = O Folders só consegue girar imagens JPEG, PNG, WebP e BMP

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = O Folders não conseguiu ler a imagem

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = O Folders não consegue salvar este tipo de imagem

# Why a link to a picture is not turned.
folders-imaging-no-turn-link = isto é um atalho, então gire a imagem para a qual ele aponta

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = O Folders não gira imagens animadas, porque só o primeiro quadro seria mantido
