
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = só imagens JPEG, PNG, WebP e BMP podem ser giradas

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = não foi possível ler a imagem

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = não é um tipo de imagem que as Pastas gravam


# Why a link to a picture is not turned.
folders-imaging-no-turn-link = um atalho não é girado; gire a imagem para a qual ele aponta

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = uma imagem animada não é girada, pois só o primeiro quadro seria mantido

