
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Nada aqui difere do outro painel em nome, tamanho ou data. As subpastas são comparadas só pelo nome.
        [one] 1 item aqui está faltando no outro painel ou difere em tamanho ou data. As subpastas são comparadas só pelo nome.
       *[other] { $n } itens aqui estão faltando no outro painel ou diferem em tamanho ou data. As subpastas são comparadas só pelo nome.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Isto precisa dos dois painéis. Pressione F3 para mostrá-los.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Os resultados da pesquisa não podem ser mostrados no outro painel.

