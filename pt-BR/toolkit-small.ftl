# machine translated (Brazilian Portuguese), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Remover { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $value } de { $max } estrelas

# The names of the three boxes of a duration entry.
kit-duration-hours = Horas

kit-duration-minutes = Minutos

kit-duration-seconds = Segundos

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Passo { $n } de { $count }

kit-step-back = Voltar

kit-step-next = Avançar

kit-step-finish = Concluir

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Localizar

kit-find-previous = Resultado anterior

kit-find-next = Próximo resultado

kit-find-none = Nenhum resultado

kit-find-count = { $at } de { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Mais uma pessoa
        [many] Mais { $n } pessoas
       *[other] Mais { $n } pessoas
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Gradiente com { $n } pontos

kit-gradient-place = Posição do ponto escolhido

kit-gradient-add = Adicionar um ponto

kit-gradient-remove = Remover o ponto

# The "i" button that shows and hides a card's help.
kit-help-show = Mostrar a ajuda

kit-help-hide = Ocultar a ajuda

