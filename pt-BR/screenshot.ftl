# Red line after some items could not be moved.
screenshot-chooser-not-moved =
    { $n ->
        [one] Um item não pôde ser movido: { $names }.
        [many] { $n } itens não puderam ser movidos: { $names }.
       *[other] { $n } itens não puderam ser movidos: { $names }.
    }

