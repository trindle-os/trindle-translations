# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] { $used } de { $all } imagem
        [many] { $used } de { $all } de imagens
       *[other] { $used } de { $all } imagens
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = { $folder } não tem imagens

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] { $used } de { $all } imagem que acompanha o Trindle
        [many] { $used } de { $all } de imagens que acompanham o Trindle
       *[other] { $used } de { $all } imagens que acompanham o Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] { $used } de { $all } imagem de { $folder }
        [many] { $used } de { $all } de imagens de { $folder }
       *[other] { $used } de { $all } imagens de { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, uma das imagens que acompanham o Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Uma cor lisa, definida abaixo.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Não há mais nada ali. Escolha uma imagem ou uma pasta.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Uma cor lisa, sem imagem.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Uma imagem nova a cada { $every }, usando { $used } da { $all } imagem que acompanha o Trindle.{ $extra }
        [many] Uma imagem nova a cada { $every }, usando { $used } das { $all } de imagens que acompanham o Trindle.{ $extra }
       *[other] Uma imagem nova a cada { $every }, usando { $used } das { $all } imagens que acompanham o Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Uma imagem nova a cada { $every }, usando { $used } da { $all } imagem em { $folder }.{ $extra }
        [many] Uma imagem nova a cada { $every }, usando { $used } das { $all } de imagens em { $folder }.{ $extra }
       *[other] Uma imagem nova a cada { $every }, usando { $used } das { $all } imagens em { $folder }.{ $extra }
    }

