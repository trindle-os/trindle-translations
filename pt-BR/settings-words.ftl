
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Suas próprias palavras

# Under the heading.
settings-words-about = Mude qualquer palavra que o Trindle mostra, em qualquer idioma, e compartilhe a planilha como arquivo.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Uma planilha alterada em qualquer lugar além da última coluna, ou que não seja da própria Trindle, é rejeitada por inteiro.

# The line that picks which language the boxes are for.
settings-words-language = Idioma

# Under the language line.
settings-words-language-sub = A planilha é para este idioma.

# The name of the language list for the screen reader.
settings-words-language-tip = Idioma da planilha

# The line that exports the sheet, and its button's tip.
settings-words-export = Baixar a planilha

# Under the export line.
settings-words-export-sub = Inglês à esquerda, seu idioma ao lado. Altere o lado direito.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Salvar a planilha de palavras

# The line that imports a sheet, and its button's tip.
settings-words-import = Enviar a planilha

# Under the import line.
settings-words-import-sub = Verificada por inteiro antes. Qualquer diferença não instala nada.

# Title of the window that asks which sheet to open.
settings-words-import-title = Abrir uma planilha de palavras

# Under the import button when a sheet was installed.
settings-words-imported = Instalada

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Não foi possível salvar

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Rejeitada: o arquivo é grande demais

# Under the import button: the file is not text.
settings-words-not-text = Rejeitada: não é texto simples

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Rejeitada: caracteres ocultos ou de controle

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Rejeitada: uma linha é longa demais

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Rejeitada: não é uma planilha de palavras do Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Rejeitada: é outra versão da planilha

# Under the import button: the language tag is not usable.
settings-words-bad-language = Rejeitada: o idioma não é válido

# Under the import button: the notes at the top were changed.
settings-words-notes = Rejeitada: o início da planilha foi alterado

# Under the import button: lines are missing or extra.
settings-words-count = Rejeitada: faltam linhas ou há linhas a mais

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Rejeitada: a chave em { $key } foi alterada

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Rejeitada: o inglês de { $key } foi alterado

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Rejeitada: a linha de { $key } não está na forma certa

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Rejeitada: as palavras de { $key } são longas demais

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Rejeitada: as palavras de { $key } têm caracteres ocultos

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Rejeitada: as palavras de { $key } têm marcação, um link ou um caminho

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Rejeitada: os marcadores de { $key } são diferentes

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Rejeitada: não foi possível ler o arquivo

# Under the rule on the card: when changed words appear.
settings-words-next-start = Suas palavras aparecem na próxima vez que um programa iniciar.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Rejeitada: o valor de verificação não confere

settings-words-reset = Voltar às palavras da Trindle

settings-words-reset-sub = Devolve este idioma ao original. Suas palavras ficam guardadas num arquivo de backup.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Oferecer sua planilha

# Under the offer button: who can send and why.
settings-words-offer-sub = Abre uma página onde você entra no Buildmorphic e a envia. A Trindle nunca a envia por você.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Criar um idioma seu

# Under the start line.
settings-words-start-sub = Dê um nome, real ou inventado. Ele começa como inglês e aparece como seu.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Nome do seu idioma

# Beside the start line when the language was made.
settings-words-started = Criado

# Under the start line: the name is empty or too long.
settings-words-name-length = Use de 1 a 30 letras

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Só letras: sem marcação, caminhos ou caracteres ocultos

# Under the start line: another language of your own has this name.
settings-words-name-taken = Você já tem um idioma com esse nome

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (seu)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Remove este idioma seu. As palavras dele ficam guardadas numa pasta de backup.

