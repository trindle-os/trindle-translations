
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Name of the Settings page about default apps, in the list and as its heading.
settings-default-apps-title = Aplicativos padrão

# Words a person might type into the Settings search to find the default apps page; separate them with spaces.
settings-default-apps-keywords = navegador correio e-mail email arquivos imagens fotos música vídeo pdf calendário abrir com terminal

# Introduction under the heading of the default apps page, and the words behind the page i.
settings-default-apps-help = Qual programa abre links da web, e-mails, imagens, o calendário e o resto. O terminal é escolhido em ~/.config/xdg-terminals.list; se nenhum for escolhido, o Trindle usa o primeiro instalado.

