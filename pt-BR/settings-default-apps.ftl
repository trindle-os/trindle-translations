settings-default-apps-kind-calendar-in-sentence = o calendário

# Title of a card on the default apps page.
settings-default-apps-card-internet = Internet

# Words behind the i of a card on the default apps page.
settings-default-apps-card-internet-about = O programa que abre um link da web clicado em qualquer lugar, o que escreve um e-mail quando um endereço é clicado e o que abre um convite de calendário.

# Title of a card on the default apps page.
settings-default-apps-card-files = Arquivos e documentos

# Words behind the i of a card on the default apps page.
settings-default-apps-card-files-about = O programa que abre uma pasta, um arquivo de texto simples e um documento PDF quando você abre um deles em Pastas, na área de trabalho ou em outro aplicativo.

# Title of a card on the default apps page.
settings-default-apps-card-media = Imagens e som

# Words behind the i of a card on the default apps page.
settings-default-apps-card-media-about = O programa que abre uma imagem, uma música ou um vídeo quando você abre um deles.

# Sentence at the top of the page when every kind has a program; { $web } is the program that opens web links.
settings-default-apps-all-set-web = Tudo tem um programa para abrir; { $web } abre links da web.

# Sentence at the top of the page when every kind has a program and the one for web links is not known.
settings-default-apps-all-set = Tudo tem um programa para abrir.

# Sentence at the top of the page when one kind has no program chosen; { $kind } is its name in lower case.
settings-default-apps-one-missing = Ainda não há programa escolhido para abrir { $kind }.

# Sentence at the top of the page when several kinds have no program chosen; { $kinds } is their names as a list joined with "or".
settings-default-apps-many-missing = Ainda não há programa escolhido para abrir { $kinds }.

# Small words under a kind that no installed program can open.
settings-default-apps-none-installed = Nada do que está instalado consegue abrir isso ainda.

# First choice in a list when no program is chosen for that kind yet.
settings-default-apps-not-chosen = Ainda não escolhido

# Small words under a kind with a program list; { $n } is how many programs can open it.
settings-default-apps-can-open =
    { $n ->
        [one] O único programa que consegue.
        [many] { $n } programas conseguem abrir isso.
       *[other] { $n } programas conseguem abrir isso.
    }

# Said in green under a kind's list after the choice was kept.
settings-default-apps-saved = Salvo
