# Headline of an updates page while something not named is installing updates.
common-updating-sentence-unknown = As atualizações estão sendo instaladas em outro lugar.

# Beside an app in a list of updates, when what waits is a newer build of the version already installed. { $version } is the version.
common-updating-newer-build-of = uma versão mais nova da versão { $version }

# Beside an app in a list of updates: the installed version, then the version that waits.
common-updating-version-to = versão { $from } para { $to }

# Beside an app in a list of updates, when only the installed version is known. { $version } is that version.
common-updating-now-version = agora na versão { $version }

# Beside an app in a list of updates, when only the new version is known. { $version } is that version.
common-updating-to-version = para a versão { $version }

# Beside a thing whose own version is shown, when what waits is a newer build of the same version.
common-updating-newer-waiting = uma versão mais nova está esperando

# Beside a thing whose own version is shown: the version that waits.
common-updating-version-waiting = a versão { $version } está esperando

# Beside a thing whose own version is shown, when the new version is not known.
common-updating-update-waiting = uma atualização está esperando

# Said in the password box when Debian's and Trindle's updates are put in together.
# SAFETY: needs a human review before it ships
common-updating-reason-all = As atualizações do Debian e do Trindle mudam o computador inteiro, para todos que o usam, por isso pedem a senha de um administrador. Os aplicativos que você instalou por conta própria são atualizados sem ela.

# Said in the password box when only Debian's updates are put in.
# SAFETY: needs a human review before it ships
common-updating-reason-debian = As atualizações do Debian mudam o computador inteiro, para todos que o usam, por isso pedem a senha de um administrador.

# Said in the password box when only Trindle's own update is put in.
# SAFETY: needs a human review before it ships
common-updating-reason-trindle = A atualização do Trindle muda o computador inteiro, para todos que o usam, por isso pede a senha de um administrador.

# Said in the password box when new firmware is put in.
# SAFETY: needs a human review before it ships
common-updating-reason-firmware = O novo firmware muda o próprio computador, por isso pede a senha de um administrador.

# Said in the password box when the lists of the whole computer's updates are fetched away from the computer's own screen.
# SAFETY: needs a human review before it ships
common-updating-reason-refresh = Procurar as atualizações do computador inteiro pede a senha de um administrador quando não é pedido na tela do próprio computador.

# The end of a sentence saying why nothing was installed. { $why } is the reason, such as "no administrator's password was given".
common-updating-because = porque { $why }.

# Red words beside an update that did not finish and gave no reason.
common-updating-no-reason = Não terminou e não deu nenhum motivo.

# Red words beside an update that did not finish. { $why } is the reason the system gave.
common-updating-failed = Não terminou. { $why }

# Red words beside an update that was never started. { $why } is the end of a sentence such as "because no administrator's password was given."
common-updating-not-installed = Não instalado, { $why }

# End of a sentence saying why a step was refused: the password box was closed. It follows "because".
# SAFETY: needs a human review before it ships
common-refused-why-cancelled = a senha de administrador não foi informada

# End of a sentence saying why a step was refused: the password was asked for and not accepted. It follows "because".
# SAFETY: needs a human review before it ships
common-refused-why-wrong = a senha de administrador não foi aceita

# End of a sentence saying why a step was refused: this login may never do it. It follows "because".
# SAFETY: needs a human review before it ships
common-refused-why-not-allowed = este login não tem permissão para fazer isso, qualquer que seja a senha

# End of a sentence saying why a step was refused: nothing was there to ask for the password. It follows "because".
# SAFETY: needs a human review before it ships
common-refused-why-unasked = não havia nada para pedir a senha de administrador

# End of a sentence saying why a step was refused: it is not known which of the two reasons it was. It follows "because".
# SAFETY: needs a human review before it ships
common-refused-why-unclear = a senha de administrador não foi aceita, ou este login não tem permissão para fazer isso

# Sentence of its own saying a step was refused: the password box was closed.
# SAFETY: needs a human review before it ships
common-refused-sentence-cancelled = A senha de administrador não foi informada

# Sentence of its own saying a step was refused: the password was not accepted.
# SAFETY: needs a human review before it ships
common-refused-sentence-wrong = A senha de administrador não foi aceita

# Sentence of its own saying a step was refused: this login may never do it.
# SAFETY: needs a human review before it ships
common-refused-sentence-not-allowed = Este login não tem permissão para fazer isso, qualquer que seja a senha

# Sentence of its own saying a step was refused: nothing was there to ask for the password.
# SAFETY: needs a human review before it ships
common-refused-sentence-unasked = Não havia nada para pedir a senha de administrador

# Sentence of its own saying a step was refused: it is not known which of the two reasons it was.
# SAFETY: needs a human review before it ships
common-refused-sentence-unclear = A senha de administrador não foi aceita, ou este login não tem permissão para fazer isso

# Red words when a step was refused because the password box was closed.
# SAFETY: needs a human review before it ships
common-refused-not-done-cancelled = Não feito: a senha de administrador não foi informada.

# Red words when a step was refused because the password was not accepted.
# SAFETY: needs a human review before it ships
common-refused-not-done-wrong = Não feito: a senha de administrador não foi aceita.

# Red words when a step was refused because this login may never do it; the last sentence says what may help.
# SAFETY: needs a human review before it ships
common-refused-not-done-not-allowed = Não feito: este login não tem permissão para fazer isso, qualquer que seja a senha. Saia da sessão, entre de novo e tente outra vez.

# Red words when a step was refused because nothing was there to ask for the password; the last sentence says what may help.
# SAFETY: needs a human review before it ships
common-refused-not-done-unasked = Não feito: não havia nada para pedir a senha de administrador. Saia da sessão, entre de novo e tente outra vez.

# Red words when a step was refused and it is not known why; the last sentence says what may help.
# SAFETY: needs a human review before it ships
common-refused-not-done-unclear = Não feito: a senha de administrador não foi aceita, ou este login não tem permissão para fazer isso. Se nada a pediu, saia da sessão, entre de novo e tente outra vez.

# Red words when a step behind the administrator's password failed and said nothing of why.
common-refused-no-reason = Não feito: a etapa falhou e não disse por quê.

# Red words when the keyring will not open without the person's password.
# SAFETY: needs a human review before it ships
common-keyring-locked = O chaveiro está bloqueado. Saia da sessão e entre de novo, ou desbloqueie-o, e tente outra vez.

# Red words when this computer has no keyring to keep a login or key in.
common-keyring-missing = Não há chaveiro neste computador para guardá-lo.

# Red words when the keyring is there and gives no answer in time.
common-keyring-silent = O chaveiro não respondeu a tempo.

# Red words when work with the keyring never ended, long after its deadline.
common-keyring-never = O chaveiro nunca respondeu.

# Red words when the turn with the keyring could not be taken. { $why } is the system's reason.
common-keyring-turn-failed = Não foi possível a vez com o chaveiro ({ $why }), então nada foi pedido a ele.

# Line shown while the keyring has not answered whether it kept or removed a login or key. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-waiting =
    { $action ->
        [removing] O chaveiro ainda não respondeu, então o(a) { $what } ainda não foi removido(a). Se o chaveiro o(a) remover depois, esta linha avisará.
       *[other] O chaveiro ainda não respondeu, então o(a) { $what } ainda não foi guardado(a). Se o chaveiro o(a) guardar depois, esta linha avisará.
    }

# Line shown when the keyring answered late and did what was asked. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-done =
    { $action ->
        [removing] O chaveiro respondeu tarde: o(a) { $what } foi removido(a).
       *[other] O chaveiro respondeu tarde: o(a) { $what } foi guardado(a).
    }

# Red words when the keyring never answered. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-never =
    { $action ->
        [removing] O chaveiro nunca respondeu, então o(a) { $what } não foi removido(a).
       *[other] O chaveiro nunca respondeu, então o(a) { $what } não foi guardado(a).
    }

# Red words when the keyring answered late and would not do it. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping"; { $why } is the reason, as a sentence.
common-keyring-late-refused =
    { $action ->
        [removing] O chaveiro respondeu tarde e não removeu o(a) { $what }: { $why }
       *[other] O chaveiro respondeu tarde e não guardou o(a) { $what }: { $why }
    }

