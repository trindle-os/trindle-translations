# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Não foi possível ligar o Bluetooth.

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Não foi possível desligar o Bluetooth.

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } O Bluetooth não está ligado.

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } O PIN ou o número não foi aceito. Tente de novo.

# Said in red when the pairing was turned down; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-turned-down = { $could_not } Foi recusado, aqui ou no outro dispositivo.

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } O outro dispositivo não respondeu a tempo. Coloque-o em modo de pareamento e tente de novo.

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Isso já está sendo feito. Espere um momento.

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } O dispositivo não respondeu. Veja se está ligado e por perto, e tente de novo.

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } O dispositivo não está pronto para uso. Coloque-o em modo de pareamento e tente de novo.

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = O barramento do sistema

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Procurando o Bluetooth…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = O Bluetooth não está em execução neste computador.

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = O Bluetooth está desligado.

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = O Bluetooth está desligado no próprio computador.

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = Este computador não tem Bluetooth.

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = Ligado, procurando dispositivos por perto…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = Ligado, sem nada conectado agora.

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] Ligado, e { $names } está conectado.
        [many] Ligado, e { $names } estão conectados.
       *[other] Ligado, e { $names } estão conectados.
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = A chave liga ou desliga o Bluetooth deste computador; abaixo dela fica o nome do adaptador. Enquanto Visível para outros dispositivos estiver ligado, dispositivos por perto podem encontrar este computador.

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = Desligado.

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
settings-bluetooth-visible = Visível para outros dispositivos

# Small line under the Visible to other devices switch.
settings-bluetooth-visible-sub = Dispositivos por perto podem encontrar este computador.

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = Desligado no próprio computador

# Small line under it.
settings-bluetooth-hard-line-sub = Por uma chave ou tecla. Ligue-a primeiro.

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Nenhum adaptador Bluetooth

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = Nenhum adaptador Bluetooth foi encontrado neste computador. Um que se conecta a uma porta USB aparece aqui assim que for conectado.

# Line in that card.
settings-bluetooth-none-found = Nenhum foi encontrado

# Small line under it.
settings-bluetooth-none-found-sub = Um adaptador USB aparece aqui depois de conectado.

# Shown beside the Bluetooth switch while the password is asked for.
settings-bluetooth-waiting = Aguardando a senha...

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = Não foi possível tornar este computador visível para outros dispositivos.

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = Não foi possível ocultar este computador de outros dispositivos.

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = Ligue o Bluetooth para usá-los.

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = Nenhum pareado ainda

# Small line under it.
settings-bluetooth-none-paired-sub = Procure dispositivos para parear um.

# Heading of the card that lists paired devices.
settings-bluetooth-mine = Meus dispositivos

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = Dispositivos pareados com este computador, cada um com a bateria quando ela é informada. Os conectados quando a página abre vêm primeiro, e uma linha fica onde está enquanto a página estiver aberta. Os botões redondos conectam ou desconectam um; a lixeira o esquece, e ele precisa ser pareado de novo.

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = Procurando dispositivos...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = Parar de procurar

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = Procurar dispositivos

# Small line under it.
settings-bluetooth-look-sub = Coloque o outro em modo de pareamento primeiro.

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = Por perto

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = Pressione Procurar dispositivos, coloque o outro dispositivo em modo de pareamento e pressione Parear ao lado dele. Os dispositivos por perto são listados do sinal mais forte para o mais fraco quando a página abre, e cada novo encontrado é adicionado no fim. Alguns mostram um número para conferir com o daqui, e alguns pedem um PIN, que costuma estar nas instruções deles, ou 0000.

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Não foi possível parar a procura por dispositivos.

# Said in red when the search could not be started.
settings-bluetooth-start-failed = Não foi possível procurar dispositivos.

# Small line of a device that is connected.
settings-bluetooth-connected = Conectado

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = Não conectado

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = bateria { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
settings-bluetooth-pair = Parear

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = Desconectar

# Tip of the button that connects a device.
settings-bluetooth-connect = Conectar

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = Esquecer este dispositivo

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = Não foi possível desconectá-lo.

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = Não foi possível esquecê-lo.

# Shown under a device while it is being paired.
settings-bluetooth-pairing = Pareando...

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = Não foi possível pareá-lo.

# Shown under a device while it is being connected.
settings-bluetooth-connecting = Conectando...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = Não foi possível conectá-lo.

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = Conectado, mas não foi possível configurá-lo para conectar sozinho da próxima vez. Conecte-o aqui quando quiser usá-lo.

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = Digite { $code } no dispositivo e pressione Enter nele.

# Question under a device that shows a number to compare with the one on this computer.
# SAFETY: needs a human review before it ships
settings-bluetooth-compare = O outro dispositivo mostra { $code }?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = Não

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = Sim, é igual

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = Parear com este dispositivo?

# Placeholder of the box where a device's PIN is typed.
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = Cancelar

# Help line above the box where a device's PIN is typed.
settings-bluetooth-pin-help = Digite o PIN deste dispositivo. Ele costuma estar nas instruções, ou 0000.

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = fones de ouvido headphones mouse teclado parear dispositivos sem fio

# Help text at the top of the page.
settings-bluetooth-help = Pressione Pesquisar, coloque o outro dispositivo em modo de pareamento e pressione Parear ao lado dele.

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Não foi possível reiniciar o som Bluetooth, então os fones podem usar qualidade básica até você entrar de novo. { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Por que os fones soam básicos depois que o Bluetooth é desligado e ligado


# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } Ele não é mais conhecido. Procure-o de novo.

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } O pareamento salvo não é mais aceito. Esqueça o dispositivo e pareie de novo.

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = Ele conectou e depois caiu. O pareamento salvo pode estar desatualizado.

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = Esquecer e parear de novo

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = Esquecido. Coloque-o em modo de pareamento e pressione Parear quando ele aparecer abaixo.

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = Mais sobre isto

