
# machine translated (Brazilian Portuguese), not yet reviewed by a person.

# Name of the top of the filesystem, "/", in the path bar, the sidebar and the Storage page: the disk the system is on.
folders-places-root-name = Disco do sistema

# Name of the page of every drive, shown in the sidebar row, the tab, the path bar, tips and Help.
folders-places-page-name = Armazenamento

# Name of the home folder on a tab.
folders-places-home = Início

# Name of the list of recently used files on a tab.
folders-places-recent = Recentes

# Name of the Trash on a tab.
folders-places-trash = Lixeira

# Name of the page of network places on a tab.
folders-places-network = Rede

# Name on a tab of a search that has no words typed, only the choices beside the box.
folders-places-found = Encontrados

# Name on a tab of a search for the words typed, which are in quotes.
folders-places-found-text = “{ $text }”

# Name on a tab of a search for the words typed inside files, which are in quotes.
folders-places-found-inside = “{ $text }” dentro dos arquivos

# Red words when a folder cannot be opened because the person is not allowed to.
# SAFETY: needs a human review before it ships
folders-places-unread-denied = Você não tem permissão para abrir esta pasta.

# Red words when a folder cannot be opened because it is gone.
folders-places-unread-gone = Esta pasta não está mais lá.

# Red words when a folder cannot be read for any other reason.
folders-places-unread-other = Não foi possível ler esta pasta.

