# machine translated (Brazilian Portuguese), not yet reviewed by a person.



# The page's name in the side bar.
settings-pads-title = Controles de jogos

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = Aperte um botão do controle para mudá-lo.

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = Agora aperte a tecla para { $name }.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = Nenhum conectado

# Small words under that line.
settings-pads-none-about = Conecte um e os botões dele aparecem aqui.

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = Qual controle

# What the picture is, for the screen reader.
settings-pads-picture = Imagem de { $title }, com cada botão aceso quando apertado

# Title of the card of the controller's buttons.
settings-pads-buttons-title = Botões

# Words behind the i of that card.
settings-pads-buttons-about = Todos os botões, gatilhos e direções dos analógicos e do d-pad. O último que você apertou fica no topo. Um botão transformado em tecla digita essa tecla em um jogo sem suporte a controle.

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = Transformar { $name } em uma tecla

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = Parar de mudar { $name }

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = Em que { $name } se transforma

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = Aperte uma tecla ou escolha um botão

# The next choice in that list: the Escape key.
settings-pads-escape = Tecla Escape

# The next choice in that list: nothing at all.
settings-pads-nothing = Nada

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = Direcional { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = Analógico { $stick } { $way }

settings-pads-left = para a esquerda

settings-pads-right = para a direita

settings-pads-up = para cima

settings-pads-down = para baixo

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = esquerdo

settings-pads-stick-right = direito

# Title of the card of the ready-made changes.
settings-pads-quick-title = Mudanças prontas

# Title of the card of changes that are not one button into another.
settings-pads-other-title = Outras mudanças

# Words behind the i of that card.
settings-pads-other-about = Analógicos invertidos, analógicos trocados e zonas mortas. Digite uma assim: Left Stick dead zone = 10%, ou Right Stick Y = inverted.



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = Teclado: { $what }

settings-pads-on-mouse = Mouse: { $what }

settings-pads-on-pad = Controle: { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = Clique esquerdo

settings-pads-right-click = Clique direito

settings-pads-middle-click = Clique do meio



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = Perfis

# Words behind the i of that card.
settings-pads-profiles-about = Um perfil é um conjunto de mudanças. Padrão não muda nada, então um jogo com suporte próprio a controles vê o controle como ele é. Todo jogo da Steam usa Padrão, a menos que você escolha aqui um perfil para ele, e o perfil muda sozinho quando esse jogo começa. Qualquer outro jogo vale para jogos que a Steam não iniciou.

# The one switch that turns every controller change off at once.
settings-pads-changes = Mudanças do controle

settings-pads-changes-sub = Desligado, todo controle fica como é.

# The game whose profile is shown.
settings-pads-game = Jogo

settings-pads-other-game = Qualquer outro jogo

settings-pads-game-running = { $name } (em execução)

settings-pads-game-number = Jogo da Steam { $n }

# The profile the shown game uses.
settings-pads-profile = Perfil

settings-pads-standard = Padrão

settings-pads-standard-sub = Sem mudanças.

settings-pads-profile-add = Adicionar um perfil

settings-pads-profile-remove = Remover { $name }

settings-pads-profile-name = Nome do perfil

# The name a new profile is given.
settings-pads-profile-new = Perfil { $n }

settings-pads-profile-empty = Um perfil precisa de um nome.

settings-pads-profile-standard = Padrão já está em uso.

settings-pads-profile-taken = Esse nome já está em uso.

settings-pads-profile-gone = Esse perfil não existe mais.

settings-pads-not-a-game = Não é um número de aplicativo da Steam.

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = Padrão não muda nada. Adicione um perfil primeiro.

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = Padrão: o controle como ele é.

settings-pads-top-off = As mudanças do controle estão desligadas.

