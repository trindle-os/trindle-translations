# Words people might search for the Help topic "Themes: a whole look from one file" by, in lower case, separated by spaces.
settings-help-topics-theme-files-keywords = تھیم ظاہری شکل فائل شامل شیئر بنائیں اپنا شیشہ گہرا ہلکا واپس جائیں تیس سیکنڈ محفوظ ڈیفالٹ آزمائش theme themes look skin file css add share make own glass dark light keep go back undo thirty seconds footer safe default trial

# Help topic "Themes: a whole look from one file": paragraph 1.
settings-help-topics-theme-files-p1 = تھیم ایک مکمل شکل ہے، رنگ، کونے، سائز اور جگہ، جو ایک فائل میں رکھی جاتی ہے۔ سیٹنگز، ظاہری شکل، تھیم ہر تھیم کو اس کے اپنے رنگوں سے بنی چھوٹی تصویر کی صورت میں دکھاتی ہے۔ Trindle کی اپنی شکل، گہری نیلی رات، ہمیشہ فہرست میں پہلی ہوتی ہے اور کبھی ہٹائی نہیں جا سکتی۔ Midnight، جو Trindle کے ساتھ آتی ہے، سیاہ اور سرمئی ہے جس میں نیلا نہیں، جیسے Trindle کی اپنی شکل پہلے ہوا کرتی تھی۔

# Help topic "Themes: a whole look from one file": step 1 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-1 = آزمانے کے لیے ایک تھیم دبائیں۔ Trindle کی ہر ونڈو ایک دم بدل جاتی ہے۔ جس تھیم میں گہری اور ہلکی دونوں شکلیں ہوں اس کی تصویر کے ساتھ Dark اور Light ہوتے ہیں: اس کے بجائے ان میں سے ایک دبائیں تاکہ تھیم اس شکل میں آزمائی جائے۔ جو تھیم آپ پہلے سے استعمال کر رہے ہوں اس پر یہ شکل فوراً بدل دیتے ہیں، رکھنے کو کچھ نہیں ہوتا۔

# Help topic "Themes: a whole look from one file": step 2 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-2 = رکھیں کا سوال ونڈو کے نیچے ایک خانے میں پوچھا جاتا ہے، جو صفحے میں آپ کہیں بھی ہوں نظر میں رہتا ہے۔ رکھنے کے لیے 30 سیکنڈ کے اندر Keep دبائیں۔ اگر آپ کچھ نہ کریں، یا Go back now یا Escape دبائیں، تو پہلے والی شکل خود واپس آ جاتی ہے، ہر جگہ، چاہے سیٹنگز بند ہو چکی ہو۔

# Help topic "Themes: a whole look from one file": step 3 of the numbered steps at block 2.
settings-help-topics-theme-files-step2-3 = کسی کی شیئر کی ہوئی تھیم شامل کرنے کے لیے تھیم شامل کریں دبائیں اور اس کی .css فائل چنیں۔ پہلے اس کی جانچ ہوتی ہے، اور جو قابل استعمال تھیم نہ ہو اسے سطر اور وجہ کے ساتھ مسترد کر دیا جاتا ہے۔

# Help topic "Themes: a whole look from one file": paragraph 3.
settings-help-topics-theme-files-p3 = تھیم فائل Trindle کی اپنی شیٹ کی طرح لکھی جاتی ہے (اسٹائل شیٹ سے شکل بدلنا دیکھیں): ایک :root { "{" } { "}" } بلاک جس میں انہی ناموں میں سے کوئی بھی ہو، جیسے --trindle-page: #101820;۔ اس کے اوپر یہ بتا سکتی ہے کہ یہ کون ہے، --trindle-theme-name، --trindle-theme-about (ایک سطر)، --trindle-theme-author اور --trindle-theme-version کے ساتھ، اور اس کی کون سی شکلیں ہیں --trindle-theme-look: dark; light; یا both; کے ساتھ۔ جو کچھ یہ چھوڑ دے وہ ویسا ہی رہتا ہے جیسا Trindle میں ہے۔ آپ کی شامل کی ہوئی تھیمز آپ کے .config فولڈر کے اندر trindle فولڈر کے themes فولڈر میں رکھی جاتی ہیں، اور وہاں سے ایک ہٹانے سے وہ فہرست سے ہٹ جاتی ہے۔

# Help topic "Themes: a whole look from one file": paragraph 4.
settings-help-topics-theme-files-p4 = دونوں شکلوں والی تھیم انہیں ایک ہی فائل میں رکھتی ہے۔ اس کی گہری قدریں معمول کے مطابق :root { "{" } { "}" } میں جاتی ہیں، اور ہلکی قدریں دوسرے بلاک میں، @media (prefers-color-scheme: light) { "{" } :root { "{" } { "}" } { "}" }، بالکل جیسے Trindle کی اپنی شیٹ کرتی ہے۔ ہلکے بلاک میں ہر وہ رنگ اور سایہ دیں جو گہری شکل مقرر کرتی ہے، ورنہ گہری قدریں ہلکی شکل میں جھلکیں گی۔ پھر سیٹنگز تھیم کی تصویر کے ساتھ Dark اور Light دکھاتی ہے۔ جو تھیم dark یا light کہے اس کی صرف وہی ایک شکل ہوتی ہے، وہ ہمیشہ اسی میں بنتی ہے، اور اس میں ایسے بٹن نہیں ہوتے؛ جو نہ کہے اس کے بارے میں مانا جاتا ہے کہ ہلکا بلاک ہو تو دونوں شکلیں ہیں اور نہ ہو تو گہری ہے۔ دوسرے پروگراموں کو وہ شکل بتائی جاتی ہے جس میں آپ کی تھیم واقعی بنتی ہے، اس لیے ہلکی تھیم انہیں ہلکا کر دیتی ہے۔

# Help topic "Themes: a whole look from one file": paragraph 5.
settings-help-topics-theme-files-p5 = تھیم آزمانا محفوظ ہے، چاہے کسی نے بھی بنائی ہو۔ اسے صرف قدروں کی فہرست کے طور پر پڑھا جاتا ہے، کبھی چلایا نہیں جاتا، اور وہ کوئی دوسری فائل نہیں لا سکتی یا انٹرنیٹ تک نہیں پہنچ سکتی۔ صرف وہ قدریں لی جاتی ہیں جو Trindle جانتا ہے، ہر ایک اپنی حدوں کے اندر، اس لیے کوئی تھیم بٹن، سوال یا وارننگ نہیں چھپا سکتی، اور نہ متن کو اتنا چھوٹا کر سکتی ہے کہ پڑھا نہ جائے۔ الفاظ اتنے واضح رکھے جاتے ہیں کہ تھیم کوئی بھی رنگ دے پڑھے جا سکیں، سرخ سرخ رہتا ہے، اور آپ کا نمایاں رنگ آپ ہی کا رہتا ہے۔ تھیم صرف آپ کی اپنی ونڈوز کو بدلتی ہے: لاگ ان اسکرین ہمیشہ Trindle کی اپنی شکل پہنتی ہے۔

# Help topic "Themes: a whole look from one file": tip 6, shown in a box of its own.
settings-help-topics-theme-files-tip6 = اگر کوئی شکل کبھی بگڑ جائے اور آپ واپسی کا راستہ نہ پائیں تو ٹرمینل کھولیں، یا Ctrl، Alt اور F3 سے ٹیکسٹ کنسول، اور لکھیں: trindle-settings --theme default

# Title of the Help topic "Changing the look with a style sheet".
settings-help-topics-theming-title = اسٹائل شیٹ سے شکل بدلنا

# Words people might search for the Help topic "Changing the look with a style sheet" by, in lower case, separated by spaces.
settings-help-topics-theming-keywords = تھیم اسٹائل شیٹ رنگ سائے کونے گول بڑا متن سائز بٹن پس منظر صفحہ اسٹور اپنی مرضی کا theme theming style sheet stylesheet css colours colors shadows corners rounder bigger text size buttons background page store look custom own retheme

# Help topic "Changing the look with a style sheet": paragraph 1.
settings-help-topics-theming-p1 = Trindle جو کچھ بناتا ہے، اس کے رنگ، سائے، کونے، چیزوں کے درمیان جگہ، بٹنوں کا سائز اور الفاظ کا سائز اور موٹائی، سب ایک اسٹائل شیٹ سے آتا ہے، جو ویب صفحات کی طرح لکھی جاتی ہے۔ آپ، یا آپ کا کہا ہوا کوئی AI، اپنی شیٹ سے اس میں سے کچھ بھی بدل سکتا ہے۔

# Help topic "Changing the look with a style sheet": step 1 of the numbered steps at block 2.
settings-help-topics-theming-step2-1 = اپنے .config فولڈر کے اندر trindle فولڈر میں style.css نام کی فائل بنائیں (چھپی فائلیں دکھائی جائیں تو Folders اسے دکھاتا ہے)۔

# Help topic "Changing the look with a style sheet": step 2 of the numbered steps at block 2.
settings-help-topics-theming-step2-2 = صرف وہی ڈالیں جو بدلنا چاہتے ہیں، :root { "{" } { "}" } کے اندر۔ مثلاً --trindle-page: #101010; ہر ونڈو کو تقریباً سیاہ صفحہ دیتا ہے، --trindle-highlight: #4bae4f; بٹنوں کو سبز کرتا ہے، اور --trindle-card-corner: 16; کارڈز کو زیادہ گول کرتا ہے۔

# Help topic "Changing the look with a style sheet": step 3 of the numbered steps at block 2.
settings-help-topics-theming-step2-3 = اسے محفوظ کریں۔ Trindle کی ہر ونڈو، رنگ اور ٹائٹل بار فوراً بدل جاتے ہیں۔

# Help topic "Changing the look with a style sheet": paragraph 3.
settings-help-topics-theming-p3 = ہر نام جو آپ استعمال کر سکتے ہیں Trindle کی اپنی شیٹ، /usr/share/trindle/style.css، میں ہے، اس کے ساتھ یہ کہ وہ کیا کرتا ہے اور اس کی حدیں، جیسے (6 سے 18)۔ صرف ہلکی شکل کی تبدیلیاں @media (prefers-color-scheme: light) { "{" } :root { "{" } { "}" } { "}" } بلاک میں جاتی ہیں، جیسے Trindle کی شیٹ میں ہے۔ سائے اس طرح لکھے جاتے ہیں جیسے ویب صفحہ لکھتا ہے، مثلاً 0 8px 20px 2px rgba(0, 0, 0, 0.8)۔ کارڈز شروع میں ہلکا سایہ ڈالتے ہیں؛ --trindle-card-shadow: none; انہیں چپٹا کر دیتا ہے، اور --trindle-edge: transparent; ان کا باریک کنارہ ہٹا دیتا ہے۔

# Help topic "Changing the look with a style sheet": paragraph 4.
settings-help-topics-theming-p4 = آپ جو کچھ لکھیں اس سے کوئی ونڈو نہیں ٹوٹ سکتی۔ Trindle کے نہ جانے ہوئے نام نظرانداز ہوتے ہیں، جو قدر وہ پڑھ نہ سکے اس کی جگہ Trindle کی اپنی قدر لگتی ہے، اور سائز اپنی حدوں میں رکھے جاتے ہیں۔ رنگ آپ کی مرضی ہیں: آپ کا مقرر کردہ رنگ بالکل ویسا ہی رہتا ہے جیسا لکھا، اور Trindle اپنے الفاظ کو ہٹاتا ہے تاکہ وہ آپ کے صفحے، کارڈ یا ٹائٹل بار پر پڑھے جا سکیں۔ صرف ہلکی شکل کے لیے مقرر رنگ صرف ہلکی شکل میں آپ کا ہے۔ شفاف رنگ کو سیاہ اور سفید دونوں پر ناپا جاتا ہے، کیونکہ جو کچھ اس کے پار دکھتا ہے وہ معلوم نہیں ہوتا؛ جہاں آپ کے رنگ ان سب پر پڑھنے کے قابل کچھ نہ چھوڑیں، وہاں Trindle کے الفاظ جہاں تک ہو سکے جاتے ہیں، سیاہ یا سفید تک۔ تین چیزیں شیٹ کچھ بھی کہے پڑھنے کے قابل رہتی ہیں: ناکامی بتانے والے سرخ الفاظ، آپ کے نمایاں رنگ پر الفاظ، اور پاس ورڈ مانگنے والے خانے، جو ہمیشہ Trindle کی اپنی شکل میں بنتے ہیں۔ جب آپ کے مقرر کردہ رنگ پڑھنے کی حد سے کم پڑیں تو سیٹنگز، ظاہری شکل "Some colours are hard to read." کہتی ہے اور انہیں ویسا ہی چھوڑ دیتی ہے جیسا آپ نے لکھا۔ اگر آپ کے اپنے مقرر کردہ الفاظ پڑھنے میں مشکل ہو جائیں تو فائل مٹا دیں اور Trindle کی اپنی شکل فوراً واپس آ جاتی ہے۔ فائل الفاظ کی عام فائل ہونی چاہیے، زیادہ سے زیادہ 256 KB؛ جو نہ ہو وہ استعمال نہیں ہوتی، اور سیٹنگز، ظاہری شکل یہ بتاتی ہے۔

# Help topic "Changing the look with a style sheet": paragraph 5.
settings-help-topics-theming-p5 = آپ کی اپنی شیٹ چنی ہوئی کسی بھی تھیم کے اوپر لگتی ہے، اس لیے آپ کی چھوٹی سی تبدیلی تھیم بدلنے پر بھی رہتی ہے۔ رکھنے یا شیئر کرنے کے لیے پوری شکل کی خاطر اس کے بجائے تھیم بنائیں؛ تھیمز دیکھیں۔

# Help topic "Changing the look with a style sheet": tip 6, shown in a box of its own.
settings-help-topics-theming-tip6 = آپ کی شیٹ میں --trindle-highlight سے مقرر کردہ رنگ سیٹنگز، ظاہری شکل میں چنے ہوئے نمایاں رنگ پر غالب آتا ہے۔

# Title of the Help topic "Voice control".
settings-help-topics-voice-title = آواز سے کنٹرول

# Words people might search for the Help topic "Voice control" by, in lower case, separated by spaces.
settings-help-topics-voice-keywords = آواز بولیں بات مائیکروفون کمانڈز سنیں کہیں voice speak talk microphone commands whisper listen say

# Help topic "Voice control": paragraph 1.
settings-help-topics-voice-p1 = آواز سے کنٹرول ایک اختیاری اضافہ ہے۔ اسے شامل کرنے کے لیے سیٹنگز کھولیں، رنگ چنیں، اور آواز شامل کریں دبائیں۔ اس میں چند منٹ اور تقریباً 150 MB لگتے ہیں۔

# Help topic "Voice control": paragraph 2.
settings-help-topics-voice-p2 = پھر رنگ کھولیں، جہاں کوئی بٹن نہ ہو وہاں اس کے بیچ میں ٹیپ کریں، اور بولیں۔ جب آپ بولنا بند کرتے ہیں تو یہ خود سننا بند کر دیتا ہے، یا دوبارہ ٹیپ کریں۔ یہ ماؤس کے ساتھ انگلی سے بھی کام کرتا ہے۔ آپ جو کہہ سکتے ہیں:

# Help topic "Voice control": step 1 of the numbered steps at block 3.
settings-help-topics-voice-step3-1 = ایپ کا نام، جیسے “Firefox” یا “folders”۔

# Help topic "Voice control": step 2 of the numbered steps at block 3.
settings-help-topics-voice-step3-2 = کسی ایپ کی طرف “Switch to”، یا “close window”۔

# Help topic "Voice control": step 3 of the numbered steps at block 3.
settings-help-topics-voice-step3-3 = “Louder”، “quieter”، “mute”۔

# Help topic "Voice control": step 4 of the numbered steps at block 3.
settings-help-topics-voice-step3-4 = “Wi-Fi settings”، “battery settings”، یا سیٹنگز کا کوئی اور صفحہ۔

# Help topic "Voice control": step 5 of the numbered steps at block 3.
settings-help-topics-voice-step3-5 = “Install” اور ایپ کا نام، اسے Apps میں ڈھونڈنے کے لیے۔

# Help topic "Voice control": step 6 of the numbered steps at block 3.
settings-help-topics-voice-step3-6 = “Next wallpaper”، “screenshot”، “what time is it”۔

# Help topic "Voice control": tip 4, shown in a box of its own.
settings-help-topics-voice-tip4 = آپ کی آواز اسی کمپیوٹر پر سمجھی جاتی ہے۔ کچھ کہیں نہیں بھیجا جاتا۔ آواز کو ہٹائے بغیر رنگ کے صفحے پر بند کیا جا سکتا ہے۔

# Title of the Help topic "Folders, USB sticks and phones".
settings-help-topics-files-title = فولڈرز، USB اسٹکس اور فونز

# Words people might search for the Help topic "Folders, USB sticks and phones" by, in lower case, separated by spaces.
settings-help-topics-files-keywords = فولڈر فائلیں فائل مینیجر یو ایس بی ڈرائیو فون کیمرہ نیٹ ورک شیئر ڈسک نکالیں فارمیٹ کھولیں کمپریس آرکائیو پاس ورڈ ٹرمنل مقام پیش منظر اسپیس بار نشان سائز گھمائیں تصویر کالم موسیقی فوٹو پی ڈی ایف کیز کی بورڈ شارٹ کٹ ٹیب نئی ونڈو folders files file manager usb stick drive phone camera nas network share sharing samba disks eject format extract unpack zip compress archive rar 7z tar iso disc image password terminal f4 root wallpaper copy path location preview space bar emblem badge resize rotate picture columns music photo pdf keys keyboard shortcuts tab tabs new window

# Help topic "Folders, USB sticks and phones": paragraph 1.
settings-help-topics-files-p1 = Folders فائل مینیجر ہے، رنگ کے گرد ایپس میں سے ایک۔ لگائے ہوئے USB اسٹکس، فون اور کیمرے اس کے بائیں طرف ظاہر ہوتے ہیں، اور آپ کے گھر کے نیٹ ورک پر شیئر کیے ہوئے فولڈر نیٹ ورک کے تحت۔

# Help topic "Folders, USB sticks and phones": paragraph 2.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p2 = Folders ایک پین کے ساتھ کھلتا ہے جو آپ کا ہوم فولڈر دکھاتا ہے، بائیں طرف Downloads اور Documents پن کیے ہوئے۔ اوپر بائیں Single اور Dual سوئچ (یا F3) دوسرا پین شامل کرتا ہے، جو حالیہ دکھاتا ہے جب تک آپ Folders کی اپنی سیٹنگز میں، اس کی اوپر کی پٹی کے آخر میں گیئر کے پیچھے (یا Ctrl اور کومہ)، کوئی اور جگہ نہ چنیں: ہر پین کہاں سے شروع ہو، چننے کے لیے ٹک باکس، فائل کے اختتامیے، اور آیا ڈرائیو لگتے ہی کھلے۔ ہر پین کی فہرست کے اوپر ٹیبز کی اپنی قطار ہے۔ اوپر کی پٹی صرف وہ رکھتی ہے جو فولڈر کی شکل بدلتا ہے، اس کے ساتھ Undo اور New folder؛ جو کچھ آپ کی چنی ہوئی چیز پر عمل کرتا ہے، جیسے Rename، Cut، Copy، Move to Trash، Delete permanently اور Wipe securely، رائٹ کلک مینو میں ہے، اور ہر ایک کی اپنی کلید ہے۔

# Help topic "Folders, USB sticks and phones": paragraph 3.
settings-help-topics-files-p3 = رائٹ کلک مینو میں دوسری ایپ کے ساتھ کھولیں وہ ایپس درج کرتا ہے جو فائل کھول سکتی ہیں: کسی پر ڈبل کلک کریں، یا اس پر Enter دبائیں، تو فائل اسی سے فوراً کھل جاتی ہے۔ ٹک بھی یہی کرتا ہے۔

# Help topic "Folders, USB sticks and phones": paragraph 4.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p4 = جب آپ USB اسٹک یا میموری کارڈ لگاتے ہیں تو رنگ ایک سطر اور کھولیں کے لفظ سے بتاتی ہے۔ کھولیں اس کی فائلیں Folders میں دکھاتا ہے، اگر مقفل ہو تو پہلے پاس فریز مانگتا ہے۔ Folders اسے ڈرائیوز کے تحت درج کرتا ہے چاہے آپ کھولیں دبائیں یا نہیں، ماؤنٹ ہو یا نہ ہو، ایک گول نکالیں بٹن کے ساتھ جو اسے محفوظ طریقے سے ہٹا دیتا ہے۔ Folders کی اپنی سیٹنگز میں، ڈرائیوز کے تحت، "ڈرائیوز لگاتے ہی کھولیں" آپ کے لیے کھولنے کا کام کرتا ہے۔ اسکرین مقفل ہو تو لگائی گئی ڈرائیو آپ کے کھولنے تک انتظار کرتی ہے۔

# Help topic "Folders, USB sticks and phones": paragraph 5.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p5 = مزید کے لیے Folders میں رائٹ کلک کریں: آرکائیوز کے لیے Extract here اور Extract to a folder، .zip یا .tar بنانے کے لیے Compress، Open in Terminal، Open as Root، Copy location، اور تصویر پر Set as wallpaper۔ Folders آرکائیوز خود کھولتا ہے: .zip، .7z، .rar یا .tar، ڈسک امیج (.iso) یا تقریباً کسی بھی دوسری قسم پر ڈبل کلک کریں اور وہ فولڈر کی طرح کھلتی ہے، تاکہ آپ اندر دیکھ سکیں اور صرف مطلوبہ نکالیں۔ پاس ورڈ سے مقفل .zip یا .7z اسے مانگتی ہے؛ Folders پاس ورڈ یاد نہیں رکھتا، اس لیے اگلی بار پھر پوچھتا ہے۔ پاس ورڈ سے مقفل .rar نہیں کھل سکتی، اور Folders آپ کو یہ بتا دیتا ہے۔

# Help topic "Folders, USB sticks and phones": paragraph 6.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p6 = فائل کو کھولے بغیر دیکھنے کے لیے اس پر اسپیس بار دبائیں، اور بند کرنے کے لیے دوبارہ۔ F4 اس فولڈر میں ٹرمینل کھولتا ہے جس میں آپ ہیں۔ فولڈر یا فائل پر رائٹ کلک کر کے رنگ پر پن کریں چنیں تاکہ وہ رنگ کے بیچ کے گرد آپ کی پسندیدہ ایپس کے ساتھ رہے، جہاں ایک کلک اسے کھولتا ہے؛ ان پن کرنے کے لیے وہاں اس پر رائٹ کلک کریں۔ تصاویر کا سائز بدلنے یا گھمانے کے لیے ان پر رائٹ کلک کریں۔ فائل کی خصوصیات اسے ایک چھوٹا نشان دے سکتی ہیں، اور فولڈر کی خصوصیات اسے آپ کے گھر کے نیٹ ورک کے دوسرے کمپیوٹروں کے ساتھ شیئر کر سکتی ہیں: پہلی بار Folders Samba چالو کرتا ہے، جو آپ کا پاس ورڈ مانگتا ہے، اور کمپیوٹر کے ری اسٹارٹ ہونے پر شیئرنگ کام کرتی ہے۔ فہرست کے منظر میں موسیقی، تصویر اور PDF کی تفصیلات شامل کرنے کے لیے کالم کے عنوانات پر رائٹ کلک کریں۔

# Help topic "Folders, USB sticks and phones": paragraph 7.
settings-help-topics-files-p7 = اوپر کے راستے میں ہر نام کے بعد ایک چھوٹا تیر ہے: اسے دبائیں تو اس فولڈر کے اندر کے فولڈروں کی فہرست ملتی ہے، اور وہاں جانے کے لیے ایک چنیں۔ فولڈر پر درمیانی کلک، یا Ctrl اور ڈبل کلک، اسے آپ کے موجودہ ٹیب کے پیچھے نئے ٹیب میں کھولتا ہے، اور ٹیب پر درمیانی کلک اسے بند کرتا ہے۔ کسی فولڈر کو بائیں طرف کے دو پن کیے ہوئے فولڈروں کے بیچ گھسیٹیں تاکہ وہ وہیں پن ہو جائے، اور پن کیے ہوئے فولڈروں کو اوپر نیچے گھسیٹ کر اپنی پسند کی ترتیب میں رکھیں۔ تلاش کے خانے کے نیچے تین فہرستیں ہیں، قسم، سائز اور تبدیل شدہ، جو چنتے ہی جو دکھایا جا رہا ہے اسے محدود کر دیتی ہیں۔

# Help topic "Folders, USB sticks and phones": paragraph 8.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p8 = کلیدیں فائل مینیجر کی معمول کی ہیں۔ Alt اور Left پیچھے جاتے ہیں، Alt اور Right آگے، اور Alt اور Up یا Backspace ایک فولڈر اوپر۔ Ctrl اور L، یا Alt اور D، آپ کو جگہ لکھنے دیتے ہیں۔ Ctrl اور T ٹیب کھولتے ہیں، Ctrl اور W اسے بند کرتے ہیں (اور ونڈو کو، جب وہ آخری ہو)، Ctrl اور Tab اگلے ٹیب پر جاتے ہیں اور Ctrl، Shift اور Tab پچھلے پر۔ Ctrl اور N دوسری ونڈو کھولتے ہیں۔ Ctrl اور F تلاش کرتے ہیں، F2 نام بدلتا ہے، F5 فولڈر دوبارہ پڑھتا ہے، Delete ردی میں ڈالتا ہے اور Shift اور Delete ہمیشہ کے لیے مٹا دیتے ہیں۔ Ctrl، Shift اور N فولڈر بناتے ہیں۔ Ctrl اور A سب چنتے ہیں، Ctrl، Shift اور A کوئی نہیں، اور Ctrl اور I انتخاب الٹ دیتے ہیں۔ Alt اور Enter خصوصیات کھولتے ہیں۔ F3 ایک اور دو پین کے درمیان بدلتا ہے، اور F4 ٹرمینل کھولتا ہے۔

# Help topic "Folders, USB sticks and phones": paragraph 9.
# SAFETY: needs a human review before it ships
settings-help-topics-files-p9 = ڈرائیوز، تمام ایپس میں اور سیٹنگز، اس کمپیوٹر کے بارے میں میں، ہر ڈرائیو اور کتنی جگہ خالی ہے دکھاتی ہے۔ وہاں سے آپ USB اسٹک کھول سکتے ہیں، نکالنے سے پہلے اسے محفوظ طریقے سے نکال سکتے ہیں، یا فارمیٹ کر سکتے ہیں۔ جس ڈرائیو پر سسٹم چلتا ہے اسے فارمیٹ کرنے کی پیشکش کبھی نہیں ہوتی۔

