screenshot-mail-too-many = منسلک کرنے کے لیے بہت زیادہ فائلیں ہیں۔

# Why: a file, or all the files together, are too big.
screenshot-mail-too-big = فائلیں منسلک کرنے کے لیے بہت بڑی ہیں۔

# Why: a file could not be read as a plain file.
screenshot-mail-bad-file = ایک فائل منسلک نہیں ہو سکی۔

# Why: an address was not a plain address.
screenshot-mail-bad-address = ایک پتہ درست نہیں تھا۔

# Why: the subject was too long or had odd characters.
screenshot-mail-bad-subject = موضوع درست نہیں تھا۔

# Why: the words were too long or had odd characters.
screenshot-mail-bad-words = الفاظ درست نہیں تھے۔

# Why: no private place to keep the files.
screenshot-mail-no-place = فائلیں محفوظ طریقے سے رکھی نہیں جا سکیں۔

# Why: the mail program did not start.
screenshot-mail-not-started = میل پروگرام شروع نہیں ہوا۔

# Line in the menu on a file or folder: delete it for good, after asking.
screenshot-chooser-delete = ہمیشہ کے لیے حذف کریں

# Question before deleting for good.
screenshot-chooser-delete-ask = ہمیشہ کے لیے حذف کریں؟

# Line in the menu: copy the place of the thing as text.
screenshot-chooser-copy-location = جگہ کاپی کریں

# Line in the menu on a folder: pin it to Folders' side bar.
screenshot-chooser-pin = سائیڈ بار میں پن کریں

# Line in the menu on a folder pinned already.
screenshot-chooser-unpin = پن ہٹائیں

# Red line after a pin could not be kept.
screenshot-chooser-pin-not-kept = پن محفوظ نہیں ہو سکا۔

# Red line after some items could not be deleted.
screenshot-chooser-not-deleted =
    { $n ->
        [one] ایک آئٹم حذف نہیں ہو سکا: { $names }۔
       *[other] { $n } آئٹم حذف نہیں ہو سکے: { $names }۔
    }

