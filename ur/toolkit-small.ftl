# machine translated (Urdu), not yet reviewed by a person.


# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = { $name } ہٹائیں

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }، { $max } ستاروں میں سے { $value }

# The names of the three boxes of a duration entry.
kit-duration-hours = گھنٹے

kit-duration-minutes = منٹ

kit-duration-seconds = سیکنڈ

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = مرحلہ { $n } از { $count }

kit-step-back = پیچھے

kit-step-next = آگے

kit-step-finish = مکمل کریں

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = تلاش

kit-find-previous = پچھلا نتیجہ

kit-find-next = اگلا نتیجہ

kit-find-none = کوئی نتیجہ نہیں

kit-find-count = { $count } میں سے { $at }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] ایک اور شخص
       *[other] { $n } اور لوگ
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = { $n } پڑاؤ والا گریڈینٹ

kit-gradient-place = چنے ہوئے پڑاؤ کی جگہ

kit-gradient-add = پڑاؤ شامل کریں

kit-gradient-remove = پڑاؤ ہٹائیں

# The "i" button that shows and hides a card's help.
kit-help-show = مدد دکھائیں

kit-help-hide = مدد چھپائیں

