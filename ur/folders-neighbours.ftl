
# machine translated (Urdu), not yet reviewed by a person.

# Line on the empty Network page while Folders is still looking for computers.
folders-neighbours-looking = اس نیٹ ورک پر فولڈر شیئر کرنے والے کمپیوٹر تلاش کیے جا رہے ہیں…

# First line on the empty Network page when nothing was found.
folders-neighbours-none = اس نیٹ ورک پر فولڈر شیئر کرنے والا کوئی کمپیوٹر نہیں ملا۔

# Line on the empty Network page saying which ways of looking were used; the variable is both, windows or other.
folders-neighbours-asked =
    { $ways ->
        [both] Folders نے Windows کمپیوٹرز کو تلاش کیا، اور NAS ڈرائیوز، Mac اور Linux کمپیوٹرز کو بھی۔
        [windows] Folders نے Windows کمپیوٹرز کو تلاش کیا۔
       *[other] Folders نے NAS ڈرائیوز، Mac اور Linux کمپیوٹرز کو تلاش کیا۔
    }

# Line on the empty Network page saying the Windows way could not be asked because Trindle's finder program is missing.
folders-neighbours-no-finder = Folders Windows کمپیوٹرز کو تلاش نہیں کر سکا، کیونکہ trindle-wsdd انسٹال نہیں ہے۔

# Line on the empty Network page saying the other way could not be asked because no network card is connected.
folders-neighbours-no-card = Folders NAS ڈرائیوز، Mac اور Linux کمپیوٹرز کو تلاش نہیں کر سکا، کیونکہ یہ کمپیوٹر کسی نیٹ ورک سے جڑا نہیں ہے۔ صرف VPN کافی نہیں۔

# Line on the empty Network page saying the network refused the question; the variable is the reason the system gave.
folders-neighbours-refused = Folders NAS ڈرائیوز، Mac اور Linux کمپیوٹرز کو تلاش نہیں کر سکا ({ $why })۔

# Last line on the empty Network page: a quiet computer can still be opened by hand.
folders-neighbours-quiet = اگر کوئی کمپیوٹر نظر نہ آئے، یا فائر وال کے پیچھے ہو، تب بھی آپ اسے اس کے نام یا پتے سے کھول سکتے ہیں۔
