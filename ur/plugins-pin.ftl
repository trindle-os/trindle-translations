# SAFETY: needs a human review before it ships
plugins-pin-delete = مٹائیں

# Name and tip of the round button on the PIN card that closes it without sending.
# SAFETY: needs a human review before it ships
plugins-pin-cancel = منسوخ کریں

# Button on the PIN card that sends the digits.
plugins-pin-send = بھیجیں

# Heading of the PIN card, and the title of its window.
# SAFETY: needs a human review before it ships
plugins-pin-title = PIN سے کھولیں
