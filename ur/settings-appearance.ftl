# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
        [one] ونڈو کے نیچے { $seconds } سیکنڈ تک پوچھا جاتا ہے کہ رکھیں یا نہیں۔
       *[other] ونڈو کے نیچے { $seconds } سیکنڈ تک پوچھا جاتا ہے کہ رکھیں یا نہیں۔
    }

