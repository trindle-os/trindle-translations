
# machine translated (Urdu), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = حلقہ

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = پسندیدہ لانچر کنارہ کلک کونا آواز بولنا ونڈوز کھلی ونڈوز کلپ بورڈ نقل چسپاں تاریخ بھولنا اطلاعات favourites favorites launcher edge click hot corner voice speech windows open windows clipboard copy paste history forget notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = آپ کے پسندیدہ حلقے کے درمیان میں رہتے ہیں۔ انہیں حلقے ہی میں چنا جاتا ہے: کسی ایپ پر دایاں کلک کر کے اسے شامل یا خارج کریں، اور ترتیب بدلنے کے لیے کسی پسندیدہ کو دوسرے کی جگہ پر کھینچ لائیں۔

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = حلقہ اسکرین کے کنارے پر کھلتا ہے، اور آپ کی کھلی ونڈوز اس میں رہتی ہیں۔

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = چیزیں کہاں کھلتی ہیں

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = اسکرین کے کنارے پر کلک کریں

# Small words under that line about the Super key.
settings-ring-open-super = Super کلید بھی اسے کھولتی ہے۔

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } پسندیدہ
       *[other] { $n } پسندیدہ
    }

# Small words under the favourites line.
settings-ring-favourites-about = ایک شامل کرنے کے لیے حلقے میں کسی ایپ پر دایاں کلک کریں۔

# Title of the card about opening the ring.
settings-ring-opening = حلقہ کھولنا

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = پوائنٹر کو اسکرین کے کنارے پر لے جا کر کلک کریں، یا Super کلید دبائیں، تو حلقہ کھل جاتا ہے۔ آپ کے پسندیدہ حلقے کے درمیان رہتے ہیں، اور آپ کی کھلی ونڈوز ان کے گرد ایک حلقے میں: کسی ایک کو آگے لانے کے لیے اس پر کلک کریں، یا اس کے بٹنوں کے لیے دایاں کلک کریں۔ کسی بھی ایپ کو شامل یا خارج کرنے کے لیے حلقے میں اس پر دایاں کلک کریں۔

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = آتے ہی دکھائیں

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = بند ہو تو: یہ پھر بھی حلقے میں جمع ہوتی ہیں۔

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = کتنی دیر رہیں

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = ضروری اطلاعات بند کیے جانے تک رکی رہتی ہیں۔

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = کہاں ظاہر ہوں

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = وہ کونا جہاں سے یہ ڈھیر بن کر نکلتی ہیں۔

# Title of the card about notifications.
settings-ring-notify-title = اطلاعات

# Words behind the i of the card about notifications.
settings-ring-notify-about = جب کسی پروگرام کو آپ کو کچھ بتانا ہو تو وہ چند سیکنڈ کے لیے ظاہر ہو کر چلا جاتا ہے۔ بند کرنے پر کچھ ظاہر نہیں ہوتا، اور سب کچھ حلقے میں اطلاعات کے دائرے میں جمع رہتا ہے۔ یہاں جو بھی چنا ہو، ضروری اطلاع بند کیے جانے تک رکی رہتی ہے، تاکہ کوئی انتباہ پڑھے جانے سے پہلے خود ہٹ نہ جائے۔

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = نقل کیا ہوا بھول جائیں

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = پن کی ہوئی سطریں رکھی جاتی ہیں۔

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = ابھی نقل شدہ

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n } سطر، { $pinned } پن کی ہوئی۔
       *[other] { $n } سطریں، { $pinned } پن کی ہوئی۔
    }

# Title of the card about the clipboard.
settings-ring-clip-title = کلپ بورڈ

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = حلقے میں کلپ بورڈ کا دائرہ آپ کی نقل کی ہوئی چیزیں رکھتا ہے، تاکہ آپ پہلے کی کوئی چیز چسپاں کر سکیں۔ یہاں جو بھی چنا ہو، پن کی ہوئی سطریں ہمیشہ رکھی جاتی ہیں۔

