
# machine translated (Urdu), not yet reviewed by a person.

# Name of the Users page, in the page list and as its heading.
settings-users-title = صارفین

# Words people may search for to find the Users page, separated by spaces.
settings-users-keywords = اکاؤنٹ لوگ پاس ورڈ تصویر فوٹو منتظم accounts people password picture photo administrator

# SAFETY: needs a human review before it ships
# Help line at the foot of the Users page.
settings-users-help = لوگوں کو شامل کرنے، پاس ورڈ بدلنے اور اکاؤنٹ حذف کرنے کے لیے منتظم کا پاس ورڈ چاہیے۔

# SAFETY: needs a human review before it ships
# Beside a change that is waiting for the administrator's password to be typed.
settings-users-waiting = پاس ورڈ کا انتظار ہے...

# Headline of the Users page when nobody on the computer is an administrator.
settings-users-sum-nobody-admin = یہاں کوئی منتظم نہیں ہے، اس لیے سب کے لیے کچھ انسٹال یا تبدیل نہیں ہو سکتا۔

# Headline of the Users page when you are the only person and an administrator.
settings-users-sum-only-you = یہ کمپیوٹر صرف آپ استعمال کرتے ہیں، اور آپ ہی اس کے منتظم ہیں۔

# Headline of the Users page when one person who is not you uses the computer.
settings-users-sum-only-one = اس کمپیوٹر کو صرف ایک شخص استعمال کرتا ہے۔

# Headline of the Users page: how many people use the computer, and you are the one administrator.
settings-users-sum-you-admin =
    { $n ->
        [one] اس کمپیوٹر کو { $n } شخص استعمال کرتا ہے، اور آپ منتظم ہیں۔
       *[other] اس کمپیوٹر کو { $n } لوگ استعمال کرتے ہیں، اور آپ منتظم ہیں۔
    }

# Headline of the Users page: how many people use the computer, and one of them is the administrator.
settings-users-sum-one-admin =
    { $n ->
        [one] اس کمپیوٹر کو { $n } شخص استعمال کرتا ہے، اور وہی منتظم ہے۔
       *[other] اس کمپیوٹر کو { $n } لوگ استعمال کرتے ہیں، اور ان میں سے ایک منتظم ہے۔
    }

# Headline of the Users page: how many people use the computer and how many are administrators.
settings-users-sum-admins =
    { $n ->
        [one] اس کمپیوٹر کو { $n } شخص استعمال کرتا ہے، اور ان میں سے { $a } منتظم ہیں۔
       *[other] اس کمپیوٹر کو { $n } لوگ استعمال کرتے ہیں، اور ان میں سے { $a } منتظم ہیں۔
    }

