
# machine translated (Urdu), not yet reviewed by a person.

# Name of the installer's window (what the window list and a screen reader call it).
installer-window-title = { $name } انسٹال کریں

# Name of the first stop on the line the mark rolls along, the welcome page.
installer-stop-welcome = خوش آمدید

# Name of the second stop on that line, the page where the disk is chosen.
installer-stop-disk = ڈسک

# Name of the third stop on that line, the page about encrypting the disk.
installer-stop-privacy = رازداری

# Name of the fourth stop on that line, the page for the disk password.
installer-stop-password = پاس ورڈ

# Name of the fifth stop on that line, the page about the person.
installer-stop-you = آپ

# Name of the sixth stop on that line, the page that says what is about to happen.
installer-stop-ready = تیار

# Name of the seventh stop on that line, shown while the install runs.
installer-stop-installing = انسٹال ہو رہا ہے

# Name of the last stop on that line, shown when the install is done.
installer-stop-done = مکمل

# Foot of the install page, before the helper has said what it is doing.
installer-getting-ready = تیاری ہو رہی ہے

# Red line at the foot when the installer's helper could not be started.
installer-no-start = انسٹالر شروع نہیں ہو سکا: { $why }

# Written to the error output when the plan sent to the helper could not be read.
installer-plan-unreadable = منصوبہ پڑھا نہیں جا سکا۔

# Written to the error output when the plan sent to the helper could not be read, with the reason.
installer-plan-unreadable-why = منصوبہ پڑھا نہیں جا سکا: { $why }

# Red line at the foot when the helper stopped without saying why.
installer-stopped = انسٹالیشن رک گئی۔ مزید کچھ نہیں لکھا گیا۔

# Name of the round button at the foot that goes back a page.
installer-back = پیچھے

# Name of the main button at the foot that goes to the next page.
installer-next = آگے

# Name of the main button at the foot of the Ready page that starts the install.
# SAFETY: needs a human review before it ships
installer-install = انسٹال کریں

# Name of the main button at the foot of the last page that restarts the computer.
installer-restart = ابھی ری اسٹارٹ کریں

# Beside the keyboard test box on the first page.
installer-try-keyboard = کی بورڈ آزمائیں

# Name of the box on the first page where the person types to try the keyboard.
installer-try-keyboard-box = کی بورڈ آزمانے کے لیے یہاں لکھیں

# Note beside Install after one press, when the second press writes beside another system.
# SAFETY: needs a human review before it ships
installer-arm = انسٹال کرنے کے لیے دوبارہ کلک کریں

# Note beside Install after one press, when the second press erases a whole disk.
# SAFETY: needs a human review before it ships
installer-arm-erase = مٹانے اور انسٹال کرنے کے لیے دوبارہ کلک کریں

# Note beside Next on the first page while no language is chosen.
installer-missing-language = زبان چنیں

# Note beside Next on the first page while no keyboard is chosen.
installer-missing-keyboard = کی بورڈ چنیں

# Note beside Next on the first page while no time zone is chosen.
installer-missing-time = وقت چنیں

# Note beside Next on the disk page while no disk is chosen.
installer-missing-disk = چنیں کہ Trindle کہاں جائے

# Note beside Next on the disk password page while no password has been typed twice.
# SAFETY: needs a human review before it ships
installer-missing-disk-password = ڈسک کا پاس ورڈ دو بار لکھیں، دونوں بار ایک جیسا

# Note beside Next on the account page while the sign-in name is not good.
installer-missing-username = لاگ ان نام ضروری ہے

# Note beside Next on the account page while the computer's name is not good.
installer-missing-hostname = اس کمپیوٹر کو ایک نام دیں

# Note beside Next on the account page while no password has been typed twice.
# SAFETY: needs a human review before it ships
installer-missing-password = اپنا پاس ورڈ دو بار لکھیں، دونوں بار ایک جیسا

# Title of the first page.
installer-welcome-title = { $name } میں خوش آمدید

# Sentence under the title of the first page.
installer-welcome-help = اپنی زبان چنیں؛ کی بورڈ اور وقت اس کے مطابق ہو جاتے ہیں، اور آپ دونوں بدل سکتے ہیں۔

# Head of the card for choosing the language, and the name of its search box.
installer-language = زبان

# Head of the card for choosing the keyboard, and the name of its search box.
installer-keyboard = کی بورڈ

# Head of the card for choosing the time zone, and the name of its search box.
installer-time = وقت

# Under a card's head while nothing has been chosen in its list.
installer-select = منتخب کریں

# Title of the disk page.
installer-disks-title = { $name } کہاں جائے

# Sentence under the title of the disk page.
# SAFETY: needs a human review before it ships
installer-disks-help = آپ جو ڈسک چنیں گے اس پر موجود ہر چیز بدل دی جائے گی، سوائے اس کے کہ آپ وہاں موجود چیزوں کے ساتھ جگہ بنائیں۔

# Shown on the disk page when no disk is big enough.
installer-disks-none = کوئی اتنی بڑی ڈسک نہیں ملی۔ Trindle کو 20 GB چاہیے۔

# Name and words of the choice to erase a whole disk.
# SAFETY: needs a human review before it ships
installer-disks-whole = پوری ڈسک استعمال کریں، اس پر موجود ہر چیز بدل دی جائے گی

# Name and words of the choice to keep a partition and share the disk; it says which one.
# SAFETY: needs a human review before it ships
installer-disks-share = { $what } رکھیں اور ڈسک بانٹیں

# Under the slider that decides how much of a shared partition is kept: the size each side gets.
installer-disks-split = { $kept } موجودہ چیزوں کے لیے رہیں گے، { $mine } Trindle کے لیے

# A partition or disk with its size, such as the name of a disk and how big it is.
installer-named-size = { $name }، { $size }

# Name of a partition with nothing on it.
installer-empty-space = خالی جگہ

# Names run together in a list, the last one after the word and.
installer-list-and = { $rest } اور { $last }

# Under a disk's name: what is on it.
installer-disk-has = اس پر { $list } ہے

# Under a disk's name: what is on it, when it is encrypted.
installer-disk-has-encrypted = اس پر { $list } ہے، مخفی (انکرپٹڈ)

# Under a disk's name: it holds an encrypted system Trindle cannot read.
installer-disk-has-encrypted-system = اس پر ایک مخفی (انکرپٹڈ) سسٹم ہے

# Under a disk's name: there is nothing on it.
installer-disk-empty = خالی

# Under a disk's name: it holds files but no system Trindle knows.
installer-disk-has-files = اس پر فائلیں ہیں، لیکن کوئی ایسا سسٹم نہیں جسے Trindle پہچانتا ہو

# Head of the card with the choice about a swap file, with the size of this computer's memory.
installer-swap-title = { $gb } GB کی سواپ فائل

# Name of the switch that makes a swap file.
installer-swap-switch = سواپ فائل بنائیں

# Under the swap file's head when Secure Boot is on.
installer-swap-secure-boot = Secure Boot چالو ہے، اس لیے یہ کمپیوٹر ہائبرنیٹ نہیں ہو سکتا، لیکن میموری کم پڑنے پر سواپ فائل پھر بھی مدد کرتی ہے۔ یہ صرف تب بنتی ہے جب ڈسک پر کافی جگہ فالتو ہو۔

# Under the swap file's head when the computer can hibernate.
installer-swap-note = ہائبرنیٹ کی جگہ، جس میں پاور بند ہونے پر بھی سب کچھ کھلا رہتا ہے، اور میموری کم پڑنے پر سہارا۔ اس کے بغیر کمپیوٹر ہائبرنیٹ نہیں ہو سکتا۔ یہ صرف تب بنتی ہے جب ڈسک پر کافی جگہ فالتو ہو۔

# Title of the page about encrypting the disk.
# SAFETY: needs a human review before it ships
installer-privacy-title = ڈسک کو انکرپٹ کرنا

# Sentence under the title of that page.
# SAFETY: needs a human review before it ships
installer-privacy-help = انکرپٹڈ ڈسک کو کوئی بھی اس کمپیوٹر سے نکال کر پڑھ نہیں سکتا۔

# Head of the card with the three choices.
# SAFETY: needs a human review before it ships
installer-privacy-locked = ڈسک کیسے مقفل ہو

# Name and words of the choice not to encrypt the disk.
# SAFETY: needs a human review before it ships
installer-privacy-none = ڈسک کو انکرپٹ نہ کریں

# Name and words of the choice to encrypt the disk with a password typed at start-up.
# SAFETY: needs a human review before it ships
installer-privacy-password = اسے انکرپٹ کریں، اور کمپیوٹر شروع ہونے پر پاس ورڈ پوچھیں

# Name and words of the choice to encrypt the disk and let the computer's TPM chip unlock it.
# SAFETY: needs a human review before it ships
installer-privacy-chip-choice = اسے انکرپٹ کریں، اور اس کمپیوٹر کی TPM چپ کو اسے کھولنے دیں

# Head of the card about the TPM chip.
installer-privacy-about = چپ کے بارے میں

# In the card about the chip, on a computer that has one.
# SAFETY: needs a human review before it ships
installer-privacy-chip = اس کمپیوٹر میں TPM چپ ہے۔ انسٹال کے بعد پہلی بار شروع ہونے پر ایک بار پاس ورڈ پوچھا جاتا ہے، جب چپ اس کمپیوٹر کو سیکھتی ہے؛ اس کے بعد وہ خود ڈسک کھولتی ہے اور کچھ لکھنا نہیں پڑتا۔ پاس ورڈ سنبھال کر رکھیں: اگر چپ بدلی جائے یا ڈسک کسی اور کمپیوٹر میں لگائی جائے تو اندر آنے کا یہی راستہ ہے۔

# In the card about the chip, on a computer that has none Trindle can use.
# SAFETY: needs a human review before it ships
installer-privacy-no-chip = اس کمپیوٹر میں ایسی TPM چپ نہیں جو Trindle استعمال کر سکے، اس لیے ہر بار شروع ہونے پر پاس ورڈ پوچھا جائے گا۔ جس کمپیوٹر میں ہو، وہاں چپ خود ڈسک کھول سکتی ہے۔

# Title of the disk password page.
# SAFETY: needs a human review before it ships
installer-disk-title = ڈسک کا پاس ورڈ

# Sentence under the title of the disk password page.
# SAFETY: needs a human review before it ships
installer-disk-help = کمپیوٹر شروع ہوتے وقت یہ سب سے پہلے لکھا جاتا ہے۔

# Head of the card with the disk password boxes, and the name of the first box.
# SAFETY: needs a human review before it ships
installer-disk-password = ڈسک کا پاس ورڈ

# Name of the round button that makes up a passphrase.
# SAFETY: needs a human review before it ships
installer-disk-suggest = پاس فریز تجویز کریں

# Label and name of the second box of a password, where it is typed again.
# SAFETY: needs a human review before it ships
installer-same-again = دوبارہ وہی

# Red line under the password boxes when the two do not match.
# SAFETY: needs a human review before it ships
installer-mismatch = دونوں پاس ورڈ ایک جیسے نہیں ہیں۔

# Head of the card that tells the person to write the password down.
# SAFETY: needs a human review before it ships
installer-disk-write-down = اسے لکھ لیں

# Words in that card.
# SAFETY: needs a human review before it ships
installer-disk-write-down-text = یہ پاس ورڈ کاغذ پر لکھ لیں اور کمپیوٹر سے دور کسی محفوظ جگہ رکھیں۔ اس کے بغیر ڈسک نہ آپ سے کھل سکتی ہے نہ کسی اور سے، کبھی نہیں۔ واپسی کا کوئی راستہ نہیں۔ چار عام الفاظ ایک ایسا پاس فریز بناتے ہیں جو لکھنے میں آسان اور اندازہ لگانے میں مشکل ہے۔

# Title of the account page.
installer-you-title = آپ کے بارے میں

# Sentence under the title of the account page.
installer-you-help = یہ وہ اکاؤنٹ ہے جس سے آپ لاگ ان کرتے ہیں۔

# Head of the card with the name boxes.
installer-account = آپ کا اکاؤنٹ

# Label and name of the box for the person's name.
installer-your-name = آپ کا نام

# Label and name of the box for the sign-in name.
installer-user-name = لاگ ان نام

# Label and name of the box for the computer's name.
installer-host-name = اس کمپیوٹر کا نام

# Head of the card with the password boxes.
# SAFETY: needs a human review before it ships
installer-your-password = آپ کا پاس ورڈ

# Label and name of the first password box.
# SAFETY: needs a human review before it ships
installer-password = پاس ورڈ

# Label of the strength meter and the name a screen reader gives it.
installer-strength = اس کا اندازہ لگانا کتنا مشکل ہے

# Red line under the account boxes: the sign-in name is empty.
installer-user-needed = لاگ ان نام ضروری ہے۔

# Red line under the account boxes: a name is too long.
installer-name-too-long = یہ نام بہت لمبا ہے۔

# Red line under the account boxes: the sign-in name does not start with a small letter.
installer-user-start = چھوٹے حرف سے شروع کریں۔

# Red line under the account boxes: the sign-in name uses letters it may not.
installer-user-letters = صرف چھوٹے حروف، ہندسے، - اور _۔

# Red line under the account boxes: the sign-in name belongs to the system.
installer-user-taken = یہ نام سسٹم پہلے ہی استعمال کر رہا ہے۔

# Red line under the account boxes: the computer's name is empty.
installer-host-needed = اس کمپیوٹر کو ایک نام دیں۔

# Red line under the account boxes: the computer's name uses letters it may not.
installer-host-letters = صرف حروف، ہندسے اور -۔

# Under the strength meter: how long a computer would take to guess the password, when it is at once.
# SAFETY: needs a human review before it ships
installer-guess-now = کمپیوٹر اس کا اندازہ فوراً لگا لے گا۔

# Under the strength meter: how long a computer would take to guess the password, in minutes.
# SAFETY: needs a human review before it ships
installer-guess-minutes =
    { $n ->
        [one] کمپیوٹر اس کا اندازہ تقریباً { $n } منٹ میں لگا لے گا۔
       *[other] کمپیوٹر اس کا اندازہ تقریباً { $n } منٹ میں لگا لے گا۔
    }

# Under the strength meter: how long a computer would take to guess the password, in hours.
# SAFETY: needs a human review before it ships
installer-guess-hours =
    { $n ->
        [one] کمپیوٹر اس کا اندازہ تقریباً { $n } گھنٹے میں لگا لے گا۔
       *[other] کمپیوٹر اس کا اندازہ تقریباً { $n } گھنٹوں میں لگا لے گا۔
    }

# Under the strength meter: how long a computer would take to guess the password, in days.
# SAFETY: needs a human review before it ships
installer-guess-days =
    { $n ->
        [one] کمپیوٹر اس کا اندازہ تقریباً { $n } دن میں لگا لے گا۔
       *[other] کمپیوٹر اس کا اندازہ تقریباً { $n } دنوں میں لگا لے گا۔
    }

# Under the strength meter: how long a computer would take to guess the password, in years.
# SAFETY: needs a human review before it ships
installer-guess-years =
    { $n ->
        [one] کمپیوٹر کو اس کا اندازہ لگانے میں تقریباً { $n } سال لگے گا۔
       *[other] کمپیوٹر کو اس کا اندازہ لگانے میں تقریباً { $n } سال لگیں گے۔
    }

# Under the strength meter: the password is too strong to guess in any time worth saying.
# SAFETY: needs a human review before it ships
installer-guess-never = کمپیوٹر کو اس کا اندازہ لگانے میں معلوم تاریخ سے بھی زیادہ وقت لگے گا۔

# Title of the Ready page.
installer-ready-title = انسٹال کے لیے تیار

# Head of the card that lists what will happen.
installer-ready-nothing-changed = ابھی تک کچھ بھی نہیں بدلا گیا

# Head of the card about security updates.
installer-ready-security = حفاظتی اپ ڈیٹس

# In the card about security updates.
installer-ready-security-text = { $name } ہر روز Debian کی حفاظتی اصلاحات خود انسٹال کرتا ہے۔ اسے بند نہیں کیا جا سکتا۔

# Sentence under the title when a whole disk will be replaced.
# SAFETY: needs a human review before it ships
installer-ready-replaced = { $disk } پر موجود ہر چیز بدل دی جائے گی۔

# Sentence under the title when the install goes beside what is there.
installer-ready-kept = { $part } پر موجود ہر چیز رکھی جائے گی، مگر پہلے اس کا بیک اپ لے لیں: بجلی جانے پر اسے چھوٹا کرنے سے فائلیں ضائع ہو سکتی ہیں۔

# Sentence under the title when no disk has been chosen.
installer-ready-none = ابھی تک کوئی ڈسک نہیں چنی گئی۔

# Name of a row in the list: the whole disk will be used.
# SAFETY: needs a human review before it ships
installer-ready-whole = پوری { $disk }

# Words of that row.
# SAFETY: needs a human review before it ships
installer-ready-whole-text = اس پر موجود ہر چیز { $name } سے بدل دی جائے گی۔

# Name of a row in the list: the install goes beside a partition.
installer-ready-beside = { $part } کے ساتھ

# Words of that row.
installer-ready-beside-text = { $part } کو چھوٹا کر کے { $size } تک کیا جائے گا، اور { $name } خالی ہونے والی جگہ میں جائے گا۔

# Name of a row in the list when no disk is chosen.
installer-ready-no-disk = کوئی ڈسک نہیں

# Words of that row.
installer-ready-no-disk-text = کوئی ڈسک نہیں چنی گئی۔

# Name of a row in the list: the disk will not be encrypted.
# SAFETY: needs a human review before it ships
installer-ready-plain = انکرپٹڈ نہیں

# Words of that row.
# SAFETY: needs a human review before it ships
installer-ready-plain-text = جو بھی ڈسک نکالے وہ اسے پڑھ سکتا ہے۔

# Name of a row in the list: the disk will be encrypted.
# SAFETY: needs a human review before it ships
installer-ready-locked = انکرپٹڈ

# Words of that row when a password is typed at each start.
# SAFETY: needs a human review before it ships
installer-ready-locked-password = کمپیوٹر ہر بار شروع ہونے پر آپ اس کا پاس ورڈ لکھتے ہیں۔

# Words of that row when the TPM chip unlocks the disk.
# SAFETY: needs a human review before it ships
installer-ready-locked-chip = ایک بار پاس ورڈ، پھر اس کمپیوٹر کی TPM چپ اسے کھولتی ہے۔

# Words of the language row: the keyboard and time zone chosen.
installer-ready-language = کی بورڈ { $keyboard }، وقت { $zone }۔

# Title of the page shown while the install runs.
installer-installing-title = { $name } انسٹال ہو رہا ہے

# Head of the card that holds the short tour.
installer-tour = ایک مختصر سیر

# Title of the last page.
installer-done-title = { $name } انسٹال ہو گیا

# Sentence under the title of the last page.
installer-done-help = USB ڈرائیو نکالیں، پھر ری اسٹارٹ کریں۔

# Head of the card that repeats the warning about the disk password.
# SAFETY: needs a human review before it ships
installer-done-keep = ڈسک کا پاس ورڈ محفوظ رکھیں

# In that card when the TPM chip unlocks the disk.
# SAFETY: needs a human review before it ships
