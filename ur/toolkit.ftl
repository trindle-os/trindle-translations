# What a screen reader is told of a scene of items: how many, and the one chosen.
kit-scene =
    { $count ->
        [one] 1 چیز کا منظر
       *[other] { $count } چیزوں کا منظر
    }

kit-scene-chosen =
    { $count ->
        [one] 1 چیز کا منظر، { $name } چنا گیا
       *[other] { $count } چیزوں کا منظر، { $name } چنا گیا
    }

## A video or sound player's controls
kit-player-play = چلائیں

kit-player-pause = روکیں

kit-player-back = 5 سیکنڈ پیچھے

kit-player-forward = 5 سیکنڈ آگے

kit-player-seek = مقام

kit-player-mute = آواز بند کریں

kit-player-unmute = آواز کھولیں

kit-player-volume = آواز

# How far in, out of how long, as clock times.
kit-player-time = { $length } میں سے { $at }

## The page shown after a program crashed or met a fault
kit-crash-title = کچھ غلط ہو گیا

kit-crash-lead = { $program } اس لیے رک گیا کہ کچھ غلط ہو گیا۔ نیچے کی رپورٹ کاپی کر کے اپنی خرابی کی اطلاع کے ساتھ بھیجیں تاکہ مسئلہ ٹھیک کیا جا سکے۔

kit-crash-copy = رپورٹ کاپی کریں

# What a screen reader calls a block of code on a help page.
kit-help-code = کوڈ

# What a screen reader calls the list of suggestions under a text box; $name is what the box is called.
kit-complete-list = { $name } کے لیے تجاویز

# Under a text box with suggestions: how many there are, said by a screen reader as they change.
kit-complete-count =
    { $n ->
        [one] 1 تجویز
       *[other] { $n } تجاویز
    }

## A title bar the program draws, where the compositor draws none
