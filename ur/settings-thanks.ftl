# The sentence at the top of the Thanks page; n is how many projects are thanked.
settings-thanks-headline =
    { $n ->
        [one] Trindle { $n } آزاد منصوبے پر بنا ہے، جو رضاکاروں نے بنایا۔ شکریہ۔
       *[other] Trindle { $n } آزاد منصوبوں پر بنا ہے، جن میں سے زیادہ تر رضاکاروں نے بنائے۔ شکریہ۔
    }

# Tip of the heart button beside a project that takes donations; name is the project.
