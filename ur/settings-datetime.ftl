# Name of the Date and time page, in the page list and as its heading.
settings-datetime-title = تاریخ اور وقت

# Words people may search for to find the Date and time page, separated by spaces.
settings-datetime-keywords = ٹائم زون گھڑی تاریخ وقت time zone clock date

# SAFETY: needs a human review before it ships
# Help line at the foot of the Date and time page.
settings-datetime-help = ٹائم زون اور خودکار وقت کے لیے منتظم کا پاس ورڈ چاہیے۔

# Spoken name of the picture of the clock at the top of the page.
settings-datetime-time-now = ابھی کا وقت

# Name of a way to write the ring's clock: hours 00 to 23.
settings-datetime-24 = 24 گھنٹے

# Name of a way to write the ring's clock: hours 1 to 12 with am or pm.
settings-datetime-12 = 12 گھنٹے

# Name of a way to write the ring's clock: hours 00 to 23 with seconds.
settings-datetime-24s = 24 گھنٹے، سیکنڈ کے ساتھ

# Name of the box for the day when the date is set by hand.
settings-datetime-day = دن

# Name of the box for the month when the date is set by hand.
settings-datetime-month = مہینہ

# Name of the box for the year when the date is set by hand.
settings-datetime-year = سال

# Name of the box for the hour when the time is set by hand.
settings-datetime-hour = گھنٹہ

# Name of the box for the minute when the time is set by hand.
settings-datetime-minute = منٹ

# Red words when the time could not be set.
settings-datetime-no-time = وقت مقرر نہیں ہو سکا۔

# Red words when the time was set by hand while automatic time is on.
settings-datetime-keeps-right = گھڑی ابھی خود کو درست رکھ رہی ہے۔ اوپر اسے بند کریں، پھر وقت ہاتھ سے مقرر کریں۔

# Red words when the system's message bus could not be reached.
settings-datetime-no-bus = سسٹم بس تک رسائی نہیں ہو سکی۔

# Red words when the time service does not answer.
settings-datetime-not-answering = وقت کی سروس جواب نہیں دے رہی۔

# Red words when automatic time could not be turned on.
settings-datetime-ntp-on-failed = گھڑی کو خود کو درست رکھنے کا نہیں کہا جا سکا۔

# Red words when automatic time could not be turned off.
settings-datetime-ntp-off-failed = خودکار وقت بند نہیں کیا جا سکا۔

# Red words when the time zone could not be changed.
settings-datetime-zone-failed = ٹائم زون بدلا نہیں جا سکا۔

# Red words when the date typed by hand is not a real date.
settings-datetime-not-real = یہ حقیقی تاریخ نہیں ہے۔

# Headline of the page before the time service has answered: { $time } is the time and { $date } the date.
settings-datetime-it-is = { $date } کو وقت { $time } ہے۔

# Headline of the page when the time service is not answering.
settings-datetime-service-down = وقت کی سروس جواب نہیں دے رہی، اس لیے گھڑی یہاں بدلی نہیں جا سکتی۔

# Headline of the page when the clock is automatic and in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-right = { $date } کو وقت { $time } ہے، اور گھڑی خود کو درست رکھتی ہے۔

# Headline of the page when the clock is automatic but not yet in step: { $time } is the time and { $date } the date.
settings-datetime-it-is-checks = { $date } کو وقت { $time } ہے۔ انٹرنیٹ ملتے ہی گھڑی خود کو جانچ لے گی۔

# Headline of the page when the clock is set by hand: { $time } is the time and { $date } the date.
settings-datetime-it-is-hand = { $date } کو وقت { $time } ہے۔ گھڑی ہاتھ سے مقرر کی گئی ہے۔

# A city and how far its time is from Greenwich.
settings-datetime-city-offset = { $city }، { $offset }

# A city, its part of the world and how far its time is from Greenwich.
settings-datetime-city-region-offset = { $city }، { $region }، { $offset }

# Spoken name of the clock picture: the time, the date and the place.
settings-datetime-tip = { $date } کو وقت { $time } ہے، { $zone }۔

# Help text of the clock card when the time service is not answering or not yet read.
settings-datetime-ring-about = حلقہ کے بیچ کی گھڑی 24 یا 12 گھنٹے میں، سیکنڈ کے ساتھ یا بغیر لکھی جاتی ہے۔ صرف حلقہ کی گھڑی اس کی پیروی کرتی ہے؛ پروگراموں میں تاریخ اور وقت وہ شکلیں استعمال کرتے ہیں جو علاقہ اور زبان میں چنی گئی ہیں۔

# Heading of the card with the clock settings.
settings-datetime-the-clock = گھڑی

# Heading of the line shown when the time service is not answering.
settings-datetime-service-down-line = وقت کی سروس جواب نہیں دے رہی

# Under Set the time automatically when the internet can be used.
settings-datetime-from-internet = انٹرنیٹ سے، جب جڑا ہو۔

# Under Set the time automatically when the time service is not installed.
settings-datetime-needs-timesyncd = systemd-timesyncd انسٹال ہونا ضروری ہے۔

# Label of the switch for automatic time, and heading of its line.
settings-datetime-set-auto = وقت خود بخود مقرر کریں

# Name of the list of time zones, and heading of its line.
settings-datetime-time-zone = ٹائم زون

# Tip of the button that sets the date and time typed by hand.
settings-datetime-set-date-time = تاریخ اور وقت مقرر کریں

# Heading of the line for setting the time by hand.
settings-datetime-by-hand = وقت ہاتھ سے مقرر کریں

# Under the Set the time by hand heading.
settings-datetime-by-hand-sub = پہلے خودکار وقت بند کریں، جیسا کہ ابھی ہے۔

# SAFETY: needs a human review before it ships
# Help text of the clock card (the information button) when the time service can keep the time from the internet.
settings-datetime-about = خود بخود مقرر ہونے پر، جب بھی کمپیوٹر جڑا ہو گھڑی کو انٹرنیٹ پر وقت کے سرورز سے جانچا جاتا ہے اور وہ خود کو درست رکھتی ہے۔ بند ہونے پر تاریخ اور وقت ہاتھ سے لکھے جاتے ہیں۔ ٹائم زون نائٹ لائٹ کو یہ بھی بتاتا ہے کہ سورج کب غروب ہوتا ہے۔ دونوں کے لیے منتظم کا پاس ورڈ چاہیے۔ حلقہ کے بیچ کی گھڑی 24 یا 12 گھنٹے میں، سیکنڈ کے ساتھ یا بغیر لکھی جاتی ہے۔ صرف حلقہ کی گھڑی اس کی پیروی کرتی ہے؛ پروگراموں میں تاریخ اور وقت وہ شکلیں استعمال کرتے ہیں جو علاقہ اور زبان میں چنی گئی ہیں۔

# SAFETY: needs a human review before it ships
# Help text of the clock card (the information button) when the time service is not installed.
settings-datetime-about-no-ntp = خود بخود مقرر ہونے پر، جب بھی کمپیوٹر جڑا ہو گھڑی کو انٹرنیٹ پر وقت کے سرورز سے جانچا جاتا ہے اور وہ خود کو درست رکھتی ہے۔ بند ہونے پر تاریخ اور وقت ہاتھ سے لکھے جاتے ہیں۔ ٹائم زون نائٹ لائٹ کو یہ بھی بتاتا ہے کہ سورج کب غروب ہوتا ہے۔ دونوں کے لیے منتظم کا پاس ورڈ چاہیے۔ انٹرنیٹ سے وقت رکھنے کے لیے systemd-timesyncd چاہیے: sudo apt install systemd-timesyncd حلقہ کے بیچ کی گھڑی 24 یا 12 گھنٹے میں، سیکنڈ کے ساتھ یا بغیر لکھی جاتی ہے۔ صرف حلقہ کی گھڑی اس کی پیروی کرتی ہے؛ پروگراموں میں تاریخ اور وقت وہ شکلیں استعمال کرتے ہیں جو علاقہ اور زبان میں چنی گئی ہیں۔

