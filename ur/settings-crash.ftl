
# machine translated (Urdu), not yet reviewed by a person.

# Name of the Crash reports page, in the page list and as its heading.
settings-crash-title = کریش رپورٹس

# Words people may search for to find the Crash reports page, separated by spaces.
settings-crash-keywords = کریش رپورٹس غلطیاں بگ خرابی بھیجنا رازداری crash reports errors bugs faults send sent privacy telemetry buildmorphic

# Help line at the foot of the Crash reports page.
# SAFETY: needs a human review before it ships
settings-crash-help = جب Trindle کا کوئی پروگرام کریش ہوتا ہے تو کریش رپورٹس ایڈ آن اس کمپیوٹر پر ایک مختصر نوٹ رکھ لیتا ہے۔ جب تک آپ اس کا بھیجنے کا کمانڈ نہ چلائیں اور ہر رپورٹ کے لیے ہاں نہ کہیں، یہ کچھ نہیں بھیجتا؛ کمانڈ پہلے پوری رپورٹ دکھاتا ہے۔ آپ کا نام اور GitHub نام صرف تب شامل ہوتے ہیں جب آپ نے انہیں یہاں لکھا ہو۔ کبھی کوئی پیغام، فائل کا نام، آپ کہاں ہیں یا دوسرے پروگراموں کے بارے میں کچھ نہیں۔ ایڈ آن ہٹانے سے سب رک جاتا ہے۔

# Heading and label of the switch for sending crashes.
# SAFETY: needs a human review before it ships
settings-crash-crashes = کریش

# Under the Crashes switch.
settings-crash-crashes-short = Trindle کے کوڈ میں کہاں کریش ہوا۔

# Part of the help text of the What is sent card: what Crashes sends.
settings-crash-crashes-long = کریش پروگرام، اس کا ورژن، کریش کی قسم اور Trindle کے کوڈ میں وہ جگہ بھیجتا ہے جہاں یہ ہوا۔

# Heading and label of the switch for sending errors.
# SAFETY: needs a human review before it ships
settings-crash-errors = غلطیاں

# Under the Errors switch.
settings-crash-errors-short = غلطی کا مقررہ نام، اور کہاں۔

# Part of the help text of the What is sent card: what Errors sends.
settings-crash-errors-long = غلطیاں پروگرام، اس کا ورژن، وہ مقررہ نام جو Trindle غلطی کو دیتا ہے اور اس کے کوڈ میں جگہ بھیجتی ہیں۔

# Heading and label of the switch for sending facts about the computer.
# SAFETY: needs a human review before it ships
settings-crash-computer = اس کمپیوٹر کے بارے میں

# Under the About this computer switch.
settings-crash-computer-short = Linux، پروسیسر، میموری، گرافکس، اسکرینیں۔

# Part of the help text of the What is sent card: what About this computer adds.
settings-crash-computer-long = اس کمپیوٹر کے بارے میں ہر رپورٹ میں یہ شامل کرتا ہے: چلنے والا Linux، پروسیسر کی قسم، نیچے گول کی ہوئی میموری، Wayland یا X11، گرافکس کا ساز، اور اسکرینوں کی تعداد۔

# Heading of the card with the switches for what is sent.
settings-crash-what-is-sent = کیا بھیجا جاتا ہے

# Help text of the What is sent card: { $switches } is what each switch sends.
# SAFETY: needs a human review before it ships
settings-crash-what-about = { $switches } رپورٹوں پر کوئی نام نہیں ہوتا جب تک آپ نیچے والے خانے میں اپنا Buildmorphic صارف نام نہ لکھیں، جس سے آپ کو صرف کریڈٹ ملتا ہے۔

# Red words when a setting could not be changed: the reason is { $why }.
settings-crash-nothing-changed-because = کچھ نہیں بدلا، کیونکہ { $why }۔

# Red words when the file that keeps the switches was not written by Trindle.
settings-crash-file-not-as-wrote = کچھ نہیں بدلا، کیونکہ اسے رکھنے والی فائل ویسی نہیں جیسی Trindle نے لکھی تھی۔

# Red words when there is no folder to keep the settings in.
settings-crash-no-settings-folder = ترتیبات کا فولڈر نہیں ہے۔

# Red words when the folder for the settings could not be made.
settings-crash-folder-not-made = ترتیبات کا فولڈر بنایا نہیں جا سکا۔

# Red words when a setting could not be written to its file.
settings-crash-not-written = ترتیب لکھی نہیں جا سکی۔

# Name of a sent report that was a crash: the signal is { $signal } and the program { $program }.
settings-crash-what-crash = { $program } میں کریش ({ $signal })

# Name of a sent report that was an error: the error is { $code } and the program { $program }.
settings-crash-what-error = { $program } میں غلطی { $code }

# In the list of sent reports: the report was taken.
settings-crash-taken = موصول ہو گئی

# In the list of sent reports: the report was not sent because the bug tracker is closed.
settings-crash-tracker-closed = نہیں بھیجی گئی: ٹریکر بند ہے

# In the list of sent reports: the report was not sent because it was too big.
settings-crash-too-big = نہیں بھیجی گئی: بہت بڑی ہے

# In the list of sent reports: the report was not sent because it was refused.
settings-crash-refused = نہیں بھیجی گئی: مسترد ہو گئی

# In the list of sent reports: the report was not sent because too many came at once.
settings-crash-too-many = نہیں بھیجی گئی: ایک ساتھ بہت زیادہ

# In the list of sent reports: the report was not sent, no reason known.
settings-crash-not-sent = نہیں بھیجی گئی

# Said beside the link line once it is saved.
settings-crash-saved = محفوظ ہو گیا

# Tip of the button that clears the list of sent reports.
settings-crash-clear = فہرست صاف کریں

# Red words when the list of sent reports could not be cleared.
settings-crash-not-cleared = فہرست صاف نہیں ہو سکی۔

# Said beside the list of sent reports once it is cleared.
settings-crash-removed = ہٹا دی گئی

# Heading of the line that holds the clear button.
settings-crash-kept-here = صرف اسی کمپیوٹر پر رکھی گئی

# Under the Kept on this computer only heading.
settings-crash-newest-first = سب سے نئی پہلے، زیادہ سے زیادہ پچاس۔

# Heading of the line shown when no report has been sent.
settings-crash-nothing-yet = ابھی کچھ نہیں

# Under the Nothing yet heading.
settings-crash-listed-here = ہر رپورٹ یہاں بالکل ویسی ہی درج ہوتی ہے جیسی بھیجی گئی۔

# Tip of the button that shows exactly what one report held.
settings-crash-show-sent = بالکل وہی دکھائیں جو بھیجا گیا

# Under a sent report: { $when } is the time, { $n } is how many times it happened (0 when once) and { $answer } how it went.
settings-crash-sent-sub =
    { $n ->
        [0] { $when }: { $answer }
        [one] { $when }، { $n } بار: { $answer }
       *[other] { $when }، { $n } بار: { $answer }
    }

# Heading of the card listing reports that were sent.
settings-crash-sent-so-far = اب تک بھیجی گئی

# Help text of the Sent so far card (the information button).
settings-crash-sent-about = ہر رپورٹ بالکل ویسی ہی درج ہوتی ہے جیسی بھیجی گئی، سب سے نئی پہلے، اور صرف اسی کمپیوٹر پر رکھی جاتی ہے۔ موصول کا مطلب ہے کہ Buildmorphic کے پاس ہے۔ نہیں بھیجی گئی: ٹریکر بند ہے کا مطلب ہے کہ Trindle کا بگ ٹریکر رپورٹس نہیں لے رہا؛ مسترد کا مطلب ہے کہ اسے غلط بنی ہونے کی وجہ سے مسترد کیا گیا؛ بہت زیادہ کا مطلب ہے کہ ایک ساتھ بہت زیادہ آئیں۔

# Headline of the page when the add-on is not installed and the person is asked after a crash.
settings-crash-sum-asked = کریش کے بعد آپ سے پوچھا جاتا ہے، پوری رپورٹ دکھا کر، کہ بھیجنی ہے یا نہیں۔

# Headline of the page when nothing is sent and the person is not asked.
settings-crash-sum-nothing = کچھ نہیں بھیجا جاتا، اور کریش کے بعد آپ سے پوچھا بھی نہیں جاتا۔

# Headline of the page when both crashes and errors are turned off.
settings-crash-sum-none = کچھ نہیں بھیجا جاتا: کریش اور غلطیاں دونوں بند ہیں۔

# Headline of the page: what is reported (crashes, errors or both) and under whose name (named, linked or anonymous) in { $which }, and the Buildmorphic name in { $name }.
settings-crash-sum-reported =
    { $which ->
        [errors] Trindle کے پروگراموں کی غلطیاں گمنام طور پر رپورٹ کی جاتی ہیں۔
        [both] Trindle کے پروگراموں کے کریش اور غلطیاں گمنام طور پر رپورٹ کی جاتی ہیں۔
       *[crashes] Trindle کے پروگراموں کے کریش گمنام طور پر رپورٹ کیے جاتے ہیں۔
    }

# Label of the switch for asking about problems and sharing reports, and heading of its line.
settings-crash-ask = مسائل کے بارے میں پوچھیں اور رپورٹس بانٹیں

# Under the Ask about problems heading.
# SAFETY: needs a human review before it ships
settings-crash-ask-sub = بند کرنے سے یہ سب چھپ جاتا ہے اور منتظر رپورٹس مٹ جاتی ہیں۔

# Said beside the Ask switch when it is turned off and no reports were waiting.
settings-crash-off-none = بند۔ کوئی رپورٹ منتظر نہیں تھی۔

# Said beside the Ask switch when it is turned off: how many waiting reports were deleted.
# SAFETY: needs a human review before it ships
settings-crash-off-deleted =
    { $n ->
        [one] بند۔ { $n } منتظر رپورٹ مٹا دی گئی۔
       *[other] بند۔ { $n } منتظر رپورٹس مٹا دی گئیں۔
    }

# Tip of the button that opens the community page.
settings-crash-about-community = کمیونٹی کے بارے میں

# Heading of the line with the community button.
settings-crash-go-to-bm = رپورٹس Buildmorphic کو جاتی ہیں

# Under the Reports go to Buildmorphic heading.
settings-crash-community = وہ کمیونٹی جو Trindle بنانے میں مدد کرتی ہے۔

# Placeholder of the box for the Buildmorphic username.
settings-crash-username = صارف نام

# Heading of the line with the username box.
settings-crash-your-username = آپ کا Buildmorphic صارف نام

# Under the username heading.
settings-crash-username-sub = اختیاری۔ کبھی ای میل پتہ نہیں۔

# Heading of a line about joining with an email address.
settings-crash-join = صرف ای میل پتے سے شامل ہوں

# Under the Join heading.
settings-crash-join-sub = جن مسائل کی آپ سب سے پہلے اطلاع دیں ان پر کریڈٹ اور درجے حاصل کریں۔

# Heading of a line saying a report holds only a fixed list.
settings-crash-fixed = رپورٹ میں صرف ایک مقررہ فہرست ہوتی ہے

# Under the fixed list heading.
settings-crash-fixed-sub = پہلے آپ اسے دیکھتے ہیں، اور آپ کے دبائے بغیر کچھ نہیں جاتا۔

# Heading of the card for reports the person sends.
settings-crash-reports-you-send = آپ کی بھیجی ہوئی رپورٹس

# Help text of the Reports you send card (the information button).
# SAFETY: needs a human review before it ships
settings-crash-reports-about = جب Trindle کا کوئی پروگرام کریش ہوتا ہے تو ایک ونڈو کھل کر پوچھ سکتی ہے کہ رپورٹ بھیجنی ہے یا نہیں۔ یہ پہلے پورا متن دکھاتی ہے: آپ کے الفاظ، کمپیوٹر کا ماڈل اور گرافکس، غلطی اور اس سے ذرا پہلے کا لاگ۔ فائلیں، پاس ورڈ اور Wi-Fi کے نام کبھی نہیں پڑھے جاتے، اور نام اور پتے خالی کر دیے جاتے ہیں۔ آپ یہی ونڈو کسی بھی وقت حلقے کے مسئلے کی اطلاع دیں بٹن سے بھی کھول سکتے ہیں۔

# Spoken name of the box where the GitHub name is typed.
settings-crash-github-name = github نام

# Heading of the line where the person can give their GitHub name.
settings-crash-github-line = آپ کا GitHub نام

# Small words under that heading.
settings-crash-github-about = اختیاری۔ “Reported by” کے طور پر دکھایا جاتا ہے۔

