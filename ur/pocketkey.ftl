# machine translated (Urdu), not yet reviewed by a person.

# The heading when a command wants administrator rights.
# SAFETY: needs a human review before it ships
pk-title-sudo = اسے ایڈمنسٹریٹر کے طور پر چلائیں؟
# The heading when a program wants to change a system setting.
# SAFETY: needs a human review before it ships
pk-title-polkit = اس تبدیلی کی اجازت دیں؟
# The heading when a phone is being added.
# SAFETY: needs a human review before it ships
pk-title-pair = یہ فون شامل کریں؟

# Shown when a program asked to change a setting and gave no details.
# SAFETY: needs a human review before it ships
pk-what-polkit = ایک پروگرام سسٹم کی ترتیب بدلنا چاہتا ہے۔
# The question when a phone is being added. $name is the phone's name, $code the digits both screens show.
# SAFETY: needs a human review before it ships
pk-pair-detail = کیا { $name } پر کوڈ { $code } نظر آ رہا ہے؟

# The small print under the question. $user is the person's login name.
# SAFETY: needs a human review before it ships
pk-note = یہ درخواست { $user } کے لیے ہے۔ اگر آپ نے یہ شروع نہیں کی تو نہیں چنیں۔

# The name of the round button that refuses, and the word under it.
# SAFETY: needs a human review before it ships
pk-no = نہیں
# The name of the round button that agrees, and the word under it.
# SAFETY: needs a human review before it ships
pk-yes = ہاں

# The title of the window that pairs a phone.
pk-pairing-title = اپنا فون جوڑیں
# Shown while the password box is open.
pk-pairing-waiting-password = اپنا پاس ورڈ لکھیں…
# Under the QR code.
pk-pairing-scan = اپنے فون پر Pocketkey سے یہ کوڈ اسکین کریں۔ یہ تین منٹ بعد کام کرنا بند کر دیتا ہے۔
# The picture description of the QR code.
pk-pairing-qr = آپ کا فون جوڑنے کے لیے QR کوڈ
# The question under the six numbers. $name is the phone's name.
pk-pairing-same-numbers = کیا { $name } پر بھی یہی چھ ہندسے نظر آ رہے ہیں؟
# The button that stops pairing.
pk-pairing-stop = جوڑنا روکیں
# The button that closes the window once pairing has ended.
pk-pairing-close = بند کریں
# Shown when the phone is paired.
pk-pairing-paired = آپ کا فون جوڑ دیا گیا ہے۔ اب آپ پاس ورڈ لکھنے کی بجائے اس سے درخواستیں منظور کر سکتے ہیں۔
# Shown when the pairing helper could not start.
pk-pairing-not-start = Pocketkey جوڑنا شروع نہیں کر سکا۔
# Shown when pairing was stopped.
pk-pairing-stopped = جوڑنے کا عمل رک گیا۔
# The reasons the Pocketkey service gives for a pairing that did not finish.
pk-pairing-why-ran-out-of-time = کوڈ کی مدت ختم ہو گئی۔ جوڑنا دوبارہ شروع کریں۔
pk-pairing-why-not-confirmed = Pocketkey تصدیق نہیں کر سکا کہ کوڈ ایک جیسے ہیں۔ جوڑنا دوبارہ شروع کریں۔
pk-pairing-why-not-saved = Pocketkey جوڑنا محفوظ نہیں کر سکا۔
pk-pairing-why-phone-left = آپ کے فون سے رابطہ ٹوٹ گیا۔
pk-pairing-why-link-failed = Pocketkey آپ کے فون سے رابطہ نہیں کر سکا۔
pk-pairing-why-bad-keys = آپ کے فون نے حفاظتی معلومات بھیجیں جو Pocketkey استعمال نہیں کر سکتا۔
pk-pairing-why-paired-to-other = یہ فون پہلے ہی کسی اور کے ساتھ جڑا ہوا ہے۔
pk-pairing-why-too-many-codes = بہت زیادہ غلط کوڈ لکھے گئے۔ جوڑنا دوبارہ شروع کریں۔
pk-pairing-why-newer-started = یہ جوڑنا اس لیے رک گیا کہ ایک اور جوڑنا شروع ہو گیا۔
pk-pairing-why-switched-off = Pocketkey بند ہے۔ اسے چالو کریں، پھر دوبارہ کوشش کریں۔
pk-pairing-why-root = روٹ، یعنی ایڈمنسٹریٹر اکاؤنٹ، سے لاگ ان ہوتے ہوئے آپ فون نہیں جوڑ سکتے۔
pk-pairing-why-service-stopped = Pocketkey چلنا بند ہو گیا۔
pk-pairing-why-service-odd = Pocketkey کو غیر متوقع جواب ملا۔
pk-pairing-why-other = جوڑنا مکمل نہیں ہوا۔

# The words of Pocketkey's page in Plugins (packaging/plugin/pocketkey.toml).
pk-set-switched-off = Pocketkey بند ہے۔
pk-set-no-phone = آپ نے ابھی تک کوئی فون نہیں جوڑا۔ پاس ورڈ کی جگہ استعمال کرنے کے لیے ایک جوڑیں۔
pk-set-password-due = آپ کو دوبارہ پاس ورڈ لکھنا ہوگا۔
pk-set-paired-near = آپ کا فون، { $name }، جڑا ہوا ہے اور قریب ہے۔
pk-set-paired-away = آپ کا فون، { $name }، جڑا ہوا ہے مگر حد سے باہر ہے۔
pk-set-on = پاس ورڈ کی جگہ میرا فون استعمال کریں
pk-set-pair = اپنا فون جوڑیں
pk-set-lock-after = اسکرین لاک کریں اس کے بعد
pk-set-lock-after-sub = آپ کا فون اتنی دیر حد سے باہر رہے تو اسکرین لاک ہو جاتی ہے۔
pk-set-10-seconds = 10 سیکنڈ
pk-set-30-seconds = 30 سیکنڈ
pk-set-1-minute = 1 منٹ
pk-set-2-minutes = 2 منٹ
pk-set-5-minutes = 5 منٹ
pk-set-reauth = میرا پاس ورڈ دوبارہ مانگیں اس کے بعد
pk-set-reauth-sub = وقت اس سے گنا جاتا ہے جب آپ نے آخری بار اس کمپیوٹر پر پاس ورڈ لکھا تھا۔
pk-set-never = کبھی نہیں
pk-set-30-minutes = 30 منٹ
pk-set-1-hour = 1 گھنٹہ
pk-set-6-hours = 6 گھنٹے
pk-set-1-day = 1 دن
pk-set-forget = اس فون کو بھلا دیں
pk-set-forget-sub = یہ فون اس کمپیوٹر پر درخواستیں منظور نہیں کر سکے گا۔

# Under those numbers: where to answer.
pk-pairing-answer-on-screen = پوری اسکرین پر دکھائے گئے سوال کا جواب دیں۔

pk-pairing-why-needs-password = دوسرا فون شامل کرنے کے لیے آپ کو پاس ورڈ لکھنا ہوگا۔ آپ کا موجودہ فون اسے منظور نہیں کر سکتا۔ یہ ونڈو بند کریں اور جوڑنا دوبارہ شروع کریں۔

pk-set-sudo = ایڈمنسٹریٹر کمانڈز اور سسٹم کی تبدیلیاں

pk-set-sudo-sub = چنیں کہ آپ کا فون پہلے فنگر پرنٹ یا پن مانگے یا نہیں۔

pk-set-sudo-unlocked = فنگر پرنٹ یا پن مانگیں، سوائے اس کے کہ فون ابھی ابھی کھلا ہو

pk-set-sudo-any = کبھی نہ مانگیں، چاہے فون مقفل ہو

