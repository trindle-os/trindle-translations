
# machine translated (Urdu), not yet reviewed by a person.

# Name of the Region and language page, in the page list and as its heading.
settings-region-title = علاقہ اور زبان

# Words people may search for to find the Region and language page, separated by spaces.
settings-region-keywords = زبان علاقہ ملک فارمیٹ تاریخ کرنسی language locale country formats date currency

# Help line at the foot of the Region and language page.
settings-region-help = زبان اور فارمیٹ اگلی بار لاگ ان کرنے پر لاگو ہوتے ہیں۔

# Said beside the Language and Formats lists once a choice is saved.
settings-region-later = دیکھنے کے لیے لاگ آؤٹ کر کے دوبارہ لاگ ان کریں۔

# Shown while the page reads the computer.
settings-region-looking = تلاش جاری ہے…

# Under Money and paper: the paper and measures the chosen formats use (paper is a4, letter or other; measures is imperial or metric).
settings-region-paper-measures =
    { $paper ->
        [a4] A4 کاغذ
        [letter] Letter کاغذ
       *[other] کاغذ
    }، { $measures ->
        [imperial] انچ اور پاؤنڈ
       *[other] میٹرک پیمائش
    }

# Under Money and paper: { $money } is the money sign and { $paper } the paper and measures.
settings-region-money-and-paper = { $money }، { $paper }

# Under A date and a number: a date and a number written the way the formats chosen write them.
settings-region-date-and-number = { $date } اور { $number }

# Said beside the Add a language line once a language is installed.
settings-region-installed-done = انسٹال ہو گئی

# Headline when the language and the formats are the same: { $lang } is the language's name.
settings-region-everything-in = سب کچھ { $lang } میں ہے۔

# Headline when the formats differ from the language: the names are { $lang } and { $fmt }.
settings-region-menus-in = مینو { $lang } میں ہیں؛ تاریخیں اور اعداد { $fmt } کے مطابق لکھے جاتے ہیں۔

# Headline when a change is saved but waits for the next login: { $words } is the sentence so far.
settings-region-with-wait = { $words } تبدیلی دیکھنے کے لیے لاگ آؤٹ کر کے دوبارہ لاگ ان کریں۔

# Said beside the Install another line while a language is made.
settings-region-installing = انسٹال ہو رہی ہے

# Name of the list of languages for menus and messages, heading of its line and of the card.
settings-region-language = زبان

# Name of the list of formats and heading of its line.
settings-region-formats = فارمیٹ

# Help text of the Language card (the information button).
settings-region-language-about = زبان وہ ہے جس میں مینو اور پیغامات ہوتے ہیں۔ فارمیٹ وہ ہیں جن میں تاریخیں، وقت، اعداد، رقم، پیمائش اور کاغذ کا سائز لکھا جاتا ہے، اور یہ کسی اور ملک کے طریقے پر بھی ہو سکتے ہیں۔ دونوں اگلی بار لاگ ان کرنے پر لاگو ہوتے ہیں۔

# Under the Language heading.
settings-region-language-sub = مینو اور پیغامات، اگلے لاگ ان سے۔

# Under the Formats heading.
settings-region-formats-sub = تاریخیں، اعداد، رقم اور کاغذ کا سائز۔

# Heading of the line that shows a date and a number in the chosen formats.
settings-region-date-number = ایک تاریخ اور ایک عدد

# Heading of the line that shows the money and paper of the chosen formats.
settings-region-money-paper = رقم اور کاغذ

# Heading of the line that shows the language now in use.
settings-region-in-use = اب استعمال میں

# Heading of the card for installing another language.
settings-region-add = زبان شامل کریں

# Help text of the Add a language card (the information button).
settings-region-add-about = ایک اور زبان انسٹال کرتا ہے تاکہ اسے مینو یا فارمیٹ کے لیے چنا جا سکے۔ اسے بنانے میں کچھ وقت لگتا ہے اور منتظم کا پاس ورڈ چاہیے۔

# Heading of the line shown when every language is already installed.
settings-region-all-installed = ہر زبان پہلے ہی انسٹال ہے

# Heading of the line saying how many languages are installed.
settings-region-installed = انسٹال شدہ

# Under the Installed heading: how many languages are installed.
settings-region-count =
    { $n ->
        [one] { $n } زبان انسٹال ہے۔
       *[other] { $n } زبانیں انسٹال ہیں۔
    }

# Name of the list of languages that can be installed, and heading of its line.
settings-region-install-another = دوسری انسٹال کریں

# SAFETY: needs a human review before it ships
# Tip of the button that installs the chosen language.
settings-region-install-this = یہ زبان انسٹال کریں (آپ کا پاس ورڈ مانگتا ہے)

# SAFETY: needs a human review before it ships
# Under the Install another heading.
settings-region-needs-password = منتظم کا پاس ورڈ چاہیے۔

# Heading of the line saying how many more languages can be made.
settings-region-ready = شامل کرنے کے لیے تیار

# Under the Ready to add heading: how many more languages can be made.
settings-region-more =
    { $n ->
        [one] { $n } اور زبان جو یہ کمپیوٹر بنا سکتا ہے۔
       *[other] { $n } اور زبانیں جو یہ کمپیوٹر بنا سکتا ہے۔
    }

settings-region-removing = ہٹایا جا رہا ہے

settings-region-removed-done = ہٹا دی گئی

settings-region-remove-language = یہ زبان ہٹائیں

settings-region-kept = اس کمپیوٹر کی زبانیں

settings-region-kept-about = یہاں نصب تمام زبانیں۔ جو استعمال نہیں کرتے انہیں ہٹا دیں؛ جو زبان آپ استعمال کر رہے ہیں وہ رہے گی۔ ایڈمنسٹریٹر کا پاس ورڈ مانگتا ہے۔

settings-region-in-use-stays = استعمال میں ہے، اس لیے رہے گی

