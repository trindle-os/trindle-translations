#!/bin/sh
# Blocks a commit if any staged language breaks placeholders, plural forms or the em dash rule against the English.
cd "$(git rev-parse --show-toplevel)" || exit 1
E="$(readlink -f ../trindle/share/lang/en) $(readlink -f ../trindle-toolkit/share/lang/en) $(readlink -f ../trindle-scan/share/lang/en) $(readlink -f ../trindle-pocketkey/crates/dialog/share/lang/en) $(readlink -f ../trindle-folders/share/lang/en) $(readlink -f ../trindle-help/share/lang/en) $(readlink -f ../trindle-keyboard/share/lang/en) $(readlink -f ../trindle-benchmarks/share/lang/en)"
[ -x target/release/check-parity ] || { echo "build tools first: cargo build --release"; exit 1; }
tmp=$(mktemp -d) && trap 'rm -rf "$tmp"' EXIT
git checkout-index -a --prefix="$tmp/"
fail=0
for l in $(git diff --cached --name-only | cut -d/ -f1 | sort -u); do
  case "$l" in en*|tools|target|docs|.*) continue ;; esac
  [ -d "$tmp/$l" ] || continue
  out=$(./target/release/check-parity "$tmp/$l" $E 2>&1)
  echo "$out" | tail -1 | grep -qx '0 problems' || { echo "$l:"; echo "$out" | head -20; fail=1; }
done
exit $fail
