# machine translated (German), not yet reviewed by a person.

# Reason given when a file to read or change is a link, not the file itself.
folders-meta-link = das ist eine Verknüpfung, keine Datei

# Reason given when a photo's notes cannot be read; the cause follows, already written out.
folders-meta-damaged = die Kameraangaben des Fotos sind beschädigt, weil { $why }

# Cause of damaged photo notes: a block points outside the notes.
folders-meta-bad-out-of-reach = ein Teil liegt außerhalb der Angaben

# Cause of damaged photo notes: a block goes beyond the end.
folders-meta-bad-block-past-end = ein Teil reicht über ihr Ende hinaus

# Cause of damaged photo notes: the notes have no TIFF header.
folders-meta-bad-no-tiff = ihr TIFF-Kopf fehlt

# Cause of damaged photo notes: the notes are much too large.
folders-meta-bad-too-big = sie sind viel zu groß

# Cause of damaged photo notes: the parts of a JPEG photo do not line up.
folders-meta-bad-jpeg-parts = die Teile des JPEG passen nicht zusammen

# Cause of damaged photo notes: a part of a JPEG photo goes beyond the end.
folders-meta-bad-jpeg-past-end = ein Teil des JPEG reicht über das Ende der Datei hinaus

# Cause of damaged photo notes: a part of a PNG photo goes beyond the end.
folders-meta-bad-png-past-end = ein Teil des PNG reicht über das Ende der Datei hinaus

# Cause of damaged photo notes: a PNG file holds no picture.
folders-meta-bad-png-empty = das PNG enthält kein Bild

# Reason a photo's date taken is refused: it is not written like the example.
folders-meta-refuse-date = das Aufnahmedatum muss so geschrieben sein: 2026:01:02 03:04:05

# Reason a photo's note is refused: it holds a nul character.
folders-meta-refuse-nul = eine Notiz darf kein Nullzeichen enthalten

# Reason a photo's way-up setting is refused: it is not from 1 to 8.
folders-meta-refuse-way-up = die Einstellung, wie herum es angezeigt wird, muss eine Zahl von 1 bis 8 sein

# Reason a photo's notes are refused: they are too long to fit in a JPEG.
folders-meta-refuse-too-long = die Kameraangaben sind zu lang für ein JPEG

# Reason notes cannot be changed in a file that is not a JPEG or PNG photo.
folders-meta-only-jpeg-png = Kameraangaben lassen sich nur in JPEG- und PNG-Fotos ändern

# Reason a change to a song or photo was not begun: the drive has no room for the copy.
folders-meta-no-room = auf dem Laufwerk ist kein Platz mehr frei

# Reason a song's tag is refused: the tag is too big.
folders-meta-tag-too-big = die Angaben zum Song sind zu groß
