
# machine translated (German), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Deine eigenen Wörter

# Under the heading.
settings-words-about = Ändere jedes Wort, das Trindle zeigt, in jeder Sprache, und teile das Blatt als Datei.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Eine Tabelle, die irgendwo außer in der letzten Spalte geändert wurde oder nicht von Trindle selbst stammt, wird ganz abgelehnt.

# The line that picks which language the boxes are for.
settings-words-language = Sprache

# Under the language line.
settings-words-language-sub = Das Blatt gilt für diese Sprache.

# The name of the language list for the screen reader.
settings-words-language-tip = Sprache des Blatts

# The line that exports the sheet, and its button's tip.
settings-words-export = Tabelle herunterladen

# Under the export line.
settings-words-export-sub = Links Englisch, daneben deine Sprache. Ändere die rechte Seite.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Wörterblatt speichern

# The line that imports a sheet, and its button's tip.
settings-words-import = Tabelle hochladen

# Under the import line.
settings-words-import-sub = Wird zuerst ganz geprüft. Jede Abweichung installiert nichts.

# Title of the window that asks which sheet to open.
settings-words-import-title = Wörterblatt öffnen

# Under the import button when a sheet was installed.
settings-words-imported = Installiert

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Konnte nicht gespeichert werden

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Abgelehnt: Die Datei ist zu groß

# Under the import button: the file is not text.
settings-words-not-text = Abgelehnt: kein reiner Text

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Abgelehnt: versteckte Zeichen oder Steuerzeichen

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Abgelehnt: Eine Zeile ist zu lang

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Abgelehnt: kein Wörterblatt von Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Abgelehnt: eine andere Version des Blatts

# Under the import button: the language tag is not usable.
settings-words-bad-language = Abgelehnt: Die Sprache ist ungültig

# Under the import button: the notes at the top were changed.
settings-words-notes = Abgelehnt: Der Anfang des Blatts wurde geändert

# Under the import button: lines are missing or extra.
settings-words-count = Abgelehnt: Zeilen fehlen oder sind zu viel

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Abgelehnt: Der Schlüssel bei { $key } wurde geändert

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Abgelehnt: Das Englisch von { $key } wurde geändert

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Abgelehnt: Die Zeile von { $key } hat nicht die richtige Form

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Abgelehnt: Die Wörter für { $key } sind zu lang

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Abgelehnt: Die Wörter für { $key } enthalten versteckte Zeichen

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Abgelehnt: Die Wörter für { $key } enthalten Auszeichnung, einen Link oder einen Pfad

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Abgelehnt: Die Platzhalter von { $key } unterscheiden sich

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Abgelehnt: Die Datei konnte nicht gelesen werden

# Under the rule on the card: when changed words appear.
settings-words-next-start = Ihre Wörter erscheinen beim nächsten Start eines Programms.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Abgelehnt: Der Prüfwert stimmt nicht überein

settings-words-reset = Zurück zu den Wörtern von Trindle

settings-words-reset-sub = Setzt diese Sprache auf den Auslieferungszustand zurück. Deine Wörter bleiben in einer Sicherungsdatei erhalten.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Tabelle anbieten

# Under the offer button: who can send and why.
settings-words-offer-sub = Öffnet eine Seite, auf der du dich bei Buildmorphic anmeldest und sie abschickst. Trindle schickt sie nie für dich ab.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Eine eigene Sprache anlegen

# Under the start line.
settings-words-start-sub = Gib ihr einen Namen, echt oder erfunden. Sie beginnt als Englisch und wird als deine geführt.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Name deiner Sprache

# Beside the start line when the language was made.
settings-words-started = Angelegt

# Under the start line: the name is empty or too long.
settings-words-name-length = Nimm 1 bis 30 Buchstaben

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Nur Buchstaben: kein Markup, keine Pfade, keine versteckten Zeichen

# Under the start line: another language of your own has this name.
settings-words-name-taken = Du hast schon eine Sprache mit diesem Namen

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (eigene)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Entfernt diese eigene Sprache. Ihre Wörter bleiben in einem Sicherungsordner erhalten.

