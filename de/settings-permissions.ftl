# machine translated (German), not yet reviewed by a person.

# Name of the Permissions page, in the page list and as its heading.
# SAFETY: needs a human review before it ships
settings-permissions-title = Berechtigungen

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = Berechtigungen Erlauben Datenschutz Flatpak Flathub Sandbox Internet Netzwerk Dateien Ton Mikrofon Kamera Bluetooth Benachrichtigungen Plugins deb X11 XWayland ältere Programme Steam Wine Java Bildschirm Terminal Computer Thunderbolt USB4 Dock Geräte permissions allow privacy

# Help line at the foot of the Permissions page.
# SAFETY: needs a human review before it ships
settings-permissions-help = Was jede App nutzen darf. Apps von Flathub, in einem eigenen Ordner installierte Programme und Plugins sind jeweils in einem eigenen Ordner installiert und standardmäßig eingeschränkt. Ein gefülltes Symbol bedeutet erlaubt; klicke darauf, um es zu ändern. Eine Änderung bei einer Flathub-App gilt ab dem nächsten Start. Erlaubte Thunderbolt- und USB4-Geräte verbinden sich immer ohne Nachfrage; vergiss eines, um wieder gefragt zu werden.

# Red words when a permission could not be changed and nothing more is known.
# SAFETY: needs a human review before it ships
settings-permissions-not-changed = Es konnte nicht geändert werden.

# Words beside a plugin when its change was saved but the plugin could not be started again.
# SAFETY: needs a human review before it ships
settings-permissions-plugin-not-restarted = Gespeichert, aber das Plugin konnte nicht neu gestartet werden. Die Änderung gilt ab dem nächsten Start.

# Said beside an app, plugin or switch once a permission change is saved.
settings-permissions-saved = Gespeichert

# Help text of the AppImages card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-images = AppImages laufen jeweils in einer eigenen Box mit einem privaten Persönlichen Ordner. Ein gefülltes Symbol bedeutet erlaubt; klicke darauf, um es zu ändern. Eine Änderung gilt ab dem nächsten Start des AppImage.

# Help text of the Started from Folders card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-programs = Aus Folders gestartete Programme laufen jeweils in einer eigenen Box mit einem privaten Persönlichen Ordner. Ein gefülltes Symbol bedeutet erlaubt; klicke darauf, um es zu ändern. Eine Änderung gilt ab dem nächsten Start des Programms.

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# Under the Allow older programs switch.
# SAFETY: needs a human review before it ships
settings-permissions-older-why = Jedes wird vom Rest getrennt gehalten. Aus: Sie öffnen sich nicht.

# Heading of the card with the switch for older programs.
settings-permissions-older = Ältere Programme

# Label and tip of the switch that lets older programs open.
# SAFETY: needs a human review before it ships
settings-permissions-allow-older = Ältere Programme erlauben

# Help text on the Thunderbolt and USB4 card when the ports only carry screens.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-screens = Diese Anschlüsse übertragen nur Bildschirme, daher kann kein Gerät den Speicher dieses Computers erreichen und es gibt nichts zu fragen.

# Help text on the Thunderbolt and USB4 card when the ports only carry USB and screens.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-usb = Diese Anschlüsse übertragen nur USB und Bildschirme, daher kann kein Gerät den Speicher dieses Computers erreichen und es gibt nichts zu fragen.

# Help text on the Thunderbolt and USB4 card when the ports let every device in.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-all = Diese Anschlüsse lassen jedes Gerät von selbst verbinden, daher gibt es nichts zu fragen. Das wird in der Firmware des Computers festgelegt.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry screens.
settings-permissions-short-screens = Diese Anschlüsse übertragen nur Bildschirme.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry USB and screens.
settings-permissions-short-usb = Diese Anschlüsse übertragen nur USB und Bildschirme.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the firmware lets every device in.
settings-permissions-short-firmware = Die Firmware lässt jedes Gerät verbinden.

# Under a package's name: its version number is { $v }.
settings-permissions-version = Version { $v }

# Under a plugin's name when it asks for nothing: its version number is { $v }.
settings-permissions-version-asks-nothing = Version { $v }. Es verlangt nichts.

# Under a plugin's name: the words so far are { $sub }, then the ports it listens on in { $detail }.
settings-permissions-sub-listen = { $sub }. { $detail }

# Red words when a Thunderbolt or USB4 device could not be forgotten.
settings-permissions-not-forgotten = Es konnte nicht vergessen werden.

# Heading of the Thunderbolt and USB4 card.
settings-permissions-thunder = Thunderbolt und USB4

# Help text of the Thunderbolt and USB4 card: { $about } is a further sentence, or nothing.
# SAFETY: needs a human review before it ships
settings-permissions-thunder-about = Erlaubte Thunderbolt- und USB4-Geräte verbinden sich immer ohne Nachfrage; vergiss eines, um wieder gefragt zu werden. { $about }

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-ports = Die Anschlüsse

# Under The ports while the Thunderbolt and USB4 card is read.
settings-permissions-reading-ports = Es wird gelesen, was sie durchlassen…

# Heading of a line on the Thunderbolt and USB4 card.
settings-permissions-devices-allowed = Erlaubte Geräte

# Under a line of the Thunderbolt and USB4 card while it is read.
settings-permissions-reading = Wird gelesen…

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-memory-apart = Speicher getrennt gehalten

# Heading of the line on the Thunderbolt and USB4 card when the computer has no such ports.
settings-permissions-no-ports = Keine Thunderbolt- oder USB4-Anschlüsse

# Under the heading when the computer has no Thunderbolt or USB4 ports.
settings-permissions-nothing-to-ask = Es gibt also nichts zu fragen.

# Under Devices allowed when the computer has no Thunderbolt or USB4 ports.
settings-permissions-none-plug = Keine: auf diese Weise wird nichts angeschlossen.

# Heading of the line on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-nothing-ask = Nichts zu fragen

# Under Devices allowed when the ports let every device in themselves.
settings-permissions-every-one = Alle, durch die Anschlüsse selbst.

# Help text of the Thunderbolt and USB4 card when the computer keeps devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-iommu = Dieser Computer hält Geräte außerdem von Speicher fern, der ihnen nicht gegeben wurde, daher ist das Risiko kleiner. Wenn du ein Gerät vergisst, bleibt es verbunden, bis es abgesteckt wird.

# Help text of the Thunderbolt and USB4 card when the computer does not keep devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-no-iommu = Wenn du ein Gerät vergisst, bleibt es verbunden, bis es abgesteckt wird; beim nächsten Mal wird wieder danach gefragt.

# Heading of the line on the Thunderbolt and USB4 card that lists the devices.
# SAFETY: needs a human review before it ships
settings-permissions-asked-before = Nachfrage, bevor sich ein neues Gerät verbindet

# Under the heading above.
settings-permissions-forget-one = Vergiss eines, um wieder gefragt zu werden.

# Red words when the list of allowed Thunderbolt devices could not be read: the reason is { $why }.
settings-permissions-devices-not-read = Die erlaubten Geräte konnten nicht gelesen werden: { $why }

# Shown when no Thunderbolt or USB4 device has been allowed always.
# SAFETY: needs a human review before it ships
settings-permissions-no-device = Noch darf sich kein Gerät ohne Nachfrage verbinden.

# Tip of the button that forgets an allowed Thunderbolt or USB4 device.
# SAFETY: needs a human review before it ships
settings-permissions-forget-device = Dieses Gerät vergessen

# Name given to a Thunderbolt or USB4 device that has none.
settings-permissions-a-device = Ein Thunderbolt-Gerät

# Under an allowed device's name when its maker is not known.
# SAFETY: needs a human review before it ships
settings-permissions-may-always = Darf sich immer verbinden

# Under an allowed device's name: the maker is { $vendor }.
# SAFETY: needs a human review before it ships
settings-permissions-made-by = Hergestellt von { $vendor }. Darf sich immer verbinden.

# Headline while the list of apps is being read.
settings-permissions-reading-apps = Es wird gelesen, was jede App nutzen darf…

# Headline while Flatpak is still answering: how many apps are listed.
settings-permissions-reading-each =
    { $n ->
        [one] Es wird gelesen, was jede von { $n } nutzen darf…
       *[other] Es wird gelesen, was jede von { $n } nutzen darf…
    }

# Headline when no app or plugin is kept in a box of its own.
settings-permissions-no-apps = Es sind keine Apps oder Plugins installiert, die in einer eigenen Box gehalten werden.

# Headline when exactly one app is kept in a box of its own.
settings-permissions-one-app = Eine App wird in einer eigenen Box gehalten und nutzt nur, was hier erlaubt ist.

# Headline: how many apps and plugins are kept in a box of their own.
settings-permissions-many-apps =
    { $n ->
        [one] { $n } App oder ein Plugin wird in einer eigenen Box gehalten und nutzt nur, was hier erlaubt ist.
       *[other] { $n } Apps und Plugins werden jeweils in einer eigenen Box gehalten und nutzen nur, was hier erlaubt ist.
    }

# Heading of the card for apps from Flathub.
settings-permissions-flathub-apps = Flathub-Apps

# Heading of the card for programs installed in their own folder.
settings-permissions-own-folder = In eigenem Ordner

# Heading of the card for plugins.
settings-permissions-plugins = Plugins

# Heading of the card for AppImages.
settings-permissions-appimages = AppImages

# Heading of the card for programs started from Folders.
settings-permissions-from-folders = Aus Folders gestartet

# Under a kind of app on the Permissions page when none is installed.
settings-permissions-none-installed = Keine installiert.

# Under a kind of app on the Permissions page when none has been run.
settings-permissions-none-run = Noch keine ausgeführt.

# Help text of the Flathub apps card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-flathub-about = Apps von Flathub werden jeweils in einer eigenen Box gehalten und dürfen nur nutzen, was hier erlaubt ist. Ein gefülltes Symbol bedeutet erlaubt; klicke darauf, um es zu ändern. Eine Änderung gilt ab dem nächsten Start der App.

# Help text of the In their own folder card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-debs-about = In einem eigenen Ordner installierte Programme sind standardmäßig eingeschränkt. Ein gefülltes Symbol bedeutet erlaubt; klicke darauf, um es zu ändern.

# Help text of the Plugins card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-plugins-about = Plugins sind standardmäßig eingeschränkt und dürfen nur das bekommen, was sie verlangen. Ein im Hintergrund laufendes Plugin startet mit der Änderung sofort neu.

# Typing codes card: every short code Trindle swaps for words as you type.
settings-permissions-codes = Tippkürzel

# SAFETY: needs a human review before it ships
settings-permissions-codes-about = Kurze Kürzel, die Trindle beim Tippen durch Wörter ersetzt, jeweils mit dem Plugin, dem sie gehören. Schalte die Kürzel eines Plugins mit seinem runden Symbol aus.

settings-permissions-codes-none = Keine Kürzel aktiv

# SAFETY: needs a human review before it ships
settings-permissions-codes-none-sub = Ein Plugin, das Kürzel erweitern darf, wird hier aufgeführt.

# Button on a plugin's row: stops that plugin's codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-off = Kürzel von { $name } ausschalten

settings-permissions-codes-count =
    { $n ->
        [one] Ein Kürzel, { $id }
       *[other] { $n } Kürzel, { $id }
    }

# A code's second line: what it types and who owns it.
settings-permissions-code-types = Tippt „{ $words }“ für { $name }

settings-permissions-codes-more =
    { $n ->
        [one] Ein weiteres Kürzel ist aktiv
       *[other] { $n } weitere Kürzel sind aktiv
    }

# Line on the typing codes card when the plugins folder could not be read: the list may be missing codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread-line = Der Plugin-Ordner konnte nicht gelesen werden

# Red words under that line.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread = Der Plugin-Ordner konnte nicht gelesen werden, daher fehlen möglicherweise einige Kürzel.

settings-permissions-not-added = Aus Folders gestartet, nicht zu Apps hinzugefügt

settings-permissions-kind-tip = Art der App



# Heading of the card for programs that are not in a box.
settings-outside-heading = Programme außerhalb einer Box

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = Trindle sieht alle paar Sekunden nach und sagt dir Bescheid. Es kann diese Programme nicht aufhalten und kann ein schnelles übersehen. Ein Programm in einer Box wird von seiner Box gehalten.

# Label of the switch for the notice about the network.
settings-outside-network = Bescheid sagen, wenn ein Programm das Netzwerk erreicht

# Label of the switch for the notice about the person's files.
settings-outside-files = Bescheid sagen, wenn ein Programm deine Dateien geöffnet hat

# Under those two switches.
settings-outside-once = Einmal für jedes Programm.

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = Für { $name } wieder Bescheid sagen

# Under a program marked fine for the network.
settings-outside-fine-network = Das Netzwerk zu erreichen ist in Ordnung.

# Under a program marked fine for the person's files.
settings-outside-fine-files = Deine Dateien geöffnet zu haben ist in Ordnung.

# The line in the card when no program is marked fine.
settings-outside-no-fine = Kein Programm ist als in Ordnung markiert.

# Heading of the card for downloaded files.
settings-downloads-heading = Heruntergeladene Dateien

# Help text of that card (the information button).
settings-downloads-about = Eine Datei aus dem Internet ist eine in Downloads oder eine, die der Browser markiert hat. Das Programm, das sie öffnet, bekommt nur diese Datei, nur lesbar, ohne Internet und ohne deine Ordner. Das gilt nicht für die Öffnen-Taste eines Browsers, die das Programm selbst startet.

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = Heruntergeladene Dateien in einer Box öffnen

# Under that switch.
settings-downloads-box-sub = Kein Internet und nur diese Datei, nur lesbar.

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = { $kind }-Dateien normal öffnen

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = { $kind }-Dateien

# Under a file type's switch.
settings-downloads-normal-sub = An: öffnet normal, mit Internet.

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = Noch kein Typ. Einer wird aufgeführt, sobald sich eine heruntergeladene Datei in einer Box öffnet.

