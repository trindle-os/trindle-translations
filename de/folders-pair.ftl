# machine translated (German), not yet reviewed by a person.

# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Hier unterscheidet sich nichts vom anderen Fenster nach Name, Größe oder Datum. Ordner werden nur nach Namen verglichen.
        [one] 1 Eintrag hier fehlt im anderen Fenster oder unterscheidet sich in Größe oder Datum. Ordner werden nur nach Namen verglichen.
       *[other] { $n } Einträge hier fehlen im anderen Fenster oder unterscheiden sich in Größe oder Datum. Ordner werden nur nach Namen verglichen.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Dafür werden beide Fenster gebraucht: Drücke F3 für die Doppelansicht.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Suchergebnisse können nicht im anderen Fenster gezeigt werden.
