
# machine translated (German), not yet reviewed by a person.

# Error when the person stopped a file comparison before it finished.
folders-diff-stopped = Angehalten

# Right-click row in the comparison that copies the line of the left file.
folders-diff-copy-left = Linke Zeile kopieren

# Right-click row in the comparison that copies the line of the right file.
folders-diff-copy-right = Rechte Zeile kopieren

# Line in the comparison standing for a run of lines that are the same in both files.
folders-diff-same-lines =
    { $n ->
        [one] 1 Zeile gleich
       *[other] { $n } Zeilen gleich
    }
