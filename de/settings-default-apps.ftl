settings-default-apps-kind-calendar-in-sentence = den Kalender

# Title of a card on the default apps page.
settings-default-apps-card-internet = Internet

# Words behind the i of a card on the default apps page.
settings-default-apps-card-internet-about = Das Programm, das einen irgendwo angeklickten Weblink öffnet, das, das eine E-Mail schreibt, wenn eine Adresse angeklickt wird, und das, das eine Kalendereinladung öffnet.

# Title of a card on the default apps page.
settings-default-apps-card-files = Dateien und Dokumente

# Words behind the i of a card on the default apps page.
settings-default-apps-card-files-about = Das Programm, das einen Ordner, eine einfache Textdatei und ein PDF-Dokument öffnet, wenn du eines aus Folders, vom Desktop oder aus einer anderen App öffnest.

# Title of a card on the default apps page.
settings-default-apps-card-media = Bilder und Ton

# Words behind the i of a card on the default apps page.
settings-default-apps-card-media-about = Das Programm, das ein Bild, ein Musikstück oder ein Video öffnet, wenn du eines öffnest.

# Sentence at the top of the page when every kind has a program; { $web } is the program that opens web links.
settings-default-apps-all-set-web = Für alles gibt es ein Programm zum Öffnen; { $web } öffnet Weblinks.

# Sentence at the top of the page when every kind has a program and the one for web links is not known.
settings-default-apps-all-set = Für alles gibt es ein Programm zum Öffnen.

# Sentence at the top of the page when one kind has no program chosen; { $kind } is its name in lower case.
settings-default-apps-one-missing = Zum Öffnen von { $kind } ist noch nichts gewählt.

# Sentence at the top of the page when several kinds have no program chosen; { $kinds } is their names as a list joined with "or".
settings-default-apps-many-missing = Zum Öffnen von { $kinds } ist noch nichts gewählt.

# Small words under a kind that no installed program can open.
settings-default-apps-none-installed = Nichts Installiertes kann diese bisher öffnen.

# First choice in a list when no program is chosen for that kind yet.
settings-default-apps-not-chosen = Noch nicht gewählt

# Small words under a kind with a program list; { $n } is how many programs can open it.
settings-default-apps-can-open =
    { $n ->
        [one] Das eine Programm, das es kann.
       *[other] { $n } Programme können diese öffnen.
    }

# Said in green under a kind's list after the choice was kept.
settings-default-apps-saved = Gespeichert
