# Name of the Settings page about default apps, in the list and as its heading.
settings-default-apps-title = Standard-Apps

# Words a person might type into the Settings search to find the default apps page; separate them with spaces.
settings-default-apps-keywords = Browser Mail E-Mail Dateien Bilder Musik Video PDF Kalender Öffnen mit Terminal

# Introduction under the heading of the default apps page, and the words behind the page i.
settings-default-apps-help = Welches Programm Weblinks, E-Mails, Bilder, den Kalender und den Rest öffnet. Das Terminal wird in ~/.config/xdg-terminals.list gewählt; ist keines gewählt, nimmt Trindle das erste installierte.

