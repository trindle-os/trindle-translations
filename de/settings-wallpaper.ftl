
# machine translated (German), not yet reviewed by a person.

# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Hintergrundbild

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = hintergrund bild diashow foto desktophintergrund

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Eine einfarbige Fläche, ein einzelnes Bild oder ein Ordner, sodass sich das Bild zur eingestellten Zeit von selbst ändert.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 Sekunden

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 Sekunden

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = 1 Minute

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 Minuten

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 Minuten

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 Minuten

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = 1 Stunde

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = 1 Tag

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Bildschirm füllen

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Einpassen, ganzes Bild sichtbar

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = Zentriert, Originalgröße

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Strecken

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Kacheln

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = Zufällig

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = Nach Dateiname

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = Das Hintergrundbild konnte nicht geändert werden: Das zuständige Programm ließ sich nicht starten.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] { $used } von { $all } Bild
       *[other] { $used } von { $all } Bildern
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = In { $folder } sind keine Bilder

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] { $used } von { $all } Bild, das zu Trindle gehört
       *[other] { $used } von { $all } Bildern, die zu Trindle gehören
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] { $used } von { $all } Bild aus { $folder }
       *[other] { $used } von { $all } Bildern aus { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, eines der Bilder, die zu Trindle gehören

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Eine einfarbige Fläche, unten eingestellt.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Dort ist nichts mehr. Wähle ein Bild oder einen Ordner.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Eine einfarbige Fläche, ohne Bild.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Ein neues Bild nach jeweils { $every }, aus { $used } von { $all } Bild, das zu Trindle gehört.{ $extra }
       *[other] Ein neues Bild nach jeweils { $every }, aus { $used } von { $all } Bildern, die zu Trindle gehören.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Ein neues Bild nach jeweils { $every }, aus { $used } von { $all } Bild in { $folder }.{ $extra }
       *[other] Ein neues Bild nach jeweils { $every }, aus { $used } von { $all } Bildern in { $folder }.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = Im Ordner { $folder } sind keine Bilder. Wähle einen anderen.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = Der Ordner enthält mehr, als Trindle durchsucht, daher fehlen möglicherweise einige seiner Bilder.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }, eines der Bilder, die zu Trindle gehören.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = Immer ein Bild, { $name }.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = Das Bild wird nicht verwendet. { $why } Trindles eigenes wird gezeigt.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = Das Bild ist nicht mehr da. Wähle ein Bild oder einen Ordner.

# Said in green under a line after its choice was kept.
settings-wallpaper-saved = Gespeichert

# Said in green under the next picture line after the picture changed.
settings-wallpaper-changed = Geändert

# Small word drawn in the corner of a moving picture's tile.
settings-wallpaper-animated = Animiert

