# machine translated (German), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Ring

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = Favoriten Starter Rand Klick Ecke Sprache Sprechen Fenster Öffnen Zwischenablage Kopieren Einfügen Verlauf Vergessen Benachrichtigungen favourites launcher voice clipboard notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Deine Favoriten sitzen rund um die Mitte des Rings. Sie werden im Ring selbst gewählt: Klicke mit der rechten Maustaste auf eine App im Ring, um sie hinzuzufügen oder zu entfernen, und ziehe einen Favoriten auf den Platz eines anderen, um die Reihenfolge zu ändern.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = Der Ring öffnet sich am Bildschirmrand, und deine offenen Fenster sitzen darin.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Wo sich Dinge öffnen

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Am Bildschirmrand klicken

# Small words under that line about the Super key.
settings-ring-open-super = Die Super-Taste öffnet ihn auch.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } Favorit
       *[other] { $n } Favoriten
    }

# Small words under the favourites line.
settings-ring-favourites-about = Klicke mit der rechten Maustaste auf eine App im Ring, um einen hinzuzufügen.

# Title of the card about opening the ring.
settings-ring-opening = Den Ring öffnen

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Bewege den Zeiger an den Bildschirmrand und klicke, oder drücke die Super-Taste, und der Ring öffnet sich. Deine Favoriten sitzen rund um die Mitte des Rings und deine offenen Fenster in einem Ring darum: Klicke auf eines, um es nach vorn zu holen, oder klicke mit der rechten Maustaste für seine Schaltflächen. Klicke mit der rechten Maustaste auf eine App im Ring, um sie hinzuzufügen oder zu entfernen.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Beim Eintreffen anzeigen

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Aus: Sie sammeln sich trotzdem im Ring.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Wie lange sie bleiben

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Dringende warten, bis sie geschlossen werden.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Wo sie erscheinen

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Die Ecke, von der aus sie sich stapeln.

# Title of the card about notifications.
settings-ring-notify-title = Benachrichtigungen

# Words behind the i of the card about notifications.
settings-ring-notify-about = Wenn ein Programm dir etwas mitzuteilen hat, erscheint es für ein paar Sekunden und verschwindet wieder. Ist es ausgeschaltet, erscheint nichts, und alles wird weiter im Benachrichtigungskreis im Ring gesammelt. Eine dringende wartet unabhängig von dieser Wahl darauf, geschlossen zu werden, damit eine Warnung nicht verschwinden kann, bevor sie gelesen wurde.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = Kopiertes vergessen

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Angeheftete Zeilen bleiben erhalten.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Jetzt kopiert

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n } Zeile, { $pinned } angeheftet.
       *[other] { $n } Zeilen, { $pinned } angeheftet.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Zwischenablage

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Der Zwischenablage-Kreis im Ring behält, was du kopierst, damit du etwas von früher einfügen kannst. Angeheftete Zeilen bleiben immer erhalten, was auch immer hier gewählt ist.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Sprache wird hinzugefügt; mach in der Zwischenzeit weiter.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Die Bauwerkzeuge werden entfernt.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Sprache wird entfernt.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Sprachsteuerung

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = An

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Aus

# Small words under the voice switch.
settings-ring-voice-about = Wird nur auf diesem Computer verstanden.

# Heading of the line, and the name of its button, that removes voice.
settings-ring-voice-remove = Sprache entfernen

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Gibt etwa 150 MB frei.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Sprache bereit. Bauwerkzeuge behalten.

# Name of the button that removes the build tools voice left behind.
settings-ring-voice-tools-remove = Die Bauwerkzeuge entfernen

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Sprachsteuerung hinzufügen (etwa 150 MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = Optional; etwa 150 MB zum Hinzufügen.

# Title of the card about voice.
settings-ring-voice-title = Sprache

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Sage den Namen einer App, „lauter“ oder „WLAN-Einstellungen“, statt zu klicken. Tippe auf die Mitte des Rings und sprich; es hört auf zuzuhören, wenn du aufhörst. Sprache wird auf diesem Computer verstanden, und nichts wird irgendwohin gesendet. Das Hinzufügen braucht etwa 150 MB und ein paar Minuten, und du kannst in der Zwischenzeit weitermachen; das Entfernen nimmt die Spracherkennung und ihr Modell weg.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Sprache wird hinzugefügt

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Bauwerkzeuge werden entfernt

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Sprache wird entfernt

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = Bei jedem Neustart des Computers

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Nach einem Tag

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Nach einer Woche

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = Nach zwei Wochen

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Nie

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = Titel beim Zeigen anzeigen

# Small words under that switch.
settings-ring-names-about = Aus: nur die Vorschau. Screenreader bekommen den Titel trotzdem.
