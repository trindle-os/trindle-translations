
# machine translated (German), not yet reviewed by a person.

# Name of the Settings page about power, in the list and as its heading.
settings-power-title = Energie

# Words a person might type into the Settings search to find the power page; separate them with spaces.
settings-power-keywords = akku batterie ruhezustand standby energiesparen herunterfahren neustart abmelden bildschirm aus inaktiv abdunkeln sperren passwort pin ziffernblock koffein wachhalten laden ladegrenze 80 akkugesundheit

# Introduction under the heading of the power page, and the words behind the page i.
settings-power-help = Akku, Energiemodus und wann sich der Bildschirm abdunkelt, sperrt und ausschaltet, auf einem Notebook getrennt für Akku und Netzteil. Die Tasse am Reiter hält den Bildschirm wach. Sperren, Neustart und Herunterfahren sind auch hier.

# Choice in a list of how long to wait.
settings-power-time-never = Nie

# Choice in a list of how long to wait.
settings-power-time-1m = 1 Minute

# Choice in a list of how long to wait.
settings-power-time-2m = 2 Minuten

# Choice in a list of how long to wait.
settings-power-time-5m = 5 Minuten

# Choice in a list of how long to wait.
settings-power-time-10m = 10 Minuten

# Choice in a list of how long to wait.
settings-power-time-15m = 15 Minuten

# Choice in a list of how long to wait.
settings-power-time-30m = 30 Minuten

# Choice in a list of how long to wait.
settings-power-time-45m = 45 Minuten

# Choice in a list of how long to wait.
settings-power-time-1h = 1 Stunde

# Choice in a list of how long to wait.
settings-power-time-90m = 1½ Stunden

# Choice in a list of how long to wait.
settings-power-time-2h = 2 Stunden

# Choice in the lock after list: lock at no other time than when the computer sleeps.
settings-power-time-only-sleep = Nur im Ruhezustand

# Heading of the line, and name of its round button, that suspends the computer.
settings-power-suspend = Bereitschaft

# Heading of the line, and name of its round button, that restarts the computer.
# SAFETY: needs a human review before it ships
settings-power-restart = Neu starten

# Heading of the line, and name of its round button, that shuts the computer down.
# SAFETY: needs a human review before it ships
settings-power-shut-down = Herunterfahren

# Choice in the list of what closing the lid does: the computer sleeps.
settings-power-lid-sleep = Bereitschaft

# Choice in the list of what closing the lid does: the computer hibernates.
settings-power-lid-hibernate = Ruhezustand

# Choice in the list of what closing the lid does: the screen locks.
settings-power-lid-lock = Bildschirm sperren

# Choice in the list of what closing the lid does: nothing.
settings-power-lid-nothing = Nichts

# Choice in the list of what closing the lid does: the computer shuts down.
# SAFETY: needs a human review before it ships
settings-power-lid-shut-down = Herunterfahren

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-dim = Bildschirm abdunkeln nach

# Small words under an idle timer line.
settings-power-timer-dim-about = Jede Bewegung bringt die Helligkeit zurück.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-clock = Wandernde Uhr zeigen nach

# Small words under an idle timer line.
settings-power-timer-clock-about = Nur die Uhrzeit, die langsam umherwandert.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-off = Bildschirm ausschalten nach

# Small words under an idle timer line.
settings-power-timer-off-about = Jede Taste oder Bewegung schaltet ihn wieder ein.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-suspend = Bereitschaft nach

# Small words under an idle timer line.
settings-power-timer-suspend-about = So lange sich selbst überlassen, geht er schlafen.

# Red words under the keep the screen awake switch when turning it on could not be saved.
settings-power-no-awake = Der Bildschirm konnte nicht wachgehalten werden: Die Auswahl konnte nicht gespeichert werden.

# Red words under the keep the screen awake switch when turning it off could not be saved.
settings-power-no-sleep = Das Wachhalten des Bildschirms konnte nicht ausgeschaltet werden: Die Auswahl konnte nicht gespeichert werden.

# Name of the power mode that saves the battery.
settings-power-profile-saver = Energiesparen

# Name of the balanced power mode.
settings-power-profile-balanced = Ausgewogen

# Name of the power mode that favours speed.
settings-power-profile-performance = Leistung

# What the battery is doing: charging.
settings-power-state-charging = Wird geladen

# What the battery is doing: running on its own charge.
settings-power-state-battery = Im Akkubetrieb

# What the battery is doing: empty.
settings-power-state-empty = Leer

# What the battery is doing: full.
settings-power-state-full = Voll

# What the battery is doing: the charger is in but it is not charging.
settings-power-state-plugged = Angeschlossen, lädt nicht

# Time left on the battery; { $h } hours and { $m } minutes. The h and min are short for hours and minutes.
settings-power-hours-minutes = { $h } Std. { $m } Min.

# Time left on the battery when under an hour; { $m } minutes. The min is short for minutes.
settings-power-minutes = { $m } Min.

# Sentence at the top of the page on a computer with no battery.
settings-power-top-no-battery = Am Netz: Dieser Computer hat keinen Akku, um den man sich kümmern müsste.

# Sentence at the top of the page on a computer with no battery; { $mode } is the power mode.
settings-power-top-no-battery-mode = Am Netz, im Modus { $mode }: kein Akku, um den man sich kümmern müsste.

# Sentence at the top of the page while charging; { $percent } is how full.
settings-power-top-charging = Wird geladen, { $percent }%.

# Sentence at the top of the page while charging; { $percent } is how full and { $left } how long until full.
settings-power-top-charging-left = Wird geladen, { $percent }%, voll in { $left }.

# Sentence at the top of the page when the battery is full.
settings-power-top-full = Der Akku ist voll.

# Sentence at the top of the page when plugged in but not charging; { $percent } is how full.
settings-power-top-plugged = Angeschlossen bei { $percent }%, lädt nicht.

# Sentence at the top of the page on battery; { $percent } is how full.
settings-power-top-battery = Akku bei { $percent }%.

# Sentence at the top of the page on battery; { $percent } is how full and { $left } how long is left.
settings-power-top-battery-left = Akku bei { $percent }%, noch etwa { $left }.

# Sentence at the top of the page while the battery is being read.
settings-power-top-looking = Der Akku wird gelesen …

# Red words under the power mode line when the mode could not be changed.
settings-power-mode-failed = Der Energiemodus konnte nicht geändert werden.

# Heading of the power mode line, and the name of its list.
settings-power-mode = Energiemodus

# Small words under the power mode line.
settings-power-mode-about = Sparen läuft kühler, Leistung schneller.

# Said in green under a line after its choice was kept.
settings-power-saved = Gespeichert

# Name of the list of battery levels to warn at.
settings-power-warn-name = Warnen, wenn der Akku nur noch hat

# Heading of the line for the battery warning.
settings-power-warn = Warnen bei nur noch

# Small words under the battery warning line.
settings-power-warn-about = Einmal, in der Mitte des Bildschirms.

# Choice in the list of battery levels: never warn.
settings-power-never = Nie

# Heading of the line, and name of its switch, for stopping charging at 80%.
settings-power-limit = Laden bei 80% beenden

# Small words under the charge limit line.
settings-power-limit-about = Schonender für einen Akku, der meist am Netz hängt.

# Title of the battery card on a laptop.
settings-power-card-battery = Akku

# Title of the battery card when there is no battery picture and no power modes.
settings-power-card-looking-after = Den Akku pflegen

# Words behind the i of the battery card.
settings-power-battery-about = Energiesparen läuft kühler und lässt den Akku länger halten, Leistung läuft schneller, Ausgewogen liegt dazwischen. Die Warnung erscheint einmal in der Mitte des Bildschirms, während sich der Akku leert. Das Beenden bei 80% schont den Akku eines Notebooks, das meist am Netz hängt: Er lädt bis 80% und nicht weiter und hält mehr Jahre. Schalte es vor einem Tag ohne Steckdose aus.

# Words under the charge limit line while the password window is open.
# SAFETY: needs a human review before it ships
settings-power-limit-waiting = Warten auf das Passwort ...

# Green words under the charge limit line after charging was limited to 80%.
settings-power-limit-on = Hört bei 80% auf

# Green words under the charge limit line after the limit was removed.
settings-power-limit-off = Lädt bis voll

# Heading of the keep the screen awake line, and name of its switch.
settings-power-awake = Bildschirm wachhalten

# Small words under the keep the screen awake line.
settings-power-awake-about = Die Tasse am Reiter tut dasselbe.

# Title of the card about dimming and the moving clock.
settings-power-screen-title = Bildschirm

# Words behind the i of the Screen card.
settings-power-screen-about = Solange „Bildschirm wachhalten“ an ist, passiert nichts davon. Die Tasse am Reiter schaltet es ebenfalls ein und aus. Abdunkeln: Jede Bewegung bringt die Helligkeit zurück. Nur Bildschirme mit eigener Helligkeit, etwa bei einem Notebook, dunkeln ab. Die wandernde Uhr: Der Bildschirm wird dunkel und zeigt nur die Uhrzeit, die langsam umherwandert. Jede Taste oder Bewegung bringt alles zurück. Auf einem Notebook wird jede Zeit zweimal eingestellt, für den Akku und für das Netzteil.

# Title of the card about turning the screen off and sleeping.
settings-power-sleep-title = Bildschirm aus und Bereitschaft

# Words behind the i of the Screen off and sleep card.
settings-power-sleep-about = Jede Taste oder Bewegung schaltet den Bildschirm wieder ein. Bereitschaft schickt den Computer schlafen, bis du ihn weckst. Auf einem Notebook wird jede Zeit zweimal eingestellt, für den Akku und für das Netzteil. Ist ein zweiter Bildschirm angeschlossen, passiert beim Zuklappen nichts, sodass du mit dem größeren Bildschirm weiterarbeiten kannst.

# Heading of the line for what closing the lid does.
settings-power-lid = Wenn der Deckel geschlossen wird

# Small words under that line.
settings-power-lid-about = Mit einem zweiten Bildschirm passiert nichts.

# Caption above a list that applies while the laptop runs on its battery.
settings-power-when-battery = Im Akkubetrieb

# Caption above a list that applies while the laptop is plugged in.
settings-power-when-charger = Am Netz

# Name of a list that applies on battery; { $title } is the name of its line.
settings-power-named-battery = { $title }: im Akkubetrieb

# Name of a list that applies while plugged in; { $title } is the name of its line.
settings-power-named-charger = { $title }: am Netz

# Heading of the lock the screen line, and name of its switch.
# SAFETY: needs a human review before it ships
settings-power-lock = Bildschirm sperren

# Small words under the lock the screen line.
# SAFETY: needs a human review before it ships
settings-power-lock-about = Mit deinem Passwort oder einer PIN kommst du wieder hinein.

# Heading of the lock after line, and the name of its list.
# SAFETY: needs a human review before it ships
settings-power-lock-after-name = Sperren nach

# Small words under the lock after line.
# SAFETY: needs a human review before it ships
settings-power-lock-after-about = So lange sich selbst überlassen, egal was sonst eingestellt ist.

# Heading of the line, and name of its switch, for locking when the computer sleeps.
# SAFETY: needs a human review before it ships
settings-power-lock-sleep = Sperren, wenn der Computer schläft

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-lock-sleep-about = Damit er immer gesperrt aufwacht.

# Heading of the line, and name of its button, that locks the screen now.
# SAFETY: needs a human review before it ships
settings-power-lock-now = Jetzt sperren

# Small words under the lock now line.
settings-power-lock-now-about = Auch Super und L zusammen.

# Red words under the lock now line when the lock screen would not start.
settings-power-lock-now-failed = Der Bildschirm konnte nicht gesperrt werden: Der Sperrbildschirm ließ sich nicht starten.

# Title of the locking card.
# SAFETY: needs a human review before it ships
settings-power-lock-title = Sperren

# Words behind the i of the locking card.
# SAFETY: needs a human review before it ships
settings-power-lock-card-about = Wenn du weg bist, sperrt sich der Bildschirm, und mit deinem Passwort oder, falls du eine wählst, einer vierstelligen PIN kommst du wieder hinein. Bis dahin ist nichts auf dem Bildschirm zu sehen. Die Anmeldung braucht immer dein Passwort. „Sperren nach“ ist, wie lange der Computer sich selbst überlassen bleibt, bevor er sperrt, egal welche Zeiten für Bildschirm und Bereitschaft gelten. Bis dahin braucht die Rückkehr keine PIN. Wenn du das Sperren ausschaltest, wird auch die PIN vergessen. Vier Ziffern sind schneller getippt als dein Passwort: Nach der für die PIN gewählten Zeit nach dem Sperren oder nach fünf falschen Versuchen wird stattdessen dein Passwort verlangt. Der Papierkorb beendet die Verwendung einer PIN.

# Heading of the line for adding a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-add = Zusätzlich mit einer PIN entsperren

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-add-about = Vier Ziffern, schneller als dein Passwort.

# Heading of the line, and name of its list, for how long a PIN works after the screen locks.
# SAFETY: needs a human review before it ships
settings-power-pin-works-name = Die PIN gilt für

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-works-about = Danach wird stattdessen dein Passwort verlangt.

# Name of the bin button that stops using a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-stop = Keine PIN mehr verwenden

# Heading of the line shown when a PIN is kept.
# SAFETY: needs a human review before it ships
settings-power-pin-kept = Eine PIN ist gespeichert

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-kept-about = Tippe vier neue Ziffern ein, um sie zu ändern.

# Placeholder of the box for typing a new PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-new = Neue PIN

# Name of the button that keeps the PIN typed.
# SAFETY: needs a human review before it ships
settings-power-pin-keep = Diese PIN behalten

# Red words under the PIN line when the PIN could not be removed.
# SAFETY: needs a human review before it ships
settings-power-pin-not-removed = Die PIN konnte nicht entfernt werden, daher entsperrt sie den Bildschirm weiterhin.

# Red words under the PIN box when it is not the right length; { $n } is how many digits a PIN has.
settings-power-pin-digits =
    { $n ->
        [one] Eine PIN hat { $n } Ziffer.
       *[other] Eine PIN hat { $n } Ziffern.
    }

# Heading of the log out line, and name of its round button.
# SAFETY: needs a human review before it ships
settings-power-log-out = Abmelden

# Small words under the log out line.
settings-power-log-out-about = Zurück zum Anmeldebildschirm.

# Title of the card with log out, suspend, restart and shut down.
settings-power-session-title = Sitzung

# Words behind the i of the session card.
# SAFETY: needs a human review before it ships
settings-power-session-about = Beim Abmelden werden alle Fenster geschlossen, und es geht zurück zum Anmeldebildschirm. Bereitschaft schickt den Computer schlafen, bis du ihn weckst. Jede Taste fragt zweimal, genauso wie die Energieauswahl im Ring, sodass ein Ausrutscher nichts bewirkt.

# Red words under a session button when the system bus is not there.
settings-power-no-bus = Der Systembus ist nicht verfügbar.

# Red words under a session button when the computer would not do it.
settings-power-would-not = Der Computer wollte das nicht tun.

# Spoken description of the battery picture while the battery is being read.
settings-power-art-looking-tip = Der Akku wird gelesen.

# Spoken description of the battery picture; { $percent } is how full and { $state } what it is doing, such as Charging.
settings-power-art-tip = Akku bei { $percent }%. { $state }

# Word drawn in the empty battery picture while the battery is being read.
settings-power-art-looking = Lesen

# Word drawn under the battery figure when its state is not known.
settings-power-art-battery = Akku

# Words drawn in the battery picture: { $left } is the time left and { $state } is either empty or full.
settings-power-art-left =
    { $state ->
        [empty] { $left } bis leer
       *[full] { $left } bis voll
    }

# Spoken description of the battery range bar when there is no warning; { $top } is the percent it charges to.
settings-power-limits-tip = Lädt bis { $top }%, keine Warnung.

# Spoken description of the battery range bar; { $top } is the percent it charges to and { $warn } where a warning comes.
settings-power-limits-tip-warn = Lädt bis { $top }%, eine Warnung bei { $warn }%.

# A length of time in the list of how long a PIN works, in minutes; { $n } is the number.
settings-power-pin-minutes =
    { $n ->
        [one] { $n } Minute
       *[other] { $n } Minuten
    }

# A length of time in the list of how long a PIN works, in whole hours; { $n } is the number.
settings-power-pin-hours =
    { $n ->
        [one] { $n } Stunde
       *[other] { $n } Stunden
    }

# A length of time in the list of how long a PIN works, in hours and minutes; { $hours } and { $minutes } are the two parts already written out, such as 1 hour and 15 minutes.
settings-power-pin-hours-minutes = { $hours } und { $minutes }
