
# machine translated (German), not yet reviewed by a person.

# Name of the Settings page about sound, in the list and as its heading.
settings-audio-title = Audio

# Words a person might type into the Settings search to find the audio page; separate them with spaces.
settings-audio-keywords = ton lautstärke lautsprecher kopfhörer mikrofon mikro stumm test

# Introduction under the heading of the audio page, and the words behind the page i.
settings-audio-help = Wähle, welche Lautsprecher oder Kopfhörer den Ton abspielen und welches Mikrofon zuhört.

# Red sentence at the top of the page when PipeWire, the sound system, is not installed.
settings-audio-top-missing = Es gibt keinen Ton: PipeWire ist nicht installiert.

# Red sentence at the top of the page when PipeWire is installed but not answering.
settings-audio-top-failed = Es gibt keinen Ton: PipeWire antwortet nicht.

# Red sentence at the top of the page when there are no speakers or headphones.
settings-audio-top-no-output = Es wurden keine Lautsprecher oder Kopfhörer gefunden.

# Plain sentence at the top of the page while the page is still finding out about sound.
settings-audio-top-listening = Hört auf Ton …

# Warning at the top of the page when sound is muted; { $device } is the speakers or headphones.
settings-audio-top-muted = Der Ton ist stummgeschaltet, darum ist { $device } still.

# Warning at the top of the page when the volume is at nothing; { $device } is the speakers or headphones.
settings-audio-top-down = Die Lautstärke ist ganz heruntergedreht, darum ist { $device } still.

# Sentence at the top of the page when all is well; { $device } is the speakers or headphones and { $percent } the volume.
settings-audio-top-playing = Der Ton läuft über { $device } mit { $percent } %.

# Title of the card for speakers and headphones.
settings-audio-out-title = Lautsprecher und Kopfhörer

# Title of the card for microphones.
settings-audio-in-title = Mikrofon

# Heading of the line shown when no speakers or headphones are found.
settings-audio-out-none = Keine Ausgabegeräte

# Heading of the line shown when no microphone is found.
settings-audio-in-none = Keine Eingabegeräte

# Small words under that line for speakers.
settings-audio-out-plug = Schließe Lautsprecher oder Kopfhörer an.

# Small words under that line for microphones.
settings-audio-in-plug = Schließe ein Mikrofon oder Headset an.

# Heading of the line with the list of devices.
settings-audio-device = Gerät

# Small words under the device line for speakers.
settings-audio-out-device-about = Wo der Ton abgespielt wird.

# Small words under the device line for microphones.
settings-audio-in-device-about = Was zuhört.

# Name of the list of speakers and headphones.
settings-audio-out-device-name = Wo der Ton abgespielt wird

# Name of the list of microphones.
settings-audio-in-device-name = Was zuhört

# Heading of the volume line.
settings-audio-volume = Lautstärke

# Name of the volume slider for the speakers.
settings-audio-out-volume-name = Lautstärke des Tons

# Name of the volume slider for the microphone.
settings-audio-in-volume-name = Lautstärke des Mikrofons

# Heading of the mute line.
settings-audio-mute = Stummschalten

# Name of the switch that mutes the sound.
settings-audio-out-mute-name = Den Ton stummschalten

# Name of the switch that mutes the microphone.
settings-audio-in-mute-name = Das Mikrofon stummschalten

# Small words under the mute line for the speakers.
settings-audio-mute-out-about = Still, die Lautstärke bleibt erhalten.

# Small words under the mute line for the microphone.
settings-audio-mute-in-about = Solange es an ist, wird nichts gehört.

# Heading of the line that plays a test sound.
settings-audio-test = Test

# Small words under the test line.
settings-audio-test-about = Spielt einen kurzen Klang über dieses Gerät ab.

# Name of the button that plays a test sound.
settings-audio-test-button = Testton abspielen

# Words behind the i of the speakers card.
settings-audio-out-about = Wähle, welche Lautsprecher oder Kopfhörer den Ton abspielen. Lautstärke und Stummschaltung hier sind dieselben wie die Tasten auf der Tastatur und der Tonkreis im Ring.

# Heading of the line with the microphone level bar.
settings-audio-level = Pegel

# Small words under the level line.
settings-audio-level-about = Sprich, und der Balken bewegt sich, wenn es dich hört.

# Words behind the i of the microphone card.
settings-audio-in-about = Wähle, welches Mikrofon zuhört. Der Pegelbalken folgt dem, was es hört, solange diese Seite offen ist; nichts wird aufgenommen oder gespeichert.

# Title of the card shown when PipeWire is not answering.
settings-audio-failed-title = Ton

# Heading of the line in that card.
settings-audio-failed-heading = PipeWire antwortet nicht

# Small words under that line.
settings-audio-failed-about = Der Ton ist für diese Sitzung vielleicht nicht gestartet.

# Red words under the volume line when the volume could not be changed.
settings-audio-no-volume = Die Lautstärke konnte nicht geändert werden. Der Ton ist vielleicht nicht gestartet; melde dich ab und wieder an und versuche es dann noch einmal.

# Red words under the mute line when the sound could not be muted.
settings-audio-no-mute = Der Ton konnte nicht stummgeschaltet werden. Der Ton ist vielleicht nicht gestartet; melde dich ab und wieder an und versuche es dann noch einmal.

# Red words under the mute line when the sound could not be turned back on.
settings-audio-no-unmute = Der Ton konnte nicht wieder eingeschaltet werden. Der Ton ist vielleicht nicht gestartet; melde dich ab und wieder an und versuche es dann noch einmal.

# Red words under the device line when the device could not be chosen.
settings-audio-not-chosen = Dieses Gerät konnte nicht gewählt werden.

# Red words under the test line when the test sound would not play.
settings-audio-test-failed = Der Testton ließ sich über dieses Gerät nicht abspielen.



# A device's name with what kind it is; { $name } is the device and { $kind } one of the kind words below.
settings-audio-with-kind = { $name } ({ $kind })

# Kind of output: a Bluetooth device.
settings-audio-kind-bluetooth = Bluetooth

# Kind of output: a screen or TV on a cable.
settings-audio-kind-hdmi = HDMI

# Kind of output: a device on a USB cable.
settings-audio-kind-usb = USB

# Kind of output: headphones or a headset on a cable.
settings-audio-kind-headphones = Kopfhörer

# Kind of output: the computer's own speakers.
settings-audio-kind-speakers = Lautsprecher

# Heading of the line shown while Bluetooth plays the sound.
settings-audio-bt-now = Der Ton geht an Bluetooth

# Words under that heading.
settings-audio-bt-now-about = Zu den Lautsprechern wechseln; Bluetooth bleibt verbunden.

# Tooltip of the button that moves the sound to the speakers; { $device } is the speakers, kind included.
settings-audio-use-speakers = Über { $device } abspielen

# Heading of the line when Bluetooth devices are connected but have no sound output; { $names } lists them.
settings-audio-bt-silent = { $names }: verbunden, aber ohne Tonausgabe.

# Words under that heading.
settings-audio-bt-silent-about = Das Tonprofil ist vielleicht aus. Trenne das Gerät und verbinde es neu.

