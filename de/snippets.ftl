# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] 1 Textbaustein
       *[other] { $count } Textbausteine
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] { $shown } von 1 Textbaustein
       *[other] { $shown } von { $all } Textbausteinen
    }

# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Snippets konnte das Ersetzen beim Tippen nicht aktualisieren: { $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Snippets hat { $file } übersprungen. { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = Bei der Nutzung mit Espanso können Dateien Befehle auf diesem Computer ausführen: { $files }. Trotzdem importieren?

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } weitere

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] 1 Datei importiert.
       *[other] { $count } Dateien importiert.
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Snippets konnte { $path } nicht erstellen: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Snippets konnte { $file } nicht lesen. { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Es wurde nichts gespeichert, weil Snippets keine Sicherungskopie der Datei anlegen konnte: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Snippets konnte { $path } nicht schreiben: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = Snippets konnte die Datei nicht lesen: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = Snippets konnte die Datei nicht öffnen: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Snippets konnte den Textbaustein nicht speichern: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = Snippets kann diesen Textbaustein anzeigen, aber nicht bearbeiten, weil er { $names } verwendet.

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name } ist zu groß, um als Datei mit Textbausteinen importiert zu werden.

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Snippets unterstützt die Einrückung in Zeile { $line } nicht.


