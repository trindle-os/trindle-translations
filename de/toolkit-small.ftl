# machine translated (German), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = { $name } entfernen

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $value } von { $max } Sternen

# The names of the three boxes of a duration entry.
kit-duration-hours = Stunden

kit-duration-minutes = Minuten

kit-duration-seconds = Sekunden

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Schritt { $n } von { $count }

kit-step-back = Zurück

kit-step-next = Weiter

kit-step-finish = Fertig

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Suchen

kit-find-previous = Vorheriger Treffer

kit-find-next = Nächster Treffer

kit-find-none = Keine Treffer

kit-find-count = { $at } von { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Eine weitere Person
       *[other] { $n } weitere Personen
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Verlauf mit { $n } Stopps

kit-gradient-place = Position des gewählten Stopps

kit-gradient-add = Einen Stopp hinzufügen

kit-gradient-remove = Den Stopp entfernen

# The "i" button that shows and hides a card's help.
kit-help-show = Hilfe zeigen

kit-help-hide = Hilfe verbergen

