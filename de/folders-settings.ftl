
# machine translated (German), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Folders-Einstellungen

# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Das konnte nicht gespeichert werden.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Das konnte nicht gespeichert werden. Es wurde nichts geändert, weil { $why }.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Die Einstellungen von Folders konnten nicht gelesen werden. Deshalb gelten die üblichen Werte, und hier lässt sich nichts ändern, bis sie wieder lesbar sind: { $why }.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Laufwerke werden von Trindles Ring geöffnet, der auf diesem Computer nicht vorhanden ist.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = Beim Öffnen von Folders

# Choice on the settings card: the part about the list.
folders-settings-page-list = Die Liste

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Laufwerke

# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Gemerkte Anmeldungen

# Note on the Kept logins part of the settings card.
folders-settings-logins-about = Eine Anmeldung, die du dir merken ließest, wird nur an eine Adresse gesendet, bei der du sie in den letzten 90 Tagen benutzt hast. Mit „Vergessen“ gibst du sie frei.

# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = Keine Anmeldung ist gemerkt.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Der Schlüsselbund wird gefragt …

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Persönlicher Ordner und Zuletzt benutzt

# One line under that choice.
folders-settings-start-usual-sub = Persönlicher Ordner links, Zuletzt benutzt rechts.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Wo jeder Bereich zuletzt war

# One line under that choice.
folders-settings-start-last-sub = Jeder Bereich öffnet den Ordner, in dem er zuletzt war.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Hier festgelegte Orte

# One line under that choice.
folders-settings-start-chosen-sub = Unten legst du für jeden Bereich einen Ort fest.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Zuletzt benutzt

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Persönlicher Ordner

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Dokumente

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Downloads

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Bilder

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Papierkorb

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Linker Bereich

# One line under the left pane setting.
folders-settings-left-pane-sub = Wo der linke Bereich startet.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Rechter Bereich

# One line under the right pane setting.
folders-settings-right-pane-sub = Wo der rechte Bereich startet.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Wähle, wo der Bereich startet

# Button of that folder chooser that accepts the folder.
folders-settings-choose-accept = Auswählen

# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
# SAFETY: needs a human review before it ships
folders-settings-forget-failed = { $server } konnte nicht vergessen werden: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Anderen Ordner wählen

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Folders öffnet mit { $left } links und { $right } rechts.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Folders öffnet jeden Bereich dort, wo er zuletzt war.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Folders öffnet mit dem persönlichen Ordner links und „Zuletzt benutzt“ rechts.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Teil der Folders-Einstellungen

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Folders liest das bei jedem Öffnen. Es öffnet mit einem Bereich, der den linken Ort zeigt; der Schalter „Einzeln“ und „Doppelt“ in der Werkzeugleiste zeigt beide.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Wie dicht die Zeilen stehen

# Name of the setting for how close the rows sit.
folders-settings-density = Zeilen

# One line under the rows setting.
folders-settings-density-sub = Wie dicht die Dinge beieinander stehen, in jeder Ansicht.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Kästchen zum Auswählen

# One line under the tick boxes setting.
folders-settings-ticks-sub = Ein kleines Kästchen an jedem Eintrag fügt ihn zur Auswahl hinzu.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Dateiendungen anzeigen

# One line under the file endings setting.
folders-settings-endings-sub = Wenn aus, wird report.pdf als report angezeigt.

# Note under the settings of the list part.
folders-settings-list-note = Bei ausgeschalteten Dateiendungen wird die letzte Endung eines Namens weggelassen, außer wenn das irreführen würde: bei einem Namen mit zwei Endungen, einem Programm oder einer Datei, die nicht das ist, was ihre Endung sagt. Bei eingeschalteten Kästchen wählt das Kästchen in der Überschrift „Name“ alle oder keine aus.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = { $server } vergessen

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Laufwerke beim Einstecken öffnen

# One line under the drives setting.
folders-settings-drives-sub = Ein USB-Laufwerk wird beim Einstecken geöffnet.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = In jedem Fall steht es in der Seitenleiste, und der Ring sagt, dass es da ist.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Freigaben

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Freigaben beim Anmelden erneut verbinden

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Aus, bis du es wählst: Zum Verbinden einer Freigabe wird jedes Mal das Administratorpasswort verlangt, und eine Freigabe mit Anmeldung wartet, bis du auf „Erneut verbinden“ drückst.
