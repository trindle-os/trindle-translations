
# machine translated (German), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth konnte nicht eingeschaltet werden.

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth konnte nicht ausgeschaltet werden.

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth ist nicht eingeschaltet.

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } Die PIN oder die Zahl wurde nicht akzeptiert. Versuche es noch einmal.

# Said in red when the pairing was turned down; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-turned-down = { $could_not } Es wurde abgelehnt, hier oder am anderen Gerät.

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } Das andere Gerät hat nicht rechtzeitig geantwortet. Versetze es in den Kopplungsmodus und versuche es noch einmal.

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Es läuft bereits. Warte einen Moment.

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } Das Gerät hat nicht geantwortet. Prüfe, ob es eingeschaltet und in der Nähe ist, und versuche es noch einmal.

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } Das Gerät ist nicht bereit. Versetze es in den Kopplungsmodus und versuche es noch einmal.

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = Der Systembus

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Suche nach Bluetooth …

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = Bluetooth läuft auf diesem Computer nicht.

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth ist aus.

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth ist am Computer selbst ausgeschaltet.

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = Dieser Computer hat kein Bluetooth.

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = An, suche nach Geräten in der Nähe …

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = An, im Moment ist nichts verbunden.

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] An, und { $names } ist verbunden.
       *[other] An, und { $names } sind verbunden.
    }

# Help text (i button) of the Bluetooth card.
# SAFETY: needs a human review before it ships
settings-bluetooth-card-about = Der Schalter schaltet das Bluetooth dieses Computers ein oder aus; darunter steht der Name des Adapters. Solange „Für andere Geräte sichtbar“ an ist, können Geräte in der Nähe diesen Computer finden.

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = Ausgeschaltet.

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible = Für andere Geräte sichtbar

# Small line under the Visible to other devices switch.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible-sub = Geräte in der Nähe können diesen Computer finden.

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = Am Computer selbst ausgeschaltet

# Small line under it.
settings-bluetooth-hard-line-sub = Durch einen Schalter oder eine Taste. Schalte ihn zuerst ein.

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Kein Bluetooth-Adapter

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = In diesem Computer wurde kein Bluetooth-Adapter gefunden. Ein Adapter für den USB-Anschluss erscheint hier, sobald er eingesteckt ist.

# Line in that card.
settings-bluetooth-none-found = Keiner gefunden

# Small line under it.
settings-bluetooth-none-found-sub = Ein USB-Adapter erscheint hier, sobald er eingesteckt ist.

# Shown beside the Bluetooth switch while the password is asked for.
settings-bluetooth-waiting = Warte auf das Passwort ...

# Said in red when this computer could not be made visible to other devices.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible-failed = Dieser Computer konnte nicht für andere Geräte sichtbar gemacht werden.

# Said in red when this computer could not be hidden from other devices.
# SAFETY: needs a human review before it ships
settings-bluetooth-hidden-failed = Dieser Computer konnte nicht vor anderen Geräten versteckt werden.

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = Schalte Bluetooth ein, um diese zu nutzen.

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = Noch keine gekoppelt

# Small line under it.
settings-bluetooth-none-paired-sub = Suche nach Geräten, um eines zu koppeln.

# Heading of the card that lists paired devices.
settings-bluetooth-mine = Meine Geräte

# Help text (i button) of the My devices card.
# SAFETY: needs a human review before it ships
settings-bluetooth-mine-about = Geräte, die mit diesem Computer gekoppelt sind, jeweils mit ihrem Akkustand, wo er angegeben wird. Verbundene Geräte stehen beim Öffnen der Seite zuerst, und eine Zeile bleibt an ihrem Platz, solange die Seite offen ist. Die runden Tasten verbinden oder trennen ein Gerät; der Papierkorb vergisst es, dann muss es neu gekoppelt werden.

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = Suche nach Geräten ...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = Suche beenden

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = Nach Geräten suchen

# Small line under it.
settings-bluetooth-look-sub = Versetze zuerst das andere Gerät in den Kopplungsmodus.

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = In der Nähe

# Help text (i button) of the Nearby card.
# SAFETY: needs a human review before it ships
settings-bluetooth-nearby-about = Drücke auf „Nach Geräten suchen“, versetze das andere Gerät in den Kopplungsmodus und drücke dann daneben auf „Koppeln“. Geräte in der Nähe werden beim Öffnen der Seite nach Signalstärke sortiert aufgelistet, und jedes neu gefundene kommt ans Ende. Manche zeigen eine Zahl zum Vergleich mit der hier, und manche fragen nach einer PIN, die oft in ihrer Anleitung steht, oder 0000.

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Die Suche nach Geräten konnte nicht beendet werden.

# Said in red when the search could not be started.
settings-bluetooth-start-failed = Die Suche nach Geräten konnte nicht gestartet werden.

# Small line of a device that is connected.
settings-bluetooth-connected = Verbunden

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = Nicht verbunden

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = Akku { $n } %

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair = Koppeln

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = Trennen

# Tip of the button that connects a device.
settings-bluetooth-connect = Verbinden

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = Dieses Gerät vergessen

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = Es konnte nicht getrennt werden.

# Said in red when a device could not be forgotten.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget-failed = Es konnte nicht vergessen werden.

# Shown under a device while it is being paired.
settings-bluetooth-pairing = Kopplung ...

# Said in red when a device could not be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-failed = Es konnte nicht gekoppelt werden.

# Shown under a device while it is being connected.
settings-bluetooth-connecting = Verbindung wird hergestellt ...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = Es konnte nicht verbunden werden.

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = Verbunden, aber es konnte nicht so eingestellt werden, dass es sich beim nächsten Mal selbst verbindet. Verbinde es hier, wenn du es brauchst.

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = Gib { $code } am Gerät ein und drücke dort die Eingabetaste.

# Question under a device that shows a number to compare with the one on this computer.
# SAFETY: needs a human review before it ships
settings-bluetooth-compare = Zeigt das andere Gerät { $code } an?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = Nein

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = Ja, sie stimmt überein

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = Mit diesem Gerät koppeln?

# Placeholder of the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = Abbrechen

# Help line above the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin-help = Gib die PIN für dieses Gerät ein. Oft steht sie in der Anleitung, oder sie ist 0000.

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = Kopfhörer Maus Tastatur koppeln Geräte drahtlos headphones mouse keyboard pair devices wireless

# Help text at the top of the page.
settings-bluetooth-help = Drücke auf „Suchen“, versetze das andere Gerät in den Kopplungsmodus und drücke dann daneben auf „Koppeln“.

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Der Bluetooth-Ton konnte nicht neu gestartet werden, deshalb nutzen Kopfhörer vielleicht nur Grundqualität, bis du dich erneut anmeldest. { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Warum Kopfhörer nach dem Aus- und Einschalten von Bluetooth nur Grundqualität haben



# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } Es ist nicht mehr bekannt. Suche erneut danach.

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } Die gespeicherte Kopplung wird nicht mehr akzeptiert. Vergiss das Gerät und koppele es neu.

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = Es war verbunden und hat dann die Verbindung verloren. Die gespeicherte Kopplung ist vielleicht veraltet.

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = Vergessen und neu koppeln

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = Vergessen. Versetze es in den Kopplungsmodus und drücke dann auf „Koppeln“, wenn es unten erscheint.

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = Mehr dazu

