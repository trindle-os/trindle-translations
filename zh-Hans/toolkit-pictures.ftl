# machine translated (Simplified Chinese), not yet reviewed by a person.


# What a screen reader says of one picture in a gallery, large or as a thumbnail. $name is what it shows, $n its place from 1, $total how many there are.
kit-photos-place = { $name }，第 { $n } 张，共 { $total } 张

# The count shown between the arrows of a gallery.
kit-photos-count = 第 { $n } 张，共 { $total } 张

# Name of the button that shows the picture before.
kit-photos-previous = 上一张图片

# Name of the button that shows the picture after.
kit-photos-next = 下一张图片

