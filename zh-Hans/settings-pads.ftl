# machine translated (Simplified Chinese), not yet reviewed by a person.


# The page's name in the side bar.
settings-pads-title = 游戏手柄

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = 按一下手柄上的按钮即可更改它。

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = 现在请按下 { $name } 要变成的按键。

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = 没有插入手柄

# Small words under that line.
settings-pads-none-about = 插入一个手柄，它的按钮会显示在这里。

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = 哪个手柄

# What the picture is, for the screen reader.
settings-pads-picture = { $title } 的图片，按下的每个按钮都会亮起

# Title of the card of the controller's buttons.
settings-pads-buttons-title = 按钮

# Words behind the i of that card.
settings-pads-buttons-about = 每个按钮、扳机，以及摇杆和方向键的各个方向。最后按下的排在最上面。改成按键的按钮，会在不支持手柄的游戏中输入那个按键。

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = 把 { $name } 改成按键

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = 停止更改 { $name }

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = { $name } 变成什么

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = 请按一个键，或选择一个按钮

# The next choice in that list: the Escape key.
settings-pads-escape = Escape 键

# The next choice in that list: nothing at all.
settings-pads-nothing = 无

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = 方向键{ $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = { $stick }摇杆{ $way }

settings-pads-left = 左

settings-pads-right = 右

settings-pads-up = 上

settings-pads-down = 下

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = 左

settings-pads-stick-right = 右

# Title of the card of the ready-made changes.
settings-pads-quick-title = 现成的更改

# Title of the card of changes that are not one button into another.
settings-pads-other-title = 其他更改

# Words behind the i of that card.
settings-pads-other-about = 摇杆反向、摇杆互换和死区。输入格式如 Left Stick dead zone = 10%，或 Right Stick Y = inverted。



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = 键盘：{ $what }

settings-pads-on-mouse = 鼠标：{ $what }

settings-pads-on-pad = 手柄：{ $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = 左键单击

settings-pads-right-click = 右键单击

settings-pads-middle-click = 中键单击



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = 配置

# Words behind the i of that card.
settings-pads-profiles-about = 配置是一组更改。“标准”不改变任何东西，所以自带手柄支持的游戏会看到原样的手柄。每个 Steam 游戏都使用“标准”，除非您在这里为它选择配置，游戏启动时配置会自动切换。“其他任何游戏”适用于不是由 Steam 启动的游戏。

# The one switch that turns every controller change off at once.
settings-pads-changes = 手柄更改

settings-pads-changes-sub = 关闭后，每个手柄都保持原样。

# The game whose profile is shown.
settings-pads-game = 游戏

settings-pads-other-game = 其他任何游戏

settings-pads-game-running = { $name }（正在运行）

settings-pads-game-number = Steam 游戏 { $n }

# The profile the shown game uses.
settings-pads-profile = 配置

settings-pads-standard = 标准

settings-pads-standard-sub = 没有更改。

settings-pads-profile-add = 添加配置

settings-pads-profile-remove = 移除 { $name }

settings-pads-profile-name = 配置名称

# The name a new profile is given.
settings-pads-profile-new = 配置 { $n }

settings-pads-profile-empty = 配置需要一个名称。

settings-pads-profile-standard = “标准”已被使用。

settings-pads-profile-taken = 这个名称已被使用。

settings-pads-profile-gone = 该配置已不存在。

settings-pads-not-a-game = 不是 Steam 应用编号。

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = “标准”不改变任何东西。请先添加一个配置。

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = 标准：手柄保持原样。

settings-pads-top-off = 手柄更改已关闭。

