
# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Ring

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = favorit peluncur tepi klik sudut suara ucapan jendela terbuka papan klip salin tempel riwayat lupakan notifikasi

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Favorit Anda berada di sekeliling bagian tengah ring. Favorit dipilih di ring itu sendiri: klik kanan aplikasi mana pun di ring untuk menambah atau menghapusnya, dan seret favorit ke tempat favorit lain untuk mengubah urutan.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = Ring terbuka di tepi layar, dan jendela Anda yang terbuka berada di dalamnya.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Tempat item terbuka

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Klik di tepi layar

# Small words under that line about the Super key.
settings-ring-open-super = Tombol Super juga membukanya.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
       *[other] { $n } favorit
    }

# Small words under the favourites line.
settings-ring-favourites-about = Klik kanan aplikasi di ring untuk menambahkan satu.

# Title of the card about opening the ring.
settings-ring-opening = Membuka ring

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Gerakkan penunjuk ke tepi layar lalu klik, atau tekan tombol Super, dan ring terbuka. Favorit Anda berada di sekeliling bagian tengah ring, dan jendela yang terbuka dalam lingkaran di sekitarnya: klik satu untuk membawanya ke depan, atau klik kanan untuk melihat tombolnya. Klik kanan aplikasi mana pun di ring untuk menambah atau menghapusnya.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Tampilkan saat tiba

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Mati: notifikasi tetap terkumpul di ring.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Berapa lama tampil

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Yang mendesak menunggu sampai ditutup.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Tempat muncul

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Sudut tempat tumpukan bermula.

# Title of the card about notifications.
settings-ring-notify-title = Notifikasi

# Words behind the i of the card about notifications.
settings-ring-notify-about = Saat sebuah program punya sesuatu untuk disampaikan, notifikasi muncul beberapa detik lalu hilang. Jika dimatikan, tidak ada yang muncul, dan semuanya tetap terkumpul di lingkaran notifikasi di ring. Notifikasi mendesak menunggu sampai ditutup apa pun pilihan di sini, sehingga peringatan tidak hilang sendiri sebelum dibaca.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
# SAFETY: needs a human review before it ships
settings-ring-clip-forget = Lupakan yang disalin

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Baris yang disematkan tetap disimpan.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Disalin sekarang

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
       *[other] { $n } baris, { $pinned } disematkan.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Papan klip

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Lingkaran papan klip di ring menyimpan apa yang Anda salin, sehingga Anda dapat menempelkan sesuatu dari sebelumnya. Baris yang disematkan selalu disimpan, apa pun pilihan di sini.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Menambahkan suara; silakan lanjutkan pekerjaan Anda.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Menghapus alat pembangunan.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Menghapus suara.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Kontrol suara

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = Nyala

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Mati

# Small words under the voice switch.
settings-ring-voice-about = Dipahami hanya di komputer ini.

# Heading of the line, and the name of its button, that removes voice.
# SAFETY: needs a human review before it ships
settings-ring-voice-remove = Hapus suara

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Mengosongkan sekitar 150 MB.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Suara siap. Alat pembangunan disimpan.

# Name of the button that removes the build tools voice left behind.
settings-ring-voice-tools-remove = Hapus alat pembangunan

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Tambahkan kontrol suara (sekitar 150 MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = Opsional; sekitar 150 MB untuk menambahkan.

# Title of the card about voice.
settings-ring-voice-title = Suara

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Ucapkan nama aplikasi, “lebih keras” atau “pengaturan Wi-Fi” sebagai ganti mengklik. Ketuk bagian tengah ring dan bicaralah; ring berhenti mendengarkan saat Anda berhenti. Ucapan dipahami di komputer ini dan tidak ada yang dikirim ke mana pun. Menambahkannya memerlukan sekitar 150 MB dan beberapa menit, dan Anda dapat melanjutkan pekerjaan; menghapusnya menghilangkan mesin ucapan dan modelnya.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Menambahkan suara

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Menghapus alat pembangunan

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Menghapus suara

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = Setiap komputer dimulai ulang

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Setelah sehari

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Setelah seminggu

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = Setelah dua minggu

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Tidak pernah

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = Tampilkan judul saat ditunjuk

# Small words under that switch.
settings-ring-names-about = Mati: hanya cuplikan. Pembaca layar tetap mendapat judulnya.

