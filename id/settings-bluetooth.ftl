
# machine translated (Indonesian), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth tidak bisa dinyalakan.

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth tidak bisa dimatikan.

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth tidak menyala.

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } PIN atau angkanya tidak diterima. Coba lagi.

# Said in red when the pairing was turned down; the first sentence says what could not be done.
settings-bluetooth-cause-turned-down = { $could_not } Pemasangan ditolak, di sini atau di perangkat lain.

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } Perangkat lain tidak menjawab tepat waktu. Aktifkan mode pemasangan, lalu coba lagi.

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Hal itu sedang dikerjakan. Tunggu sebentar.

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } Perangkat tidak menjawab. Pastikan perangkat menyala dan berada di dekat, lalu coba lagi.

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } Perangkat belum siap dipakai. Aktifkan mode pemasangan, lalu coba lagi.

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = Bus sistem

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Mencari Bluetooth…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = Bluetooth tidak berjalan di komputer ini.

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth mati.

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth dimatikan pada komputer itu sendiri.

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = Komputer ini tidak punya Bluetooth.

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = Menyala, mencari perangkat di dekat…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = Menyala, belum ada yang terhubung.

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
       *[other] Menyala, dan { $names } terhubung.
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = Sakelar ini menyalakan atau mematikan Bluetooth komputer ini; di bawahnya ada nama adaptornya. Selama Terlihat oleh perangkat lain menyala, perangkat di dekat bisa menemukan komputer ini.

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = Dimatikan.

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible = Terlihat oleh perangkat lain

# Small line under the Visible to other devices switch.
settings-bluetooth-visible-sub = Perangkat di dekat bisa menemukan komputer ini.

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = Dimatikan pada komputer itu sendiri

# Small line under it.
settings-bluetooth-hard-line-sub = Lewat sakelar atau tombol. Nyalakan itu dulu.

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Tidak ada adaptor Bluetooth

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = Tidak ditemukan adaptor Bluetooth di komputer ini. Adaptor yang dicolokkan ke soket USB akan muncul di sini begitu dicolokkan.

# Line in that card.
settings-bluetooth-none-found = Tidak ada yang ditemukan

# Small line under it.
settings-bluetooth-none-found-sub = Adaptor USB muncul di sini setelah dicolokkan.

# Shown beside the Bluetooth switch while the password is asked for.
settings-bluetooth-waiting = Menunggu kata sandi...

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = Komputer ini tidak bisa dibuat terlihat oleh perangkat lain.

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = Komputer ini tidak bisa disembunyikan dari perangkat lain.

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = Nyalakan Bluetooth untuk memakai ini.

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = Belum ada yang dipasangkan

# Small line under it.
settings-bluetooth-none-paired-sub = Cari perangkat untuk dipasangkan.

# Heading of the card that lists paired devices.
settings-bluetooth-mine = Perangkat saya

# Help text (i button) of the My devices card.
# SAFETY: needs a human review before it ships
settings-bluetooth-mine-about = Perangkat yang dipasangkan dengan komputer ini, masing-masing dengan baterainya jika tersedia. Yang terhubung saat halaman dibuka tampil lebih dulu, dan satu baris tetap di tempatnya selama halaman terbuka. Tombol bulat menghubungkan atau memutuskan satu perangkat; tong sampah melupakannya, jadi harus dipasangkan lagi.

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = Mencari perangkat...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = Berhenti mencari

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = Cari perangkat

# Small line under it.
settings-bluetooth-look-sub = Aktifkan mode pemasangan pada perangkat lain dulu.

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = Di dekat

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = Tekan Cari perangkat, aktifkan mode pemasangan pada perangkat lain, lalu tekan Pasangkan di sebelahnya. Perangkat di dekat diurutkan dari yang terkuat saat halaman dibuka, dan setiap yang baru ditemukan ditambahkan di akhir. Ada yang menampilkan angka untuk dicocokkan dengan angka di sini, dan ada yang meminta PIN, yang sering ada di petunjuknya, atau 0000.

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Pencarian perangkat tidak bisa dihentikan.

# Said in red when the search could not be started.
settings-bluetooth-start-failed = Perangkat tidak bisa dicari.

# Small line of a device that is connected.
settings-bluetooth-connected = Terhubung

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = Tidak terhubung

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = baterai { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair = Pasangkan

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = Putuskan

# Tip of the button that connects a device.
settings-bluetooth-connect = Hubungkan

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = Lupakan perangkat ini

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = Tidak bisa diputuskan.

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = Tidak bisa dilupakan.

# Shown under a device while it is being paired.
settings-bluetooth-pairing = Memasangkan...

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = Tidak bisa dipasangkan.

# Shown under a device while it is being connected.
settings-bluetooth-connecting = Menghubungkan...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = Tidak bisa dihubungkan.

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = Terhubung, tetapi tidak bisa diatur untuk terhubung sendiri lain kali. Hubungkan di sini saat Anda memerlukannya.

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = Ketik { $code } di perangkat, lalu tekan Enter di perangkat.

# Question under a device that shows a number to compare with the one on this computer.
settings-bluetooth-compare = Apakah perangkat lain menampilkan { $code }?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = Tidak

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = Ya, cocok

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = Pasangkan dengan perangkat ini?

# Placeholder of the box where a device's PIN is typed.
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = Batal

# Help line above the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin-help = Ketik PIN untuk perangkat ini. Biasanya ada di petunjuknya, atau 0000.

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = headphone earphone mouse keyboard papan ketik pasangkan perangkat nirkabel

# Help text at the top of the page.
settings-bluetooth-help = Tekan Cari, aktifkan mode pemasangan pada perangkat lain, lalu tekan Pasangkan di sebelahnya.

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Suara Bluetooth tidak bisa dimulai ulang, jadi headphone mungkin memakai kualitas dasar sampai Anda masuk lagi. { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Mengapa headphone terdengar biasa saja setelah Bluetooth dimatikan lalu dinyalakan



# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } Perangkat ini tidak dikenali lagi. Cari lagi.

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } Pemasangan yang tersimpan tidak diterima lagi. Lupakan perangkat, lalu pasangkan lagi.

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = Perangkat terhubung, lalu terputus. Pemasangan yang tersimpan mungkin sudah usang.

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = Lupakan dan pasangkan lagi

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = Sudah dilupakan. Aktifkan mode pemasangan di perangkat, lalu tekan Pasangkan saat muncul di bawah.

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = Selengkapnya

