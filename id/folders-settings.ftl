
# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Pengaturan Folders


# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Folders tidak dapat menyimpan pengaturan ini.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Folders tidak dapat menyimpan pengaturan ini karena { $why }. Tidak ada yang diubah.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Folders tidak dapat membaca pengaturannya: { $why }. Pengaturan biasa yang ditampilkan, dan Anda tidak dapat mengubahnya sampai Folders dapat membaca pengaturan tersimpan Anda.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Membuka drive otomatis saat dicolokkan memerlukan cincin Trindle, yang tidak ada di komputer ini.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = Saat Folders dibuka

# Choice on the settings card: the part about the list.
folders-settings-page-list = Daftar

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Drive

# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Login tersimpan

# Note on the Kept logins part of the settings card.
# SAFETY: needs a human review before it ships
folders-settings-logins-about = Folders hanya mengirim login tersimpan ke alamat yang Anda pakai bersamanya dalam 90 hari terakhir.

# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = Tidak ada login tersimpan.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Memuat login tersimpan…

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Beranda dan Terbaru

# One line under that choice.
folders-settings-start-usual-sub = Beranda di kiri, Terbaru di kanan.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Tempat Anda meninggalkan setiap panel

# One line under that choice.
folders-settings-start-last-sub = Setiap panel dibuka di folder tempatnya terakhir berada.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Tempat yang Anda pilih


# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Terbaru

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Beranda

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Dokumen

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Unduhan

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Gambar

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Tempat sampah

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Panel kiri


# Name of the setting for where the right pane starts.
folders-settings-right-pane = Panel kanan


# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Pilih tempat panel dimulai


# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = Folders tidak dapat melupakan login untuk { $server }: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Pilih folder lain




# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Bagian pengaturan

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Perubahan berlaku saat Folders dibuka berikutnya. Tekan F3 untuk menampilkan atau menyembunyikan panel kanan.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Jarak antarbaris

# Name of the setting for how close the rows sit.
folders-settings-density = Jarak

# One line under the rows setting.
folders-settings-density-sub = Berlaku untuk setiap tampilan.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Kotak centang untuk memilih


# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Tampilkan akhiran berkas

# One line under the file endings setting.
folders-settings-endings-sub = Jika mati, report.pdf ditampilkan sebagai report.

# Note under the settings of the list part.
folders-settings-list-note = Saat akhiran berkas disembunyikan, Folders tetap menampilkannya untuk program, nama dengan dua akhiran, dan berkas yang bukan seperti kata akhirannya. Saat kotak centang menyala, kotak di judul Nama memilih semuanya atau tidak sama sekali.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = Lupakan { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Buka drive saat dicolokkan

# One line under the drives setting.
folders-settings-drives-sub = Untuk flash disk USB.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Bagaimanapun, drive muncul di bilah samping dan cincin menunjukkan bahwa drive ada di sana.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Berbagi

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Hubungkan kembali berbagi saat Anda masuk

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Mati pada awalnya, karena menghubungkan berbagi memerlukan kata sandi administrator setiap kali. Berbagi yang perlu login hanya terhubung saat Anda menekan Hubungkan kembali.
