# machine translated (Indonesian), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = Program AI

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = ai program claude codex cursor gemini aider agen pagar sandbox pribadi folder bagikan ssh kunci token sudo

# Help line at the foot of the AI programs page.
settings-ai-help = Program pemrograman AI berjalan di dalam pagar yang menyembunyikan berkas pribadi Anda. Bagikan hanya folder yang mereka perlukan.

# Headline of the AI programs page.
# SAFETY: needs a human review before it ships
settings-ai-note = Ini menjauhkan program AI dari berkas pribadi Anda dalam pemakaian sehari-hari, misalnya jika salah satunya ditipu untuk mengumpulkan laporan rekening bank Anda dan mengirimkannya keluar. Ini perlindungan terbatas, bukan jaminan: program yang gigih, cacat pada perangkat lunak komputer, atau Anda yang menyetujui permintaan atau membagikan folder tetap bisa membuat sesuatu lolos.

# Note under the headline of the AI programs page.
settings-ai-inside = Semua yang dijalankan program AI, seperti program terpasang, skrip, dan program lain, tetap berada di dalam pagar bersamanya.

# Red words when a change to the fence could not be made.
settings-ai-not-changed = Tidak dapat diubah.

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = Tersimpan

# Title of the window for choosing a folder to share with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-choose-folder = Pilih folder untuk dibagikan dengan program AI

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = Kunci tidak dapat dibuat.

# Label of the switch that limits the network of AI programs, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-limit-net = Batasi jaringan ke situs yang tercantum di sini

# Under the Limit the network heading.
settings-ai-limit-net-sub = Mati: jaringan terbuka. Hidup: hanya situs di bawah.

# Tip of the button that removes a site from the list AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-stop-site = Hentikan program AI menjangkau situs ini

# Example in the box for typing a site AI programs may reach.
settings-ai-eg-site = misalnya api.anthropic.com

# Tip of the button that adds a site AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-let-site = Izinkan program AI menjangkau situs ini

# Heading of the line for adding a site.
settings-ai-add-site = Tambah situs

# Under the Add a site heading.
settings-ai-add-site-sub = Namanya, atau *.example.com untuk setiap nama di bawahnya.

# Heading of the card that limits the network of AI programs.
settings-ai-network = Jaringan

# Help text of the Network card (the information button).
settings-ai-network-about = Lanjutan. Saat mati, program AI memakai jaringan seperti Anda. Saat hidup, mereka hanya dapat menjangkau situs di bawah, lewat sambungan aman (https), dan pagar tidak punya jaringan sendiri. Alat sebuah program harus memakai pengaturan proksi yang diberikan kepadanya. Tambahkan situs layanan AI, dan sumber paket apa pun yang diperlukan pemasangan.

# Label of the switch that keeps AI programs inside the fence, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-keep-inside = Jaga program AI tetap di dalam pagar

# Under the fence switch when it is on.
settings-ai-hides-home = Menyembunyikan folder beranda Anda, kecuali folder yang dibagikan di bawah.

# Under the fence switch when it is off.
# SAFETY: needs a human review before it ships
settings-ai-fence-off = Pagar mati. Program AI sekarang dapat melihat semua yang dapat Anda lihat.

# Heading of the card with the fence switch.
settings-ai-the-fence = Pagar

# Help text of The fence card (the information button).
settings-ai-fence-about = Sistem tetap terlihat dan dapat dipakai oleh program AI. Folder beranda Anda diganti dengan beranda pribadi kosong yang mereka simpan di antara pemakaian, hanya dengan folder yang Anda bagikan. Mereka tidak dapat melihat program lain, sesi, kunci, atau kata sandi Anda. Program yang dijalankan dengan cara lain selain lewat namanya di daftar ini tidak dipagari. Jika Anda telah memasang koneksi asisten (trindle-mcp), asisten yang terhubung dapat membaca hal berikut tanpa bertanya kepada Anda: judul jendela yang terbuka dan aplikasi di baliknya, aplikasi terpasang, program yang berjalan beserta pemakaian memorinya, kondisi memori, disk, baterai, waktu aktif, dan jaringan, pengaturan Trindle Anda, hingga 500 baris jurnal sistem untuk layanan apa pun, catatan crash terbaru, serta nama perangkat suara, perangkat Bluetooth yang dipasangkan, jaringan Wi-Fi di sekitar, dan drive. Asisten selalu bertanya kepada Anda sebelum mengubah apa pun.

# Label of the switch that fences one AI program: its name is { $name }.
# SAFETY: needs a human review before it ships
settings-ai-fence-name = Pagari { $name }

# Tip of the button that takes one program off the list: its name is { $name }.
settings-ai-take-off = Keluarkan { $name } dari daftar

# Label of the switch for using a program's existing settings folder: its name is { $name }.
settings-ai-own-for = Pakai folder pengaturan saya yang ada untuk { $name }

# Heading of the line with the switch for using a program's existing settings folder.
settings-ai-own = Pakai folder pengaturan saya yang ada

# Under the existing settings folder heading.
settings-ai-own-sub = Berisi percakapan program ini sebelumnya.

# Example in the box for typing the name of an AI program.
settings-ai-eg-program = misalnya claude

# Tip of the button that adds an AI program, and heading of its line.
settings-ai-add-program = Tambah program

# Under the Add a program heading.
settings-ai-add-program-sub = Ketik nama yang Anda pakai untuk memulainya.

# Help text of the AI programs card (the information button).
settings-ai-programs-about = Nama-nama ini dimulai di dalam pagar. Pakai folder pengaturan saya yang ada: jika mati, program dimulai dengan folder pribadi yang baru. Program masuk sendiri di dalam: akun masuk Anda tidak dibagikan.

# Heading of the line shown when no folder is shared with AI programs.
settings-ai-nothing-shared = Tidak ada yang dibagikan

# Under the Nothing is shared heading.
settings-ai-none-seen = Program AI tidak melihat satu pun folder Anda.

# Label of the switch that lets AI programs only read a shared folder.
# SAFETY: needs a human review before it ships
settings-ai-only-read = Izinkan hanya membaca folder ini

# Tip of the button that stops sharing a folder with AI programs.
settings-ai-make-private = Jadikan folder ini pribadi lagi

# Under a shared folder's path, beside the switch that makes it read only.
settings-ai-only-read-short = Hanya izinkan membaca

# Tip of the button that shares a folder, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-share-folder = Bagikan folder

# Under the Share a folder heading.
settings-ai-share-folder-sub = Terlihat di tempat yang sama, untuk dibaca dan ditulis.

# Heading of the card listing folders shared with AI programs.
settings-ai-shared = Dibagikan dengan program AI

# Help text of the shared folders card (the information button).
settings-ai-shared-about = Pribadi dari program AI adalah aturan untuk semua yang lain di folder beranda Anda. Folder tersembunyi, dan folder yang menyimpan kunci, kata sandi, atau surel, tidak pernah dapat dibagikan. Folder yang dibagikan di sini ada saat program dimulai berikutnya.

# Tip of the button that removes a computer from the list AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-stop-computer = Hentikan program AI menjangkau komputer ini

# Example in the box for typing a computer AI programs may reach by ssh.
settings-ai-eg-computer = misalnya nas.local

# Tip of the button that adds a computer AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-let-computer = Izinkan program AI menjangkau komputer ini

# Heading of the line for adding a computer.
settings-ai-add-computer = Tambah komputer

# Under the Add a computer heading.
settings-ai-add-computer-sub = Ketik namanya.

# Note showing the public key to put on each computer: the key is { $key }.
settings-ai-put-key = Taruh kunci ini di setiap komputer: { $key }

# Tip of the button that makes a key for AI programs.
settings-ai-make-key = Buat kuncinya

# Heading of the line for making a key for AI programs.
settings-ai-make-key-for = Buat kunci untuk program AI

# Under the Make a key heading.
settings-ai-make-key-sub = Kunci terpisah, disimpan di luar folder yang dapat mereka lihat.

# Heading of the card listing computers AI programs may reach by ssh.
settings-ai-ssh = Komputer yang boleh mereka jangkau lewat ssh

# Help text of the ssh card (the information button).
settings-ai-ssh-about = Di dalam pagar, ssh bertanya kepada Trindle, yang memakai kunci sendiri dan hanya untuk komputer yang tercantum di sini. Kunci Anda sendiri tidak pernah diperlihatkan kepada program AI.

# Tip of the button that stops giving AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-stop-key = Berhenti memberikan kunci ini kepada program AI

# Under the name of a key that AI programs are given.
settings-ai-given = Diberikan kepada program AI

# Example in the box for typing a key to give AI programs: a name, an equals sign and the value.
settings-ai-eg-key = NAMA=nilai

# Tip of the button that gives AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-give-key = Berikan kunci ini kepada program AI

# Heading of the line for adding a key.
settings-ai-add-key = Tambah kunci

# Under the Add a key heading.
settings-ai-add-key-sub = Ditulis sebagai NAMA=nilai.

# Heading of the card listing keys given to AI programs.
settings-ai-keys = Kunci yang diberikan kepada program AI

# Help text of the keys card (the information button).
settings-ai-keys-about = Kunci dan token di sesi Anda tidak pernah sampai ke program AI. Kunci yang diketik di sini diberikan kepada mereka, dan hanya di sini.
