
# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Settings page about power, in the list and as its heading.
settings-power-title = Daya

# Words a person might type into the Settings search to find the power page; separate them with spaces.
settings-power-keywords = battery suspend sleep shut down restart log out screen off idle dim lock password pin keypad caffeine keep awake charge charging limit 80 battery health baterai tidur matikan mulai ulang keluar layar kunci kata sandi daya pengisian

# Introduction under the heading of the power page, and the words behind the page i.
settings-power-help = Baterai, mode daya, dan kapan layar meredup, terkunci, dan mati, pada laptop terpisah untuk baterai dan untuk pengisi daya. Cangkir di tab menjaga layar tetap menyala. Kunci, mulai ulang, dan matikan juga ada di sini.

# Choice in a list of how long to wait.
settings-power-time-never = Tidak pernah

# Choice in a list of how long to wait.
settings-power-time-1m = 1 menit

# Choice in a list of how long to wait.
settings-power-time-2m = 2 menit

# Choice in a list of how long to wait.
settings-power-time-5m = 5 menit

# Choice in a list of how long to wait.
settings-power-time-10m = 10 menit

# Choice in a list of how long to wait.
settings-power-time-15m = 15 menit

# Choice in a list of how long to wait.
settings-power-time-30m = 30 menit

# Choice in a list of how long to wait.
settings-power-time-45m = 45 menit

# Choice in a list of how long to wait.
settings-power-time-1h = 1 jam

# Choice in a list of how long to wait.
settings-power-time-90m = 1½ jam

# Choice in a list of how long to wait.
settings-power-time-2h = 2 jam

# Choice in the lock after list: lock at no other time than when the computer sleeps.
settings-power-time-only-sleep = Hanya saat tidur

# Heading of the line, and name of its round button, that suspends the computer.
settings-power-suspend = Tangguhkan

# Heading of the line, and name of its round button, that restarts the computer.
# SAFETY: needs a human review before it ships
settings-power-restart = Mulai ulang

# Heading of the line, and name of its round button, that shuts the computer down.
# SAFETY: needs a human review before it ships
settings-power-shut-down = Matikan

# Choice in the list of what closing the lid does: the computer sleeps.
settings-power-lid-sleep = Tidur

# Choice in the list of what closing the lid does: the computer hibernates.
settings-power-lid-hibernate = Hibernasi

# Choice in the list of what closing the lid does: the screen locks.
settings-power-lid-lock = Kunci layar

# Choice in the list of what closing the lid does: nothing.
settings-power-lid-nothing = Tidak ada

# Choice in the list of what closing the lid does: the computer shuts down.
# SAFETY: needs a human review before it ships
settings-power-lid-shut-down = Matikan

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-dim = Redupkan layar setelah

# Small words under an idle timer line.
settings-power-timer-dim-about = Gerakan apa pun mengembalikan kecerahan.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-clock = Tampilkan jam bergerak setelah

# Small words under an idle timer line.
settings-power-timer-clock-about = Hanya waktu, bergerak perlahan.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-off = Matikan layar setelah

# Small words under an idle timer line.
settings-power-timer-off-about = Tombol atau gerakan apa pun menyalakannya lagi.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-suspend = Tangguhkan setelah

# Small words under an idle timer line.
settings-power-timer-suspend-about = Jika dibiarkan selama ini, komputer tidur.

# Red words under the keep the screen awake switch when turning it on could not be saved.
settings-power-no-awake = Layar tidak dapat dijaga tetap menyala: pilihan tidak dapat disimpan.

# Red words under the keep the screen awake switch when turning it off could not be saved.
settings-power-no-sleep = Menjaga layar tetap menyala tidak dapat dimatikan: pilihan tidak dapat disimpan.

# Name of the power mode that saves the battery.
settings-power-profile-saver = Hemat baterai

# Name of the balanced power mode.
settings-power-profile-balanced = Seimbang

# Name of the power mode that favours speed.
settings-power-profile-performance = Performa

# What the battery is doing: charging.
settings-power-state-charging = Mengisi daya

# What the battery is doing: running on its own charge.
settings-power-state-battery = Memakai baterai

# What the battery is doing: empty.
settings-power-state-empty = Kosong

# What the battery is doing: full.
settings-power-state-full = Penuh

# What the battery is doing: the charger is in but it is not charging.
settings-power-state-plugged = Tersambung, tidak mengisi

# Time left on the battery; { $h } hours and { $m } minutes. The h and min are short for hours and minutes.
settings-power-hours-minutes = { $h } j { $m } mnt

# Time left on the battery when under an hour; { $m } minutes. The min is short for minutes.
settings-power-minutes = { $m } mnt

# Sentence at the top of the page on a computer with no battery.
settings-power-top-no-battery = Tersambung ke listrik: komputer ini tidak punya baterai untuk dirawat.

# Sentence at the top of the page on a computer with no battery; { $mode } is the power mode.
settings-power-top-no-battery-mode = Tersambung ke listrik, dalam mode { $mode }: tidak ada baterai untuk dirawat.

# Sentence at the top of the page while charging; { $percent } is how full.
settings-power-top-charging = Mengisi daya, { $percent }%.

# Sentence at the top of the page while charging; { $percent } is how full and { $left } how long until full.
settings-power-top-charging-left = Mengisi daya, { $percent }%, penuh dalam { $left }.

# Sentence at the top of the page when the battery is full.
settings-power-top-full = Baterai penuh.

# Sentence at the top of the page when plugged in but not charging; { $percent } is how full.
settings-power-top-plugged = Tersambung pada { $percent }%, tidak mengisi.

# Sentence at the top of the page on battery; { $percent } is how full.
settings-power-top-battery = Baterai { $percent }%.

# Sentence at the top of the page on battery; { $percent } is how full and { $left } how long is left.
settings-power-top-battery-left = Baterai { $percent }%, sekitar { $left } lagi.

# Sentence at the top of the page while the battery is being read.
settings-power-top-looking = Memeriksa baterai…

# Red words under the power mode line when the mode could not be changed.
settings-power-mode-failed = Mode daya tidak dapat diubah.

# Heading of the power mode line, and the name of its list.
settings-power-mode = Mode daya

# Small words under the power mode line.
settings-power-mode-about = Hemat lebih dingin; performa lebih cepat.

# Said in green under a line after its choice was kept.
settings-power-saved = Tersimpan

# Name of the list of battery levels to warn at.
settings-power-warn-name = Peringatkan saat baterai tinggal

# Heading of the line for the battery warning.
settings-power-warn = Peringatkan saat tinggal

# Small words under the battery warning line.
settings-power-warn-about = Sekali, di tengah layar.

# Choice in the list of battery levels: never warn.
settings-power-never = Tidak pernah

# Heading of the line, and name of its switch, for stopping charging at 80%.
settings-power-limit = Berhenti mengisi pada 80%

# Small words under the charge limit line.
settings-power-limit-about = Lebih ramah bagi baterai yang sebagian besar tersambung ke listrik.

# Title of the battery card on a laptop.
settings-power-card-battery = Baterai

# Title of the battery card when there is no battery picture and no power modes.
settings-power-card-looking-after = Merawat baterai

# Words behind the i of the battery card.
settings-power-battery-about = Hemat baterai berjalan lebih dingin dan membuat baterai bertahan lebih lama; performa berjalan lebih cepat; seimbang ada di antara keduanya. Peringatan muncul di tengah layar sekali, saat baterai menurun. Berhenti pada 80% lebih ramah bagi baterai laptop yang sebagian besar tersambung ke listrik: diisi sampai 80% dan tidak lebih, dan awet lebih bertahun-tahun. Matikan sebelum seharian jauh dari stopkontak.

# Words under the charge limit line while the password window is open.
# SAFETY: needs a human review before it ships
settings-power-limit-waiting = Menunggu kata sandi...

# Green words under the charge limit line after charging was limited to 80%.
settings-power-limit-on = Berhenti pada 80%

# Green words under the charge limit line after the limit was removed.
settings-power-limit-off = Diisi sampai penuh

# Heading of the keep the screen awake line, and name of its switch.
settings-power-awake = Jaga layar tetap menyala

# Small words under the keep the screen awake line.
settings-power-awake-about = Cangkir di tab melakukan hal yang sama.

# Title of the card about dimming and the moving clock.
settings-power-screen-title = Layar

# Words behind the i of the Screen card.
settings-power-screen-about = Selama Jaga layar tetap menyala aktif, tidak satu pun dari ini terjadi; cangkir di tab juga menyalakan dan mematikannya. Meredup: gerakan apa pun mengembalikan kecerahan; hanya layar dengan kecerahan sendiri, seperti layar laptop, yang meredup. Jam bergerak: layar menjadi gelap hanya dengan waktu di atasnya, bergerak perlahan, dan tombol atau gerakan apa pun mengembalikan semuanya. Pada laptop setiap waktu diatur dua kali, untuk baterai dan untuk pengisi daya.

# Title of the card about turning the screen off and sleeping.
settings-power-sleep-title = Layar mati dan tidur

# Words behind the i of the Screen off and sleep card.
settings-power-sleep-about = Tombol atau gerakan apa pun menyalakan layar lagi. Menangguhkan membuat komputer tidur sampai Anda membangunkannya. Pada laptop setiap waktu diatur dua kali, untuk baterai dan untuk pengisi daya. Dengan layar kedua tersambung, menutup penutup tidak melakukan apa-apa, sehingga Anda dapat melanjutkan dengan layar yang lebih besar.

# Heading of the line for what closing the lid does.
settings-power-lid = Saat penutup ditutup

# Small words under that line.
settings-power-lid-about = Tidak terjadi apa-apa jika ada layar kedua.

# Caption above a list that applies while the laptop runs on its battery.
settings-power-when-battery = Memakai baterai

# Caption above a list that applies while the laptop is plugged in.
settings-power-when-charger = Tersambung ke listrik

# Name of a list that applies on battery; { $title } is the name of its line.
settings-power-named-battery = { $title }: memakai baterai

# Name of a list that applies while plugged in; { $title } is the name of its line.
settings-power-named-charger = { $title }: tersambung ke listrik

# Heading of the lock the screen line, and name of its switch.
settings-power-lock = Kunci layar

# Small words under the lock the screen line.
# SAFETY: needs a human review before it ships
settings-power-lock-about = Kata sandi atau PIN Anda membawa Anda kembali masuk.

# Heading of the lock after line, and the name of its list.
settings-power-lock-after-name = Kunci setelah

# Small words under the lock after line.
settings-power-lock-after-about = Jika dibiarkan selama ini, apa pun yang diatur lainnya.

# Heading of the line, and name of its switch, for locking when the computer sleeps.
settings-power-lock-sleep = Kunci saat komputer tidur

# Small words under that line.
settings-power-lock-sleep-about = Sehingga selalu bangun dalam keadaan terkunci.

# Heading of the line, and name of its button, that locks the screen now.
settings-power-lock-now = Kunci sekarang

# Small words under the lock now line.
settings-power-lock-now-about = Bisa juga dengan Super dan L bersamaan.

# Red words under the lock now line when the lock screen would not start.
settings-power-lock-now-failed = Layar tidak dapat dikunci: layar kunci tidak mau dimulai.

# Title of the locking card.
settings-power-lock-title = Penguncian

# Words behind the i of the locking card.
# SAFETY: needs a human review before it ships
settings-power-lock-card-about = Saat Anda pergi, layar terkunci, dan kata sandi Anda, atau PIN empat angka jika Anda memilihnya, membawa Anda kembali masuk. Tidak ada yang tampil di layar sampai saat itu. Login selalu memerlukan kata sandi Anda. Kunci setelah adalah berapa lama komputer dibiarkan sebelum terkunci, berapa pun waktu layar dan tidurnya; sebelum itu, kembali tidak memerlukan PIN. Mematikan penguncian juga melupakan PIN. Empat angka lebih cepat diketik daripada kata sandi Anda: setelah waktu yang dipilih untuk PIN berakhir, atau setelah lima kali salah, kata sandi Anda diperlukan sebagai gantinya. Tong sampah berhenti memakai PIN.

# Heading of the line for adding a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-add = Buka kunci juga dengan PIN

# Small words under that line.
settings-power-pin-add-about = Empat angka, lebih cepat daripada kata sandi Anda.

# Heading of the line, and name of its list, for how long a PIN works after the screen locks.
# SAFETY: needs a human review before it ships
settings-power-pin-works-name = PIN berlaku selama

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-works-about = Setelah itu kata sandi Anda diperlukan.

# Name of the bin button that stops using a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-stop = Berhenti memakai PIN

# Heading of the line shown when a PIN is kept.
# SAFETY: needs a human review before it ships
settings-power-pin-kept = PIN tersimpan

# Small words under that line.
settings-power-pin-kept-about = Ketik empat angka baru untuk mengubahnya.

# Placeholder of the box for typing a new PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-new = PIN baru

# Name of the button that keeps the PIN typed.
# SAFETY: needs a human review before it ships
settings-power-pin-keep = Simpan PIN ini

# Red words under the PIN line when the PIN could not be removed.
# SAFETY: needs a human review before it ships
settings-power-pin-not-removed = PIN tidak dapat dihapus, jadi masih membuka kunci layar.

# Red words under the PIN box when it is not the right length; { $n } is how many digits a PIN has.
settings-power-pin-digits =
    { $n ->
       *[other] PIN terdiri dari { $n } angka.
    }

# Heading of the log out line, and name of its round button.
# SAFETY: needs a human review before it ships
settings-power-log-out = Keluar

# Small words under the log out line.
settings-power-log-out-about = Kembali ke layar login.

# Title of the card with log out, suspend, restart and shut down.
settings-power-session-title = Sesi

# Words behind the i of the session card.
# SAFETY: needs a human review before it ships
settings-power-session-about = Keluar menutup semua jendela dan kembali ke layar login. Menangguhkan membuat komputer tidur sampai Anda membangunkannya. Setiap tombol bertanya dua kali, sama seperti pilihan daya di ring, sehingga salah pencet tidak berakibat apa-apa.

# Red words under a session button when the system bus is not there.
settings-power-no-bus = Bus sistem tidak tersedia.

# Red words under a session button when the computer would not do it.
settings-power-would-not = Komputer tidak mau melakukannya.

# Spoken description of the battery picture while the battery is being read.
settings-power-art-looking-tip = Memeriksa baterai.

# Spoken description of the battery picture; { $percent } is how full and { $state } what it is doing, such as Charging.
settings-power-art-tip = Baterai { $percent }%. { $state }

# Word drawn in the empty battery picture while the battery is being read.
settings-power-art-looking = Memeriksa

# Word drawn under the battery figure when its state is not known.
settings-power-art-battery = Baterai

# Words drawn in the battery picture: { $left } is the time left and { $state } is either empty or full.
settings-power-art-left =
    { $state ->
        [empty] { $left } sampai kosong
       *[full] { $left } sampai penuh
    }

# Spoken description of the battery range bar when there is no warning; { $top } is the percent it charges to.
settings-power-limits-tip = Diisi sampai { $top }%; tanpa peringatan.

# Spoken description of the battery range bar; { $top } is the percent it charges to and { $warn } where a warning comes.
settings-power-limits-tip-warn = Diisi sampai { $top }%; peringatan pada { $warn }%.

# A length of time in the list of how long a PIN works, in minutes; { $n } is the number.
settings-power-pin-minutes =
    { $n ->
       *[other] { $n } menit
    }

# A length of time in the list of how long a PIN works, in whole hours; { $n } is the number.
settings-power-pin-hours =
    { $n ->
       *[other] { $n } jam
    }

# A length of time in the list of how long a PIN works, in hours and minutes; { $hours } and { $minutes } are the two parts already written out, such as 1 hour and 15 minutes.
settings-power-pin-hours-minutes = { $hours } { $minutes }
