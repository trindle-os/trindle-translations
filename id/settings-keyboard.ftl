
# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Settings page about the keyboard and mouse, in the list and as its heading.
settings-keyboard-title = Papan ketik dan mouse

# Words a person might type into the Settings search to find the keyboard page; separate them with spaces.
settings-keyboard-keywords = tata letak bahasa mengetik caps lock papan ketik di layar tombol ring mouse touchpad trackpad penunjuk kecepatan ketuk klik gulir roda lebih lambat lebih cepat alami kidal plugin pintasan tombol petakan ubah tukar ctrl escape super alt mac tombol samping diketuk ditahan dibuat oleh program keyd keyboard layout

# Introduction under the heading of the keyboard page, and the words behind the page i.
settings-keyboard-help = Semua yang ada di sini langsung berubah. Tata letak kedua dipertukarkan dengan Alt dan Shift bersamaan.

# First sentence at the top of the page; { $layout } is the name of the layout in use.
settings-keyboard-top-typing = Mengetik dalam { $layout }.

# Sentence after it when a second layout is set; { $layout } is the second layout.
settings-keyboard-top-second = Alt dan Shift berganti ke { $layout }.

# Sentence after it when Caps Lock is set to do nothing.
settings-keyboard-top-caps-nothing = Caps Lock tidak melakukan apa-apa.

# Sentence after it when Caps Lock is set to act as another key; { $key } is that key, such as Escape.
settings-keyboard-top-caps-acts = Caps Lock berfungsi sebagai { $key }.

# The key Caps Lock acts as, in the middle of a sentence: a second Ctrl key.
settings-keyboard-caps-as-ctrl = Ctrl kedua

# The key Caps Lock acts as, in the middle of a sentence.
settings-keyboard-caps-as-escape = Escape

# The key Caps Lock acts as, in the middle of a sentence.
settings-keyboard-caps-as-backspace = Backspace

# Sentence at the top of the page when the list of keyboard layouts is missing.
settings-keyboard-no-list = Daftar tata letak papan ketik tidak ada di komputer ini.

# Title of the card shown when the list of keyboard layouts is missing.
settings-keyboard-no-list-title = Papan ketik

# Heading of the line in that card.
settings-keyboard-no-list-heading = Daftar tata letak papan ketik tidak tersedia

# Small words under that line, telling what to install; the command is typed as it is.
settings-keyboard-no-list-about = Pasang dengan: sudo apt install xkb-data

# Sentence at the end of the top words when keys or buttons have been changed; { $n } is how many.
settings-keyboard-top-changed =
    { $n ->
        [1] Satu tombol diubah.
       *[other] { $n } tombol diubah.
    }

# Title of the card with the keyboard layout.
settings-keyboard-layout-title = Tata letak

# Heading of the layout line, and the name of its list.
settings-keyboard-layout = Tata letak

# Heading of the variant line, and the name of its list.
settings-keyboard-variant = Varian

# First choice in the list of variants: the layout without a variant.
settings-keyboard-standard = Standar

# First choice in the list of second layouts: no second layout.
settings-keyboard-none = Tidak ada

# Heading of the line, and the name of its list, for a second layout.
settings-keyboard-switch-to = Ganti ke

# Small words under the second layout line.
settings-keyboard-switch-to-about = Alt dan Shift bersamaan berganti antara keduanya.

# Words behind the i of the layout card.
settings-keyboard-layout-about = Apa yang diketik setiap tombol: tata letak, dan variannya seperti yang tanpa tombol mati. Tata letak kedua dipertukarkan dengan Alt dan Shift bersamaan, dan dikembalikan dengan cara yang sama. Semuanya langsung berubah.

# Green words under a layout line once the new layout is in use.
settings-keyboard-in-use = Sedang digunakan

# Choice in the Caps Lock list: Caps Lock does its own job.
settings-keyboard-caps-key = Caps Lock

# Choice in the Caps Lock list: it acts as a second Ctrl key.
settings-keyboard-caps-ctrl = Ctrl kedua

# Choice in the Caps Lock list: it acts as Escape.
settings-keyboard-caps-escape = Escape

# Choice in the Caps Lock list: it acts as Backspace.
settings-keyboard-caps-backspace = Backspace

# Choice in the Caps Lock list: it does nothing.
settings-keyboard-caps-nothing = Tidak ada

# Heading of the line, and the name of its list, for what Caps Lock acts as.
settings-keyboard-caps-acts-as = Tombol Caps Lock berfungsi sebagai

# Small words under that line.
settings-keyboard-caps-acts-as-about = Ctrl kedua, Escape, dan sebagainya.

# Heading of the line, and name of its switch, for the keyboard button in the ring.
settings-keyboard-ring-button = Tombol papan ketik di ring

# Small words under that line.
settings-keyboard-ring-button-about = Memunculkan papan ketik di layar.

# Title of the card with Caps Lock and the ring keyboard button.
settings-keyboard-other-title = Tombol lain

# Words behind the i of that card.
settings-keyboard-other-about = Caps Lock dapat berfungsi sebagai tombol lain, seperti Ctrl kedua atau Escape. Tombol papan ketik adalah papan ketik di tengah ring yang memunculkan papan ketik di layar, untuk mengetik dengan mouse atau layar sentuh. Tombol ini muncul saat ring dibuka berikutnya.

# Words under a line when a press that was not the person's own changed nothing.
settings-keyboard-only-yours = Hanya tekanan tombol Anda sendiri yang dapat mengubah ini.

# Words under the change a key line while it waits for a key or mouse button to be pressed.
settings-keyboard-press-now = Tekan tombol atau tombol mouse yang akan diubah.

# Words under the change a key line when nothing was pressed in time.
settings-keyboard-nothing-pressed = Tidak ada yang ditekan, jadi tidak ada yang ditambahkan.

# Words under a changed key's line asking for what it becomes; the examples are names a person types.
settings-keyboard-type-it = Ketik menjadi apa tombol itu, misalnya Escape, Ctrl+C atau Nothing.

# Words under the change a key line when the press could not be told apart from another.
settings-keyboard-not-told = Tekanan itu tidak dapat dibedakan. Pilih tombolnya dari daftar.

# Choice in the list of keyboards and mice: the change applies on every one.
settings-keyboard-every-device = Semua papan ketik dan mouse

# Small words under a ready-made swap that the person's own change overrides.
settings-keyboard-swap-over = Juga diubah di bawah; perubahan itu yang dipakai.

# Name of the list of keyboards for one changed key; { $key } is the key.
settings-keyboard-which-device = Papan ketik atau mouse mana yang diubah untuk { $key }

# Name of the box for what a changed key becomes; { $key } is the key.
settings-keyboard-becomes = Menjadi apa { $key }

# Name of the bin button that takes a change away.
settings-keyboard-take-away = Hapus perubahan ini

# Small words under a changed key's line when it changes on every keyboard and mouse.
settings-keyboard-every-device-about = Pada semua papan ketik dan mouse.

# Small words under a line of a file that was not understood; { $n } is its number and { $why } the reason.
settings-keyboard-line-unused = Baris { $n } tidak dipakai: { $why }

# Heading of the line shown when the file of changed keys could not be read.
settings-keyboard-keys-unread = Tombol yang diubah tidak dapat dibaca

# Small words under that line; { $why } is the reason.
settings-keyboard-keys-unread-about = Semua tombol tetap seperti tercetak sampai dapat dibaca: { $why }.

# Name of the list from which a key or button to change is chosen.
settings-keyboard-keys-list = Pilih tombol yang akan diubah

# Name of the button that waits for a key or button to be pressed.
settings-keyboard-keys-press = Tekan tombol yang akan diubah

# Small words under the change a key line.
settings-keyboard-keys-add-about = Tekan tombolnya, atau pilih dari daftar.

# Heading of the line for changing a key or button.
settings-keyboard-keys-add = Ubah tombol

# Words under the change a key line when the key chosen is already changed; { $key } is the key.
settings-keyboard-already = { $key } sudah diubah, di bawah.

# Title of the card with changed keys and buttons.
settings-keyboard-keys-title = Tombol

# Words behind the i of the keys and buttons card; the examples are names a person types.
settings-keyboard-keys-about = Tombol atau tombol mouse apa pun dapat melakukan hal lain: tombol lain, tombol yang ditahan bersamaan seperti Ctrl+C, rangkaian tombol berurutan seperti H, I, tidak ada sama sekali, atau satu hal saat diketuk dan hal lain saat ditahan, misalnya Escape saat diketuk, Ctrl saat ditahan. Ini berlaku di mana saja mulai dari layar masuk. Ctrl, Alt, dan tombol F selalu menjangkau konsol teks, dan mengetik trindle-settings --keys default di sana mengembalikan semua tombol.

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-ctrl-caps = Tukar Ctrl dan Caps Lock

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-caps-tap = Caps Lock adalah Escape saat diketuk, Ctrl saat ditahan

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-esc-caps = Tukar Escape dan Caps Lock

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-alt-super = Tukar Alt dan Super, seperti pada papan ketik Mac

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-side-copy = Tombol samping mouse untuk menyalin dan menempel

# SAFETY: needs a human review before it ships
# Small words under a keyboard or mouse a program made, when it counts as the person.
settings-keyboard-made-yes = Dianggap sebagai Anda, seperti papan ketik yang dicolokkan.

# SAFETY: needs a human review before it ships
# Small words under a keyboard or mouse a program made, when it does not count as the person.
settings-keyboard-made-no = Mengetik dan bermain. Tidak dapat menekan tombol yang dilindungi.

# SAFETY: needs a human review before it ships
# Name of the switch that lets a program's keyboard or mouse count as the person; { $name } is its name.
settings-keyboard-made-switch = { $name } dianggap sebagai Anda

# Heading of the line shown when no program has made a keyboard or mouse.
settings-keyboard-made-none = Belum ada

# Small words under that line.
settings-keyboard-made-none-about = Yang dibuat oleh program muncul di sini, agar dapat dianggap sebagai Anda.

# Title of the card about keyboards and mice made by programs.
settings-keyboard-made-title = Papan ketik dan mouse buatan program

# SAFETY: needs a human review before it ships
# Words behind the i of that card.
settings-keyboard-made-about = Alat pemetaan ulang dan peluncur permainan dapat membuat papan ketik atau mouse sendiri. Tombol dan klik mereka tetap mengetik dan bermain, tetapi tidak dapat menekan tombol yang dilindungi, seperti Matikan atau Izinkan, atau mengetik ke pertanyaan yang ditujukan untuk Anda. Nyalakan salah satunya di sini agar dianggap sebagai Anda.

# Name of a game controller that has no name; { $vendor } and { $product } are numbers that identify it.
settings-keyboard-pad-unnamed = Pengendali { $vendor }:{ $product }

# Name of the switch for a controller's swap; { $name } is the swap and { $title } the controller.
settings-keyboard-pad-swap-switch = { $name } pada { $title }

# Name of the box for what a controller's button does; { $title } is the controller.
settings-keyboard-pad-does = Fungsi { $title }

# Small words under a controller's changed button; the words Button and what it becomes stand for the two sides of the line typed.
settings-keyboard-pad-type = Ketik sebagai Tombol = menjadi apa.

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-a-b = Tukar A dan B

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-x-y = Tukar X dan Y

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-stick = Balik atas dan bawah stik kanan

# Title of the card with the shortcuts plugins ask for.
settings-keyboard-plugin-title = Pintasan plugin

# Small words under a plugin shortcut that is not in use; { $plugin } is the plugin and { $why } the reason.
settings-keyboard-plugin-refused = { $plugin }. Tidak dipakai: { $why }

# Small words under a plugin shortcut; { $plugin } is the plugin. The example is keys a person types.
settings-keyboard-plugin-about = { $plugin }. Ketik tombolnya, misalnya Ctrl+Alt+S, atau kosongkan jika tidak ada.

# Name of the box for a plugin shortcut's keys; { $label } is the shortcut.
settings-keyboard-plugin-keys-name = Tombol untuk { $label }

# Said in green under a plugin shortcut after the keys were kept.
settings-keyboard-plugin-saved = Tersimpan

# Small words under the pointer speed slider when there is a touchpad.
settings-keyboard-both = Touchpad juga.

# Title of the mouse card.
settings-keyboard-mouse-title = Mouse

# Words behind the i of the mouse card.
settings-keyboard-mouse-about = Kecepatan penunjuk adalah seberapa jauh penunjuk bergerak untuk satu gerakan mouse, dan touchpad juga. Kecepatan gulir adalah seberapa jauh halaman bergerak untuk setiap putaran roda: Lebih lambat, Normal atau Lebih cepat, atau di mana saja di sepanjang penggeser. Dengan gulir alami halaman bergerak searah putaran roda, seperti di ponsel. Kidal menukar tombol kiri dan kanan.

# Heading and slider name for the pointer speed.
settings-keyboard-pointer-speed = Kecepatan penunjuk

# Heading and slider name for the scroll speed of the wheel or the touchpad.
settings-keyboard-scroll-speed = Kecepatan gulir

# Small words under the wheel's scroll speed.
settings-keyboard-scroll-wheel-about = Seberapa jauh halaman bergerak per putaran roda.

# Heading of the natural scrolling switch (the page follows the wheel or fingers).
settings-keyboard-natural = Gulir alami

# Small words under natural scrolling for the mouse wheel.
settings-keyboard-natural-wheel-about = Halaman mengikuti roda, seperti di ponsel.

# Heading of the switch that swaps the left and right mouse buttons.
settings-keyboard-left-handed = Kidal

# Small words under that switch.
settings-keyboard-left-handed-about = Menukar tombol kiri dan kanan.

# Heading and switch name for the clicking helper.
settings-keyboard-clicker = Pembantu klik

# Small words under the clicking helper line.
settings-keyboard-clicker-about = Klik dari alat klik tahan atau sakelar dianggap sebagai klik Anda.

# Title of the touchpad card.
settings-keyboard-touchpad-title = Touchpad

# Words behind the i of the touchpad card.
settings-keyboard-touchpad-about = Kecepatan gulir adalah seberapa jauh halaman bergerak untuk dua jari. Ketuk untuk klik membuat ketukan ringan dihitung sebagai klik. Dengan gulir alami halaman bergerak searah jari Anda, seperti di ponsel. Mati saat mengetik mencegah telapak tangan yang menyentuh touchpad menggerakkan penunjuk saat Anda mengetik.

# Small words under the touchpad's scroll speed.
settings-keyboard-scroll-touchpad-about = Seberapa jauh halaman bergerak untuk dua jari.

# Heading of the switch that makes a light tap count as a click.
settings-keyboard-tap = Ketuk untuk klik

# Small words under that switch.
settings-keyboard-tap-about = Ketukan ringan dihitung sebagai klik.

# Small words under natural scrolling for the touchpad.
settings-keyboard-natural-touchpad-about = Halaman mengikuti jari Anda, seperti di ponsel.

# Heading of the switch that stops the touchpad moving the pointer while typing.
settings-keyboard-quiet = Mati saat mengetik

# Small words under that switch.
settings-keyboard-quiet-about = Telapak tangan yang menyentuh tidak menggerakkan penunjuk.

# Choice above a scroll speed slider: slower than normal.
settings-keyboard-pace-slower = Lebih lambat

# Choice above a scroll speed slider: the normal speed.
settings-keyboard-pace-normal = Normal

# Choice above a scroll speed slider: faster than normal.
settings-keyboard-pace-faster = Lebih cepat

# Title of the card about USB ports that were switched off and on.
settings-keyboard-usb-title = Port USB

# Words behind the i of that card.
settings-keyboard-usb-about = Saat port USB gagal dimulai, Trindle mematikan lalu menyalakannya sekali untuk mencoba lagi, dan tidak pernah lebih dari sekali untuk satu port.

# Red words under the keyboard button switch when it could not be kept and its mark could not be taken away again; { $error } is the first problem and { $undo } the second.
settings-keyboard-button-and-mark = { $error }; dan tandanya tidak dapat dihapus kembali: { $undo }


# Title of the card with the keys that take a screenshot and show the shortcut list.
settings-keyboard-shortcuts-title = Tangkapan layar dan daftar pintasan

# Name of the shortcut and its line that starts the screenshot.
settings-keyboard-shortcuts-screenshot = Ambil tangkapan layar

# Name of the shortcut and its line that shows every shortcut in a list.
settings-keyboard-shortcuts-list = Tampilkan daftar pintasan

# Small words under each of the two shortcuts.
settings-keyboard-shortcuts-about = Ketik tombolnya, atau kosongkan agar tidak ada.

# Tip of the round button that starts the screenshot now.
settings-keyboard-shortcuts-screenshot-tip = Ambil tangkapan layar sekarang

# Tip of the round button that shows the shortcut list now.
settings-keyboard-shortcuts-list-tip = Tampilkan daftarnya sekarang

# Title of the card with the two shortcuts that restart the desktop.
settings-keyboard-restart-title = Mulai ulang desktop

# Name of the shortcut and its line that restarts the ring and the helper parts only.
settings-keyboard-restart-parts = Mulai ulang ring dan bagian pembantu

# Name of the shortcut and its line that restarts everything, the compositor too.
settings-keyboard-restart-all = Mulai ulang semuanya

# Small words under each of the two restart shortcuts. The example is keys a person types.
settings-keyboard-restart-about = Ketik tombolnya, seperti Ctrl+Alt+Escape, atau kosongkan agar tidak ada.

# Name of the box for a restart shortcut's keys; { $label } is the shortcut.
settings-keyboard-restart-keys-name = Tombol untuk { $label }

# Tip of the round button that restarts the ring and the helper parts now; open windows are left as they are.
settings-keyboard-restart-parts-tip = Mulai ulang sekarang. Jendela yang terbuka dibiarkan apa adanya.

# Tip of the round button that asks whether to restart everything now.
settings-keyboard-restart-all-tip = Mulai ulang semuanya. Bertanya dulu.

# Said under the line after the parts were restarted.
settings-keyboard-restart-parts-done = Dimulai ulang

# Said in red under a restart shortcut whose keys another shortcut has; { $keys } is the keys.
settings-keyboard-restart-clash = { $keys } sudah dipakai pintasan lain.

# Said in red under a restart shortcut that could not be kept; { $why } is the reason.
settings-keyboard-restart-not-saved = Tidak disimpan: { $why }


# Name of the shortcut and its line that opens the window to report a problem.
settings-keyboard-shortcuts-report = Laporkan masalah

# Tip of the round button that opens the report window now.
settings-keyboard-shortcuts-report-tip = Laporkan masalah sekarang

