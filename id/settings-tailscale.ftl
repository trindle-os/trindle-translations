# machine translated (Indonesian), not yet reviewed by a person.

# What a device runs, shown in a device's small line, when it is an iPhone or iPad.
settings-tailscale-system-ios = iPhone atau iPad

# In a device's small line: the device is on the network now.
settings-tailscale-online = daring sekarang

# In a device's small line: the device has never been seen.
settings-tailscale-not-seen = belum pernah terlihat

# In a device's small line: when the device was last online; the date is already written.
settings-tailscale-last-online = terakhir daring { $day }

# Shown beside the Use Tailscale switch while the password is asked for, when Tailscale is already installed.
settings-tailscale-waiting = Menunggu kata sandi...

# Shown beside the Use Tailscale switch while the password is asked for, before Tailscale is installed.
settings-tailscale-waiting-install = Menunggu kata sandi, lalu memasang Tailscale...

# Shown beside the switch after Tailscale is turned on.
settings-tailscale-done-on = Tailscale hidup

# Shown beside the switch after Tailscale is turned off.
settings-tailscale-done-off = Tailscale mati

# Shown under the Sign in line once the browser is being opened.
settings-tailscale-opening = Membuka halaman masuk di peramban Anda...

# Red words under the Sign in line when Tailscale could not be started.
settings-tailscale-not-started = Tailscale tidak dapat dijalankan.

# Red words under the Sign out line when signing out did not work.
settings-tailscale-sign-out-failed = Tailscale tidak mau keluar.

# Headline of the page while Tailscale is being asked how it is.
settings-tailscale-top-asking = Menanyakan keadaan Tailscale…

# Headline of the page when Tailscale is off and not installed.
settings-tailscale-top-not-installed = Tailscale belum terpasang. Hidupkan di bawah untuk memasangnya.

# Headline of the page when Tailscale is installed but off.
settings-tailscale-top-off = Tailscale mati, jadi tidak memakai memori.

# Headline of the page when Tailscale is on but does not answer.
settings-tailscale-top-silent = Tailscale tidak menjawab. Mungkin masih memulai.

# Headline of the page when connected: the name of the private network and of this computer.
settings-tailscale-top-connected = Terhubung ke { $network } sebagai { $name }.

# Name used in the headline for the private network when it has no name of its own.
settings-tailscale-network-fallback = Tailscale

# Headline of the page when Tailscale is on and has to be signed in to.
settings-tailscale-top-sign-in = Tailscale hidup. Masuk di bawah untuk bergabung ke jaringan pribadi Anda.

# Headline of the page for any other state; the state is already written in lower case.
settings-tailscale-top-state = Tailscale { $state }.

# Name of the page in the list of settings pages.
settings-tailscale-title = Tailscale

# Words the settings search looks for on this page (not shown).
settings-tailscale-keywords = tailscale vpn jaringan pribadi perangkat jarak jauh tailnet

# Help text at the top of the page.
settings-tailscale-help = Tailscale menggabungkan komputer dan ponsel Anda sendiri menjadi satu jaringan pribadi, di mana pun masing-masing berada. Tidak ada yang terpasang sampai Anda menghidupkannya, dan saat mati ia tidak memakai memori.

# Small line under the Use Tailscale switch before Tailscale is installed.
settings-tailscale-switch-sub-first = Memasangnya dari sumber resmi Tailscale.

# Small line under the Use Tailscale switch once Tailscale is installed.
settings-tailscale-switch-sub = Mati: dihentikan, tidak dimulai bersama komputer.

# Text of the switch that turns Tailscale on or off, and heading of its line.
# SAFETY: needs a human review before it ships
settings-tailscale-switch = Pakai Tailscale

# Help text (i button) of the Tailscale card when Tailscale is off or has not answered.
settings-tailscale-about-plain = Saat pertama kali dihidupkan, Tailscale dipasang dari sumber perangkat lunak resmi Tailscale, lalu dijalankan. Layanan latar belakangnya memakai memori saat hidup, jadi hanya berjalan ketika ini hidup. Saat ini mati, Tailscale dihentikan dan tidak dimulai bersama komputer. Firewall mengizinkan perangkat Tailscale Anda sendiri masuk, dan tetap menahan yang lain seperti sebelumnya.

# Help text (i button) of the Tailscale card when Tailscale is on but not yet connected.
settings-tailscale-about-sign-in = { settings-tailscale-about-plain } Masuk akan membuka halaman masuk Tailscale di peramban Anda. Pakai akun yang sama di setiap perangkat Anda.

# Help text (i button) of the Tailscale card when connected.
settings-tailscale-about-connected = { settings-tailscale-about-plain } Keluar akan mengeluarkan komputer ini dari jaringan pribadi Anda sampai Anda masuk lagi.

# Line in the devices card when there are no other devices.
settings-tailscale-no-devices = Belum ada perangkat lain

# Small line under "No other devices yet".
settings-tailscale-no-devices-sub = Masuk di perangkat lain dengan akun yang sama.

# Shown on the devices card while Tailscale is off.
settings-tailscale-waits-off = Hidupkan Tailscale untuk melihat perangkat Anda.

# Shown on the devices card while Tailscale has not answered.
settings-tailscale-waits-looking = Mencari perangkat Anda…

# Shown on the devices card when Tailscale needs signing in to.
settings-tailscale-waits-sign-in = Masuk untuk melihat perangkat Anda.

# Shown on the devices card when Tailscale is on but not connected.
settings-tailscale-waits-connect = Hubungkan untuk melihat perangkat Anda.

# Small line under this computer when it has no address yet.
settings-tailscale-no-address = Belum ada alamat.

# Small line under this computer: its address on the private network.
settings-tailscale-address = { $address } di jaringan pribadi Anda.

# Name of this computer's line when Tailscale gives it no name.
settings-tailscale-this-computer = Komputer ini

# Heading of the line that signs in to Tailscale, and tip of its round button.
settings-tailscale-sign-in = Masuk

# Small line under the Sign in line.
settings-tailscale-sign-in-sub = Membuka halaman masuk di peramban Anda.

# Heading of the line that joins the private network again, and tip of its round button.
settings-tailscale-connect = Hubungkan

# Small line under the Connect line.
settings-tailscale-connect-sub = Bergabung lagi ke jaringan pribadi Anda.

# Heading of the line that says the firewall lets the person's own devices in.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall = Perangkat Anda sendiri bisa masuk

# Small line under that heading.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall-sub = Yang lain tetap ditahan, seperti sebelumnya.

# Heading of the line that signs out, and tip of its button.
# SAFETY: needs a human review before it ships
settings-tailscale-sign-out = Keluar

# Small line under the Sign out line.
settings-tailscale-sign-out-sub = Meninggalkan jaringan pribadi Anda.

# Heading of the card with the Tailscale switch.
settings-tailscale-card = Tailscale

# Heading of the card that lists the person's devices.
settings-tailscale-devices = Perangkat Anda

# Help text (i button) of the Your devices card.
settings-tailscale-devices-about = Setiap perangkat yang masuk ke jaringan pribadi Anda, dengan alamatnya, sistem yang dijalankan, dan kapan terakhir daring. Untuk menambah satu, pasang Tailscale di ponsel atau komputer lain dan masuk dengan akun yang sama.
