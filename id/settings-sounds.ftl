settings-sounds-none-yet-about = Tambahkan satu untuk memilihnya bagi momen mana pun.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Suara itu sudah tidak ada di komputer ini. Pilih yang lain.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Suara tidak dapat diputar. Periksa speaker di Audio.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Pilih file suara

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Suara

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } bukan jenis suara yang dapat diputar Trindle.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = { $name } tidak dapat disalin.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = { $n } ditambahkan. Pilih di samping sebuah momen di atas.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = { $name } tidak dapat diganti.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = { $name } sudah diganti.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = { $n } dari { $total } sudah diganti.

# Red words under a sound's line when it could not be removed.
# SAFETY: needs a human review before it ships
settings-sounds-not-removed = Tidak dapat dihapus.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Suaranya sudah dihapus, dan tidak dapat dikembalikan ke suara bawaannya.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Masuk dan keluar

# Words behind the i of that card.
settings-sounds-coming-about = Memilih suara akan memutarnya, dan Mati membuat momen itu senyap. Tombol bulat di sampingnya memutar suara yang sedang dipilih. Setiap volume berkisar dari 0 sampai 100 dalam puluhan dan diputar sekali saat Anda melepasnya.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Daya

# Words behind the i of that card.
settings-sounds-power-about = Suara saat pengisi daya dicolok dan dicabut, dan saat baterai hampir habis. Volume berkisar dari 0 sampai 100 dalam puluhan dan diputar sekali saat Anda melepasnya.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Suara Anda sendiri

# Words behind the i of that card.
# SAFETY: needs a human review before it ships
settings-sounds-own-about = WAV, OGG, Opus, FLAC, atau MP3. Suara disalin ke folder Anda sendiri, jadi aslinya boleh dipindahkan atau dihapus, lalu dapat dipilih di samping momen mana pun seperti yang lain. Menghapus satu suara mengembalikan momen yang memakainya ke suara bawaannya.
