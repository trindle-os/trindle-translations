# machine translated (Indonesian), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Suara

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = suara bunyi nada awal mulai login masuk logout keluar matikan pengisi daya dicolok dicabut baterai peringatan bip mati senyap sendiri kustom tambah file wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Suara untuk setiap momen. Memilih satu akan memutarnya, dan Mati membuat momen itu senyap. Suara Anda sendiri dapat ditambahkan lalu dipilih seperti yang lain.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Mati

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Semua senyap: tidak ada momen yang berbunyi.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Setiap momen punya suaranya.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
       *[other] { $n } dari { $total } momen berbunyi; sisanya senyap.
    }

