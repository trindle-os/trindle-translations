# Title of a card on the default apps page.
settings-default-apps-card-internet = Internet

# Words behind the i of a card on the default apps page.
settings-default-apps-card-internet-about = Program yang membuka tautan web yang diklik di mana saja, yang menulis email saat sebuah alamat diklik, dan yang membuka undangan kalender.

# Title of a card on the default apps page.
settings-default-apps-card-files = Berkas dan dokumen

# Words behind the i of a card on the default apps page.
settings-default-apps-card-files-about = Program yang membuka folder, berkas teks biasa dan dokumen PDF saat Anda membukanya dari Folders, desktop atau aplikasi lain.

# Title of a card on the default apps page.
settings-default-apps-card-media = Gambar dan suara

# Words behind the i of a card on the default apps page.
settings-default-apps-card-media-about = Program yang membuka gambar, musik atau video saat Anda membukanya.

# Sentence at the top of the page when every kind has a program; { $web } is the program that opens web links.
settings-default-apps-all-set-web = Semuanya punya program untuk membukanya; { $web } membuka tautan web.

# Sentence at the top of the page when every kind has a program and the one for web links is not known.
settings-default-apps-all-set = Semuanya punya program untuk membukanya.

# Sentence at the top of the page when one kind has no program chosen; { $kind } is its name in lower case.
settings-default-apps-one-missing = Belum ada yang dipilih untuk membuka { $kind }.

# Sentence at the top of the page when several kinds have no program chosen; { $kinds } is their names as a list joined with "or".
settings-default-apps-many-missing = Belum ada yang dipilih untuk membuka { $kinds }.

# Small words under a kind that no installed program can open.
settings-default-apps-none-installed = Belum ada program terpasang yang dapat membukanya.

# First choice in a list when no program is chosen for that kind yet.
settings-default-apps-not-chosen = Belum dipilih

# Small words under a kind with a program list; { $n } is how many programs can open it.
settings-default-apps-can-open =
    { $n ->
       *[other] { $n } program dapat membukanya.
    }

# Said in green under a kind's list after the choice was kept.
settings-default-apps-saved = Tersimpan

