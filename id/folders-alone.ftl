
# machine translated (Indonesian), not yet reviewed by a person.

# Red note when a folder is shared and Trindle's own helper is not on this computer.
folders-alone-no-share = Berbagi folder diatur oleh pembantu bawaan Trindle, yang tidak ada di komputer ini.

# Note when a Windows share is opened and Trindle's own helper is not on this computer.
folders-alone-no-mount = Membuka berbagi Windows memerlukan pembantu bawaan Trindle, yang tidak ada di komputer ini.

# Note when an NFS export is opened and Trindle's own helper is not on this computer.
folders-alone-no-nfs = Membuka ekspor NFS memerlukan pembantu bawaan Trindle, yang tidak ada di komputer ini.

# Red note when the wallpaper is set from Folders and Trindle's wallpaper program is not on this computer.
folders-alone-no-wallpaper = Mengatur wallpaper memerlukan program wallpaper Trindle, yang tidak ada di komputer ini.

# Red note when a folder is opened as administrator and the program that asks for the administrator password is not on this computer.
# SAFETY: needs a human review before it ships
folders-alone-no-root = Membuka folder sebagai administrator memerlukan pkexec, yang tidak ada di komputer ini.

# Red note when a folder is shared with AI programs and Trindle's program for that is not on this computer.
folders-alone-no-ai = Berbagi dengan program AI memerlukan program Trindle untuk itu, yang tidak ada di komputer ini.

# Red note when a folder is opened in a terminal and none is installed.
folders-alone-no-terminal = Tidak ada terminal terpasang untuk membuka folder ini.
