# machine translated (Indonesian), not yet reviewed by a person.



# The page's name in the side bar.
settings-pads-title = Pengontrol game

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = Tekan tombol pada pengontrol untuk mengubahnya.

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = Sekarang tekan tombol untuk { $name }.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = Tidak ada yang terpasang

# Small words under that line.
settings-pads-none-about = Colokkan satu dan tombolnya ditampilkan di sini.

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = Pengontrol yang mana

# What the picture is, for the screen reader.
settings-pads-picture = Gambar { $title }, dengan setiap tombol menyala saat ditekan

# Title of the card of the controller's buttons.
settings-pads-buttons-title = Tombol

# Words behind the i of that card.
settings-pads-buttons-about = Setiap tombol, pemicu, dan arah stik serta d-pad. Yang terakhir Anda tekan ada di atas. Tombol yang diubah menjadi tombol papan ketik mengetik tombol itu di game yang tidak mendukung pengontrol.

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = Ubah { $name } menjadi tombol papan ketik

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = Berhenti mengubah { $name }

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = Menjadi apa { $name }

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = Tekan tombol papan ketik atau pilih tombol

# The next choice in that list: the Escape key.
settings-pads-escape = Tombol Escape

# The next choice in that list: nothing at all.
settings-pads-nothing = Tidak apa-apa

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = D-pad { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = Stik { $stick } { $way }

settings-pads-left = kiri

settings-pads-right = kanan

settings-pads-up = atas

settings-pads-down = bawah

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = Kiri

settings-pads-stick-right = Kanan

# Title of the card of the ready-made changes.
settings-pads-quick-title = Perubahan siap pakai

# Title of the card of changes that are not one button into another.
settings-pads-other-title = Perubahan lain

# Words behind the i of that card.
settings-pads-other-about = Stik dibalik, stik ditukar, dan zona mati. Ketik salah satunya seperti Left Stick dead zone = 10%, atau Right Stick Y = inverted.



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = Papan ketik: { $what }

settings-pads-on-mouse = Mouse: { $what }

settings-pads-on-pad = Pengontrol game: { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = Klik kiri

settings-pads-right-click = Klik kanan

settings-pads-middle-click = Klik tengah



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = Profil

# Words behind the i of that card.
settings-pads-profiles-about = Profil adalah sekumpulan perubahan. Standar tidak mengubah apa pun, sehingga game dengan dukungan pengontrol sendiri melihat pengontrol apa adanya. Setiap game Steam memakai Standar kecuali Anda memilih profil untuknya di sini, dan profil berubah sendiri saat game itu dimulai. Game lain apa pun untuk game yang tidak dijalankan Steam.

# The one switch that turns every controller change off at once.
settings-pads-changes = Perubahan pengontrol

settings-pads-changes-sub = Jika mati, setiap pengontrol apa adanya.

# The game whose profile is shown.
settings-pads-game = Game

settings-pads-other-game = Game lain apa pun

settings-pads-game-running = { $name } (berjalan)

settings-pads-game-number = Game Steam { $n }

# The profile the shown game uses.
settings-pads-profile = Profil

settings-pads-standard = Standar

settings-pads-standard-sub = Tanpa perubahan.

settings-pads-profile-add = Tambah profil

settings-pads-profile-remove = Hapus { $name }

settings-pads-profile-name = Nama profil

# The name a new profile is given.
settings-pads-profile-new = Profil { $n }

settings-pads-profile-empty = Profil perlu nama.

settings-pads-profile-standard = Nama Standar sudah dipakai.

settings-pads-profile-taken = Nama itu sudah dipakai.

settings-pads-profile-gone = Profil itu sudah tidak ada.

settings-pads-not-a-game = Bukan nomor aplikasi Steam.

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = Standar tidak mengubah apa pun. Tambahkan profil dulu.

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = Standar: pengontrol apa adanya.

settings-pads-top-off = Perubahan pengontrol mati.

