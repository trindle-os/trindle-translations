# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Tidak ada yang berbeda dari panel lain menurut nama, ukuran atau tanggal. Folder hanya dicocokkan menurut nama.
       *[other] { $n } item di sini tidak ada di panel lain, atau berbeda ukuran atau tanggalnya. Folder hanya dicocokkan menurut nama.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Ini perlu dua panel: tekan F3 untuk tampilan ganda.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Hasil pencarian tidak dapat ditampilkan di panel lain.

