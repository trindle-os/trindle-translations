# machine translated (Indonesian), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Kata-kata Anda sendiri

# Under the heading.
settings-words-about = Ubah kata apa pun yang ditampilkan Trindle, dalam bahasa apa pun, dan bagikan lembarnya sebagai berkas.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Lembar yang diubah di mana pun selain kolom terakhirnya, atau bukan milik Trindle sendiri, ditolak seluruhnya.

# The line that picks which language the boxes are for.
settings-words-language = Bahasa

# Under the language line.
settings-words-language-sub = Lembar ini untuk bahasa tersebut.

# The name of the language list for the screen reader.
settings-words-language-tip = Bahasa lembar

# The line that exports the sheet, and its button's tip.
settings-words-export = Unduh lembar

# Under the export line.
settings-words-export-sub = Bahasa Inggris di kiri, bahasa Anda di sebelahnya. Ubah sisi kanan.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Simpan lembar kata

# The line that imports a sheet, and its button's tip.
settings-words-import = Unggah lembar

# Under the import line.
settings-words-import-sub = Diperiksa seluruhnya lebih dulu. Perbedaan apa pun berarti tidak ada yang dipasang.

# Title of the window that asks which sheet to open.
settings-words-import-title = Buka lembar kata

# Under the import button when a sheet was installed.
settings-words-imported = Terpasang

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Tidak bisa disimpan

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Ditolak: berkas terlalu besar

# Under the import button: the file is not text.
settings-words-not-text = Ditolak: bukan teks biasa

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Ditolak: ada karakter tersembunyi atau karakter kontrol

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Ditolak: ada baris yang terlalu panjang

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Ditolak: bukan lembar kata Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Ditolak: versi lembar yang lain

# Under the import button: the language tag is not usable.
settings-words-bad-language = Ditolak: bahasanya tidak valid

# Under the import button: the notes at the top were changed.
settings-words-notes = Ditolak: bagian atas lembar telah diubah

# Under the import button: lines are missing or extra.
settings-words-count = Ditolak: ada baris yang hilang atau berlebih

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Ditolak: kunci di { $key } telah diubah

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Ditolak: teks Inggris di { $key } telah diubah

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Ditolak: baris { $key } bentuknya tidak benar

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Ditolak: kata-kata untuk { $key } terlalu panjang

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Ditolak: kata-kata untuk { $key } berisi karakter tersembunyi

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Ditolak: kata-kata untuk { $key } berisi markup, tautan, atau jalur

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Ditolak: penanda isi di { $key } berbeda

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Ditolak: berkas tidak bisa dibaca

# Under the rule on the card: when changed words appear.
settings-words-next-start = Kata-kata Anda tampil saat program dimulai berikutnya.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Ditolak: nilai pemeriksaan tidak cocok

settings-words-reset = Kembali ke kata-kata Trindle

settings-words-reset-sub = Mengembalikan bahasa ini seperti semula. Kata-kata Anda disimpan dalam berkas cadangan.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Tawarkan lembar Anda

# Under the offer button: who can send and why.
settings-words-offer-sub = Membuka halaman tempat Anda masuk ke Buildmorphic dan mengirimkannya. Trindle tidak pernah mengirimkannya untuk Anda.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Mulai bahasa Anda sendiri

# Under the start line.
settings-words-start-sub = Beri nama, nyata atau karangan. Bahasa ini mulai sebagai bahasa Inggris dan dicantumkan sebagai milik Anda.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Nama bahasa Anda

# Beside the start line when the language was made.
settings-words-started = Dimulai

# Under the start line: the name is empty or too long.
settings-words-name-length = Gunakan 1 sampai 30 huruf

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Hanya huruf: tanpa markup, jalur, atau karakter tersembunyi

# Under the start line: another language of your own has this name.
settings-words-name-taken = Anda sudah punya bahasa dengan nama itu

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (milik Anda)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Menghapus bahasa milik Anda ini. Kata-katanya disimpan dalam folder cadangan.

