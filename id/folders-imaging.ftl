# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = Folders hanya dapat memutar gambar JPEG, PNG, WebP, dan BMP

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = Folders tidak dapat membaca gambar

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = Folders tidak dapat menyimpan jenis gambar ini

# Why a link to a picture is not turned.
folders-imaging-no-turn-link = ini tautan, jadi putar gambar yang ditujunya

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = Folders tidak memutar gambar animasi, karena hanya frame pertamanya yang akan disimpan
