# machine translated (Indonesian), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Hapus { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $value } dari { $max } bintang

# The names of the three boxes of a duration entry.
kit-duration-hours = Jam

kit-duration-minutes = Menit

kit-duration-seconds = Detik

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Langkah { $n } dari { $count }

kit-step-back = Kembali

kit-step-next = Berikutnya

kit-step-finish = Selesai

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Cari

kit-find-previous = Hasil sebelumnya

kit-find-next = Hasil berikutnya

kit-find-none = Tidak ada hasil

kit-find-count = { $at } dari { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
       *[other] { $n } orang lagi
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Gradasi dengan { $n } titik

kit-gradient-place = Posisi titik yang dipilih

kit-gradient-add = Tambah titik

kit-gradient-remove = Hapus titik

# The "i" button that shows and hides a card's help.
kit-help-show = Tampilkan bantuan

kit-help-hide = Sembunyikan bantuan

