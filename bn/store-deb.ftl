
# machine translated (Bengali), not yet reviewed by a person.

# Window title of the window opened for a .deb file.
store-deb-title = একটি প্যাকেজ ইনস্টল করুন

# Words at the top of the window while the package is read.
store-deb-reading = প্যাকেজটি পড়া হচ্ছে…

# Red words when the file is not a Debian package and may not have finished downloading.
store-deb-not-finished = এই ফাইলটি ইনস্টল করার মতো Debian প্যাকেজ নয়। এটি হয়তো ডাউনলোড শেষ হয়নি।

# Words at the top of the window for a package that can be installed.
store-deb-ready = { $name } নিজের ফোল্ডারে ইনস্টল করার জন্য তৈরি।

# Red words at the top of the window for a package made for another kind of computer.
store-deb-elsewhere = এই প্যাকেজটি { $arch } কম্পিউটারের জন্য, তাই এটি এখানে বসানো যাবে না।

# Red words at the top of the window when the package is Trindle itself.
store-deb-trindle = এটি Trindle নিজেই। এটি ফাইল থেকে নয়, অ্যাপের আপডেট পাতা থেকে আপডেট হয়।

# Red words at the top of the window for a driver or a background service.
store-deb-service = { $name } একটি ড্রাইভার বা ব্যাকগ্রাউন্ড সেবা, যা নিজের ফোল্ডার থেকে কাজ করতে পারে না, তাই এটি এখানে ইনস্টল করা যাবে না।

# Words on the caution card above every package.
# SAFETY: needs a human review before it ships
store-deb-caution = Debian ও Trindle-এর বাইরের কোনো প্যাকেজ নিজের ফোল্ডারে বসে, যেখানে সেটি সীমিত কিন্তু পুরোপুরি আটকানো নয়। শুধু আপনার বিশ্বাসযোগ্য প্রস্তুতকারকের প্যাকেজ ইনস্টল করুন।

# Words at the top of the window once the package is installed.
store-deb-installed = { $name } নিজের ফোল্ডারে ইনস্টল করা আছে।

# In the card that says where the file came from, while it is checked.
store-deb-checking-origin = এটি কোথা থেকে এসেছে তা দেখা হচ্ছে…

# Heading in the card that says where the file came from.
store-deb-where = কোথা থেকে এসেছে

# Tip and spoken name of the round button that removes the package and what it saved.
# SAFETY: needs a human review before it ships
store-deb-remove = এটি ও এর রাখা সবকিছু সরিয়ে দিন

# Word beside the ring while the package goes in.
store-deb-installing = ইনস্টল হচ্ছে

# Main button that installs the package.
store-deb-install = ইনস্টল করুন

# Main button that installs the same version again.
store-deb-reinstall = আবার ইনস্টল করুন

# Main button that brings the installed package up to this version.
store-deb-update = আপডেট করুন

# Heading of the card for a package not installed yet.
# SAFETY: needs a human review before it ships
store-deb-goes-in = এটি নিজের ফোল্ডারে বসে, ডিফল্টভাবে সীমিত

# Under that heading.
# SAFETY: needs a human review before it ships
store-deb-goes-in-note = পাসওয়ার্ড লাগে না। আপনি অনুমতি না দেওয়া পর্যন্ত এটি ইন্টারনেট, শব্দ বা আপনার ফাইল ছুঁতে পারে না।

# Heading of the card for a package installed at this version.
store-deb-same-version = সংস্করণ { $version } নিজের ফোল্ডারে ইনস্টল করা আছে

# Under that heading.
store-deb-same-version-note = ঠিকমতো কাজ করা বন্ধ হয়ে গেলে সেখানে আবার ইনস্টল করুন।

# Heading of the card for a package installed at another version.
store-deb-other-version = সংস্করণ { $version } নিজের ফোল্ডারে ইনস্টল করা আছে

# Under that heading: the version this brings.
store-deb-other-version-note = এটি সেখানে ইনস্টল করলে তা সংস্করণ { $version }-এ আসবে, আর যা রাখা আছে তা থেকে যাবে।

# Facts line: how big the package is once installed.
store-deb-fact-size = ইনস্টলের পর আকার

# Facts line: the computer kind it is made for.
store-deb-fact-arch = যার জন্য বানানো

# Text of the About card when the package has no description.
store-deb-no-description = এই প্যাকেজের কোনো বিবরণ নেই।

# Words at the top of the window while the package goes in.
store-deb-installing-note = নিজের ফোল্ডারে ইনস্টল হচ্ছে। যা লাগে তা আনতে কয়েক মিনিট লাগতে পারে।

# Words at the top of the window once the package is installed.
store-deb-done = নিজের ফোল্ডারে ইনস্টল হয়েছে। এটি রিংয়ে পাবেন।

# Red words at the top of the window when parts the package needs could not be found; the parts follow.
store-deb-missing = নিজের ফোল্ডারে ইনস্টল হয়েছে, কিন্তু এই অংশগুলো পাওয়া যায়নি, তাই এটি হয়তো চালু হবে না: { $parts }।

# Words at the top of the window once the package is removed.
# SAFETY: needs a human review before it ships
store-deb-removed = এর রাখা সবকিছু সহ নিজের ফোল্ডার থেকে সরানো হয়েছে।

# Red words when a file is not a Debian package.
store-boxed-not-deb = এই ফাইলটি ইনস্টল করার মতো Debian প্যাকেজ নয়।

# Step shown while a package is unpacked.
store-boxed-unpacking = { $name } খোলা হচ্ছে

# Step shown while a part a package needs is added.
store-boxed-adding = { $part } যোগ করা হচ্ছে

# Red words when a file is not a Debian package.
store-parts-not-deb = { $path } ইনস্টল করার মতো Debian প্যাকেজ নয়।

# Red words when a package could not be unpacked.
store-parts-not-unpacked = { $path } খোলা যায়নি।

# Red words when the program is not one kept in a box.
store-loose-not-boxed = ওই প্রোগ্রামটি বাক্সে রাখা নয়।

# Name of Trindle's own terminal in the ring.
store-boxed-terminal = টার্মিনাল

# Title of the notice when older programs are off.
store-boxed-x-off = পুরোনো প্রোগ্রাম বন্ধ আছে

# Body of that notice: where to turn them on.
store-boxed-x-off-where = সেটিংস, অনুমতি

# Title of the notice when too many older programs are open.
store-boxed-x-many = পুরোনো প্রোগ্রাম অনেক বেশি

# Body of that notice.
store-boxed-x-many-close = একটি বন্ধ করে আবার চেষ্টা করুন

# Body of the notice that a program could not open because its Xwayland would not start.
store-boxed-x-could-not-open = { $app } খোলা যায়নি

# Body of the notice the first time a terminal opens outside its box.
# SAFETY: needs a human review before it ships
store-boxed-terminal-told = টার্মিনাল আপনার কম্পিউটারের অন্য অ্যাপের চেয়ে বেশি অংশ ছুঁতে পারে, কারণ কাজের জন্য তার তা দরকার। শুধু সেই কমান্ডই লিখুন যা আপনি বোঝেন এবং যা বিশ্বাসযোগ্য মানুষদের কাছ থেকে পাওয়া।

# Title of the notice when a plugin allowed the home network has none.
store-boxed-home-off = হোম নেটওয়ার্ক বন্ধ

# Body of that notice: the plugin's name and why.
store-boxed-home-off-why = { $app }-এর কোনো নেটওয়ার্ক নেই: { $why }

# Why a plugin allowed the home network has none: Trindle could not find its own program.
store-boxed-home-why-self = এটি নিজের প্রোগ্রাম খুঁজে পায়নি

# The same: the unshare program is missing.
store-boxed-home-why-unshare = unshare ইনস্টল করা নেই

# The same: the pasta program is missing.
store-boxed-home-why-pasta = pasta ইনস্টল করা নেই

# The same: the network room was not made.
store-boxed-home-why-not-made = এর নেটওয়ার্ক কক্ষ বানানো হয়নি

# The same: the room was not a new one, so it was left alone.
store-boxed-home-why-not-new = এর নেটওয়ার্ক কক্ষ নতুন ছিল না

# The same: the filter that keeps a box from making a room of its own could not be made.
store-boxed-home-why-filter = সিস্টেম কল ফিল্টার বানানো যায়নি

# The same: the room's rules would not load.
store-boxed-home-why-rules = কক্ষের নিয়মগুলো লোড হয়নি

# The same: a program would not start, with its name and the reason.
store-boxed-home-why-would-not-start = { $program } চালু হয়নি: { $why }

# The same: pasta refused, with what it said.
store-boxed-home-why-pasta-said = pasta বলেছে: { $why }

# The same: pasta could not join the room and said nothing.
store-boxed-home-why-pasta-no-join = pasta কক্ষে যোগ দিতে পারেনি


# Title of the notice when a program was given a downloaded file and run in a box with no internet.
store-downloaded-opened = ইন্টারনেট ছাড়া খোলা হয়েছে

# Body of that notice: why, and what the program was given.
store-downloaded-why = এটি ডাউনলোড করা, তাই প্রোগ্রামটি শুধু সেই ফাইলটিই পায়, শুধু পড়ার জন্য।

