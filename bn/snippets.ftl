snippets-y-comment = এর লেখার মাঝখানে একটি মন্তব্য আছে।

# Why a snippet is shown but not edited.
snippets-y-block-header = Snippets এই ব্লকের শিরোনাম সম্পাদনা করতে পারে না।

# Why a snippet is shown but not edited.
snippets-y-block-indent = এই ব্লকে লেখা যেভাবে ভেতরের দিকে সরানো, Snippets তা বোঝে না।

# Why a file is left alone.
snippets-y-first-indent = প্রথম লাইনটি ভেতরের দিকে সরানো। এমন সাজানো ফাইল Snippets সম্পাদনা করতে পারে না।

# Why a file is left alone.
snippets-y-not-named = স্নিপেট ফাইলে নাম দেওয়া মান লাগে, কিন্তু এই ফাইলে তা নেই।

# Why a file is left alone.
snippets-y-matches-twice = ফাইলে দুটি matches অংশ আছে।

# Why a file is left alone.
snippets-y-bom = ফাইলটি একটি বাইট অর্ডার মার্ক দিয়ে শুরু হয়েছে। এমন চিহ্নওয়ালা ফাইল Snippets সম্পাদনা করতে পারে না।

# Why a file is left alone.
snippets-y-tabs = এই ফাইলে লেখা ভেতরের দিকে সরাতে ট্যাব ব্যবহার করা হয়েছে, যা YAML অনুমতি দেয় না।

# Why a file is left alone.
snippets-y-directive = ফাইলটি একটি YAML নির্দেশ দিয়ে শুরু হয়েছে। এমন নির্দেশওয়ালা ফাইল Snippets সম্পাদনা করতে পারে না।

# Why a file is left alone.
snippets-y-documents = ফাইলে একটির বেশি ডকুমেন্ট আছে।

# Why a file is left alone.
snippets-y-one-line = স্নিপেটগুলো এক লাইনে লেখা। এমন সাজানো ফাইল Snippets সম্পাদনা করতে পারে না।

# Why a file is left alone.
snippets-y-matches-not-list = matches অংশটি একটি তালিকা হতে হবে।

# Why a snippet is shown but not edited.
snippets-y-empty = এটি ফাঁকা।

# Why a snippet is shown but not edited.
snippets-y-item-indent = এই মানগুলো ভেতরের দিকে যেভাবে সরানো, Snippets তা বোঝে না।

# Why a snippet is shown but not edited.
snippets-y-item-not-named = এই এন্ট্রিতে নাম দেওয়া মান নেই।

# Why a snippet is shown but not edited.
snippets-y-item-twice = এই এন্ট্রিতে একই নাম দুবার আছে।

# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] ১টি স্নিপেট
       *[other] { $count }টি স্নিপেট
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] ১টির মধ্যে { $shown }টি স্নিপেট
       *[other] { $all }টির মধ্যে { $shown }টি স্নিপেট
    }

# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Snippets টাইপ করলে বসানো হালনাগাদ করতে পারেনি: { $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Snippets { $file } বাদ দিয়েছে। { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = Espanso-র সঙ্গে ব্যবহার করলে { $files } এই কম্পিউটারে কমান্ড চালাবে। আমদানি করবেন?

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = আরও +{ $count }

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] ১টি ফাইল আমদানি হয়েছে।
       *[other] { $count }টি ফাইল আমদানি হয়েছে।
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Snippets { $path } তৈরি করতে পারেনি: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Snippets { $file } পড়তে পারেনি। { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = কিছুই সংরক্ষণ হয়নি, কারণ Snippets ফাইলটির একটি ব্যাকআপ কপি তৈরি করতে পারেনি: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Snippets { $path } লিখতে পারেনি: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = Snippets ফাইলটি পড়তে পারেনি: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = Snippets ফাইলটি খুলতে পারেনি: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Snippets স্নিপেটটি সংরক্ষণ করতে পারেনি: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = { $names } ব্যবহার করা হয়েছে বলে Snippets এই স্নিপেট দেখাতে পারে, কিন্তু সম্পাদনা করতে পারে না।

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name } স্নিপেট ফাইল হিসেবে আমদানির জন্য খুব বড়।

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = { $line } নম্বর লাইনে ভেতরের দিকে যেভাবে সরানো, Snippets তা বোঝে না।

