# machine translated (Bengali), not yet reviewed by a person.

# What a device runs, shown in a device's small line, when it is an iPhone or iPad.
settings-tailscale-system-ios = iPhone বা iPad

# In a device's small line: the device is on the network now.
settings-tailscale-online = এখন অনলাইনে

# In a device's small line: the device has never been seen.
settings-tailscale-not-seen = এখনও দেখা যায়নি

# In a device's small line: when the device was last online; the date is already written.
settings-tailscale-last-online = শেষবার অনলাইনে ছিল { $day }

# Shown beside the Use Tailscale switch while the password is asked for, when Tailscale is already installed.
# SAFETY: needs a human review before it ships
settings-tailscale-waiting = পাসওয়ার্ডের জন্য অপেক্ষা করা হচ্ছে...

# Shown beside the Use Tailscale switch while the password is asked for, before Tailscale is installed.
# SAFETY: needs a human review before it ships
settings-tailscale-waiting-install = পাসওয়ার্ডের জন্য অপেক্ষা, তারপর Tailscale ইনস্টল হবে...

# Shown beside the switch after Tailscale is turned on.
settings-tailscale-done-on = Tailscale চালু

# Shown beside the switch after Tailscale is turned off.
settings-tailscale-done-off = Tailscale বন্ধ

# Shown under the Sign in line once the browser is being opened.
settings-tailscale-opening = আপনার ব্রাউজারে সাইন-ইন পাতা খোলা হচ্ছে...

# Red words under the Sign in line when Tailscale could not be started.
settings-tailscale-not-started = Tailscale চালু করা যায়নি।

# Red words under the Sign out line when signing out did not work.
settings-tailscale-sign-out-failed = Tailscale সাইন আউট হয়নি।

# Headline of the page while Tailscale is being asked how it is.
settings-tailscale-top-asking = Tailscale-কে জিজ্ঞাসা করা হচ্ছে…

# Headline of the page when Tailscale is off and not installed.
settings-tailscale-top-not-installed = Tailscale ইনস্টল করা নেই। ইনস্টল করতে নিচে এটি চালু করুন।

# Headline of the page when Tailscale is installed but off.
settings-tailscale-top-off = Tailscale বন্ধ, তাই কোনো মেমরি নেয় না।

# Headline of the page when Tailscale is on but does not answer.
settings-tailscale-top-silent = Tailscale সাড়া দিচ্ছে না। হয়তো এখনও চালু হচ্ছে।

# Headline of the page when connected: the name of the private network and of this computer.
settings-tailscale-top-connected = { $network }-এ { $name } হিসেবে যুক্ত।

# Name used in the headline for the private network when it has no name of its own.
settings-tailscale-network-fallback = Tailscale

# Headline of the page when Tailscale is on and has to be signed in to.
settings-tailscale-top-sign-in = Tailscale চালু আছে। আপনার ব্যক্তিগত নেটওয়ার্কে যোগ দিতে নিচে সাইন ইন করুন।

# Headline of the page for any other state; the state is already written in lower case.
settings-tailscale-top-state = Tailscale: { $state }।

# Name of the page in the list of settings pages.
settings-tailscale-title = Tailscale

# Words the settings search looks for on this page (not shown).
settings-tailscale-keywords = ট্যাইলস্কেল ভিপিএন ব্যক্তিগত নেটওয়ার্ক ডিভাইস দূরবর্তী tailscale vpn private network devices remote tailnet

# Help text at the top of the page.
settings-tailscale-help = Tailscale আপনার নিজের কম্পিউটার ও ফোনগুলোকে, যে যেখানেই থাকুক, একটি ব্যক্তিগত নেটওয়ার্কে জুড়ে দেয়। চালু না করা পর্যন্ত এর কিছুই ইনস্টল হয় না, আর বন্ধ থাকলে কোনো মেমরি নেয় না।

# Small line under the Use Tailscale switch before Tailscale is installed.
settings-tailscale-switch-sub-first = Tailscale-এর নিজস্ব উৎস থেকে ইনস্টল করে।

# Small line under the Use Tailscale switch once Tailscale is installed.
settings-tailscale-switch-sub = বন্ধ: থামানো, কম্পিউটারের সাথে চালু হয় না।

# Text of the switch that turns Tailscale on or off, and heading of its line.
settings-tailscale-switch = Tailscale ব্যবহার করুন

# Help text (i button) of the Tailscale card when Tailscale is off or has not answered.
# SAFETY: needs a human review before it ships
settings-tailscale-about-plain = প্রথমবার চালু করলে Tailscale তার নিজস্ব সফটওয়্যার উৎস থেকে ইনস্টল হয়, তারপর চালু হয়। এর ব্যাকগ্রাউন্ড সেবা চালু থাকলে মেমরি নেয়, তাই এটি চালু থাকলেই শুধু চলে। বন্ধ থাকলে Tailscale থামানো থাকে এবং কম্পিউটারের সাথে চালু হয় না। ফায়ারওয়াল আপনার নিজের Tailscale ডিভাইসগুলোকে ঢুকতে দেয়, আর বাকি সব আগের মতোই বাইরে রাখে।

# Help text (i button) of the Tailscale card when Tailscale is on but not yet connected.
settings-tailscale-about-sign-in = { settings-tailscale-about-plain } সাইন ইন করলে ব্রাউজারে Tailscale-এর সাইন-ইন পাতা খোলে। আপনার প্রতিটি ডিভাইসে একই অ্যাকাউন্ট ব্যবহার করুন।

# Help text (i button) of the Tailscale card when connected.
settings-tailscale-about-connected = { settings-tailscale-about-plain } সাইন আউট করলে আবার সাইন ইন না করা পর্যন্ত এই কম্পিউটার আপনার ব্যক্তিগত নেটওয়ার্কের বাইরে থাকে।

# Line in the devices card when there are no other devices.
settings-tailscale-no-devices = এখনও অন্য কোনো ডিভাইস নেই

# Small line under "No other devices yet".
settings-tailscale-no-devices-sub = একই অ্যাকাউন্টে অন্য একটিতে সাইন ইন করুন।

# Shown on the devices card while Tailscale is off.
settings-tailscale-waits-off = আপনার ডিভাইস দেখতে Tailscale চালু করুন।

# Shown on the devices card while Tailscale has not answered.
settings-tailscale-waits-looking = আপনার ডিভাইস খোঁজা হচ্ছে…

# Shown on the devices card when Tailscale needs signing in to.
settings-tailscale-waits-sign-in = আপনার ডিভাইস দেখতে সাইন ইন করুন।

# Shown on the devices card when Tailscale is on but not connected.
settings-tailscale-waits-connect = আপনার ডিভাইস দেখতে যুক্ত হোন।

# Small line under this computer when it has no address yet.
settings-tailscale-no-address = এখনও কোনো ঠিকানা নেই।

# Small line under this computer: its address on the private network.
settings-tailscale-address = আপনার ব্যক্তিগত নেটওয়ার্কে { $address }।

# Name of this computer's line when Tailscale gives it no name.
settings-tailscale-this-computer = এই কম্পিউটার

# Heading of the line that signs in to Tailscale, and tip of its round button.
settings-tailscale-sign-in = সাইন ইন

# Small line under the Sign in line.
settings-tailscale-sign-in-sub = ব্রাউজারে সাইন-ইন পাতা খোলে।

# Heading of the line that joins the private network again, and tip of its round button.
settings-tailscale-connect = যুক্ত হোন

# Small line under the Connect line.
settings-tailscale-connect-sub = আপনার ব্যক্তিগত নেটওয়ার্কে আবার যোগ দেয়।

# Heading of the line that says the firewall lets the person's own devices in.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall = আপনার নিজের ডিভাইস ঢুকতে পারে

# Small line under that heading.
# SAFETY: needs a human review before it ships
settings-tailscale-firewall-sub = বাকি সব আগের মতোই বাইরে থাকে।

# Heading of the line that signs out, and tip of its button.
settings-tailscale-sign-out = সাইন আউট

# Small line under the Sign out line.
settings-tailscale-sign-out-sub = আপনার ব্যক্তিগত নেটওয়ার্ক ছেড়ে যায়।

# Heading of the card with the Tailscale switch.
settings-tailscale-card = Tailscale

# Heading of the card that lists the person's devices.
settings-tailscale-devices = আপনার ডিভাইস

# Help text (i button) of the Your devices card.
settings-tailscale-devices-about = আপনার ব্যক্তিগত নেটওয়ার্কে সাইন ইন করা প্রতিটি ডিভাইস, তাতে এর ঠিকানা, কী চালায় এবং শেষ কখন অনলাইনে ছিল সহ। একটি যোগ করতে আপনার ফোনে বা অন্য কম্পিউটারে Tailscale ইনস্টল করে একই অ্যাকাউন্টে সাইন ইন করুন।
