# machine translated (Bengali), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = রিং

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = প্রিয় লঞ্চার প্রান্ত ক্লিক কোণ ভয়েস কথা উইন্ডো খোলা ক্লিপবোর্ড কপি পেস্ট ইতিহাস ভুলে বিজ্ঞপ্তি favourites favorites launcher edge click hot corner voice speech windows open windows clipboard copy paste history forget notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = আপনার প্রিয় অ্যাপগুলো রিংয়ের মাঝখানে থাকে। সেগুলো রিংয়েই বাছা হয়: যোগ বা সরাতে রিংয়ের যেকোনো অ্যাপে ডান-ক্লিক করুন, আর ক্রম বদলাতে একটি প্রিয়কে অন্যটির জায়গায় টেনে আনুন।

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = রিং পর্দার প্রান্তে খোলে, আর আপনার খোলা উইন্ডোগুলো তাতে থাকে।

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = কোথায় কী খোলে

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = পর্দার প্রান্তে ক্লিক করুন

# Small words under that line about the Super key.
settings-ring-open-super = Super কী চাপলেও এটি খোলে।

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n }টি প্রিয়
       *[other] { $n }টি প্রিয়
    }

# Small words under the favourites line.
settings-ring-favourites-about = একটি যোগ করতে রিংয়ের কোনো অ্যাপে ডান-ক্লিক করুন।

# Title of the card about opening the ring.
settings-ring-opening = রিং খোলা

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = পয়েন্টার পর্দার প্রান্তে নিয়ে ক্লিক করুন, বা Super কী চাপুন, তাহলে রিং খুলবে। আপনার প্রিয়গুলো রিংয়ের মাঝখানে থাকে, আর খোলা উইন্ডোগুলো তাদের ঘিরে একটি রিংয়ে: সামনে আনতে একটিতে ক্লিক করুন, বা তার বোতামের জন্য ডান-ক্লিক করুন। যোগ বা সরাতে রিংয়ের যেকোনো অ্যাপে ডান-ক্লিক করুন।

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = আসামাত্র দেখান

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = বন্ধ থাকলে: সেগুলো তবু রিংয়ে জমা হয়।

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = কতক্ষণ থাকবে

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = জরুরিগুলো বন্ধ না করা পর্যন্ত থাকে।

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = কোথায় দেখা যাবে

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = যে কোণ থেকে সেগুলো সাজানো হয়।

# Title of the card about notifications.
settings-ring-notify-title = বিজ্ঞপ্তি

# Words behind the i of the card about notifications.
settings-ring-notify-about = কোনো প্রোগ্রামের আপনাকে কিছু বলার থাকলে সেটি কয়েক সেকেন্ডের জন্য দেখা দিয়ে চলে যায়। বন্ধ করলে কিছুই দেখা যায় না, তবে সবকিছু রিংয়ের বিজ্ঞপ্তি-বৃত্তে জমা থাকে। এখানে যা-ই বাছুন, জরুরি বিজ্ঞপ্তি বন্ধ না করা পর্যন্ত থাকে, যাতে পড়ার আগে কোনো সতর্কতা সরে না যায়।

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = কপি করা জিনিস ভুলে যান

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = পিন করা লাইন রাখা হয়।

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = এখন কপি করা

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n }টি লাইন, { $pinned }টি পিন করা।
       *[other] { $n }টি লাইন, { $pinned }টি পিন করা।
    }

# Title of the card about the clipboard.
settings-ring-clip-title = ক্লিপবোর্ড

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = রিংয়ের ক্লিপবোর্ড-বৃত্ত আপনার কপি করা জিনিস রাখে, যাতে আগের কিছু পেস্ট করতে পারেন। এখানে যা-ই বাছুন, পিন করা লাইন সবসময় রাখা হয়।

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = ভয়েস যোগ হচ্ছে; ততক্ষণ কাজ চালিয়ে যান।

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = বিল্ড টুল সরানো হচ্ছে।

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = ভয়েস সরানো হচ্ছে।

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = ভয়েস নিয়ন্ত্রণ

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = চালু

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = বন্ধ

# Small words under the voice switch.
settings-ring-voice-about = শুধু এই কম্পিউটারেই বোঝা হয়।

# Heading of the line, and the name of its button, that removes voice.
# SAFETY: needs a human review before it ships
settings-ring-voice-remove = ভয়েস সরান

# Small words under the line that removes voice.
settings-ring-voice-remove-about = প্রায় ১৫০ MB জায়গা খালি হয়।

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = ভয়েস তৈরি। বিল্ড টুল রাখা আছে।

# Name of the button that removes the build tools voice left behind.
# SAFETY: needs a human review before it ships
settings-ring-voice-tools-remove = বিল্ড টুল সরান

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = ভয়েস নিয়ন্ত্রণ যোগ করুন (প্রায় ১৫০ MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = ঐচ্ছিক; যোগ করতে প্রায় ১৫০ MB লাগে।

# Title of the card about voice.
settings-ring-voice-title = ভয়েস

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = ক্লিক করার বদলে কোনো অ্যাপের নাম, “আরও জোরে” বা “Wi-Fi সেটিংস” বলুন। রিংয়ের মাঝখানে ছুঁয়ে কথা বলুন; আপনি থামলে এটিও শোনা বন্ধ করে। কথা এই কম্পিউটারেই বোঝা হয়, কোথাও কিছু পাঠানো হয় না। যোগ করতে প্রায় ১৫০ MB ও কয়েক মিনিট লাগে, ততক্ষণ কাজ চালিয়ে যেতে পারেন; সরালে কথা বোঝার ইঞ্জিন ও তার মডেল চলে যায়।

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = ভয়েস যোগ হচ্ছে

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = বিল্ড টুল সরানো হচ্ছে

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = ভয়েস সরানো হচ্ছে

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = কম্পিউটার প্রতিবার রিস্টার্ট হলে

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = একদিন পর

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = এক সপ্তাহ পর

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = দুই সপ্তাহ পর

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = কখনও না

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = পয়েন্ট করলে শিরোনাম দেখান

# Small words under that switch.
settings-ring-names-about = বন্ধ থাকলে: শুধু ছবি দেখায়। স্ক্রিন রিডার তবু শিরোনাম পায়।
