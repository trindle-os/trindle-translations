# machine translated (Bengali), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = { $name } সরান

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $max }টি তারার মধ্যে { $value }টি

# The names of the three boxes of a duration entry.
kit-duration-hours = ঘণ্টা

kit-duration-minutes = মিনিট

kit-duration-seconds = সেকেন্ড

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = { $count }টি ধাপের মধ্যে { $n } নম্বর

kit-step-back = পিছনে

kit-step-next = পরের

kit-step-finish = শেষ করুন

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = খুঁজুন

kit-find-previous = আগের মিল

kit-find-next = পরের মিল

kit-find-none = কোনো মিল নেই

kit-find-count = { $count }টির মধ্যে { $at } নম্বর

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] আরও একজন
       *[other] আরও { $n } জন
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = { $n }টি বিন্দুর গ্রেডিয়েন্ট

kit-gradient-place = বেছে নেওয়া বিন্দুর অবস্থান

kit-gradient-add = একটি বিন্দু যোগ করুন

kit-gradient-remove = বিন্দুটি সরান

# The "i" button that shows and hides a card's help.
kit-help-show = সাহায্য দেখান

kit-help-hide = সাহায্য লুকান

