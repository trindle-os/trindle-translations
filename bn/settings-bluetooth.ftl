# machine translated (Bengali), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth চালু করা যায়নি।

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth বন্ধ করা যায়নি।

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth চালু নেই।

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } PIN বা নম্বর গ্রহণ করা হয়নি। আবার চেষ্টা করুন।

# Said in red when the pairing was turned down; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-turned-down = { $could_not } এখানে বা অন্য ডিভাইসে এটি প্রত্যাখ্যান করা হয়েছে।

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } অন্য ডিভাইস সময়মতো সাড়া দেয়নি। সেটি পেয়ারিং মোডে রেখে আবার চেষ্টা করুন।

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } এটি আগে থেকেই চলছে। একটু অপেক্ষা করুন।

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } ডিভাইস সাড়া দেয়নি। সেটি চালু ও কাছে আছে কিনা দেখে আবার চেষ্টা করুন।

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } ডিভাইস ব্যবহারের জন্য তৈরি নয়। সেটি পেয়ারিং মোডে রেখে আবার চেষ্টা করুন।

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = সিস্টেম বাস

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Bluetooth খোঁজা হচ্ছে…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = এই কম্পিউটারে Bluetooth চলছে না।

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth বন্ধ আছে।

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = কম্পিউটারেই Bluetooth বন্ধ করা আছে।

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = এই কম্পিউটারে Bluetooth নেই।

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = চালু আছে, কাছের ডিভাইস খোঁজা হচ্ছে…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = চালু আছে, এই মুহূর্তে কিছু সংযুক্ত নেই।

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] চালু আছে, এবং { $names } সংযুক্ত আছে।
       *[other] চালু আছে, এবং { $names } সংযুক্ত আছে।
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = সুইচটি এই কম্পিউটারের Bluetooth চালু বা বন্ধ করে; এর নিচে অ্যাডাপ্টারের নাম আছে। অন্য ডিভাইসের কাছে দৃশ্যমান চালু থাকলে কাছের ডিভাইস এই কম্পিউটারকে খুঁজে পাবে।

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = বন্ধ করা আছে।

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
settings-bluetooth-visible = অন্য ডিভাইসের কাছে দৃশ্যমান

# Small line under the Visible to other devices switch.
settings-bluetooth-visible-sub = কাছের ডিভাইস এই কম্পিউটারকে খুঁজে পাবে।

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = কম্পিউটারেই বন্ধ করা আছে

# Small line under it.
settings-bluetooth-hard-line-sub = একটি সুইচ বা কী দিয়ে। আগে সেটি চালু করুন।

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Bluetooth অ্যাডাপ্টার নেই

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = এই কম্পিউটারে কোনো Bluetooth অ্যাডাপ্টার পাওয়া যায়নি। USB সকেটে লাগানোর মতো একটি লাগালেই এখানে দেখা যাবে।

# Line in that card.
settings-bluetooth-none-found = কিছু পাওয়া যায়নি

# Small line under it.
settings-bluetooth-none-found-sub = USB-র একটি লাগালে এখানে দেখা যাবে।

# Shown beside the Bluetooth switch while the password is asked for.
# SAFETY: needs a human review before it ships
settings-bluetooth-waiting = পাসওয়ার্ডের জন্য অপেক্ষা করা হচ্ছে...

# Said in red when this computer could not be made visible to other devices.
settings-bluetooth-visible-failed = এই কম্পিউটারকে অন্য ডিভাইসের কাছে দৃশ্যমান করা যায়নি।

# Said in red when this computer could not be hidden from other devices.
settings-bluetooth-hidden-failed = এই কম্পিউটারকে অন্য ডিভাইসের কাছ থেকে লুকানো যায়নি।

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = এগুলো ব্যবহার করতে Bluetooth চালু করুন।

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = এখনও কিছু পেয়ার করা নেই

# Small line under it.
settings-bluetooth-none-paired-sub = পেয়ার করতে ডিভাইস খুঁজুন।

# Heading of the card that lists paired devices.
settings-bluetooth-mine = আমার ডিভাইস

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = এই কম্পিউটারের সঙ্গে পেয়ার করা ডিভাইস, যেখানে জানানো হয় সেখানে ব্যাটারিসহ। পাতা খোলার সময় যেগুলো সংযুক্ত ছিল সেগুলো আগে আসে, আর পাতা খোলা থাকলে কোনো সারি জায়গা বদলায় না। গোল বোতাম ডিভাইস সংযুক্ত বা বিচ্ছিন্ন করে; বিনটি ডিভাইস ভুলিয়ে দেয়, তাই আবার পেয়ার করতে হবে।

