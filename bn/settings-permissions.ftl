settings-outside-heading = বাক্সের বাইরের প্রোগ্রাম

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = Trindle কয়েক সেকেন্ড পরপর দেখে এবং আপনাকে জানায়। এটি এই প্রোগ্রামগুলোকে আটকাতে পারে না, আর খুব দ্রুত চলা কোনোটি ফসকে যেতে পারে। বাক্সের ভেতরের প্রোগ্রামকে তার বাক্সই আটকে রাখে।

# Label of the switch for the notice about the network.
settings-outside-network = কোনো প্রোগ্রাম নেটওয়ার্কে পৌঁছালে জানান

# Label of the switch for the notice about the person's files.
settings-outside-files = কোনো প্রোগ্রাম আপনার ফাইল খুলে রাখলে জানান

# Under those two switches.
settings-outside-once = প্রতিটি প্রোগ্রামের জন্য একবার।

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = { $name }-এর জন্য আবার জানান

# Under a program marked fine for the network.
settings-outside-fine-network = নেটওয়ার্কে পৌঁছানো ঠিক আছে।

# Under a program marked fine for the person's files.
settings-outside-fine-files = ফাইল খুলে রাখা ঠিক আছে।

# The line in the card when no program is marked fine.
settings-outside-no-fine = কোনো প্রোগ্রামকে ঠিক আছে বলে চিহ্নিত করা হয়নি।

# Heading of the card for downloaded files.
settings-downloads-heading = ডাউনলোড করা ফাইল

# Help text of that card (the information button).
settings-downloads-about = ইন্টারনেট থেকে আসা ফাইল হলো Downloads-এ থাকা ফাইল, বা ব্রাউজার যাকে চিহ্নিত করেছে। যে প্রোগ্রাম এটি খোলে সে শুধু সেই ফাইলটিই পায়, শুধু পড়ার জন্য, ইন্টারনেট ছাড়া এবং আপনার কোনো ফোল্ডার ছাড়া। ব্রাউজারের নিজের Open বোতাম এর আওতায় পড়ে না, কারণ সেটি প্রোগ্রাম নিজেই চালু করে।

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = ডাউনলোড করা ফাইল বাক্সে খুলুন

# Under that switch.
settings-downloads-box-sub = ইন্টারনেট নেই, আর শুধু সেই ফাইলটি, শুধু পড়ার জন্য।

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = { $kind } ফাইল সাধারণভাবে খুলুন

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = { $kind } ফাইল

# Under a file type's switch.
settings-downloads-normal-sub = চালু: সাধারণভাবে, ইন্টারনেটসহ খোলে।

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = এখনও কোনো ধরন নেই। ডাউনলোড করা ফাইল বাক্সে খুললে একটি এখানে তালিকায় আসবে।

