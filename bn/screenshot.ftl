# Sentence under the title once colours have been taken.
screenshot-eye-taken =
    { $n ->
        [one] একটি রং নেওয়া হয়েছে: { $newest }।
       *[other] { $n }টি রং নেওয়া হয়েছে; সবচেয়ে নতুনটি { $newest }।
    }

