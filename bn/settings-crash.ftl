# machine translated (Bengali), not yet reviewed by a person.

# Name of the Crash reports page, in the page list and as its heading.
settings-crash-title = ক্র্যাশ রিপোর্ট

# Words people may search for to find the Crash reports page, separated by spaces.
settings-crash-keywords = ক্র্যাশ রিপোর্ট ত্রুটি বাগ পাঠানো গোপনীয়তা crash reports errors bugs faults send sent privacy telemetry buildmorphic

# Help line at the foot of the Crash reports page.
# SAFETY: needs a human review before it ships
settings-crash-help = Trindle-এর কোনো প্রোগ্রাম ক্র্যাশ করলে ক্র্যাশ রিপোর্ট অ্যাড-অন এই কম্পিউটারে একটি ছোট নোট রাখে। আপনি এর পাঠানোর কমান্ড চালিয়ে প্রতিটি রিপোর্টে হ্যাঁ না বলা পর্যন্ত এটি কিছুই পাঠায় না; কমান্ডটি আগে পুরো রিপোর্ট দেখায়। আপনার নাম ও GitHub নাম তখনই যায় যখন আপনি সেগুলো এখানে লিখেছেন। কখনও কোনো বার্তা, ফাইলের নাম, আপনি কোথায় আছেন বা অন্য প্রোগ্রাম সম্পর্কে কিছু নয়। অ্যাড-অন সরালে সব বন্ধ হয়ে যায়।

# Heading and label of the switch for sending crashes.
settings-crash-crashes = ক্র্যাশ

# Under the Crashes switch.
settings-crash-crashes-short = Trindle-এর কোডের কোথায় ক্র্যাশ হয়েছে।

# Part of the help text of the What is sent card: what Crashes sends.
# SAFETY: needs a human review before it ships
settings-crash-crashes-long = ক্র্যাশ পাঠায় প্রোগ্রাম, তার সংস্করণ, ক্র্যাশের ধরন এবং Trindle-এর কোডের কোথায় ঘটেছে তা।

# Heading and label of the switch for sending errors.
settings-crash-errors = ত্রুটি

# Under the Errors switch.
settings-crash-errors-short = ত্রুটির নির্দিষ্ট নাম ও কোথায়।

# Part of the help text of the What is sent card: what Errors sends.
# SAFETY: needs a human review before it ships
settings-crash-errors-long = ত্রুটি পাঠায় প্রোগ্রাম, তার সংস্করণ, Trindle ত্রুটিকে যে নির্দিষ্ট নাম দেয় সেটি এবং কোডের কোথায়।

# Heading and label of the switch for sending facts about the computer.
settings-crash-computer = এই কম্পিউটার সম্পর্কে

# Under the About this computer switch.
settings-crash-computer-short = Linux, প্রসেসর, মেমরি, গ্রাফিক্স, পর্দা।

# Part of the help text of the What is sent card: what About this computer adds.
# SAFETY: needs a human review before it ships
settings-crash-computer-long = এই কম্পিউটার সম্পর্কে প্রতিটি রিপোর্টে যোগ করে: কোন Linux চলছে, প্রসেসরের ধরন, নিচের দিকে গোল করা মেমরি, Wayland না X11, গ্রাফিক্স কে বানিয়েছে, এবং কতগুলো পর্দা।

# Heading of the card with the switches for what is sent.
settings-crash-what-is-sent = কী পাঠানো হয়

# Help text of the What is sent card: { $switches } is what each switch sends.
# SAFETY: needs a human review before it ships
settings-crash-what-about = { $switches } নিচের বাক্সে আপনার Buildmorphic ব্যবহারকারীর নাম না লিখলে রিপোর্টে কোনো নাম থাকে না; এতে শুধু আপনি কৃতিত্ব পান।

# Red words when a setting could not be changed: the reason is { $why }.
settings-crash-nothing-changed-because = কিছুই বদলানো হয়নি, কারণ { $why }।

# Red words when the file that keeps the switches was not written by Trindle.
settings-crash-file-not-as-wrote = কিছুই বদলানো হয়নি, কারণ যে ফাইলে এটি রাখা হয় সেটি Trindle যেভাবে লিখেছিল সেভাবে নেই।

# Red words when there is no folder to keep the settings in.
settings-crash-no-settings-folder = সেটিংসের ফোল্ডার নেই।

# Red words when the folder for the settings could not be made.
settings-crash-folder-not-made = সেটিংসের ফোল্ডার তৈরি করা যায়নি।

# Red words when a setting could not be written to its file.
settings-crash-not-written = সেটিংটি লেখা যায়নি।

# Name of a sent report that was a crash: the signal is { $signal } and the program { $program }.
settings-crash-what-crash = { $program }-এ ক্র্যাশ ({ $signal })

# Name of a sent report that was an error: the error is { $code } and the program { $program }.
settings-crash-what-error = { $program }-এ ত্রুটি { $code }

# In the list of sent reports: the report was taken.
settings-crash-taken = গৃহীত

# In the list of sent reports: the report was not sent because the bug tracker is closed.
settings-crash-tracker-closed = পাঠানো হয়নি: ট্র্যাকার বন্ধ

# In the list of sent reports: the report was not sent because it was too big.
settings-crash-too-big = পাঠানো হয়নি: অনেক বড়

# In the list of sent reports: the report was not sent because it was refused.
settings-crash-refused = পাঠানো হয়নি: প্রত্যাখ্যাত

# In the list of sent reports: the report was not sent because too many came at once.
settings-crash-too-many = পাঠানো হয়নি: একসঙ্গে অনেক

# In the list of sent reports: the report was not sent, no reason known.
settings-crash-not-sent = পাঠানো হয়নি

# Said beside the link line once it is saved.
settings-crash-saved = সংরক্ষিত

# Tip of the button that clears the list of sent reports.
# SAFETY: needs a human review before it ships
settings-crash-clear = তালিকা মুছুন

# Red words when the list of sent reports could not be cleared.
# SAFETY: needs a human review before it ships
settings-crash-not-cleared = তালিকা মোছা যায়নি।

# Said beside the list of sent reports once it is cleared.
# SAFETY: needs a human review before it ships
settings-crash-removed = সরানো হয়েছে

# Heading of the line that holds the clear button.
settings-crash-kept-here = শুধু এই কম্পিউটারে রাখা

# Under the Kept on this computer only heading.
settings-crash-newest-first = সবচেয়ে নতুন আগে, পঞ্চাশটি পর্যন্ত।

# Heading of the line shown when no report has been sent.
settings-crash-nothing-yet = এখনও কিছু নেই

# Under the Nothing yet heading.
settings-crash-listed-here = প্রতিটি রিপোর্ট ঠিক যেভাবে পাঠানো হয়েছে সেভাবে এখানে তালিকাভুক্ত।

# Tip of the button that shows exactly what one report held.
settings-crash-show-sent = ঠিক কী পাঠানো হয়েছে দেখান

# Under a sent report: { $when } is the time, { $n } is how many times it happened (0 when once) and { $answer } how it went.
settings-crash-sent-sub =
    { $n ->
        [0] { $when }: { $answer }
        [one] { $when }, { $n } বার: { $answer }
       *[other] { $when }, { $n } বার: { $answer }
    }

# Heading of the card listing reports that were sent.
settings-crash-sent-so-far = এ পর্যন্ত পাঠানো

# Help text of the Sent so far card (the information button).
settings-crash-sent-about = প্রতিটি রিপোর্ট ঠিক যেভাবে পাঠানো হয়েছে সেভাবে, সবচেয়ে নতুন আগে, তালিকাভুক্ত এবং শুধু এই কম্পিউটারে রাখা। "গৃহীত" মানে Buildmorphic এটি পেয়েছে। "পাঠানো হয়নি: ট্র্যাকার বন্ধ" মানে Trindle-এর বাগ ট্র্যাকার রিপোর্ট নিচ্ছে না; "প্রত্যাখ্যাত" মানে ভুলভাবে তৈরি বলে ফিরিয়ে দেওয়া হয়েছে; "একসঙ্গে অনেক" মানে একসঙ্গে অনেক এসেছিল।

# Headline of the page when the add-on is not installed and the person is asked after a crash.
settings-crash-sum-asked = ক্র্যাশের পর আপনাকে পুরো রিপোর্ট দেখিয়ে জিজ্ঞাসা করা হয় পাঠানো হবে কি না।

# Headline of the page when nothing is sent and the person is not asked.
settings-crash-sum-nothing = কিছুই পাঠানো হয় না, এবং ক্র্যাশের পর আপনাকে জিজ্ঞাসাও করা হয় না।

# Headline of the page when both crashes and errors are turned off.
settings-crash-sum-none = কিছুই পাঠানো হয় না: ক্র্যাশ ও ত্রুটি দুটিই বন্ধ।

# Headline of the page: what is reported (crashes, errors or both) and under whose name (named, linked or anonymous) in { $which }, and the Buildmorphic name in { $name }.
settings-crash-sum-reported =
    { $which ->
        [errors] Trindle-এর প্রোগ্রামের ত্রুটি নাম ছাড়াই জানানো হয়।
        [both] Trindle-এর প্রোগ্রামের ক্র্যাশ ও ত্রুটি নাম ছাড়াই জানানো হয়।
       *[crashes] Trindle-এর প্রোগ্রামের ক্র্যাশ নাম ছাড়াই জানানো হয়।
    }

# Label of the switch for asking about problems and sharing reports, and heading of its line.
settings-crash-ask = সমস্যা ও রিপোর্ট শেয়ার নিয়ে জিজ্ঞাসা করুন

# Under the Ask about problems heading.
# SAFETY: needs a human review before it ships
settings-crash-ask-sub = বন্ধ করলে সবকিছু লুকানো হয় এবং অপেক্ষমাণ রিপোর্ট মুছে যায়।

# Said beside the Ask switch when it is turned off and no reports were waiting.
settings-crash-off-none = বন্ধ। কোনো রিপোর্ট অপেক্ষায় ছিল না।

# Said beside the Ask switch when it is turned off: how many waiting reports were deleted.
# SAFETY: needs a human review before it ships
settings-crash-off-deleted =
    { $n ->
        [one] বন্ধ। অপেক্ষমাণ { $n }টি রিপোর্ট মুছে ফেলা হয়েছে।
       *[other] বন্ধ। অপেক্ষমাণ { $n }টি রিপোর্ট মুছে ফেলা হয়েছে।
    }

# Tip of the button that opens the community page.
settings-crash-about-community = কমিউনিটি সম্পর্কে

# Heading of the line with the community button.
settings-crash-go-to-bm = রিপোর্ট যায় Buildmorphic-এ

# Under the Reports go to Buildmorphic heading.
settings-crash-community = যে কমিউনিটি Trindle গড়তে সাহায্য করে।

# Placeholder of the box for the Buildmorphic username.
settings-crash-username = ব্যবহারকারীর নাম

# Heading of the line with the username box.
settings-crash-your-username = আপনার Buildmorphic ব্যবহারকারীর নাম

# Under the username heading.
settings-crash-username-sub = ঐচ্ছিক। কখনও ইমেইল ঠিকানা নয়।

# Heading of a line about joining with an email address.
settings-crash-join = শুধু একটি ইমেইল ঠিকানা দিয়ে যোগ দিন

# Under the Join heading.
settings-crash-join-sub = আপনি প্রথমে যে সমস্যা জানাবেন তার জন্য ক্রেডিট ও স্তর পান।

# Heading of a line saying a report holds only a fixed list.
settings-crash-fixed = একটি রিপোর্টে শুধু একটি নির্দিষ্ট তালিকা থাকে

# Under the fixed list heading.
settings-crash-fixed-sub = আপনি আগে দেখতে পান, আর আপনার চাপ ছাড়া কিছুই যায় না।

# Heading of the card for reports the person sends.
settings-crash-reports-you-send = আপনার পাঠানো রিপোর্ট

# Help text of the Reports you send card (the information button).
# SAFETY: needs a human review before it ships
settings-crash-reports-about = Trindle-এর কোনো প্রোগ্রাম ক্র্যাশ করলে রিপোর্ট পাঠানো হবে কি না জিজ্ঞাসা করে একটি উইন্ডো খুলতে পারে। সেটি আগে হুবহু লেখাটি দেখায়: আপনার কথা, কম্পিউটারের মডেল ও গ্রাফিক্স, ত্রুটি এবং ঠিক আগের লগ। ফাইল, পাসওয়ার্ড ও Wi-Fi-এর নাম কখনও পড়া হয় না, আর নাম ও ঠিকানা ফাঁকা করে দেওয়া হয়। একই উইন্ডো যেকোনো সময় রিংয়ের "সমস্যা জানান" বোতাম থেকেও খুলতে পারেন।

# Spoken name of the box where the GitHub name is typed.
settings-crash-github-name = গিটহাব নাম

# Heading of the line where the person can give their GitHub name.
settings-crash-github-line = আপনার GitHub নাম

# Small words under that heading.
settings-crash-github-about = ঐচ্ছিক। "রিপোর্ট করেছেন" হিসেবে দেখানো হয়।

