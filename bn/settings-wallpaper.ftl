settings-wallpaper-changing-own =
    { $all ->
        [one] প্রতি { $every } অন্তর নতুন ছবি, Trindle-এর সঙ্গে আসা { $all }টি ছবির মধ্যে { $used }টি থেকে।{ $extra }
       *[other] প্রতি { $every } অন্তর নতুন ছবি, Trindle-এর সঙ্গে আসা { $all }টি ছবির মধ্যে { $used }টি থেকে।{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] প্রতি { $every } অন্তর নতুন ছবি, { $folder } এর { $all }টি ছবির মধ্যে { $used }টি থেকে।{ $extra }
       *[other] প্রতি { $every } অন্তর নতুন ছবি, { $folder } এর { $all }টি ছবির মধ্যে { $used }টি থেকে।{ $extra }
    }

