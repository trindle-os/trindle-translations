# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Обои

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = фон картинка изображение слайд-шоу фото обои

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Один цвет, или одно изображение, или папка, в которой изображение меняется само через заданное время.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 секунд

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 секунд

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = 1 минута

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 минут

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 минут

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 минут

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = 1 час

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = 1 день

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Заполнить экран

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Вписать, показать целиком

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = По центру, реальный размер

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Растянуть

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Замостить

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = В случайном порядке

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = По имени файла

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = Не удалось сменить обои: программа для них не запустилась.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] Используется { $used } из { $all } изображения
        [few] Используется { $used } из { $all } изображений
        [many] Используется { $used } из { $all } изображений
       *[other] Используется { $used } из { $all } изображения
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = В папке «{ $folder }» нет изображений

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] Используется { $used } из { $all } изображения из комплекта Trindle
        [few] Используется { $used } из { $all } изображений из комплекта Trindle
        [many] Используется { $used } из { $all } изображений из комплекта Trindle
       *[other] Используется { $used } из { $all } изображения из комплекта Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] Используется { $used } из { $all } изображения из папки «{ $folder }»
        [few] Используется { $used } из { $all } изображений из папки «{ $folder }»
        [many] Используется { $used } из { $all } изображений из папки «{ $folder }»
       *[other] Используется { $used } из { $all } изображения из папки «{ $folder }»
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, одно из изображений из комплекта Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Один цвет, задаётся ниже.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Здесь больше ничего нет. Выберите изображение или папку.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Один цвет, без изображения.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображения из комплекта Trindle.{ $extra }
        [few] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображений из комплекта Trindle.{ $extra }
        [many] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображений из комплекта Trindle.{ $extra }
       *[other] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображения из комплекта Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображения в папке «{ $folder }».{ $extra }
        [few] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображений в папке «{ $folder }».{ $extra }
        [many] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображений в папке «{ $folder }».{ $extra }
       *[other] Изображение меняется, интервал: { $every }. Используется { $used } из { $all } изображения в папке «{ $folder }».{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = В папке «{ $folder }» нет изображений. Выберите другую.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = В папке больше файлов, чем просматривает Trindle, поэтому некоторые изображения могут быть пропущены.

