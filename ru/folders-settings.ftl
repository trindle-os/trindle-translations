folders-settings-start-usual = Домашняя папка и недавние

# One line under that choice.
folders-settings-start-usual-sub = Домашняя папка слева, недавние справа.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Там, где вы оставили каждую панель

# One line under that choice.
folders-settings-start-last-sub = Каждая панель открывается в папке, где она была.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
