# machine translated (Russian), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = Оформление

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = цвет цвета тема темы внешний вид оформление подсветка акцент стекло тёмная светлая режим солнце яркий значки иконки шрифт курсор указатель экран чтение вслух диспетчер слепой доступность подписи подсказки названия наведение

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = Светлая или тёмная тема, цвета, значки, шрифты, указатель и чтение экрана вслух. Некоторые программы заметят изменения только после повторного открытия.

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = Оставить этот вид?

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = Escape вернёт прежний вид сразу.

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = Тёмная

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = Светлая

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = тёмная

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = светлая

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }, { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = Как выглядит «{ $name }», { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = Выбрана { $look } тема.

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = Собственный вид Trindle, потому что тему «{ $theme }» нельзя использовать. { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = Тема «{ $theme }», { $look }, с цветом подсветки { $accent } и { $shape } значками.

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = Тема «{ $theme }», с цветом подсветки { $accent } и { $shape } значками.

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look } тема, с цветом подсветки { $accent } и { $shape } значками.

# Shape of the icons in the top sentence.
settings-appearance-shape-round = круглыми

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = Жёлтый Trindle

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = Говорит, что на экране и что вы печатаете. Super, Alt и S вместе тоже включают и выключают чтение.

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = Не удалось перерисовать значки, поэтому у некоторых прежняя форма. Выберите набор ещё раз, чтобы повторить попытку.

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = Некоторые цвета сделаны более читаемыми.

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
        [one] Пробуем тему «{ $theme }». Прежний вид вернётся через { $seconds } секунду, если не нажать «Оставить». Escape возвращает его сразу.
        [few] Пробуем тему «{ $theme }». Прежний вид вернётся через { $seconds } секунды, если не нажать «Оставить». Escape возвращает его сразу.
        [many] Пробуем тему «{ $theme }». Прежний вид вернётся через { $seconds } секунд, если не нажать «Оставить». Escape возвращает его сразу.
       *[other] Пробуем тему «{ $theme }». Прежний вид вернётся через { $seconds } секунды, если не нажать «Оставить». Escape возвращает его сразу.
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = Тема «{ $theme }» сохранена.

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = Прежний вид вернётся, когда выйдет время.

# Said aloud when the look from before is back.
settings-appearance-aloud-back = Прежний вид возвращён.

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = Выберите тему

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = Темы

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = «{ $name }» в списке выше. Нажмите на неё, чтобы использовать.

# Red words under the Theme line when a theme could not be removed.
settings-appearance-not-removed = Не удалось удалить тему.

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = Тему «{ $theme }» нельзя использовать. { $why }

# Heading of the line saying a theme is tried first.
settings-appearance-tried-first = Сначала тема пробуется

# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
        [one] Вопрос «Оставить?» показывается внизу окна { $seconds } секунду.
        [few] Вопрос «Оставить?» показывается внизу окна { $seconds } секунды.
        [many] Вопрос «Оставить?» показывается внизу окна { $seconds } секунд.
       *[other] Вопрос «Оставить?» показывается внизу окна { $seconds } секунды.
    }

# Name of the bin button that removes one of the person's own themes.
# SAFETY: needs a human review before it ships
settings-appearance-remove-theme = Удалить эту тему

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = Использовать «{ $name }»

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = Автор: { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = Добавить тему

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = Поиск тем

# Title of the Theme card.
settings-appearance-theme-card = Тема

# Words behind the i of the Theme card.
settings-appearance-theme-about = Тема - это весь внешний вид в одном файле: цвета, углы, размеры и отступы. Нажмите на тему, чтобы попробовать: все окна Trindle изменятся сразу, а прежний вид вернётся сам через 30 секунд, если не нажать «Оставить», так что нечитаемая тема не останется. У темы с тёмным и светлым видом рядом с картинкой есть кнопки «Тёмная» и «Светлая»; светлая лучше видна на ярком солнце, а приложения из раздела «Приложения» применят её при следующем открытии. У темы с одним видом таких кнопок нет. Ваш цвет подсветки остаётся вашим в любой теме. Добавленная тема только читается и никогда не запускается, а слова, которые в ней трудно прочесть, делаются чётче. Из терминала команда trindle-settings --theme default всегда возвращает собственный вид Trindle.

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = Тема

# Small words under that line.
settings-appearance-theme-line-about = Весь внешний вид. Если у темы есть оба вида, рядом с ней выбирается тёмный или светлый.

# Small words under the Add a theme line.
settings-appearance-add-theme-about = Один файл .css, например тот, которым с вами поделились.

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = Что содержит файл темы

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = Шесть знаков из 0-9 и a-f, например #fbc711.

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = Введённый цвет

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = Шестнадцатеричный код

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = Любой цвет в виде шестнадцатеричного кода, например #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = Любой цвет

# Small words under that line.
settings-appearance-any-colour-about = Шесть или восемь знаков, например #fbc711.

# Title of the Colour card.
settings-appearance-colour-title = Цвет

# Words behind the i of the Colour card.
settings-appearance-colour-about = Подсветка отмечает кнопки, переключатели, заполняющееся кольцо и то место, где вы находитесь. Окна Trindle меняются сразу, кольцо - при следующем открытии. Цвет, слишком тёмный для карточки, осветляется, пока его не станет видно, а в светлом виде слишком бледный затемняется. Тёмный или светлый вид выбирается на плитке самой темы, в разделе «Тема».

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = Подсветка

# Small words under that line.
settings-appearance-highlight-about = Кнопки, переключатели и место, где вы находитесь.

# Small words under the read the screen aloud switch when a screen reader is installed.
settings-appearance-reader-on = Super, Alt и S тоже включают и выключают чтение.

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = Читать экран вслух

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = Не скрывать подписи при наведении

# Small words under that line.
settings-appearance-labels-about = Название кнопки остаётся, пока вы на неё наводите указатель.

# Title of the Reading the screen card.
settings-appearance-reading-title = Чтение экрана

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } Название кнопки обычно исчезает через полторы секунды; если включено сохранение, оно остаётся, пока указатель на кнопке. Пока экран читается вслух, у каждой кнопки под ней показано её название.

# Name of the set of round icons.
settings-appearance-icons-circles = Круги

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = Меняем значки

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = Готово

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = Значки: { $name }

# Heading of the line for the shape of the icons.
settings-appearance-shape = Форма

# Small words under that line.
settings-appearance-shape-about = Значки Trindle, круглые или квадратные.

# Title of the Icons card.
settings-appearance-icons-title = Значки

# Words behind the i of the Icons card.
settings-appearance-icons-about = Значки Trindle бывают круглыми или квадратными. Для приложения, которое они не рисуют, создаётся подходящий значок, а кольцо и панель перерисовываются в новой форме.

# Name of the list of font families, and heading of the font line.
settings-appearance-font = Шрифт

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = По умолчанию

# Name of the list of font sizes.
settings-appearance-font-size = Размер шрифта

# Small words under the font line.
settings-appearance-font-about = Текст в окнах программ.

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = Добавить шрифты

# Small words under the Add fonts line.
settings-appearance-add-fonts-about = Файл .ttf или .otf либо zip-архив с ними.

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = Что должно быть в файле

# Title of the Text card.
settings-appearance-text-title = Текст

# Words behind the i of the Text card.
settings-appearance-text-about = Шрифт, которым программы показывают текст, и его размер. Добавленные здесь шрифты (файл .ttf или .otf либо zip-архив с ними) попадают в список только для вас; некоторые программы заметят их лишь после повторного открытия.

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = Выберите шрифты

# Red words when a font could not be replaced; { $name } is the file name.
settings-appearance-font-not-replaced = Не удалось заменить { $name }.

# Green words after one font took the place of the one there; { $name } is the file name.
settings-appearance-font-replaced-one = { $name } заменён. Программы, запущенные с этого момента, будут его использовать.

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
settings-appearance-font-replaced-some = Заменено: { $n } из { $total }. Программы, запущенные с этого момента, будут их использовать.

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
        [one] { $n } шрифт появился в списке выше. Выберите его выше.
        [few] { $n } шрифта появились в списке выше. Выберите их выше.
        [many] { $n } шрифтов появились в списке выше. Выберите их выше.
       *[other] { $n } шрифта появились в списке выше. Выберите их выше.
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = Эти шрифты уже есть в списке.

# Choice in the list of cursor sizes: the normal size.
settings-appearance-cursor-normal = Обычный

# Choice in the list of cursor sizes: a large size.
settings-appearance-cursor-large = Большой

# Choice in the list of cursor sizes: the largest size.
settings-appearance-cursor-larger = Крупнее

# Spoken name of a picture of a cursor size; { $size } is its name, such as Large.
settings-appearance-pointer-spoken = Указатель: { $size }

# Name of the standard cursor theme (the one every system has).
settings-appearance-cursor-standard = Стандартный

# Name of the list of cursor themes, and heading of its line.
settings-appearance-cursor = Курсор

# Name of the list of cursor sizes, and heading of its line.
settings-appearance-cursor-size = Размер курсора

# Small words under the cursor line.
settings-appearance-cursor-about = Как рисуется указатель.

# Small words under the cursor size line.
settings-appearance-cursor-size-about = Чем крупнее, тем легче найти.

# Title of the Pointer card.
settings-appearance-pointer-title = Указатель
