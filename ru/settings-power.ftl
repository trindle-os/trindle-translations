# Choice in a list of how long to wait.
settings-power-time-1m = 1 минута

# Choice in a list of how long to wait.
settings-power-time-2m = 2 минуты

# Choice in a list of how long to wait.
settings-power-time-5m = 5 минут

# Choice in a list of how long to wait.
settings-power-time-10m = 10 минут

# Choice in a list of how long to wait.
settings-power-time-15m = 15 минут

# Choice in a list of how long to wait.
settings-power-time-30m = 30 минут

# Choice in a list of how long to wait.
settings-power-time-45m = 45 минут

# Choice in a list of how long to wait.
settings-power-time-1h = 1 час

# Choice in a list of how long to wait.
settings-power-time-90m = 1,5 часа

# Choice in a list of how long to wait.
settings-power-time-2h = 2 часа

# Choice in the lock after list: lock at no other time than when the computer sleeps.
