# machine translated (Russian), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Звуки

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = звук звуки сигнал запуск вход выход завершение работы выключение зарядка зарядное подключено отключено батарея предупреждение писк тихо свои добавить файл wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Звук для каждого события. Выбранный звук сразу проигрывается, а «Выкл.» делает событие беззвучным. Свои звуки можно добавить и выбирать так же, как остальные.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Выкл.

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Тишина: ни одно событие не издаёт звука.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = У каждого события есть свой звук.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
        [one] Звук есть у { $n } из { $total } событий; остальные беззвучны.
        [few] Звук есть у { $n } из { $total } событий; остальные беззвучны.
        [many] Звук есть у { $n } из { $total } событий; остальные беззвучны.
       *[other] Звук есть у { $n } из { $total } событий; остальные беззвучны.
    }

