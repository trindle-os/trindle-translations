# Small words under the charger unplugged line.
settings-sounds-moment-unplug-about = Когда отключают зарядное устройство.

# Small words under the battery low line.
settings-sounds-moment-battery-about = Когда пора заряжать.

# Small words under the notifications line.
settings-sounds-moment-notification-about = Когда появляется уведомление.

# Heading and slider name for the volume of the logging in and out sounds.
settings-sounds-volume-coming = Громкость входа и выхода

# Heading and slider name for the volume of notification sounds.
settings-sounds-volume-notifications = Громкость уведомлений

# Heading and slider name for the volume of the charger and battery sounds.
settings-sounds-volume-power = Громкость звуков питания

# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Прослушать

# Name of the button that opens a window to add sound files.
settings-sounds-add = Добавить звуковые файлы

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Открыть папку, где они хранятся

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = Не удалось открыть папку.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = Не удалось создать папку для ваших звуков.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Прослушать добавляемый

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Прослушать тот, который уже есть

# Heading of the line for adding sounds.
settings-sounds-add-heading = Добавить звуки

# Small words under the add sounds line, listing the kinds of file that can be added.
settings-sounds-add-formats = WAV, OGG, Opus, FLAC или MP3.

# Name of the bin button that removes a sound added by the person.
# SAFETY: needs a human review before it ships
settings-sounds-remove = Удалить этот звук

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Пока ничего не добавлено

# Small words under that line.
settings-sounds-none-yet-about = Добавьте звук, чтобы выбрать его для любого события.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Этого звука больше нет на компьютере. Выберите другой.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Звук не проигрывается. Проверьте колонки в разделе «Звук».

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Выберите звуковые файлы

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Звуки

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } - не тот вид звука, который умеет проигрывать Trindle.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = Не удалось скопировать { $name }.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = Добавлено: { $n }. Выберите звук рядом с нужным событием выше.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = Не удалось заменить { $name }.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = { $name } заменён.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = Заменено: { $n } из { $total }.

# Red words under a sound's line when it could not be removed.
settings-sounds-not-removed = Не удалось удалить.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Звук удалён, но событию не удалось вернуть его собственный звук.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Вход и выход

# Words behind the i of that card.
settings-sounds-coming-about = Выбранный звук сразу проигрывается, а «Выкл.» делает событие беззвучным. Круглая кнопка рядом проигрывает звук, выбранный сейчас. Громкость меняется от 0 до 100 с шагом 10 и проигрывается один раз, когда вы отпускаете ползунок.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Питание

# Words behind the i of that card.
settings-sounds-power-about = Звуки подключения и отключения зарядного устройства и низкого заряда батареи. Громкость меняется от 0 до 100 с шагом 10 и проигрывается один раз, когда вы отпускаете ползунок.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Ваши звуки

# Words behind the i of that card.
settings-sounds-own-about = WAV, OGG, Opus, FLAC или MP3. Они копируются в вашу папку, поэтому исходные файлы можно перемещать или удалять, а затем выбирать рядом с любым событием, как остальные. Если удалить звук, все события, которые его использовали, вернутся к своему звуку.
