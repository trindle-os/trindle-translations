# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-logout = Выход, перезагрузка и выключение

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-plug = Зарядное устройство подключено

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-unplug = Зарядное устройство отключено

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-battery = Низкий заряд батареи

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-notification = Появляется уведомление

# Heading of the logging out line.
settings-sounds-moment-logout-short = Выход из системы

# Heading of the notifications line.
settings-sounds-moment-notification-short = Уведомления

# Small words under the logging in line.
settings-sounds-moment-login-about = Когда появляется рабочий стол.

# Small words under the logging out line.
settings-sounds-moment-logout-about = Также при перезагрузке и выключении.

# Small words under the charger plugged in line.
