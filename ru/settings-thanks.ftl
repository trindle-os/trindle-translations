# Text behind the info button of the Thanks page.
settings-thanks-help =
    Спасибо всем, кто их создаёт. Если какой-то из них важен для вас, сердечко ведёт туда, где принимают пожертвования.

# The sentence at the top of the Thanks page; n is how many projects are thanked.
settings-thanks-headline =
    { $n ->
        [one] Trindle построен на { $n } свободном проекте, созданном добровольцами. Спасибо.
        [few] Trindle построен на { $n } свободных проектах, большинство которых созданы добровольцами. Спасибо.
        [many] Trindle построен на { $n } свободных проектах, большинство которых созданы добровольцами. Спасибо.
       *[other] Trindle построен на { $n } свободных проектах, большинство которых созданы добровольцами. Спасибо.
    }

# Tip of the heart button beside a project that takes donations; name is the project.
settings-thanks-donate = Пожертвовать проекту { $name }

# Text behind the info button of a card on the Thanks page, for a project whose line is shortened: its name and its full description.
settings-thanks-longer = { $name }: { $what }.

# Heading of the Licences card on the Thanks page.
settings-thanks-licences = Лицензии

# Quiet line under Trindle in the Licences card.
settings-thanks-trindle-licence = Свободное программное обеспечение по GPL-3.0-or-later.

# First sentence behind the info button of the Licences card.
settings-thanks-licences-about = То, с чего начался Trindle или что он включает, сохраняет свою лицензию.

# One line behind the info button of the Licences card: the work's name and where its licence is read.
settings-thanks-where = { $name }: { $where_read }

# Name of the line in the Licences card that counts the Rust libraries.
settings-thanks-rust = Библиотеки Rust

# Quiet line under the Rust libraries while the list of licences is still being read.
settings-thanks-rust-reading = Чтение списка.

# Quiet line under the Rust libraries: how many there are and how many are under the commonest licence.
settings-thanks-rust-counts =
    { $total ->
        [one] { $total } библиотека Rust, из них { $n } под лицензией { $licence }
        [few] { $total } библиотеки Rust, из них { $n } под лицензией { $licence }
        [many] { $total } библиотек Rust, из них { $n } под лицензией { $licence }
       *[other] { $total } библиотеки Rust, из них { $n } под лицензией { $licence }
    }

# Quiet line under the Rust libraries when the list of licences is not on this computer.
settings-thanks-rust-missing = Список на этом компьютере не найден.

# Tip of the button that opens the full list of licences as a text page.
settings-thanks-open-list = Открыть полный список как текстовую страницу

# Red words under the Rust libraries line when the list could not be opened.
settings-thanks-open-failed = Не удалось открыть список.

