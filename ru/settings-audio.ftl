# machine translated (Russian), not yet reviewed by a person.

# Name of the Settings page about sound, in the list and as its heading.
settings-audio-title = Звук

# Words a person might type into the Settings search to find the audio page; separate them with spaces.
settings-audio-keywords = звук громкость колонки динамики наушники микрофон микрофон выключить проверка

# Introduction under the heading of the audio page, and the words behind the page i.
settings-audio-help = Выберите, какие колонки или наушники воспроизводят звук и какой микрофон слушает.

# Red sentence at the top of the page when PipeWire, the sound system, is not installed.
settings-audio-top-missing = Звука нет: PipeWire не установлен.

# Red sentence at the top of the page when PipeWire is installed but not answering.
settings-audio-top-failed = Звука нет: PipeWire не отвечает.

# Red sentence at the top of the page when there are no speakers or headphones.
settings-audio-top-no-output = Колонки или наушники не найдены.

# Plain sentence at the top of the page while the page is still finding out about sound.
settings-audio-top-listening = Определяется состояние звука…

# Warning at the top of the page when sound is muted; { $device } is the speakers or headphones.
settings-audio-top-muted = Звук выключен, поэтому { $device } молчит.

# Warning at the top of the page when the volume is at nothing; { $device } is the speakers or headphones.
settings-audio-top-down = Громкость на нуле, поэтому { $device } молчит.

# Sentence at the top of the page when all is well; { $device } is the speakers or headphones and { $percent } the volume.
settings-audio-top-playing = Звук идёт через { $device } с громкостью { $percent }%.

# Title of the card for speakers and headphones.
settings-audio-out-title = Колонки и наушники

# Title of the card for microphones.
settings-audio-in-title = Микрофон

# Heading of the line shown when no speakers or headphones are found.
settings-audio-out-none = Нет устройств вывода

# Heading of the line shown when no microphone is found.
settings-audio-in-none = Нет устройств ввода

# Small words under that line for speakers.
settings-audio-out-plug = Подключите колонки или наушники.

# Small words under that line for microphones.
settings-audio-in-plug = Подключите микрофон или гарнитуру.

# Heading of the line with the list of devices.
settings-audio-device = Устройство

# Small words under the device line for speakers.
settings-audio-out-device-about = Где воспроизводится звук.

# Small words under the device line for microphones.
settings-audio-in-device-about = Что слушает.

# Name of the list of speakers and headphones.
settings-audio-out-device-name = Где воспроизводится звук

# Name of the list of microphones.
settings-audio-in-device-name = Что слушает

# Heading of the volume line.
settings-audio-volume = Громкость

# Name of the volume slider for the speakers.
settings-audio-out-volume-name = Громкость звука

# Name of the volume slider for the microphone.
settings-audio-in-volume-name = Громкость микрофона

# Heading of the mute line.
settings-audio-mute = Без звука

# Name of the switch that mutes the sound.
settings-audio-out-mute-name = Выключить звук

# Name of the switch that mutes the microphone.
settings-audio-in-mute-name = Выключить микрофон

# Small words under the mute line for the speakers.
settings-audio-mute-out-about = Тишина, громкость сохраняется.

# Small words under the mute line for the microphone.
settings-audio-mute-in-about = Пока включено, ничего не слышно.

# Heading of the line that plays a test sound.
settings-audio-test = Проверка

# Small words under the test line.
settings-audio-test-about = Воспроизводит короткий сигнал через это устройство.

# Name of the button that plays a test sound.
settings-audio-test-button = Воспроизвести тестовый звук

# Words behind the i of the speakers card.
settings-audio-out-about = Выберите, какие колонки или наушники воспроизводят звук. Громкость и отключение звука здесь те же, что и клавиши на клавиатуре и значок звука в кольце.

# Heading of the line with the microphone level bar.
settings-audio-level = Уровень

# Small words under the level line.
settings-audio-level-about = Говорите, и полоса будет двигаться, когда микрофон вас слышит.

# Words behind the i of the microphone card.
settings-audio-in-about = Выберите, какой микрофон слушает. Полоса уровня следует за тем, что он слышит, пока эта страница открыта; ничего не записывается и не сохраняется.

# Title of the card shown when PipeWire is not answering.
settings-audio-failed-title = Звук

# Heading of the line in that card.
settings-audio-failed-heading = PipeWire не отвечает

# Small words under that line.
settings-audio-failed-about = Возможно, звук не запустился в этом сеансе.

# Red words under the volume line when the volume could not be changed.
settings-audio-no-volume = Не удалось изменить громкость. Возможно, звук не запустился; выйдите из системы и войдите снова, затем повторите попытку.

# Red words under the mute line when the sound could not be muted.
settings-audio-no-mute = Не удалось выключить звук. Возможно, звук не запустился; выйдите из системы и войдите снова, затем повторите попытку.

# Red words under the mute line when the sound could not be turned back on.
settings-audio-no-unmute = Не удалось снова включить звук. Возможно, звук не запустился; выйдите из системы и войдите снова, затем повторите попытку.

# Red words under the device line when the device could not be chosen.
settings-audio-not-chosen = Не удалось выбрать это устройство.

# Red words under the test line when the test sound would not play.
settings-audio-test-failed = Тестовый звук не воспроизвёлся через это устройство.



# A device's name with what kind it is; { $name } is the device and { $kind } one of the kind words below.
settings-audio-with-kind = { $name } ({ $kind })

# Kind of output: a Bluetooth device.
settings-audio-kind-bluetooth = Bluetooth

# Kind of output: a screen or TV on a cable.
settings-audio-kind-hdmi = HDMI

# Kind of output: a device on a USB cable.
settings-audio-kind-usb = USB

# Kind of output: headphones or a headset on a cable.
settings-audio-kind-headphones = наушники

# Kind of output: the computer's own speakers.
settings-audio-kind-speakers = динамики

# Heading of the line shown while Bluetooth plays the sound.
settings-audio-bt-now = Звук идёт на Bluetooth

# Words under that heading.
settings-audio-bt-now-about = Переключитесь на колонки; Bluetooth останется подключённым.

# Tooltip of the button that moves the sound to the speakers; { $device } is the speakers, kind included.
settings-audio-use-speakers = Играть через { $device }

# Heading of the line when Bluetooth devices are connected but have no sound output; { $names } lists them.
settings-audio-bt-silent = { $names }: подключено, но нет вывода звука.

# Words under that heading.
settings-audio-bt-silent-about = Возможно, звуковой профиль выключен. Отключите устройство и подключите снова.

