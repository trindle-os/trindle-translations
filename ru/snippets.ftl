# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] { $count } фрагмент
        [few] { $count } фрагмента
        [many] { $count } фрагментов
       *[other] { $count } фрагмента
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] { $shown } из { $all } фрагмента
        [few] { $shown } из { $all } фрагментов
        [many] { $shown } из { $all } фрагментов
       *[other] { $shown } из { $all } фрагмента
    }

# The version at the foot of the window. $version is its number.
snippets-version = Snippets { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Snippets не удалось обновить подстановку при вводе: { $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Snippets пропустил файл { $file }. { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = При работе с Espanso эти файлы смогут выполнять команды на этом компьютере: { $files }. Импортировать их?

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = ещё { $count }

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] Импортирован { $count } файл.
        [few] Импортировано { $count } файла.
        [many] Импортировано { $count } файлов.
       *[other] Импортировано { $count } файла.
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Snippets не удалось создать { $path }: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Snippets не удалось прочитать файл { $file }. { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Ничего не сохранено, потому что Snippets не удалось сделать резервную копию файла: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Snippets не удалось записать { $path }: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = Snippets не удалось прочитать файл: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = Snippets не удалось открыть файл: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Snippets не удалось сохранить фрагмент: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = Snippets может показать этот фрагмент, но не может его изменить, потому что он использует: { $names }.

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = Файл { $name } слишком большой для импорта в качестве файла фрагментов.

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Snippets не поддерживает отступ в строке { $line }.
