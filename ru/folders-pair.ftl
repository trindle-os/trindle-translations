# machine translated (Russian), not yet reviewed by a person.

# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Здесь нет отличий от другой панели по имени, размеру или дате. Папки сопоставляются только по имени.
        [one] { $n } элемент здесь отсутствует в другой панели или отличается от неё по размеру или дате. Папки сопоставляются только по имени.
        [few] { $n } элемента здесь отсутствуют в другой панели или отличаются от неё по размеру или дате. Папки сопоставляются только по имени.
        [many] { $n } элементов здесь отсутствуют в другой панели или отличаются от неё по размеру или дате. Папки сопоставляются только по имени.
       *[other] { $n } элемента здесь отсутствуют в другой панели или отличаются от неё по размеру или дате. Папки сопоставляются только по имени.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Для этого нужны обе панели: нажмите F3 для двойного вида.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Результаты поиска нельзя показать в другой панели.
