
# Red words under the search box when nothing that was dropped on the window is a kind Apps takes.
store-left-minute = осталась примерно минута

# How long is left, in minutes.
store-left-minutes = осталось примерно { $n } мин

# How long is left, in hours.
store-left-hours =
    { $n ->
        [one] остался примерно { $n } час
        [few] осталось примерно { $n } часа
        [many] осталось примерно { $n } часов
       *[other] осталось примерно { $n } часа
    }

