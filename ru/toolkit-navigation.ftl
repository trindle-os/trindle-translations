# machine translated (Russian), not yet reviewed by a person.

# What the screen reader calls the strip of page names over a stack of pages.
kit-pages = Страницы

# Name of the button at the top left of a page that goes back to the page before. Also read out by the screen reader.
kit-back = Назад

# Name of the button at the top of a panel laid over a page, which puts the panel away.
kit-shut-panel = Закрыть панель

# What the screen reader calls the one column of a grid of icons: each tile's name.
kit-name = Имя

# Under a program's name on its about page.
kit-version = Версия { $version }

# Name of the button on an about page that opens the program's website.
kit-website = Веб-сайт

# Heading over who made a program, on its about page.
kit-credits = Авторы

# Heading over a program's licence and copyright, on its about page.
kit-licence = Лицензия

# Name of one dot under a pager of pages, said by the screen reader and on pointing.
kit-page-of = Страница { $n } из { $of }

# What the screen reader calls the list of places in an outline, such as a sidebar of folders.
kit-places = Места

# What the screen reader calls the list of programs that can open a file.
kit-apps = Приложения

