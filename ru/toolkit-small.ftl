# machine translated (Russian), not yet reviewed by a person.

# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Удалить «{ $name }»

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, звёзд: { $value } из { $max }

# The names of the three boxes of a duration entry.
kit-duration-hours = Часы

kit-duration-minutes = Минуты

kit-duration-seconds = Секунды

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Шаг { $n } из { $count }

kit-step-back = Назад

kit-step-next = Далее

kit-step-finish = Готово

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Найти

kit-find-previous = Предыдущее совпадение

kit-find-next = Следующее совпадение

kit-find-none = Совпадений нет

kit-find-count = { $at } из { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Ещё { $n } человек
        [few] Ещё { $n } человека
        [many] Ещё { $n } человек
       *[other] Ещё { $n } человека
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Градиент с точками: { $n }

kit-gradient-place = Положение выбранной точки

kit-gradient-add = Добавить точку

kit-gradient-remove = Удалить точку

# The "i" button that shows and hides a card's help.
kit-help-show = Показать справку

kit-help-hide = Скрыть справку

