
# Red words under the search box when nothing that was dropped on the window is a kind Apps takes.
store-left-minute = تبقّت نحو دقيقة

# How long is left, in minutes.
store-left-minutes = تبقّت نحو { $n } دقيقة

# How long is left, in hours.
store-left-hours =
    { $n ->
        [zero] تبقّت نحو { $n } ساعة
        [one] تبقّت نحو ساعة واحدة
        [two] تبقّت نحو ساعتين
        [few] تبقّت نحو { $n } ساعات
        [many] تبقّت نحو { $n } ساعة
       *[other] تبقّت نحو { $n } ساعة
    }

