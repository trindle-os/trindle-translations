# machine translated (Arabic), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = إزالة { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }، { $value } من { $max } نجوم

# The names of the three boxes of a duration entry.
kit-duration-hours = ساعات

kit-duration-minutes = دقائق

kit-duration-seconds = ثوانٍ

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = الخطوة { $n } من { $count }

kit-step-back = رجوع

kit-step-next = التالي

kit-step-finish = إنهاء

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = بحث

kit-find-previous = المطابقة السابقة

kit-find-next = المطابقة التالية

kit-find-none = لا مطابقات

kit-find-count = { $at } من { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [zero] لا أحد آخر
        [one] شخص آخر واحد
        [two] شخصان آخران
        [few] { $n } أشخاص آخرين
        [many] { $n } شخصًا آخر
       *[other] { $n } شخص آخر
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = تدرّج بـ { $n } نقاط توقف

kit-gradient-place = موضع نقطة التوقف المحددة

kit-gradient-add = إضافة نقطة توقف

kit-gradient-remove = إزالة نقطة التوقف

# The "i" button that shows and hides a card's help.
kit-help-show = إظهار المساعدة

kit-help-hide = إخفاء المساعدة

