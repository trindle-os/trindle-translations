# machine translated (Arabic), not yet reviewed by a person.

# Name of the Permissions page, in the page list and as its heading.
settings-permissions-title = الأذونات

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = الأذونات السماح الخصوصية فلات باك flatpak flathub فلاثب الحماية الصندوق الإنترنت الشبكة الملفات الصوت الميكروفون الكاميرا بلوتوث الإشعارات الإضافات deb x11 xwayland البرامج القديمة steam wine java الشاشة الطرفية الحاسوب thunderbolt usb4 قاعدة الأجهزة

# Help line at the foot of the Permissions page.
# SAFETY: needs a human review before it ships
settings-permissions-help = ما يجوز لكل تطبيق استخدامه. التطبيقات من Flathub والبرامج المثبّتة في مجلدها الخاص والإضافات يُثبَّت كل منها في مجلده الخاص، ومقيَّدة افتراضيًا. الأيقونة الممتلئة تعني مسموحًا؛ انقر عليها لتغييره. يسري تغيير تطبيق Flathub عند بدئه في المرة القادمة. أجهزة Thunderbolt وUSB4 المسموح بها تتصل دائمًا دون سؤال؛ انسَ جهازًا ليُسأل عنه من جديد.

# Red words when a permission could not be changed and nothing more is known.
settings-permissions-not-changed = تعذّر التغيير.

# Words beside a plugin when its change was saved but the plugin could not be started again.
settings-permissions-plugin-not-restarted = تم الحفظ، لكن تعذّر تشغيل الإضافة من جديد. يسري التغيير عند بدئها في المرة القادمة.

# Said beside an app, plugin or switch once a permission change is saved.
settings-permissions-saved = تم الحفظ

# Help text of the AppImages card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-images = يعمل كل AppImage في صندوق خاص به، بمجلد رئيسي خاص. الأيقونة الممتلئة تعني مسموحًا؛ انقر عليها لتغييره. يسري التغيير عند بدء AppImage في المرة القادمة.

# Help text of the Started from Folders card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-programs = يعمل كل برنامج بدأ من المجلدات في صندوق خاص به، بمجلد رئيسي خاص. الأيقونة الممتلئة تعني مسموحًا؛ انقر عليها لتغييره. يسري التغيير عند بدء البرنامج في المرة القادمة.

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# Under the Allow older programs switch.
# SAFETY: needs a human review before it ships
settings-permissions-older-why = يُفصل كل منها عن الباقي. وهي مطفأة لا تُفتح.

# Heading of the card with the switch for older programs.
settings-permissions-older = البرامج القديمة

# Label and tip of the switch that lets older programs open.
# SAFETY: needs a human review before it ships
settings-permissions-allow-older = اسمح بالبرامج القديمة

# Help text on the Thunderbolt and USB4 card when the ports only carry screens.
settings-permissions-lets-in-screens = هذه المنافذ تنقل الشاشات فقط، فلا يستطيع أي جهاز الوصول إلى ذاكرة هذا الحاسوب ولا شيء يُسأل عنه.

# Help text on the Thunderbolt and USB4 card when the ports only carry USB and screens.
settings-permissions-lets-in-usb = هذه المنافذ تنقل USB والشاشات فقط، فلا يستطيع أي جهاز الوصول إلى ذاكرة هذا الحاسوب ولا شيء يُسأل عنه.

# Help text on the Thunderbolt and USB4 card when the ports let every device in.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-all = هذه المنافذ تدع كل جهاز يتصل بنفسه، فلا شيء يُسأل عنه. هذا مضبوط في البرنامج الثابت للحاسوب.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry screens.
settings-permissions-short-screens = هذه المنافذ تنقل الشاشات فقط.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry USB and screens.
settings-permissions-short-usb = هذه المنافذ تنقل USB والشاشات فقط.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the firmware lets every device in.
# SAFETY: needs a human review before it ships
settings-permissions-short-firmware = البرنامج الثابت يدع كل جهاز يتصل.

# Under a package's name: its version number is { $v }.
settings-permissions-version = النسخة { $v }

# Under a plugin's name when it asks for nothing: its version number is { $v }.
settings-permissions-version-asks-nothing = النسخة { $v }. لا تطلب شيئًا.

# Under a plugin's name: the words so far are { $sub }, then the ports it listens on in { $detail }.
settings-permissions-sub-listen = { $sub }. { $detail }

# Red words when a Thunderbolt or USB4 device could not be forgotten.
settings-permissions-not-forgotten = تعذّر نسيانه.

# Heading of the Thunderbolt and USB4 card.
settings-permissions-thunder = Thunderbolt وUSB4

# Help text of the Thunderbolt and USB4 card: { $about } is a further sentence, or nothing.
# SAFETY: needs a human review before it ships
settings-permissions-thunder-about = أجهزة Thunderbolt وUSB4 المسموح بها تتصل دائمًا دون سؤال؛ انسَ جهازًا ليُسأل عنه من جديد. { $about }

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-ports = المنافذ

# Under The ports while the Thunderbolt and USB4 card is read.
settings-permissions-reading-ports = جارٍ قراءة ما تسمح به…

# Heading of a line on the Thunderbolt and USB4 card.
settings-permissions-devices-allowed = الأجهزة المسموح بها

# Under a line of the Thunderbolt and USB4 card while it is read.
settings-permissions-reading = جارٍ القراءة…

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-memory-apart = الذاكرة المعزولة

# Heading of the line on the Thunderbolt and USB4 card when the computer has no such ports.
settings-permissions-no-ports = لا منافذ Thunderbolt أو USB4

# Under the heading when the computer has no Thunderbolt or USB4 ports.
settings-permissions-nothing-to-ask = فلا شيء يُسأل عنه.

# Under Devices allowed when the computer has no Thunderbolt or USB4 ports.
settings-permissions-none-plug = لا شيء: لا يتصل شيء بهذه الطريقة.

# Heading of the line on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-nothing-ask = لا شيء يُسأل عنه

# Under Devices allowed when the ports let every device in themselves.
# SAFETY: needs a human review before it ships
settings-permissions-every-one = كلها، بواسطة المنافذ نفسها.

# Help text of the Thunderbolt and USB4 card when the computer keeps devices away from memory.
settings-permissions-iommu = يُبعد هذا الحاسوب الأجهزة أيضًا عن الذاكرة التي لم تُعطَ لها، فالخطر أقل. نسيان جهاز يتركه متصلًا حتى يُفصل.

# Help text of the Thunderbolt and USB4 card when the computer does not keep devices away from memory.
settings-permissions-no-iommu = نسيان جهاز يتركه متصلًا حتى يُفصل؛ وفي المرة القادمة يُسأل عنه من جديد.

# Heading of the line on the Thunderbolt and USB4 card that lists the devices.
# SAFETY: needs a human review before it ships
settings-permissions-asked-before = يُسأل عنه قبل اتصال جهاز جديد

# Under the heading above.
settings-permissions-forget-one = انسَ جهازًا ليُسأل عنه من جديد.

# Red words when the list of allowed Thunderbolt devices could not be read: the reason is { $why }.
settings-permissions-devices-not-read = تعذّرت قراءة الأجهزة المسموح بها: { $why }

# Shown when no Thunderbolt or USB4 device has been allowed always.
# SAFETY: needs a human review before it ships
settings-permissions-no-device = لا يجوز لأي جهاز الاتصال دون سؤال بعد.

# Tip of the button that forgets an allowed Thunderbolt or USB4 device.
# SAFETY: needs a human review before it ships
settings-permissions-forget-device = انسَ هذا الجهاز

# Name given to a Thunderbolt or USB4 device that has none.
settings-permissions-a-device = جهاز Thunderbolt

# Under an allowed device's name when its maker is not known.
# SAFETY: needs a human review before it ships
settings-permissions-may-always = يجوز له الاتصال دائمًا

# Under an allowed device's name: the maker is { $vendor }.
# SAFETY: needs a human review before it ships
settings-permissions-made-by = صنعته { $vendor }. يجوز له الاتصال دائمًا.

# Headline while the list of apps is being read.
settings-permissions-reading-apps = جارٍ قراءة ما يجوز لكل تطبيق استخدامه…

# Headline while Flatpak is still answering: how many apps are listed.
settings-permissions-reading-each =
    { $n ->
        [one] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
        [two] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
        [few] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
        [many] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
        [zero] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
       *[other] جارٍ قراءة ما يجوز لكل واحد من { $n } استخدامه…
    }

# Headline when no app or plugin is kept in a box of its own.
settings-permissions-no-apps = لا توجد تطبيقات أو إضافات محفوظة في صندوق خاص بها.

# Headline when exactly one app is kept in a box of its own.
settings-permissions-one-app = تطبيق واحد محفوظ في صندوق خاص به ولا يستخدم إلا ما هو مسموح هنا.

# Headline: how many apps and plugins are kept in a box of their own.
settings-permissions-many-apps =
    { $n ->
        [one] تطبيق أو إضافة واحدة محفوظة في صندوق خاص بها، ولا تستخدم إلا ما هو مسموح هنا.
        [two] تطبيقان أو إضافتان محفوظان كل في صندوق خاص به، ولا يستخدمان إلا ما هو مسموح هنا.
        [few] { $n } تطبيقات وإضافات محفوظة كل في صندوق خاص به، ولا تستخدم إلا ما هو مسموح هنا.
        [many] { $n } تطبيقًا وإضافة محفوظة كل في صندوق خاص به، ولا تستخدم إلا ما هو مسموح هنا.
        [zero] { $n } تطبيق وإضافة محفوظة كل في صندوق خاص به، ولا تستخدم إلا ما هو مسموح هنا.
       *[other] { $n } تطبيق وإضافة محفوظة كل في صندوق خاص به، ولا تستخدم إلا ما هو مسموح هنا.
    }

# Heading of the card for apps from Flathub.
settings-permissions-flathub-apps = تطبيقات Flathub

# Heading of the card for programs installed in their own folder.
settings-permissions-own-folder = في مجلدها الخاص

# Heading of the card for plugins.
settings-permissions-plugins = الإضافات

# Heading of the card for AppImages.
settings-permissions-appimages = AppImages

# Heading of the card for programs started from Folders.
settings-permissions-from-folders = بدأت من المجلدات

# Under a kind of app on the Permissions page when none is installed.
settings-permissions-none-installed = لا شيء مثبّت.

# Under a kind of app on the Permissions page when none has been run.
settings-permissions-none-run = لا شيء شُغّل بعد.

# Help text of the Flathub apps card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-flathub-about = كل تطبيق من Flathub محفوظ في صندوق خاص به، ولا يجوز له استخدام إلا ما هو مسموح هنا. الأيقونة الممتلئة تعني مسموحًا؛ انقر عليها لتغييره. يسري التغيير عند بدء التطبيق في المرة القادمة.

# Help text of the In their own folder card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-debs-about = البرامج المثبّتة في مجلدها الخاص مقيَّدة افتراضيًا. الأيقونة الممتلئة تعني مسموحًا؛ انقر عليها لتغييره.

# Help text of the Plugins card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-plugins-about = الإضافات مقيَّدة افتراضيًا، ولا يجوز أن يُسمح لها إلا بما تطلبه. الإضافة العاملة في الخلفية تبدأ من جديد فورًا مع التغيير.

# Typing codes card: every short code Trindle swaps for words as you type.
settings-permissions-codes = رموز الكتابة

settings-permissions-codes-about = رموز قصيرة يستبدلها Trindle بكلمات أثناء الكتابة، مع الإضافة المالكة لكل منها. أوقف رموز أي إضافة بأيقونتها الدائرية.

settings-permissions-codes-none = لا توجد رموز نشطة

# SAFETY: needs a human review before it ships
settings-permissions-codes-none-sub = تظهر هنا الإضافة المسموح لها بتوسيع الرموز.

# Button on a plugin's row: stops that plugin's codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-off = إيقاف رموز { $name }

settings-permissions-codes-count =
    { $n ->
        [zero] لا رموز، { $id }
        [one] رمز واحد، { $id }
        [two] رمزان، { $id }
        [few] { $n } رموز، { $id }
        [many] { $n } رمزاً، { $id }
       *[other] { $n } رمز، { $id }
    }

# A code's second line: what it types and who owns it.
settings-permissions-code-types = يكتب "{ $words }" لـ { $name }

settings-permissions-codes-more =
    { $n ->
        [zero] لا توجد رموز أخرى نشطة
        [one] رمز واحد آخر نشط
        [two] رمزان آخران نشطان
        [few] { $n } رموز أخرى نشطة
        [many] { $n } رمزاً آخر نشطاً
       *[other] { $n } رمز آخر نشط
    }

# Line on the typing codes card when the plugins folder could not be read: the list may be missing codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread-line = تعذرت قراءة مجلد الإضافات

# Red words under that line.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread = تعذرت قراءة مجلد الإضافات، لذلك قد تكون بعض الرموز مفقودة.

settings-permissions-not-added = شُغّل من Folders ولم يُضف إلى Apps

settings-permissions-kind-tip = نوع التطبيق



# Heading of the card for programs that are not in a box.
settings-outside-heading = برامج خارج الصندوق

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = يتفقد Trindle كل بضع ثوانٍ ويخبرك. لا يستطيع إيقاف هذه البرامج، وقد يفوته برنامج سريع. البرنامج الموجود في صندوق يحتويه صندوقه.

# Label of the switch for the notice about the network.
settings-outside-network = أخبرني عندما يصل برنامج إلى الشبكة

# Label of the switch for the notice about the person's files.
settings-outside-files = أخبرني عندما يفتح برنامج ملفاتك

# Under those two switches.
settings-outside-once = مرة واحدة لكل برنامج.

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = أخبرني مرة أخرى عن { $name }

# Under a program marked fine for the network.
settings-outside-fine-network = الوصول إلى الشبكة مقبول.

# Under a program marked fine for the person's files.
settings-outside-fine-files = فتح ملفاتك مقبول.

# The line in the card when no program is marked fine.
settings-outside-no-fine = لا برنامج معلَّم بأنه مقبول.

# Heading of the card for downloaded files.
settings-downloads-heading = الملفات المنزَّلة

# Help text of that card (the information button).
settings-downloads-about = الملف من الإنترنت هو ما في التنزيلات، أو ما علّمه المتصفح. البرنامج الذي يفتحه يحصل على ذلك الملف فقط، للقراءة فقط، دون إنترنت ودون أي من مجلداتك. هذا لا يشمل زر «فتح» في المتصفح نفسه، فهو يشغّل البرنامج بنفسه.

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = فتح الملفات المنزَّلة في صندوق

# Under that switch.
settings-downloads-box-sub = دون إنترنت، وذلك الملف فقط، للقراءة فقط.

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = فتح ملفات { $kind } كالمعتاد

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = ملفات { $kind }

# Under a file type's switch.
settings-downloads-normal-sub = مفعّل: تُفتح كالمعتاد، مع الإنترنت.

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = لا نوع بعد. يُدرج نوع عندما يُفتح ملف منزَّل في صندوق.

