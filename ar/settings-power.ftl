# machine translated (Arabic), not yet reviewed by a person.

# Name of the Settings page about power, in the list and as its heading.
settings-power-title = الطاقة

# Words a person might type into the Settings search to find the power page; separate them with spaces.
settings-power-keywords = battery suspend sleep shut down restart log out screen off idle dim lock password pin keypad caffeine keep awake charge charging limit 80 battery health بطارية سكون إيقاف التشغيل إعادة التشغيل تسجيل الخروج الشاشة قفل كلمة المرور شحن صحة البطارية

# Introduction under the heading of the power page, and the words behind the page i.
# SAFETY: needs a human review before it ships
settings-power-help = البطارية ووضع الطاقة، ومتى تخفت الشاشة وتُقفل وتنطفئ، وفي الحاسوب المحمول بشكل منفصل للبطارية وللشاحن. الكوب على اللسان يُبقي الشاشة مستيقظة. القفل وإعادة التشغيل وإيقاف التشغيل هنا أيضًا.

# Choice in a list of how long to wait.
settings-power-time-never = أبدًا

# Choice in a list of how long to wait.
settings-power-time-1m = دقيقة واحدة

# Choice in a list of how long to wait.
settings-power-time-2m = دقيقتان

# Choice in a list of how long to wait.
settings-power-time-5m = 5 دقائق

# Choice in a list of how long to wait.
settings-power-time-10m = 10 دقائق

# Choice in a list of how long to wait.
settings-power-time-15m = 15 دقيقة

# Choice in a list of how long to wait.
settings-power-time-30m = 30 دقيقة

# Choice in a list of how long to wait.
settings-power-time-45m = 45 دقيقة

# Choice in a list of how long to wait.
settings-power-time-1h = ساعة واحدة

# Choice in a list of how long to wait.
settings-power-time-90m = ساعة ونصف

# Choice in a list of how long to wait.
settings-power-time-2h = ساعتان

# Choice in the lock after list: lock at no other time than when the computer sleeps.
settings-power-time-only-sleep = عند السكون فقط

# Heading of the line, and name of its round button, that suspends the computer.
# SAFETY: needs a human review before it ships
settings-power-suspend = تعليق

# Heading of the line, and name of its round button, that restarts the computer.
# SAFETY: needs a human review before it ships
settings-power-restart = إعادة التشغيل

# Heading of the line, and name of its round button, that shuts the computer down.
# SAFETY: needs a human review before it ships
settings-power-shut-down = إيقاف التشغيل

# Choice in the list of what closing the lid does: the computer sleeps.
settings-power-lid-sleep = السكون

# Choice in the list of what closing the lid does: the computer hibernates.
settings-power-lid-hibernate = السبات

# Choice in the list of what closing the lid does: the screen locks.
settings-power-lid-lock = قفل الشاشة

# Choice in the list of what closing the lid does: nothing.
settings-power-lid-nothing = لا شيء

# Choice in the list of what closing the lid does: the computer shuts down.
# SAFETY: needs a human review before it ships
settings-power-lid-shut-down = إيقاف التشغيل

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-dim = أخفت الشاشة بعد

# Small words under an idle timer line.
settings-power-timer-dim-about = أي حركة تعيد السطوع.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-clock = أظهر الساعة المتحركة بعد

# Small words under an idle timer line.
settings-power-timer-clock-about = الوقت وحده، يتنقل ببطء.

# Heading of an idle timer line, and the name of its lists.
settings-power-timer-off = أطفئ الشاشة بعد

# Small words under an idle timer line.
settings-power-timer-off-about = أي مفتاح أو حركة تشغّلها من جديد.

# Heading of an idle timer line, and the name of its lists.
# SAFETY: needs a human review before it ships
settings-power-timer-suspend = علّق الحاسوب بعد

# Small words under an idle timer line.
settings-power-timer-suspend-about = إذا تُرك بلا استخدام طوال هذه المدة، ينام.

# Red words under the keep the screen awake switch when turning it on could not be saved.
settings-power-no-awake = تعذّر إبقاء الشاشة مستيقظة: لم يمكن حفظ الاختيار.

# Red words under the keep the screen awake switch when turning it off could not be saved.
settings-power-no-sleep = تعذّر إيقاف إبقاء الشاشة مستيقظة: لم يمكن حفظ الاختيار.

# Name of the power mode that saves the battery.
settings-power-profile-saver = توفير البطارية

# Name of the balanced power mode.
settings-power-profile-balanced = متوازن

# Name of the power mode that favours speed.
settings-power-profile-performance = الأداء

# What the battery is doing: charging.
settings-power-state-charging = قيد الشحن

# What the battery is doing: running on its own charge.
settings-power-state-battery = تعمل بالبطارية

# What the battery is doing: empty.
settings-power-state-empty = فارغة

# What the battery is doing: full.
settings-power-state-full = ممتلئة

# What the battery is doing: the charger is in but it is not charging.
settings-power-state-plugged = موصولة بالكهرباء، لا تُشحن

# Time left on the battery; { $h } hours and { $m } minutes. The h and min are short for hours and minutes.
settings-power-hours-minutes = { $h } س { $m } د

# Time left on the battery when under an hour; { $m } minutes. The min is short for minutes.
settings-power-minutes = { $m } د

# Sentence at the top of the page on a computer with no battery.
settings-power-top-no-battery = موصول بالكهرباء: لا توجد بطارية في هذا الحاسوب لتُعتنى بها.

# Sentence at the top of the page on a computer with no battery; { $mode } is the power mode.
settings-power-top-no-battery-mode = موصول بالكهرباء، بوضع { $mode }: لا توجد بطارية لتُعتنى بها.

# Sentence at the top of the page while charging; { $percent } is how full.
settings-power-top-charging = قيد الشحن، { $percent }%.

# Sentence at the top of the page while charging; { $percent } is how full and { $left } how long until full.
settings-power-top-charging-left = قيد الشحن، { $percent }%، تمتلئ خلال { $left }.

# Sentence at the top of the page when the battery is full.
settings-power-top-full = البطارية ممتلئة.

# Sentence at the top of the page when plugged in but not charging; { $percent } is how full.
settings-power-top-plugged = موصول بالكهرباء عند { $percent }%، لا يُشحن.

# Sentence at the top of the page on battery; { $percent } is how full.
settings-power-top-battery = البطارية عند { $percent }%.

# Sentence at the top of the page on battery; { $percent } is how full and { $left } how long is left.
settings-power-top-battery-left = البطارية عند { $percent }%، يتبقى نحو { $left }.

# Sentence at the top of the page while the battery is being read.
settings-power-top-looking = جارٍ النظر في البطارية…

# Red words under the power mode line when the mode could not be changed.
settings-power-mode-failed = تعذّر تغيير وضع الطاقة.

# Heading of the power mode line, and the name of its list.
settings-power-mode = وضع الطاقة

# Small words under the power mode line.
settings-power-mode-about = التوفير أبرد؛ والأداء أسرع.

# Said in green under a line after its choice was kept.
settings-power-saved = تم الحفظ

# Name of the list of battery levels to warn at.
settings-power-warn-name = حذّر عندما تنخفض البطارية إلى

# Heading of the line for the battery warning.
settings-power-warn = حذّر عندما تنخفض إلى

# Small words under the battery warning line.
settings-power-warn-about = مرة واحدة، في وسط الشاشة.

# Choice in the list of battery levels: never warn.
settings-power-never = أبدًا

# Heading of the line, and name of its switch, for stopping charging at 80%.
settings-power-limit = أوقف الشحن عند 80%

# Small words under the charge limit line.
settings-power-limit-about = ألطف بالبطارية الموصولة بالكهرباء في الغالب.

# Title of the battery card on a laptop.
settings-power-card-battery = البطارية

# Title of the battery card when there is no battery picture and no power modes.
settings-power-card-looking-after = العناية بالبطارية

# Words behind the i of the battery card.
settings-power-battery-about = توفير البطارية أبرد ويجعل البطارية تدوم أطول؛ والأداء أسرع؛ والمتوازن بين الاثنين. يظهر التحذير مرة واحدة في وسط الشاشة أثناء نفاد البطارية. الإيقاف عند 80% ألطف بالبطارية في حاسوب محمول موصول بالكهرباء في الغالب: تُشحن حتى 80% لا أكثر، وتدوم سنوات أطول. أوقفه قبل يوم بعيد عن مقبس الكهرباء.

# Words under the charge limit line while the password window is open.
# SAFETY: needs a human review before it ships
settings-power-limit-waiting = بانتظار كلمة المرور...

# Green words under the charge limit line after charging was limited to 80%.
settings-power-limit-on = يتوقف عند 80%

# Green words under the charge limit line after the limit was removed.
settings-power-limit-off = يُشحن حتى الامتلاء

# Heading of the keep the screen awake line, and name of its switch.
settings-power-awake = أبقِ الشاشة مستيقظة

# Small words under the keep the screen awake line.
settings-power-awake-about = الكوب على اللسان يفعل الشيء نفسه.

# Title of the card about dimming and the moving clock.
settings-power-screen-title = الشاشة

# Words behind the i of the Screen card.
settings-power-screen-about = ما دام إبقاء الشاشة مستيقظة مفعّلًا، لا يحدث أي من هذه؛ والكوب على اللسان يشغّله ويوقفه أيضًا. الإخفات: أي حركة تعيد السطوع؛ ولا تخفت إلا الشاشات التي لها سطوعها الخاص، مثل شاشة الحاسوب المحمول. الساعة المتحركة: تظلم الشاشة ولا يظهر عليها إلا الوقت، يتنقل ببطء، وأي مفتاح أو حركة تعيد كل شيء. في الحاسوب المحمول يُضبط كل وقت مرتين، للبطارية وللشاحن.

# Title of the card about turning the screen off and sleeping.
settings-power-sleep-title = إطفاء الشاشة والسكون

# Words behind the i of the Screen off and sleep card.
settings-power-sleep-about = أي مفتاح أو حركة تشغّل الشاشة من جديد. التعليق يضع الحاسوب في السكون حتى توقظه. في الحاسوب المحمول يُضبط كل وقت مرتين، للبطارية وللشاحن. عند توصيل شاشة ثانية، لا يفعل إغلاق الغطاء شيئًا، لتتابع العمل على الشاشة الأكبر.

# Heading of the line for what closing the lid does.
settings-power-lid = عند إغلاق الغطاء

# Small words under that line.
settings-power-lid-about = لا يحدث شيء مع وجود شاشة ثانية.

# Caption above a list that applies while the laptop runs on its battery.
settings-power-when-battery = على البطارية

# Caption above a list that applies while the laptop is plugged in.
settings-power-when-charger = موصول بالكهرباء

# Name of a list that applies on battery; { $title } is the name of its line.
settings-power-named-battery = { $title }: على البطارية

# Name of a list that applies while plugged in; { $title } is the name of its line.
settings-power-named-charger = { $title }: موصول بالكهرباء

# Heading of the lock the screen line, and name of its switch.
settings-power-lock = اقفل الشاشة

# Small words under the lock the screen line.
# SAFETY: needs a human review before it ships
settings-power-lock-about = كلمة مرورك أو رمز PIN يعيدك إليها.

# Heading of the lock after line, and the name of its list.
settings-power-lock-after-name = اقفل بعد

# Small words under the lock after line.
settings-power-lock-after-about = إذا تُرك بلا استخدام طوال هذه المدة، مهما كان غير ذلك مضبوطًا.

# Heading of the line, and name of its switch, for locking when the computer sleeps.
settings-power-lock-sleep = اقفل عندما ينام الحاسوب

# Small words under that line.
settings-power-lock-sleep-about = ليستيقظ دائمًا وهو مقفل.

# Heading of the line, and name of its button, that locks the screen now.
settings-power-lock-now = اقفل الآن

# Small words under the lock now line.
settings-power-lock-now-about = وأيضًا Super وL معًا.

# Red words under the lock now line when the lock screen would not start.
settings-power-lock-now-failed = تعذّر قفل الشاشة: لم تبدأ شاشة القفل.

# Title of the locking card.
settings-power-lock-title = القفل

# Words behind the i of the locking card.
# SAFETY: needs a human review before it ships
settings-power-lock-card-about = عندما تكون بعيدًا، تُقفل الشاشة، ويعيدك إليها كلمة مرورك، أو رمز PIN من أربعة أرقام إن اخترت واحدًا. لا يظهر شيء على الشاشة حتى ذلك الحين. تسجيل الدخول يحتاج دائمًا إلى كلمة مرورك. «اقفل بعد» هي المدة التي يُترك فيها الحاسوب قبل أن يُقفل، مهما كانت أوقات الشاشة والسكون؛ وحتى ذلك الحين، لا يحتاج الرجوع إلى PIN. إيقاف القفل ينسى PIN أيضًا. أربعة أرقام أسرع في الكتابة من كلمة مرورك: بعد المدة المختارة لعمل PIN بعد القفل، أو بعد خمس محاولات خاطئة، تلزم كلمة مرورك بدلًا منه. سلة المهملات توقف استخدام PIN.

# Heading of the line for adding a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-add = افتح القفل برمز PIN أيضًا

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-add-about = أربعة أرقام، أسرع من كلمة مرورك.

# Heading of the line, and name of its list, for how long a PIN works after the screen locks.
# SAFETY: needs a human review before it ships
settings-power-pin-works-name = يعمل PIN لمدة

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-works-about = بعدها تلزم كلمة مرورك بدلًا منه.

# Name of the bin button that stops using a PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-stop = أوقف استخدام PIN

# Heading of the line shown when a PIN is kept.
# SAFETY: needs a human review before it ships
settings-power-pin-kept = PIN محفوظ

# Small words under that line.
# SAFETY: needs a human review before it ships
settings-power-pin-kept-about = اكتب أربعة أرقام جديدة لتغييره.

# Placeholder of the box for typing a new PIN.
# SAFETY: needs a human review before it ships
settings-power-pin-new = PIN جديد

# Name of the button that keeps the PIN typed.
# SAFETY: needs a human review before it ships
settings-power-pin-keep = احتفظ بهذا PIN

# Red words under the PIN line when the PIN could not be removed.
# SAFETY: needs a human review before it ships
settings-power-pin-not-removed = تعذّرت إزالة PIN، لذا لا يزال يفتح قفل الشاشة.

# Red words under the PIN box when it is not the right length; { $n } is how many digits a PIN has.
settings-power-pin-digits =
    { $n ->
        [zero] لا يحتوي PIN على أرقام.
        [one] يتكون PIN من رقم واحد.
        [two] يتكون PIN من رقمين.
        [few] يتكون PIN من { $n } أرقام.
        [many] يتكون PIN من { $n } رقمًا.
       *[other] يتكون PIN من { $n } رقم.
    }

# Heading of the log out line, and name of its round button.
# SAFETY: needs a human review before it ships
settings-power-log-out = تسجيل الخروج

# Small words under the log out line.
settings-power-log-out-about = العودة إلى شاشة تسجيل الدخول.

# Title of the card with log out, suspend, restart and shut down.
settings-power-session-title = الجلسة

# Words behind the i of the session card.
# SAFETY: needs a human review before it ships
settings-power-session-about = تسجيل الخروج يغلق كل نافذة ويعود إلى شاشة تسجيل الدخول. التعليق يضع الحاسوب في السكون حتى توقظه. يسأل كل زر مرتين، كما في خيار الطاقة في الحلقة، فلا يحدث شيء بزلة.

# Red words under a session button when the system bus is not there.
settings-power-no-bus = ناقل النظام غير متاح.

# Red words under a session button when the computer would not do it.
settings-power-would-not = لم يفعل الحاسوب ذلك.

# Spoken description of the battery picture while the battery is being read.
settings-power-art-looking-tip = جارٍ النظر في البطارية.

# Spoken description of the battery picture; { $percent } is how full and { $state } what it is doing, such as Charging.
settings-power-art-tip = البطارية عند { $percent }%. { $state }

# Word drawn in the empty battery picture while the battery is being read.
settings-power-art-looking = جارٍ النظر

# Word drawn under the battery figure when its state is not known.
settings-power-art-battery = البطارية

# Words drawn in the battery picture: { $left } is the time left and { $state } is either empty or full.
settings-power-art-left =
    { $state ->
        [empty] { $left } حتى تفرغ
       *[full] { $left } حتى تمتلئ
    }

# Spoken description of the battery range bar when there is no warning; { $top } is the percent it charges to.
settings-power-limits-tip = تُشحن حتى { $top }%؛ بلا تحذير.

# Spoken description of the battery range bar; { $top } is the percent it charges to and { $warn } where a warning comes.
settings-power-limits-tip-warn = تُشحن حتى { $top }%؛ وتحذير عند { $warn }%.

# A length of time in the list of how long a PIN works, in minutes; { $n } is the number.
settings-power-pin-minutes =
    { $n ->
        [zero] لا دقائق
        [one] دقيقة واحدة
        [two] دقيقتان
        [few] { $n } دقائق
        [many] { $n } دقيقة
       *[other] { $n } دقيقة
    }

# A length of time in the list of how long a PIN works, in whole hours; { $n } is the number.
settings-power-pin-hours =
    { $n ->
        [zero] لا ساعات
        [one] ساعة واحدة
        [two] ساعتان
        [few] { $n } ساعات
        [many] { $n } ساعة
       *[other] { $n } ساعة
    }

# A length of time in the list of how long a PIN works, in hours and minutes; { $hours } and { $minutes } are the two parts already written out, such as 1 hour and 15 minutes.
settings-power-pin-hours-minutes = { $hours } و{ $minutes }

