# machine translated (Arabic), not yet reviewed by a person.



# The page's name in the side bar.
settings-pads-title = أيدي التحكم في الألعاب

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = اضغط زرًا على يد التحكم لتغييره.

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = اضغط الآن المفتاح الخاص بـ { $name }.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = لا شيء موصول

# Small words under that line.
settings-pads-none-about = صِل واحدة وستظهر أزرارها هنا.

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = أي يد تحكم

# What the picture is, for the screen reader.
settings-pads-picture = صورة { $title }، مع إضاءة كل زر عند الضغط عليه

# Title of the card of the controller's buttons.
settings-pads-buttons-title = الأزرار

# Words behind the i of that card.
settings-pads-buttons-about = كل زر وزناد واتجاه للعصي ولوحة الاتجاهات. آخر زر ضغطته في الأعلى. الزر المحوَّل إلى مفتاح يكتب ذلك المفتاح في لعبة لا تدعم يد التحكم.

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = تحويل { $name } إلى مفتاح

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = إيقاف تغيير { $name }

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = ما سيصبحه { $name }

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = اضغط مفتاحًا أو اختر زرًا

# The next choice in that list: the Escape key.
settings-pads-escape = مفتاح Escape

# The next choice in that list: nothing at all.
settings-pads-nothing = لا شيء

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = لوحة الاتجاهات { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = العصا { $stick } { $way }

settings-pads-left = لليسار

settings-pads-right = لليمين

settings-pads-up = للأعلى

settings-pads-down = للأسفل

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = اليسرى

settings-pads-stick-right = اليمنى

# Title of the card of the ready-made changes.
settings-pads-quick-title = تغييرات جاهزة

# Title of the card of changes that are not one button into another.
settings-pads-other-title = تغييرات أخرى

# Words behind the i of that card.
settings-pads-other-about = عصي معكوسة وعصي مبدلة ومناطق ميتة. اكتب واحدة هكذا: Left Stick dead zone = 10%، أو Right Stick Y = inverted.



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = لوحة المفاتيح: { $what }

settings-pads-on-mouse = الفأرة: { $what }

settings-pads-on-pad = وحدة التحكم بالألعاب: { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = نقرة يسرى

settings-pads-right-click = نقرة يمنى

settings-pads-middle-click = نقرة وسطى



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = الملفات الشخصية

# Words behind the i of that card.
settings-pads-profiles-about = الملف الشخصي مجموعة تغييرات. «قياسي» لا يغيّر شيئًا، فترى اللعبة التي لها دعم خاص ليد التحكم اليد كما هي. كل لعبة في Steam تستخدم «قياسي» ما لم تختر لها ملفًا هنا، ويتغير الملف من تلقاء نفسه عند بدء تلك اللعبة. «أي لعبة أخرى» للألعاب التي لم يشغّلها Steam.

# The one switch that turns every controller change off at once.
settings-pads-changes = تغييرات يد التحكم

settings-pads-changes-sub = عند الإيقاف تبقى كل يد تحكم كما هي.

# The game whose profile is shown.
settings-pads-game = اللعبة

settings-pads-other-game = أي لعبة أخرى

settings-pads-game-running = { $name } (قيد التشغيل)

settings-pads-game-number = لعبة Steam { $n }

# The profile the shown game uses.
settings-pads-profile = الملف الشخصي

settings-pads-standard = قياسي

settings-pads-standard-sub = لا تغييرات.

settings-pads-profile-add = إضافة ملف شخصي

settings-pads-profile-remove = إزالة { $name }

settings-pads-profile-name = اسم الملف الشخصي

# The name a new profile is given.
settings-pads-profile-new = ملف شخصي { $n }

settings-pads-profile-empty = يحتاج الملف الشخصي إلى اسم.

settings-pads-profile-standard = الاسم «قياسي» مستخدم.

settings-pads-profile-taken = هذا الاسم مستخدم.

settings-pads-profile-gone = هذا الملف الشخصي لم يعد موجودًا.

settings-pads-not-a-game = ليس رقم تطبيق في Steam.

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = «قياسي» لا يغيّر شيئًا. أضف ملفًا شخصيًا أولًا.

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = قياسي: يد التحكم كما هي.

settings-pads-top-off = تغييرات يد التحكم متوقفة.

