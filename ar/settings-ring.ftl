
# machine translated (Arabic), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = الحلقة

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = المفضلة مشغّل حافة نقر زاوية ساخنة صوت كلام نوافذ مفتوحة الحافظة نسخ لصق السجل نسيان إشعارات

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = تقع تطبيقاتك المفضلة حول وسط الحلقة. وتُختار في الحلقة نفسها: انقر بالزر الأيمن على أي تطبيق في الحلقة لإضافته أو إزالته، واسحب أحد المفضلات إلى مكان آخر لتغيير الترتيب.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = تُفتح الحلقة من حافة الشاشة، وتظهر فيها نوافذك المفتوحة.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = أين تُفتح الأشياء

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = انقر عند حافة الشاشة

# Small words under that line about the Super key.
settings-ring-open-super = ويفتحها مفتاح Super أيضًا.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [zero] لا مفضلات
        [one] مفضّل واحد
        [two] مفضّلان
        [few] { $n } مفضّلات
        [many] { $n } مفضّلًا
       *[other] { $n } مفضّل
    }

# Small words under the favourites line.
settings-ring-favourites-about = انقر بالزر الأيمن على تطبيق في الحلقة لإضافة واحد.

# Title of the card about opening the ring.
settings-ring-opening = فتح الحلقة

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = حرّك المؤشر إلى حافة الشاشة وانقر، أو اضغط مفتاح Super، فتُفتح الحلقة. تقع مفضلاتك حول وسطها، وتحيط بها حلقة نوافذك المفتوحة: انقر على نافذة لإحضارها إلى الأمام، أو انقر عليها بالزر الأيمن لعرض أزرارها. انقر بالزر الأيمن على أي تطبيق في الحلقة لإضافته أو إزالته.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = أظهرها عند وصولها

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = متوقف: تبقى تتجمع في الحلقة.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = مدة بقائها

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = العاجلة منها تنتظر أن تُغلق.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = مكان ظهورها

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = الزاوية التي تتراص بعيدًا عنها.

# Title of the card about notifications.
settings-ring-notify-title = الإشعارات

# Words behind the i of the card about notifications.
settings-ring-notify-about = عندما يكون لدى برنامج ما يخبرك به، يظهر لبضع ثوانٍ ثم يختفي. وإذا أُوقفت، لا يظهر شيء، ويبقى كل شيء مجمّعًا في دائرة الإشعارات في الحلقة. الإشعار العاجل ينتظر أن يُغلق مهما كان الاختيار هنا، حتى لا يختفي تحذير قبل أن يُقرأ.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
# SAFETY: needs a human review before it ships
settings-ring-clip-forget = انسَ ما نُسخ

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = الأسطر المثبّتة تبقى محفوظة.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = المنسوخ الآن

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [zero] لا أسطر، { $pinned } مثبّت.
        [one] سطر واحد، { $pinned } مثبّت.
        [two] سطران، { $pinned } مثبّت.
        [few] { $n } أسطر، { $pinned } مثبّت.
        [many] { $n } سطرًا، { $pinned } مثبّت.
       *[other] { $n } سطر، { $pinned } مثبّت.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = الحافظة

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = تحتفظ دائرة الحافظة في الحلقة بما تنسخه، فتستطيع لصق شيء من وقت سابق. الأسطر المثبّتة تبقى دائمًا، مهما كان الاختيار هنا.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = جارٍ إضافة الأوامر الصوتية؛ تابع عملك في الأثناء.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = جارٍ إزالة أدوات البناء.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = جارٍ إزالة الأوامر الصوتية.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = التحكم الصوتي

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = يعمل

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = متوقف

# Small words under the voice switch.
settings-ring-voice-about = يُفهم الكلام على هذا الحاسوب فقط.

# Heading of the line, and the name of its button, that removes voice.
# SAFETY: needs a human review before it ships
settings-ring-voice-remove = أزِل الأوامر الصوتية

# Small words under the line that removes voice.
settings-ring-voice-remove-about = يوفّر نحو 150 ميغابايت.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = الأوامر الصوتية جاهزة. أدوات البناء ما زالت موجودة.

# Name of the button that removes the build tools voice left behind.
# SAFETY: needs a human review before it ships
settings-ring-voice-tools-remove = أزِل أدوات البناء

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = أضف التحكم الصوتي (نحو 150 ميغابايت)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = اختياري؛ إضافته تأخذ نحو 150 ميغابايت.

# Title of the card about voice.
settings-ring-voice-title = الصوت

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = قل اسم تطبيق، أو «أعلى صوتًا»، أو «إعدادات Wi-Fi» بدل النقر. اضغط وسط الحلقة وتكلّم؛ ويتوقف الاستماع عندما تتوقف. يُفهم الكلام على هذا الحاسوب ولا يُرسل شيء إلى أي مكان. تستغرق إضافته نحو 150 ميغابايت وبضع دقائق، ويمكنك متابعة عملك في الأثناء؛ وتؤدي إزالته إلى حذف محرك الكلام ونموذجه.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = جارٍ إضافة الأوامر الصوتية

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = جارٍ إزالة أدوات البناء

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = جارٍ إزالة الأوامر الصوتية

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = عند كل إعادة تشغيل للحاسوب

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = بعد يوم

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = بعد أسبوع

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = بعد أسبوعين

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = أبدًا

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = أظهر العنوان عند التأشير

# Small words under that switch.
settings-ring-names-about = متوقف: اللقطة فقط. وتبقى قارئات الشاشة تحصل على العنوان.

