# machine translated (Arabic), not yet reviewed by a person.



# Words for the keys that open the ring.
ring-shortcuts-ring = فتح الحلقة

# Words for the keys that open the terminal.
ring-shortcuts-terminal = فتح الطرفية

# Words for the key that opens Settings.
ring-shortcuts-settings = فتح الإعدادات

# Words for the keys that close the window in front.
ring-shortcuts-close = إغلاق النافذة

# Words for the key that locks the screen.
ring-shortcuts-lock = قفل الشاشة

# Words for the key that puts every window away to show the desktop.
ring-shortcuts-desktop = إظهار سطح المكتب

# Words for the key that opens Activity, the task manager.
ring-shortcuts-activity = فتح النشاط

# Words for the key that moves the keyboard into the notification circles.
ring-shortcuts-notes = لوحة المفاتيح إلى الإشعارات

# Words for the key that switches the screen reader on or off.
ring-shortcuts-reader = تشغيل قارئ الشاشة أو إيقافه

# Words for the keys that make the window in front fill the screen, or give it back its size.
ring-shortcuts-maximise = تكبير أو استعادة

# Words for the key that puts the window in front away.
ring-shortcuts-minimise = تصغير

# Words for the key that takes the window in front to full screen or back.
ring-shortcuts-fullscreen = تشغيل ملء الشاشة أو إيقافه

# Words for the key that switches to the next window.
ring-shortcuts-next-window = النافذة التالية

# Words for the key that switches to the window before.
ring-shortcuts-previous-window = النافذة السابقة

# Words for the key that puts the window in front on the left half of the screen.
ring-shortcuts-snap-left = النافذة إلى النصف الأيسر

# Words for the key that puts the window in front on the right half of the screen.
ring-shortcuts-snap-right = النافذة إلى النصف الأيمن

# Words for the keys that start the screenshot.
ring-shortcuts-screenshot = التقاط صورة للشاشة

# Words for the key that takes a screenshot of the whole screen without asking.
ring-shortcuts-screenshot-whole = لقطة للشاشة كلها

# Words for the key that makes the sound louder.
ring-shortcuts-volume-up = رفع الصوت

# Words for the key that makes the sound quieter.
ring-shortcuts-volume-down = خفض الصوت

# Words for the key that mutes the sound.
ring-shortcuts-mute = كتم الصوت

# Words for the key that mutes the microphone.
ring-shortcuts-mic-mute = كتم الميكروفون

# Words for the key that makes the screen brighter.
ring-shortcuts-brightness-up = زيادة سطوع الشاشة

# Words for the key that makes the screen dimmer.
ring-shortcuts-brightness-down = خفض سطوع الشاشة

# Words for the key that restarts the ring and the helper parts, leaving windows alone.
ring-shortcuts-restart-parts = إعادة تشغيل الحلقة والأجزاء المساعدة

# Words for the key that restarts everything, the compositor too.
ring-shortcuts-restart-all = إعادة تشغيل كل شيء

# Words for the key that opens this list.
ring-shortcuts-list = إظهار قائمة الاختصارات

# Words for the keys that switch to a text console.
ring-shortcuts-console = التبديل إلى طرفية نصية

# The keys that switch to a text console.
ring-shortcuts-console-keys = Ctrl+Alt+F1 إلى F12

# Words for the keys the screen reader takes while it is on.
ring-shortcuts-reader-keys = مفاتيح قارئ الشاشة نفسه، ما دام يعمل

# The keys the screen reader takes while it is on.
ring-shortcuts-reader-keys-keys = Caps Lock، Insert

# Words for a shortcut of the person's own that has no action Trindle can name.
ring-shortcuts-other = اختصارك الخاص

# Words for a shortcut of the person's own that starts a program; { $command } is what it runs.
ring-shortcuts-runs = يشغّل { $command }

# Words for a plugin's shortcut; { $plugin } is the plugin and { $label } what its shortcut does.
ring-shortcuts-plugin = { $plugin }: { $label }

# Two shortcuts for the same thing on one line; { $first } is the ones so far and { $next } the one added.
ring-shortcuts-and = { $first }، { $next }

# Name of the Super key pressed alone.
ring-shortcuts-key-super = Super

# Name of the volume up key on a keyboard.
ring-shortcuts-key-volume-up = مفتاح رفع الصوت

# Name of the volume down key on a keyboard.
ring-shortcuts-key-volume-down = مفتاح خفض الصوت

# Name of the mute key on a keyboard.
ring-shortcuts-key-mute = مفتاح الكتم

# Name of the microphone mute key on a keyboard.
ring-shortcuts-key-mic-mute = مفتاح كتم الميكروفون

# Name of the brightness up key on a keyboard.
ring-shortcuts-key-brightness-up = مفتاح زيادة السطوع

# Name of the brightness down key on a keyboard.
ring-shortcuts-key-brightness-down = مفتاح خفض السطوع

# Heading over the shortcuts of plugins on the list.
ring-shortcuts-heading-plugins = الإضافات

# Heading over the shortcuts the person set up on the list.
ring-shortcuts-heading-yours = اختصاراتك


# Words for the key that opens the window to report a problem.
ring-shortcuts-report = الإبلاغ عن مشكلة

