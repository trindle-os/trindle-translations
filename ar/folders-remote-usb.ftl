
# machine translated (Arabic), not yet reviewed by a person.

# Red words when the system refused access to the phone; the variable is the device file of its USB connection.
folders-remote-usb-denied = { $node }، اتصال USB الخاص بالهاتف

# Reason in red words ("Could not reach it: ...") when the phone was unplugged.
folders-remote-usb-unplugged = فُصل الهاتف

# Name of what is in use by another program when the phone is already open elsewhere ("The phone is in use by another program.").
folders-remote-usb-busy = الهاتف

# Red words when the phone stopped answering.
folders-remote-usb-stopped = توقف الهاتف عن الاستجابة.

# Red words when the phone refused a request.
folders-remote-usb-refused = رفض الهاتف ذلك.

# Red words when the phone took only part of what was sent.
folders-remote-usb-part = أخذ الهاتف جزءاً فقط مما أُرسل.

