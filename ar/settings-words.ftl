
# machine translated (Arabic), not yet reviewed by a person.

# The card's heading.
settings-words-heading = كلماتك الخاصة

# Under the heading.
settings-words-about = غيّر أي كلمة يعرضها Trindle بأي لغة، وشارك الجدول كملف.

# The first line of the card: what is locked, in plain words.
settings-words-rule = تُرفض الورقة كلها إذا عُدّلت في أي مكان غير عمودها الأخير، أو إذا لم تكن من Trindle نفسه.

# The line that picks which language the boxes are for.
settings-words-language = اللغة

# Under the language line.
settings-words-language-sub = الجدول لهذه اللغة.

# The name of the language list for the screen reader.
settings-words-language-tip = لغة الجدول

# The line that exports the sheet, and its button's tip.
settings-words-export = نزّل الورقة

# Under the export line.
settings-words-export-sub = الإنجليزية على اليسار ولغتك بجانبها. غيّر الجانب الأيمن.

# Title of the window that asks where to save the sheet.
settings-words-export-title = حفظ جدول الكلمات

# The line that imports a sheet, and its button's tip.
settings-words-import = ارفع الورقة

# Under the import line.
settings-words-import-sub = يُفحص كاملًا أولًا. أي اختلاف يعني ألّا يُثبَّت شيء.

# Title of the window that asks which sheet to open.
settings-words-import-title = فتح جدول كلمات

# Under the import button when a sheet was installed.
settings-words-imported = تم التثبيت

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = تعذّر الحفظ

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = مرفوض: الملف كبير جدًا

# Under the import button: the file is not text.
settings-words-not-text = مرفوض: ليس نصًا عاديًا

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = مرفوض: يحتوي على أحرف مخفية أو أحرف تحكم

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = مرفوض: سطر طويل جدًا

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = مرفوض: ليس جدول كلمات من Trindle

# Under the import button: the sheet is of another version.
settings-words-version = مرفوض: إصدار آخر من الجدول

# Under the import button: the language tag is not usable.
settings-words-bad-language = مرفوض: اللغة غير صالحة

# Under the import button: the notes at the top were changed.
settings-words-notes = مرفوض: تم تغيير أعلى الجدول

# Under the import button: lines are missing or extra.
settings-words-count = مرفوض: هناك أسطر ناقصة أو زائدة

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = مرفوض: تم تغيير المفتاح عند { $key }

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = مرفوض: تم تغيير النص الإنجليزي لـ { $key }

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = مرفوض: صف { $key } ليس بالشكل الصحيح

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = مرفوض: كلمات { $key } طويلة جدًا

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = مرفوض: كلمات { $key } تحتوي على أحرف مخفية

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = مرفوض: كلمات { $key } تحتوي على وسوم أو رابط أو مسار

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = مرفوض: العناصر النائبة في { $key } تختلف

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = مرفوض: تعذّرت قراءة الملف

# Under the rule on the card: when changed words appear.
settings-words-next-start = ستظهر كلماتك عند البدء التالي للبرنامج.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = تم الرفض: قيمة التحقق غير مطابقة

settings-words-reset = العودة إلى كلمات Trindle

settings-words-reset-sub = يعيد هذه اللغة كما جاءت. تُحفظ كلماتك في ملف نسخة احتياطية.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = قدّم ورقتك

# Under the offer button: who can send and why.
settings-words-offer-sub = يفتح صفحة تسجّل فيها الدخول إلى Buildmorphic وترسلها. لا يرسلها Trindle عنك أبداً.

# The line that starts a language of your own, and its button's tip.
settings-words-start = ابدأ لغة خاصة بك

# Under the start line.
settings-words-start-sub = سمّها باسم حقيقي أو مختلق. تبدأ كالإنجليزية وتظهر على أنها لغتك.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = اسم لغتك

# Beside the start line when the language was made.
settings-words-started = بدأت

# Under the start line: the name is empty or too long.
settings-words-name-length = استخدم من 1 إلى 30 حرفاً

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = أحرف فقط: دون ترميز أو مسارات أو محارف مخفية

# Under the start line: another language of your own has this name.
settings-words-name-taken = لديك بالفعل لغة بهذا الاسم

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (خاصة بك)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = يزيل هذه اللغة الخاصة بك. تُحفظ كلماتها في مجلد نسخة احتياطية.

