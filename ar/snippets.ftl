# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [zero] لا مقتطفات
        [one] مقتطف واحد
        [two] مقتطفان
        [few] { $count } مقتطفات
        [many] { $count } مقتطفًا
       *[other] { $count } مقتطف
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [zero] { $shown } من 0 مقتطف
        [one] { $shown } من مقتطف واحد
        [two] { $shown } من مقتطفين
        [few] { $shown } من { $all } مقتطفات
        [many] { $shown } من { $all } مقتطفًا
       *[other] { $shown } من { $all } مقتطف
    }

# The version at the foot of the window. $version is its number.
snippets-version = المقتطفات { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = تعذّر على المقتطفات تحديث الاستبدال أثناء الكتابة:{ $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = تخطّت المقتطفات الملف { $file }. { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = ستشغّل الملفات التالية أوامر على هذا الحاسوب إذا استُخدمت مع Espanso: { $files }. هل تريد استيرادها؟

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } أخرى

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [zero] لم يُستورد أي ملف.
        [one] استُورد ملف واحد.
        [two] استُورد ملفان.
        [few] استُوردت { $count } ملفات.
        [many] استُورد { $count } ملفًا.
       *[other] استُورد { $count } ملف.
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = تعذّر على المقتطفات إنشاء { $path }: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = تعذّر على المقتطفات قراءة { $file }. { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = لم يُحفظ شيء، لأن المقتطفات لم تستطع إنشاء نسخة احتياطية من الملف: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = تعذّر على المقتطفات الكتابة في { $path }: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = تعذّر على المقتطفات قراءة الملف: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = تعذّر على المقتطفات فتح الملف: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = تعذّر على المقتطفات حفظ المقتطف: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = تستطيع المقتطفات عرض هذا المقتطف لكنها لا تستطيع تحريره، لأنه يستخدم { $names }.

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = الملف { $name } أكبر من أن يُستورد كملف مقتطفات.

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = لا تدعم المقتطفات المسافة البادئة في السطر { $line }.

