settings-help-topics-sounds-keywords = sounds chime startup login logout shut down charger plugged unplugged battery alert off quiet change أصوات نغمة بدء تسجيل الدخول تسجيل الخروج الشاحن البطارية تنبيه صامت تغيير

# Help topic "Sounds for logging in, the charger and the battery": paragraph 1.
settings-help-topics-sounds-p1 = افتح الإعدادات واختر الأصوات. لكل لحظة صوتها: تسجيل الدخول؛ وتسجيل الخروج وإعادة التشغيل وإيقاف التشغيل؛ وتوصيل الشاحن؛ وفصل الشاحن؛ ونفاد البطارية.

# Help topic "Sounds for logging in, the charger and the battery": step 1 of the numbered steps at block 2.
settings-help-topics-sounds-step2-1 = اختر صوتًا آخر من القائمة بجانب لحظة؛ يُشغَّل لتسمعه.

# Help topic "Sounds for logging in, the charger and the battery": step 2 of the numbered steps at block 2.
settings-help-topics-sounds-step2-2 = اختر «إيقاف» لتبقى تلك اللحظة صامتة.

# Help topic "Sounds for logging in, the charger and the battery": step 3 of the numbered steps at block 2.
settings-help-topics-sounds-step2-3 = انقر المكبر لتسمع الصوت مرة أخرى.

# Title of the Help topic "Bluetooth headphones, mice and keyboards".
settings-help-topics-bluetooth-title = سماعات Bluetooth وفأراته ولوحات مفاتيحه

# Words people might search for the Help topic "Bluetooth headphones, mice and keyboards" by, in lower case, separated by spaces.
settings-help-topics-bluetooth-keywords = bluetooth pair headphones earbuds mouse keyboard speaker connect اقتران سماعات فأرة لوحة مفاتيح مكبر اتصال

# Help topic "Bluetooth headphones, mice and keyboards": step 1 of the numbered steps at block 1.
settings-help-topics-bluetooth-step1-1 = افتح الإعدادات واختر Bluetooth. تأكد من أن Bluetooth مشغَّل.

# Help topic "Bluetooth headphones, mice and keyboards": step 2 of the numbered steps at block 1.
settings-help-topics-bluetooth-step1-2 = ضع جهازك في وضع الاقتران (راجع تعليماته).

# Help topic "Bluetooth headphones, mice and keyboards": step 3 of the numbered steps at block 1.
# SAFETY: needs a human review before it ships
settings-help-topics-bluetooth-step1-3 = اضغط بحث، ثم اضغط اقتران بجانب جهازك عندما يظهر.

# Help topic "Bluetooth headphones, mice and keyboards": step 4 of the numbered steps at block 1.
# SAFETY: needs a human review before it ships
settings-help-topics-bluetooth-step1-4 = إذا عرض الجهاز الآخر رقمًا، تحقق من تطابقه واضغط نعم.

# Help topic "Bluetooth headphones, mice and keyboards": caption and spoken name of picture 2 (settings-bluetooth.png).
