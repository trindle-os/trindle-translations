# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = تعذّر تغيير الخلفية: لم يبدأ البرنامج الخاص بها.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [zero] { $used } من { $all } صورة
        [one] { $used } من صورة واحدة
        [two] { $used } من صورتين
        [few] { $used } من { $all } صور
        [many] { $used } من { $all } صورة
       *[other] { $used } من { $all } صورة
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = لا توجد صور في { $folder }

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [zero] { $used } من { $all } صورة من صور Trindle
        [one] { $used } من صورة واحدة تأتي مع Trindle
        [two] { $used } من صورتين تأتيان مع Trindle
        [few] { $used } من { $all } صور تأتي مع Trindle
        [many] { $used } من { $all } صورة تأتي مع Trindle
       *[other] { $used } من { $all } صورة تأتي مع Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [zero] { $used } من { $all } صورة من { $folder }
        [one] { $used } من صورة واحدة من { $folder }
        [two] { $used } من صورتين من { $folder }
        [few] { $used } من { $all } صور من { $folder }
        [many] { $used } من { $all } صورة من { $folder }
       *[other] { $used } من { $all } صورة من { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }، إحدى الصور التي تأتي مع Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = لون ساده، يُضبط أدناه.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = لا شيء هناك بعد الآن. اختر صورة أو مجلدًا.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = لون ساده، بلا صورة.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [zero] صورة جديدة كل { $every }، من { $used } من صور Trindle.{ $extra }
        [one] صورة جديدة كل { $every }، من { $used } من الصورة الواحدة التي تأتي مع Trindle.{ $extra }
        [two] صورة جديدة كل { $every }، من { $used } من الصورتين اللتين تأتيان مع Trindle.{ $extra }
        [few] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
        [many] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
       *[other] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } التي تأتي مع Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [zero] صورة جديدة كل { $every }، من { $used } من صور { $folder }.{ $extra }
        [one] صورة جديدة كل { $every }، من { $used } من الصورة الواحدة في { $folder }.{ $extra }
        [two] صورة جديدة كل { $every }، من { $used } من الصورتين في { $folder }.{ $extra }
        [few] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
        [many] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
       *[other] صورة جديدة كل { $every }، من { $used } من الصور الـ { $all } في { $folder }.{ $extra }
    }

