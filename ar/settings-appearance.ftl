
# machine translated (Arabic), not yet reviewed by a person.

# Name of the Settings page about appearance, in the list and as its heading.
settings-appearance-title = المظهر

# Words a person might type into the Settings search to find the appearance page; separate them with spaces.
settings-appearance-keywords = لون ألوان تمييز سمة سمات مظهر زجاج داكن فاتح وضع شمس ساطع أيقونات خط مؤشر قارئ الشاشة مكفوف قراءة بصوت عالٍ إمكانية الوصول تسميات تلميحات أسماء colour colours color colors accent theme themes look skin glass dark light mode sunshine bright icons font cursor pointer screen reader blind read aloud accessibility labels tooltips names pointing

# Introduction under the heading of the appearance page, and the words behind the page i.
settings-appearance-help = فاتح أو داكن، والألوان والأيقونات والخطوط والمؤشر وقراءة الشاشة بصوت عالٍ. بعض البرامج لا تلاحظ التغيير إلا بعد إعادة فتحها.

# Question along the bottom of the page while a theme is on trial.
settings-appearance-foot-keep = هل تريد الإبقاء على هذا المظهر؟

# Small words beside the question along the bottom while a theme is on trial.
settings-appearance-foot-escape = مفتاح Escape يعيدك الآن.

# Name of the dark look, on a theme's button and in the top sentence.
settings-appearance-look-dark = داكن

# Name of the light look, on a theme's button and in the top sentence.
settings-appearance-look-light = فاتح

# The dark look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-dark-lower = داكن

# The light look in the middle of a sentence, so in lower case where the language does that.
settings-appearance-look-light-lower = فاتح

# Spoken name of a theme's Dark or Light button; { $name } is the theme and { $look } the look.
settings-appearance-theme-spoken = { $name }، { $look }

# Spoken description of the small picture of a theme; { $name } is the theme and { $look } its look, such as dark.
settings-appearance-sample-spoken = مظهر { $name }، { $look }

# Said aloud after Dark or Light was chosen; { $look } is dark or light.
settings-appearance-aloud-look = المظهر { $look }.

# Sentence at the top of the page when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-top-unusable = مظهر Trindle الخاص، لأن السمة { $theme } لا يمكن استخدامها. { $why }

# Sentence at the top of the page for a theme that has dark and light looks; { $theme } is the theme, { $look } dark or light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme-look = السمة { $theme }، { $look }، بلون التمييز { $accent } وأيقونات { $shape }.

# Sentence at the top of the page for a theme with one look; { $theme } is the theme, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-theme = السمة { $theme }، بلون التمييز { $accent } وأيقونات { $shape }.

# Sentence at the top of the page when no theme is chosen; { $look } is Dark or Light, { $accent } the highlight colour and { $shape } round or square.
settings-appearance-top-look = { $look }، بلون التمييز { $accent } وأيقونات { $shape }.

# Shape of the icons in the top sentence.
settings-appearance-shape-round = مستديرة

# Name of Trindle's own highlight colour, first in the list of colours.
settings-appearance-trindle-yellow = أصفر Trindle

# Start of the words behind the i of the reading the screen card.
settings-appearance-reading-says = تقول ما على الشاشة وما تكتبه. ويشغّلها ويوقفها أيضًا الضغط معًا على Super وAlt وS.

# Red words under the icon shape line when the icons could not be remade.
settings-appearance-no-icons = تعذّرت إعادة إنشاء الأيقونات، لذلك يحتفظ بعضها بشكله القديم. اختر المجموعة مرة أخرى للمحاولة من جديد.

# Small words on a theme's tile when Trindle made some of its colours clearer.
settings-appearance-corrected = جُعلت بعض الألوان أوضح للقراءة.

# Said aloud when a theme is tried; { $theme } is its name and { $seconds } how long until the old look comes back.
settings-appearance-aloud-trying =
    { $seconds ->
        [zero] تجربة السمة { $theme }. يعود مظهرك السابق الآن ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
        [one] تجربة السمة { $theme }. يعود مظهرك السابق بعد ثانية واحدة ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
        [two] تجربة السمة { $theme }. يعود مظهرك السابق بعد ثانيتين ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
        [few] تجربة السمة { $theme }. يعود مظهرك السابق بعد { $seconds } ثوانٍ ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
        [many] تجربة السمة { $theme }. يعود مظهرك السابق بعد { $seconds } ثانية ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
       *[other] تجربة السمة { $theme }. يعود مظهرك السابق بعد { $seconds } ثانية ما لم تضغط الإبقاء. مفتاح Escape يعيدك الآن.
    }

# Name of Trindle's own theme when none is named.
settings-appearance-trindle = Trindle

# Said aloud when a theme was kept; { $theme } is its name.
settings-appearance-aloud-kept = تم الإبقاء على السمة { $theme }.

# Red words under the Theme line when the old look could not be written back.
settings-appearance-back-failed = يعود مظهرك السابق عند انتهاء الوقت.

# Said aloud when the look from before is back.
settings-appearance-aloud-back = عاد مظهرك السابق.

# Title of the window for choosing a theme file.
settings-appearance-chooser-title = اختر سمة

# Name of the filter in that window that shows only themes.
settings-appearance-chooser-filter = السمات

# Green words under the Add a theme line after a theme was added; { $name } is its name.
settings-appearance-added = { $name } في القائمة أعلاه. اضغط عليها لاستخدامها.

# Red words under the Theme line when a theme could not be removed.
settings-appearance-not-removed = تعذّرت إزالة السمة.

# Red words under the theme tiles when a theme cannot be used; { $theme } is its name and { $why } the reason.
settings-appearance-cannot-use = لا يمكن استخدام السمة { $theme }. { $why }

# Heading of the line saying a theme is tried first.
settings-appearance-tried-first = تُجرَّب السمة أولًا

# Small words under that line; { $seconds } is how long Keep is asked for.
settings-appearance-tried-first-about =
    { $seconds ->
        [zero] يظهر سؤال الإبقاء أسفل النافذة.
        [one] يظهر سؤال الإبقاء أسفل النافذة لمدة ثانية واحدة.
        [two] يظهر سؤال الإبقاء أسفل النافذة لمدة ثانيتين.
        [few] يظهر سؤال الإبقاء أسفل النافذة لمدة { $seconds } ثوانٍ.
        [many] يظهر سؤال الإبقاء أسفل النافذة لمدة { $seconds } ثانية.
       *[other] يظهر سؤال الإبقاء أسفل النافذة لمدة { $seconds } ثانية.
    }

# Name of the bin button that removes one of the person's own themes.
settings-appearance-remove-theme = إزالة هذه السمة

# Name of the button that chooses a theme; { $name } is the theme.
settings-appearance-use-theme = استخدام { $name }

# Small words on a theme's tile naming its author; { $author } is the name.
settings-appearance-by = من { $author }

# Name of the button that adds a theme, and heading of its line.
settings-appearance-add-theme = إضافة سمة

# Spoken name of the turning ring shown while themes are being found.
settings-appearance-looking = جارٍ البحث عن السمات

# Title of the Theme card.
settings-appearance-theme-card = السمة

# Words behind the i of the Theme card.
settings-appearance-theme-about = السمة مظهر كامل في ملف واحد: الألوان والزوايا والأحجام والمساحات. اضغط على واحدة لتجربتها: تتغير كل نوافذ Trindle فورًا، ويعود مظهرك السابق من تلقائه بعد 30 ثانية ما لم تضغط الإبقاء، فلا تبقى سمة لا يمكن قراءتها. السمة التي لها مظهر داكن وآخر فاتح يظهر بجانب صورتها زرّا داكن وفاتح؛ والفاتح أسهل رؤية في ضوء الشمس الساطع، وتأخذه تطبيقات التطبيقات في المرة التالية التي تُفتح فيها. السمة ذات المظهر الواحد لا تحمل هذين الزرين. يبقى لون التمييز لك في كل سمة. السمة التي تضيفها تُقرأ فقط ولا تُشغَّل أبدًا، وتُوضَّح الكلمات التي قد يصعب قراءتها. من الطرفية، يعيد الأمر trindle-settings --theme default مظهر Trindle الخاص دائمًا.

# Heading of the line holding the theme tiles.
settings-appearance-theme-line = السمة

# Small words under that line.
settings-appearance-theme-line-about = المظهر كاملًا. داكن أو فاتح بجانب السمة التي تملكهما.

# Small words under the Add a theme line.
settings-appearance-add-theme-about = ملف .css واحد، مثل ملف شاركه أحدهم.

# Words of the link that opens help about what a theme file holds.
settings-appearance-theme-file-help = ما يحويه ملف السمة

# Red words under the colour box when what was typed is not a colour.
settings-appearance-hex-bad = ستة من 0-9 وa-f، مثل #fbc711.

# Spoken description of the small dot that shows the colour typed.
settings-appearance-dot = اللون المكتوب

# Placeholder of the box for typing a colour code.
settings-appearance-hex-code = رمز hex

# Spoken name of the box for typing a colour as a hex code; the example is a code.
settings-appearance-hex-spoken = أي لون، برمز hex مثل #fbc711

# Heading of the line for typing any colour.
settings-appearance-any-colour = أي لون

# Small words under that line.
settings-appearance-any-colour-about = ست خانات أو ثماني، مثل #fbc711.

# Title of the Colour card.
settings-appearance-colour-title = اللون

# Words behind the i of the Colour card.
settings-appearance-colour-about = يعلّم لون التمييز الأزرار والمفاتيح والحلقة المتعبئة ومكانك الحالي. تتغير نوافذ Trindle فورًا؛ والحلقة عند فتحها التالي. اللون الداكن جدًا بحيث لا يُرى على بطاقة يُفتَّح حتى يمكن قراءته، وفي المظهر الفاتح يُغمَّق اللون الباهت جدًا. يُختار داكن أو فاتح على بطاقة السمة نفسها، تحت السمة.

# Heading of the line with the highlight colour swatches.
settings-appearance-highlight = لون التمييز

# Small words under that line.
settings-appearance-highlight-about = الأزرار والمفاتيح ومكانك الحالي.

# Small words under the read the screen aloud switch when a screen reader is installed.
settings-appearance-reader-on = يشغّلها ويوقفها أيضًا Super وAlt وS.

# Heading of the line, and name of its switch, for reading the screen aloud.
settings-appearance-reader = قراءة الشاشة بصوت عالٍ

# Heading of the line, and name of its switch, for keeping labels while pointing.
settings-appearance-labels = إبقاء التسميات عند التأشير

# Small words under that line.
settings-appearance-labels-about = يبقى اسم الزر ظاهرًا ما دمت تؤشر عليه.

# Title of the Reading the screen card.
settings-appearance-reading-title = قراءة الشاشة

# Words behind the i of that card; { $says } is the first sentences, from the key reading-says.
settings-appearance-reading-about = { $says } يختفي اسم الزر عادةً بعد ثانية ونصف؛ وعند الإبقاء يبقى ما دام المؤشر عليه. وأثناء قراءة الشاشة بصوت عالٍ يُظهر كل زر اسمه تحته.

# Name of the set of round icons.
settings-appearance-icons-circles = دوائر

# Words beside the turning ring while the icons are remade.
settings-appearance-icons-working = جارٍ تغيير الأيقونات

# Green words under the shape line after the icons were remade.
settings-appearance-icons-changed = تم التغيير

# Name of the button that chooses an icon set; { $name } is the set, such as Circles.
settings-appearance-icons-set = أيقونات { $name }

# Heading of the line for the shape of the icons.
settings-appearance-shape = الشكل

# Small words under that line.
settings-appearance-shape-about = أيقونات Trindle، مستديرة أو مربعة.

# Title of the Icons card.
settings-appearance-icons-title = الأيقونات

# Words behind the i of the Icons card.
settings-appearance-icons-about = تأتي أيقونات Trindle مستديرة أو مربعة. والتطبيق الذي لا ترسمه تُنشأ له أيقونة متناسقة، وتُعاد رسم الحلقة واللوحة بالشكل الجديد.

# Name of the list of font families, and heading of the font line.
settings-appearance-font = الخط

# Name of the font line's choice before the font in use has been read, so a screen reader has a word to say.
settings-appearance-font-default = الافتراضي

# Name of the list of font sizes.
settings-appearance-font-size = حجم الخط

# Small words under the font line.
settings-appearance-font-about = الكلمات في نوافذ البرامج.

# Name of the button that adds fonts, and heading of its line.
settings-appearance-add-fonts = إضافة خطوط

# Small words under the Add fonts line.
settings-appearance-add-fonts-about = ملف .ttf أو .otf، أو ملف zip يحويها.

# Words of the link that opens help about what a font file must contain.
settings-appearance-fonts-help = ما يجب أن يحويه الملف

# Title of the Text card.
settings-appearance-text-title = النص

# Words behind the i of the Text card.
settings-appearance-text-about = الخط الذي تستخدمه البرامج لكلماتها وحجمه. الخطوط المضافة هنا، وهي ملف .ttf أو .otf أو ملف zip يحويها، تنضم إلى قائمة الخطوط لك وحدك؛ وبعض البرامج لا تلاحظها إلا بعد إعادة فتحها.

# Title of the window for choosing font files.
settings-appearance-chooser-fonts = اختر خطوطًا

# Red words when a font could not be replaced; { $name } is the file name.
settings-appearance-font-not-replaced = تعذّر استبدال { $name }.

# Green words after one font took the place of the one there; { $name } is the file name.
settings-appearance-font-replaced-one = استُبدل { $name }. تستخدمه البرامج التي تبدأ من الآن.

# Green words after several fonts took the place of the ones there; { $n } of { $total } were done.
settings-appearance-font-replaced-some = استُبدل { $n } من { $total }. تستخدمها البرامج التي تبدأ من الآن.

# Green words after fonts were added; { $n } is how many.
settings-appearance-fonts-added =
    { $n ->
        [zero] لم تُضف خطوط. اختر من القائمة أعلاه.
        [one] خط واحد في القائمة أعلاه. اخترْه من الأعلى.
        [two] خطان في القائمة أعلاه. اخترْهما من الأعلى.
        [few] { $n } خطوط في القائمة أعلاه. اخترْها من الأعلى.
        [many] { $n } خطًا في القائمة أعلاه. اخترْها من الأعلى.
       *[other] { $n } خط في القائمة أعلاه. اخترْها من الأعلى.
    }

# Green words after added fonts were already in the list.
settings-appearance-fonts-in-list = هذه الخطوط موجودة في القائمة من قبل.

# Choice in the list of cursor sizes: the normal size.
settings-appearance-cursor-normal = عادي

# Choice in the list of cursor sizes: a large size.
settings-appearance-cursor-large = كبير

# Choice in the list of cursor sizes: the largest size.
settings-appearance-cursor-larger = أكبر

# Spoken name of a picture of a cursor size; { $size } is its name, such as Large.
settings-appearance-pointer-spoken = مؤشر { $size }

# Name of the standard cursor theme (the one every system has).
settings-appearance-cursor-standard = قياسي

# Name of the list of cursor themes, and heading of its line.
settings-appearance-cursor = المؤشر

# Name of the list of cursor sizes, and heading of its line.
settings-appearance-cursor-size = حجم المؤشر

# Small words under the cursor line.
settings-appearance-cursor-about = كيف يُرسم المؤشر.

# Small words under the cursor size line.
settings-appearance-cursor-size-about = الأكبر أسهل في العثور عليه.

# Title of the Pointer card.
settings-appearance-pointer-title = المؤشر
