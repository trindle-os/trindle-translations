# machine translated (Swahili), not yet reviewed by a person.

# Reason given when a file to read or change is a link, not the file itself.
folders-meta-link = hiki ni kiungo, si faili

# Reason given when a photo's notes cannot be read; the cause follows, already written out.
folders-meta-damaged = maelezo ya kamera ya picha yameharibika kwa sababu { $why }

# Cause of damaged photo notes: a block points outside the notes.
folders-meta-bad-out-of-reach = sehemu moja inaelekeza nje ya maelezo hayo

# Cause of damaged photo notes: a block goes beyond the end.
folders-meta-bad-block-past-end = sehemu moja inavuka mwisho wa maelezo hayo

# Cause of damaged photo notes: the notes have no TIFF header.
folders-meta-bad-no-tiff = maelezo hayo hayana kichwa cha TIFF

# Cause of damaged photo notes: the notes are much too large.
folders-meta-bad-too-big = ni makubwa kupita kiasi

# Cause of damaged photo notes: the parts of a JPEG photo do not line up.
folders-meta-bad-jpeg-parts = sehemu za JPEG hazioani

# Cause of damaged photo notes: a part of a JPEG photo goes beyond the end.
folders-meta-bad-jpeg-past-end = sehemu ya JPEG inavuka mwisho wa faili

# Cause of damaged photo notes: a part of a PNG photo goes beyond the end.
folders-meta-bad-png-past-end = sehemu ya PNG inavuka mwisho wa faili

# Cause of damaged photo notes: a PNG file holds no picture.
folders-meta-bad-png-empty = PNG haina picha ndani yake

# Reason a photo's date taken is refused: it is not written like the example.
folders-meta-refuse-date = tarehe ya kupigwa lazima iandikwe kama 2026:01:02 03:04:05

# Reason a photo's note is refused: it holds a nul character.
folders-meta-refuse-nul = maelezo hayawezi kuwa na herufi ya null

# Reason a photo's way-up setting is refused: it is not from 1 to 8.
folders-meta-refuse-way-up = mpangilio wa mwelekeo wa kuonyesha lazima uwe namba kuanzia 1 hadi 8

# Reason a photo's notes are refused: they are too long to fit in a JPEG.
folders-meta-refuse-too-long = maelezo ya kamera ni marefu mno kutosha ndani ya JPEG

# Reason notes cannot be changed in a file that is not a JPEG or PNG photo.
folders-meta-only-jpeg-png = maelezo ya kamera yanaweza kubadilishwa kwenye picha za JPEG na PNG tu

# Reason a change to a song or photo was not begun: the drive has no room for the copy.
folders-meta-no-room = hakuna nafasi iliyobaki kwenye diski

# Reason a song's tag is refused: the tag is too big.
folders-meta-tag-too-big = maelezo ya wimbo ni makubwa mno

