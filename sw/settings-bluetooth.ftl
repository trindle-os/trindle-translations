# machine translated (Swahili), not yet reviewed by a person.

# Said in red under the Bluetooth switch when switching it on failed for no known reason.
settings-bluetooth-on-failed = Bluetooth haikuweza kuwashwa.

# Said in red under the Bluetooth switch when switching it off failed for no known reason.
settings-bluetooth-off-failed = Bluetooth haikuweza kuzimwa.

# Said in red when Bluetooth refuses something because it is not switched on; the first sentence says what could not be done.
settings-bluetooth-cause-not-ready = { $could_not } Bluetooth haijawashwa.

# Said in red when the PIN or number typed was wrong; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-auth-failed = { $could_not } PIN au nambari haikukubaliwa. Jaribu tena.

# Said in red when the pairing was turned down; the first sentence says what could not be done.
# SAFETY: needs a human review before it ships
settings-bluetooth-cause-turned-down = { $could_not } Ilikataliwa, hapa au kwenye kifaa kingine.

# Said in red when the other device did not answer in time; the first sentence says what could not be done.
settings-bluetooth-cause-timeout = { $could_not } Kifaa kingine hakikujibu kwa wakati. Kiweke katika hali ya kuoanisha, kisha jaribu tena.

# Said in red when the same thing is already being done; the first sentence says what could not be done.
settings-bluetooth-cause-in-progress = { $could_not } Tayari inafanyika. Subiri kidogo.

# Said in red when the device did not answer; the first sentence says what could not be done.
settings-bluetooth-cause-no-answer = { $could_not } Kifaa hakikujibu. Hakikisha kimewashwa na kiko karibu, kisha jaribu tena.

# Said in red when the device is not ready to be used; the first sentence says what could not be done.
settings-bluetooth-cause-not-available = { $could_not } Kifaa hakiko tayari kutumika. Kiweke katika hali ya kuoanisha, kisha jaribu tena.

# The word for the system bus in "The system bus is not available".
settings-bluetooth-the-bus = Basi la mfumo

# Headline of the page while Bluetooth is looked for.
settings-bluetooth-top-looking = Inatafuta Bluetooth…

# Headline of the page when the Bluetooth service is not running.
settings-bluetooth-top-gone = Bluetooth haifanyi kazi kwenye kompyuta hii.

# Headline of the page when Bluetooth is off.
settings-bluetooth-top-off = Bluetooth imezimwa.

# Headline of the page when Bluetooth is off at a switch or key on the computer itself.
settings-bluetooth-top-hard = Bluetooth imezimwa kwenye kompyuta yenyewe.

# Headline of the page when the computer has no Bluetooth.
settings-bluetooth-top-none = Kompyuta hii haina Bluetooth.

# Headline of the page when Bluetooth is on and searching.
settings-bluetooth-top-searching = Imewashwa, inatafuta vifaa vilivyo karibu…

# Headline of the page when Bluetooth is on and nothing is connected.
settings-bluetooth-top-idle = Imewashwa, hakuna kilichounganishwa kwa sasa.

# Headline of the page when Bluetooth is on and devices are connected; the names are already joined into a list.
settings-bluetooth-top-connected =
    { $n ->
        [one] Imewashwa, na { $names } imeunganishwa.
       *[other] Imewashwa, na { $names } vimeunganishwa.
    }

# Help text (i button) of the Bluetooth card.
settings-bluetooth-card-about = Kiwashio huwasha au kuzima Bluetooth ya kompyuta hii; chini yake kuna jina la adapta. Wakati Inaonekana kwa vifaa vingine imewashwa, vifaa vilivyo karibu vinaweza kupata kompyuta hii.

# Heading of the Bluetooth card, of its switch's line, and the name of its switch.
settings-bluetooth-title = Bluetooth

# Small line under the Bluetooth switch when Bluetooth is blocked by the system.
settings-bluetooth-switched-off = Imezimwa.

# Heading of the line with the switch that makes this computer visible, and the name of that switch.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible = Inaonekana kwa vifaa vingine

# Small line under the Visible to other devices switch.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible-sub = Vifaa vilivyo karibu vinaweza kupata kompyuta hii.

# Heading of the card when Bluetooth is off at a switch on the computer itself.
settings-bluetooth-hard-line = Imezimwa kwenye kompyuta yenyewe

# Small line under it.
settings-bluetooth-hard-line-sub = Kwa swichi au kitufe. Iwashe hiyo kwanza.

# Heading of the card when the computer has no Bluetooth adapter.
settings-bluetooth-no-adapter = Hakuna adapta ya Bluetooth

# Help text (i button) of that card.
settings-bluetooth-no-adapter-about = Hakuna adapta ya Bluetooth iliyopatikana kwenye kompyuta hii. Ile inayochomekwa kwenye soketi ya USB huonekana hapa mara tu inapochomekwa.

# Line in that card.
settings-bluetooth-none-found = Hakuna iliyopatikana

# Small line under it.
settings-bluetooth-none-found-sub = Ya USB huonekana hapa ikishachomekwa.

# Shown beside the Bluetooth switch while the password is asked for.
# SAFETY: needs a human review before it ships
settings-bluetooth-waiting = Inasubiri nenosiri...

# Said in red when this computer could not be made visible to other devices.
# SAFETY: needs a human review before it ships
settings-bluetooth-visible-failed = Kompyuta hii haikuweza kufanywa ionekane kwa vifaa vingine.

# Said in red when this computer could not be hidden from other devices.
# SAFETY: needs a human review before it ships
settings-bluetooth-hidden-failed = Kompyuta hii haikuweza kufichwa kutoka kwa vifaa vingine.

# Shown on the two device lists while Bluetooth is off.
settings-bluetooth-switch-on-first = Washa Bluetooth ili kutumia hivi.

# Line in the My devices card when nothing is paired.
settings-bluetooth-none-paired = Hakuna kilichooanishwa bado

# Small line under it.
settings-bluetooth-none-paired-sub = Tafuta vifaa ili kuoanisha kimoja.

# Heading of the card that lists paired devices.
settings-bluetooth-mine = Vifaa vyangu

# Help text (i button) of the My devices card.
settings-bluetooth-mine-about = Vifaa vilivyooanishwa na kompyuta hii, kila kimoja na betri yake inapoonyeshwa. Vilivyounganishwa ukurasa unapofunguliwa huja kwanza, na mstari hubaki mahali pake ukurasa ukiwa wazi. Vitufe vya duara huunganisha au kutenganisha kimoja; pipa hukisahau, kwa hiyo lazima kioanishwe tena.

# Line in the Nearby card while the search runs.
settings-bluetooth-looking = Inatafuta vifaa...

# Tip of the button that stops the search.
settings-bluetooth-stop-looking = Acha kutafuta

# Heading of the line that starts the search, and tip of its button.
settings-bluetooth-look = Tafuta vifaa

# Small line under it.
settings-bluetooth-look-sub = Weka kifaa kingine katika hali ya kuoanisha kwanza.

# Heading of the card that lists devices nearby.
settings-bluetooth-nearby = Vilivyo karibu

# Help text (i button) of the Nearby card.
settings-bluetooth-nearby-about = Bonyeza Tafuta vifaa, weka kifaa kingine katika hali ya kuoanisha, kisha bonyeza Oanisha kando yake. Vifaa vilivyo karibu huorodheshwa vyenye nguvu zaidi kwanza ukurasa unapofunguliwa, na kila kipya kinachopatikana huongezwa mwishoni. Baadhi huonyesha nambari ya kulinganisha na ya hapa, na baadhi huomba PIN, ambayo mara nyingi iko kwenye maelekezo yao, au ni 0000.

# Said in red when the search could not be stopped.
settings-bluetooth-stop-failed = Kutafuta vifaa hakukuweza kusimamishwa.

# Said in red when the search could not be started.
settings-bluetooth-start-failed = Vifaa havikuweza kutafutwa.

# Small line of a device that is connected.
settings-bluetooth-connected = Imeunganishwa

# Small line of a paired device that is not connected.
settings-bluetooth-not-connected = Haijaunganishwa

# Part of a device's small line: its battery level in per cent.
settings-bluetooth-battery = betri { $n }%

# Tip of the button that pairs a device, and the button of the same name in the pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair = Oanisha

# Tip of the button that disconnects a device.
settings-bluetooth-disconnect = Tenganisha

# Tip of the button that connects a device.
settings-bluetooth-connect = Unganisha

# Tip of the bin button that forgets a device.
# SAFETY: needs a human review before it ships
settings-bluetooth-forget = Sahau kifaa hiki

# Said in red when a device could not be disconnected.
settings-bluetooth-disconnect-failed = Haikuweza kutenganishwa.

# Said in red when a device could not be forgotten.
settings-bluetooth-forget-failed = Haikuweza kusahauliwa.

# Shown under a device while it is being paired.
settings-bluetooth-pairing = Inaoanisha...

# Said in red when a device could not be paired.
settings-bluetooth-pair-failed = Haikuweza kuoanishwa.

# Shown under a device while it is being connected.
settings-bluetooth-connecting = Inaunganisha...

# Said in red when a device could not be connected.
settings-bluetooth-connect-failed = Haikuweza kuunganishwa.

# Said under a device that paired but could not be set to connect by itself.
settings-bluetooth-not-trusted = Imeunganishwa, lakini haikuweza kuwekwa ijiunganishe yenyewe wakati ujao. Iunganishe hapa unapoihitaji.

# Said under a device that shows a code to be typed on it; the code is already written.
settings-bluetooth-type-code = Andika { $code } kwenye kifaa, kisha bonyeza Enter juu yake.

# Question under a device that shows a number to compare with the one on this computer.
# SAFETY: needs a human review before it ships
settings-bluetooth-compare = Je, kifaa kingine kinaonyesha { $code }?

# Tip of the button that answers no to a pairing question.
# SAFETY: needs a human review before it ships
settings-bluetooth-no = Hapana

# Tip of the button that says the numbers match.
# SAFETY: needs a human review before it ships
settings-bluetooth-yes-matches = Ndiyo, inalingana

# Question under a device that asks to be paired.
# SAFETY: needs a human review before it ships
settings-bluetooth-pair-question = Oanisha na kifaa hiki?

# Placeholder of the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin = PIN

# Tip of the button that refuses to type a PIN.
# SAFETY: needs a human review before it ships
settings-bluetooth-cancel = Ghairi

# Help line above the box where a device's PIN is typed.
# SAFETY: needs a human review before it ships
settings-bluetooth-pin-help = Andika PIN ya kifaa hiki. Mara nyingi iko kwenye maelekezo yake, au ni 0000.

# Words the settings search looks for on this page (not shown).
settings-bluetooth-keywords = vipokea sauti kipanya kibodi oanisha vifaa pasiwaya

# Help text at the top of the page.
settings-bluetooth-help = Bonyeza Tafuta, weka kifaa kingine katika hali ya kuoanisha, kisha bonyeza Oanisha kando yake.

# Said in red under the Bluetooth switch when restarting the sound service after Bluetooth came back on failed; $why is the system's own reason.
settings-bluetooth-sound-failed = Sauti ya Bluetooth haikuweza kuanzishwa upya, kwa hiyo vipokea sauti vinaweza kutumia ubora wa kawaida hadi uingie tena. { $why }

# Tooltip of the help button beside the Bluetooth switch.
settings-bluetooth-sound-help = Kwa nini vipokea sauti husikika vya kawaida baada ya Bluetooth kuzimwa na kuwashwa


# Said in red when a device is no longer in BlueZ's list; the first sentence says what could not be done.
settings-bluetooth-cause-gone = { $could_not } Kifaa hakijulikani tena. Kitafute tena.

# Said in red when a paired device's saved pairing is refused; the first sentence says what could not be done.
settings-bluetooth-cause-old-pairing = { $could_not } Uoanishaji uliohifadhiwa haukubaliwi tena. Sahau kifaa kisha uoanishe tena.

# Said in red under a device that connected and then dropped at once.
settings-bluetooth-dropped = Kiliunganishwa, kisha kikakatika. Uoanishaji uliohifadhiwa unaweza kuwa wa zamani.

# Tooltip of the button that forgets a paired device and looks for it afresh.
settings-bluetooth-pair-again = Sahau na uoanishe tena

# Said under Look for devices after a device was forgotten to be paired afresh.
settings-bluetooth-forgotten-pair = Kimesahauliwa. Kiweke katika hali ya kuoanisha, kisha bonyeza Oanisha kinapoonekana hapa chini.

# Tooltip of the button that opens Help from a failed connection.
settings-bluetooth-more = Zaidi kuhusu hili

