# machine translated (Swahili), not yet reviewed by a person.

# Name of the program, shown as the window title and its heading.
crash-app-name = Kuripoti

# One paragraph at the top: what the window is for and what is promised.
crash-app-intro = Programu ya Trindle inapoharibika, Trindle huacha noti fupi kwenye kompyuta hii. Hakuna kinachohifadhiwa wala kutumwa isipokuwa ukiliwasha hapa, na hakuna kinachotumwa mpaka ubonyeze Tuma kwenye ripoti hiyo.

# Red words at start-up when the home folder is not set, so nothing can be kept.
crash-main-no-home = Folda ya nyumbani haijawekwa, kwa hiyo hakuna ripoti zinazoweza kuhifadhiwa.

# Red words at start-up when the desktop cannot be reached.
crash-main-no-desktop = Kuripoti kunahitaji eneo-kazi la Trindle ili kufunguka.

crash-switches-heading = Kinachohifadhiwa

crash-crashes = Programu kuharibika

crash-crashes-tip = Hifadhi ripoti ya kila programu kuharibika

crash-crashes-about = Programu, toleo lake, aina ya hitilafu na mahali katika msimbo wa Trindle ilipotokea. Ukizima hili, ripoti zinazosubiri hufutwa katika zoezi lijalo la kila saa.

crash-errors = Hitilafu

crash-errors-tip = Hifadhi ripoti ya kila hitilafu

crash-errors-about = Programu, toleo lake, jina lisilobadilika ambalo Trindle hulipa hitilafu na mahali katika msimbo wake. Ukizima hili, ripoti za hitilafu zinazosubiri hufutwa katika zoezi lijalo la kila saa.

crash-computer = Kuhusu kompyuta hii

crash-computer-tip = Ongeza maelezo mafupi ya kompyuta hii kwenye kila ripoti unayotuma

crash-computer-about = Linux inayotumika, aina ya kichakataji, kumbukumbu (imepunguzwa), Wayland au X11, aliyetengeneza kadi ya picha na idadi ya skrini.

crash-username = Jina lako la mtumiaji la Buildmorphic

crash-username-tip = Ongeza jina lako la mtumiaji la Buildmorphic kwenye kila ripoti unayotuma

crash-username-about = Ili upate sifa kwa marekebisho. Si lazima. Kamwe si anwani ya barua pepe.

crash-username-field-tip = Jina lako la mtumiaji la Buildmorphic

crash-username-bad = Jina la mtumiaji la Buildmorphic lina herufi, nambari au vistari 2 hadi 31, na halianzi na kistari.

crash-github = Jina lako la GitHub

crash-github-tip = Ongeza jina lako la GitHub kwenye kila ripoti unayotuma

crash-github-about = Linaonyeshwa kama aliyeripoti. Si lazima. Kamwe si anwani ya barua pepe.

crash-github-field-tip = Jina lako la GitHub

crash-github-bad = Jina la GitHub lina herufi, nambari au vistari 1 hadi 39, na halianzi na kistari.

# Red words when a switch or a name could not be written to this computer.
crash-not-kept = Hilo halikuweza kuhifadhiwa kwenye kompyuta hii.

crash-waiting-heading = Zinazosubiri kutumwa

crash-waiting-none = Hakuna ripoti inayosubiri. Moja itaonekana hapa baada ya programu ya Trindle kuharibika, ikiwa swichi yake iliyo juu imewashwa.

crash-waiting-about = Kila ripoti inaonyeshwa nzima, kama itakavyotumwa.

# Heading of one report. { $what } is the kind, { $program } the program, { $version } its version.
crash-report-title = { $what } katika { $program } { $version }

# The kind of report, for crash-report-title.
crash-kind-crash = Programu kuharibika ({ $signal })

crash-kind-error = Hitilafu { $code }

crash-send = Tuma

crash-delete = Futa

# Shown under the reports while one is on its way to Buildmorphic.
crash-sending = Inatuma ripoti...

# Red words under the reports when one was not sent. The report is kept.
crash-result-not-taking = Buildmorphic haipokei ripoti sasa. Ripoti imehifadhiwa.

crash-result-failed = Haikutumwa: Buildmorphic ilijibu { $answer }. Ripoti imehifadhiwa.

crash-result-unreachable = Haikutumwa: Buildmorphic haikufikiwa. Ripoti imehifadhiwa.

# Red words when one was sent but this computer could not take it off the list.
crash-result-not-recorded = Imetumwa, lakini kompyuta hii haikuweza kuiondoa kwenye orodha ya zinazosubiri, kwa hiyo inaweza kutolewa tena.

crash-result-busy = Haikufanyika: ripoti zinakusanywa sasa hivi. Jaribu tena baada ya dakika moja.

crash-forget = Futa ripoti zote zinazosubiri

crash-forget-sure = Bonyeza tena ili kufuta ripoti { $count } zinazosubiri. Hili haliwezi kutenguliwa.

crash-sent-heading = Zilizotumwa hadi sasa

crash-sent-none = Hakuna kilichotumwa bado.

crash-sent-about = Mpya zaidi kwanza, hadi hamsini, zimehifadhiwa kwenye kompyuta hii tu.

# One line of the sent list. { $what } is the kind, { $program } the program, { $date } the day it was sent.
crash-sent-line = { $what } katika { $program }, imetumwa { $date }

crash-clear = Futa orodha

crash-clear-sure = Bonyeza tena ili kufuta orodha. Hili haliwezi kutenguliwa.

