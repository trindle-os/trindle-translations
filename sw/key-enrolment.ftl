
# machine translated (Swahili), not yet reviewed by a person.

# Title of the Help topic about approving a driver's key.
# SAFETY: needs a human review before it ships
key-enrol-title = Kuidhinisha ufunguo wa dereva wakati wa kuwasha upya

# Words people might search for that topic by, in lower case, separated by spaces.
key-enrol-keywords = secure boot key mok enroll enrol skrini ya buluu nenosiri password dereva driver nvidia virtualbox kamera dkms mokutil skrini nyeusi

# First paragraph before the steps when the driver is NVIDIA's own.
# SAFETY: needs a human review before it ships
key-enrol-why-nvidia = Dereva ya NVIDIA hujengwa kwenye kompyuta hii, kwa hiyo Secure Boot haitaipakia hadi uidhinishe ufunguo wake. Fanya hivi kabla ya kuwasha upya, la sivyo skrini inaweza kubaki nyeusi.

# First paragraph before the steps when the driver is an add-on driver from the Apps page or the Terminal.
# SAFETY: needs a human review before it ships
key-enrol-why-addon = Dereva ya ziada hujengwa kwenye kompyuta hii, kwa hiyo Secure Boot haitaipakia hadi uidhinishe ufunguo wake. Fanya hivi kabla ya kuwasha upya.

# Step 1: the password, made before the restart.
# SAFETY: needs a human review before it ships
key-enrol-step1 = Tunga nenosiri la herufi na tarakimu tu. Skrini ya buluu ina kibodi ya Kimarekani, kwa hiyo alama zinaweza kuwa kwenye vitufe vingine. Liandike; litatumika mara moja tu.

# Step 2: the restart and how long the blue screen waits.
key-enrol-step2 = Washa upya. Skrini ya buluu yenye kichwa Enroll MOK inaonekana kabla Trindle haijaanza. Inakata tamaa baada ya sekunde 10 hivi, kwa hiyo uwe tayari kubonyeza kitufe.

# Step 3: the first two screens.
key-enrol-step3 = Chagua Enroll MOK, kisha Continue.

# Step 4: the third screen and the password.
# SAFETY: needs a human review before it ships
key-enrol-step4 = Chagua Yes, kisha andika nenosiri ulilotunga.

# Step 5: the last screen.
key-enrol-step5 = Chagua Reboot. Dereva itapakiwa kompyuta ikiwa imerudi.

# Tip after the steps: what happens when the blue screen is missed and how to be asked again.
# SAFETY: needs a human review before it ships
key-enrol-missed = Ukikosa skrini ya buluu, kompyuta inaanza bila dereva, kama awali. Hakuna kilichoharibika; endesha sudo mokutil --import /var/lib/dkms/mok.pub kisha uwashe upya ili uulizwe tena.
