# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about sound, in the list and as its heading.
settings-audio-title = Sauti

# Words a person might type into the Settings search to find the audio page; separate them with spaces.
settings-audio-keywords = sauti sauti-kubwa spika vipaza-sauti vipokea-sauti maikrofoni mic nyamazisha jaribu sound volume speakers headphones microphone mute test

# Introduction under the heading of the audio page, and the words behind the page i.
settings-audio-help = Chagua spika au vipokea sauti vitakavyocheza sauti, na maikrofoni itakayosikiliza.

# Red sentence at the top of the page when PipeWire, the sound system, is not installed.
settings-audio-top-missing = Hakuna sauti: PipeWire haijasakinishwa.

# Red sentence at the top of the page when PipeWire is installed but not answering.
settings-audio-top-failed = Hakuna sauti: PipeWire haijibu.

# Red sentence at the top of the page when there are no speakers or headphones.
settings-audio-top-no-output = Hakuna spika wala vipokea sauti vilivyopatikana.

# Plain sentence at the top of the page while the page is still finding out about sound.
settings-audio-top-listening = Inasikiliza sauti…

# Warning at the top of the page when sound is muted; { $device } is the speakers or headphones.
settings-audio-top-muted = Sauti imenyamazishwa, kwa hiyo { $device } iko kimya.

# Warning at the top of the page when the volume is at nothing; { $device } is the speakers or headphones.
settings-audio-top-down = Sauti imeshushwa kabisa, kwa hiyo { $device } iko kimya.

# Sentence at the top of the page when all is well; { $device } is the speakers or headphones and { $percent } the volume.
settings-audio-top-playing = Sauti inacheza kupitia { $device } kwa asilimia { $percent }.

# Title of the card for speakers and headphones.
settings-audio-out-title = Spika na vipokea sauti

# Title of the card for microphones.
settings-audio-in-title = Maikrofoni

# Heading of the line shown when no speakers or headphones are found.
settings-audio-out-none = Hakuna vifaa vya kutoa sauti

# Heading of the line shown when no microphone is found.
settings-audio-in-none = Hakuna vifaa vya kuingiza sauti

# Small words under that line for speakers.
settings-audio-out-plug = Chomeka spika au vipokea sauti.

# Small words under that line for microphones.
settings-audio-in-plug = Chomeka maikrofoni au kipokea sauti chenye maikrofoni.

# Heading of the line with the list of devices.
settings-audio-device = Kifaa

# Small words under the device line for speakers.
settings-audio-out-device-about = Mahali sauti inapochezwa.

# Small words under the device line for microphones.
settings-audio-in-device-about = Kinachosikiliza.

# Name of the list of speakers and headphones.
settings-audio-out-device-name = Mahali sauti inapochezwa

# Name of the list of microphones.
settings-audio-in-device-name = Kinachosikiliza

# Heading of the volume line.
settings-audio-volume = Kiwango cha sauti

# Name of the volume slider for the speakers.
settings-audio-out-volume-name = Kiwango cha sauti

# Name of the volume slider for the microphone.
settings-audio-in-volume-name = Kiwango cha sauti ya maikrofoni

# Heading of the mute line.
settings-audio-mute = Nyamazisha

# Name of the switch that mutes the sound.
settings-audio-out-mute-name = Nyamazisha sauti

# Name of the switch that mutes the microphone.
settings-audio-in-mute-name = Nyamazisha maikrofoni

# Small words under the mute line for the speakers.
settings-audio-mute-out-about = Kimya, huku kiwango cha sauti kikibaki.

# Small words under the mute line for the microphone.
settings-audio-mute-in-about = Hakuna kinachosikika ikiwa imewashwa.

# Heading of the line that plays a test sound.
settings-audio-test = Jaribio

# Small words under the test line.
settings-audio-test-about = Inacheza mlio mfupi kupitia kifaa hiki.

# Name of the button that plays a test sound.
settings-audio-test-button = Cheza sauti ya jaribio

# Words behind the i of the speakers card.
settings-audio-out-about = Chagua spika au vipokea sauti vitakavyocheza sauti. Kiwango cha sauti na kunyamazisha hapa ni sawa na vitufe vya kibodi na duara la sauti kwenye pete.

# Heading of the line with the microphone level bar.
settings-audio-level = Kiwango

# Small words under the level line.
settings-audio-level-about = Ongea na upau utasogea unapokusikia.

# Words behind the i of the microphone card.
settings-audio-in-about = Chagua maikrofoni itakayosikiliza. Upau wa kiwango unafuata inachosikia ukurasa huu ukiwa wazi; hakuna kinachorekodiwa wala kuhifadhiwa.

# Title of the card shown when PipeWire is not answering.
settings-audio-failed-title = Sauti

# Heading of the line in that card.
settings-audio-failed-heading = PipeWire haijibu

# Small words under that line.
settings-audio-failed-about = Huenda sauti haikuanza kwa kipindi hiki.

# Red words under the volume line when the volume could not be changed.
settings-audio-no-volume = Kiwango cha sauti hakikuweza kubadilishwa. Huenda sauti haikuanza; toka kisha ingia tena, kisha jaribu tena.

# Red words under the mute line when the sound could not be muted.
settings-audio-no-mute = Sauti haikuweza kunyamazishwa. Huenda sauti haikuanza; toka kisha ingia tena, kisha jaribu tena.

# Red words under the mute line when the sound could not be turned back on.
settings-audio-no-unmute = Sauti haikuweza kurudishwa. Huenda sauti haikuanza; toka kisha ingia tena, kisha jaribu tena.

# Red words under the device line when the device could not be chosen.
settings-audio-not-chosen = Kifaa hicho hakikuweza kuchaguliwa.

# Red words under the test line when the test sound would not play.
settings-audio-test-failed = Sauti ya jaribio haikuchezwa kupitia kifaa hiki.



# A device's name with what kind it is; { $name } is the device and { $kind } one of the kind words below.
settings-audio-with-kind = { $name } ({ $kind })

# Kind of output: a Bluetooth device.
settings-audio-kind-bluetooth = Bluetooth

# Kind of output: a screen or TV on a cable.
settings-audio-kind-hdmi = HDMI

# Kind of output: a device on a USB cable.
settings-audio-kind-usb = USB

# Kind of output: headphones or a headset on a cable.
settings-audio-kind-headphones = vipokea sauti vya masikioni

# Kind of output: the computer's own speakers.
settings-audio-kind-speakers = spika

# Heading of the line shown while Bluetooth plays the sound.
settings-audio-bt-now = Sauti inaelekea Bluetooth

# Words under that heading.
settings-audio-bt-now-about = Badilisha hadi spika; Bluetooth inabaki imeunganishwa.

# Tooltip of the button that moves the sound to the speakers; { $device } is the speakers, kind included.
settings-audio-use-speakers = Cheza kupitia { $device }

# Heading of the line when Bluetooth devices are connected but have no sound output; { $names } lists them.
settings-audio-bt-silent = { $names }: imeunganishwa, lakini haina pato la sauti.

# Words under that heading.
settings-audio-bt-silent-about = Wasifu wake wa sauti huenda umezimwa. Ondoa muunganisho kisha uunganishe tena.

