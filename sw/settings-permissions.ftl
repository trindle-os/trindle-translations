# machine translated (Swahili), not yet reviewed by a person.

# Name of the Permissions page, in the page list and as its heading.
settings-permissions-title = Ruhusa

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = ruhusa ruhusu faragha flatpak flathub sandbox intaneti mtandao faili sauti maikrofoni kamera bluetooth arifa programu jalizi deb x11 xwayland programu za zamani steam wine java skrini terminali kompyuta thunderbolt usb4 dock vifaa permissions

# Help line at the foot of the Permissions page.
# SAFETY: needs a human review before it ships
settings-permissions-help = Kile ambacho kila programu inaweza kutumia. Programu kutoka Flathub, programu zilizosakinishwa kwenye folda yao wenyewe na programu jalizi kila moja husakinishwa kwenye folda yake, na hudhibitiwa kwa chaguo-msingi. Ikoni iliyojazwa imeruhusiwa; ibofye ili kuibadilisha. Mabadiliko kwa programu ya Flathub huanza kutumika itakapoanzishwa tena. Vifaa vya Thunderbolt na USB4 vilivyoruhusiwa huunganishwa kila mara bila kuuliza; sahau kimoja ili kiulizwe tena.

# Red words when a permission could not be changed and nothing more is known.
settings-permissions-not-changed = Haikuweza kubadilishwa.

# Words beside a plugin when its change was saved but the plugin could not be started again.
settings-permissions-plugin-not-restarted = Imehifadhiwa, lakini programu jalizi haikuweza kuanzishwa tena. Mabadiliko yataanza kutumika itakapoanzishwa tena.

# Said beside an app, plugin or switch once a permission change is saved.
settings-permissions-saved = Imehifadhiwa

# Help text of the AppImages card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-images = Kila AppImage huendeshwa kwenye boksi lake lenyewe, lenye nyumbani la faragha. Ikoni iliyojazwa imeruhusiwa; ibofye ili kuibadilisha. Mabadiliko huanza kutumika AppImage itakapoanzishwa tena.

# Help text of the Started from Folders card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-loose-programs = Kila programu iliyoanzishwa kutoka Folda huendeshwa kwenye boksi lake lenyewe, lenye nyumbani la faragha. Ikoni iliyojazwa imeruhusiwa; ibofye ili kuibadilisha. Mabadiliko huanza kutumika programu itakapoanzishwa tena.

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# Under the Allow older programs switch.
# SAFETY: needs a human review before it ships
settings-permissions-older-why = Kila moja imetengwa na zingine. Ikizimwa, hazifunguki.

# Heading of the card with the switch for older programs.
settings-permissions-older = Programu za zamani

# Label and tip of the switch that lets older programs open.
# SAFETY: needs a human review before it ships
settings-permissions-allow-older = Ruhusu programu za zamani

# Help text on the Thunderbolt and USB4 card when the ports only carry screens.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-screens = Milango hii hubeba skrini tu, kwa hiyo hakuna kifaa kinachoweza kufikia kumbukumbu ya kompyuta hii na hakuna cha kuuliza.

# Help text on the Thunderbolt and USB4 card when the ports only carry USB and screens.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-usb = Milango hii hubeba USB na skrini tu, kwa hiyo hakuna kifaa kinachoweza kufikia kumbukumbu ya kompyuta hii na hakuna cha kuuliza.

# Help text on the Thunderbolt and USB4 card when the ports let every device in.
# SAFETY: needs a human review before it ships
settings-permissions-lets-in-all = Milango hii huruhusu kila kifaa kuunganishwa chenyewe, kwa hiyo hakuna cha kuuliza. Hili limewekwa kwenye programu dhibiti ya kompyuta.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry screens.
settings-permissions-short-screens = Milango hii hubeba skrini tu.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry USB and screens.
settings-permissions-short-usb = Milango hii hubeba USB na skrini tu.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the firmware lets every device in.
settings-permissions-short-firmware = Programu dhibiti huruhusu kila kifaa kuunganishwa.

# Under a package's name: its version number is { $v }.
settings-permissions-version = Toleo { $v }

# Under a plugin's name when it asks for nothing: its version number is { $v }.
settings-permissions-version-asks-nothing = Toleo { $v }. Haiombi chochote.

# Under a plugin's name: the words so far are { $sub }, then the ports it listens on in { $detail }.
settings-permissions-sub-listen = { $sub }. { $detail }

# Red words when a Thunderbolt or USB4 device could not be forgotten.
settings-permissions-not-forgotten = Haikuweza kusahauliwa.

# Heading of the Thunderbolt and USB4 card.
settings-permissions-thunder = Thunderbolt na USB4

# Help text of the Thunderbolt and USB4 card: { $about } is a further sentence, or nothing.
# SAFETY: needs a human review before it ships
settings-permissions-thunder-about = Vifaa vya Thunderbolt na USB4 vilivyoruhusiwa huunganishwa kila mara bila kuuliza; sahau kimoja ili kiulizwe tena. { $about }

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-ports = Milango

# Under The ports while the Thunderbolt and USB4 card is read.
settings-permissions-reading-ports = Inasoma kile wanachoruhusu…

# Heading of a line on the Thunderbolt and USB4 card.
settings-permissions-devices-allowed = Vifaa vilivyoruhusiwa

# Under a line of the Thunderbolt and USB4 card while it is read.
settings-permissions-reading = Inasoma…

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-memory-apart = Kumbukumbu imetengwa

# Heading of the line on the Thunderbolt and USB4 card when the computer has no such ports.
settings-permissions-no-ports = Hakuna milango ya Thunderbolt au USB4

# Under the heading when the computer has no Thunderbolt or USB4 ports.
settings-permissions-nothing-to-ask = Kwa hiyo hakuna cha kuuliza.

# Under Devices allowed when the computer has no Thunderbolt or USB4 ports.
settings-permissions-none-plug = Hakuna: hakuna kinachochomekwa kwa njia hii.

# Heading of the line on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-nothing-ask = Hakuna cha kuuliza

# Under Devices allowed when the ports let every device in themselves.
settings-permissions-every-one = Kila kimoja, kwa milango yenyewe.

# Help text of the Thunderbolt and USB4 card when the computer keeps devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-iommu = Kompyuta hii pia huzuia vifaa kufikia kumbukumbu ambayo havikupewa, kwa hiyo hatari ni ndogo. Kusahau kifaa kunakiacha kimeunganishwa hadi kitakapochomolewa.

# Help text of the Thunderbolt and USB4 card when the computer does not keep devices away from memory.
# SAFETY: needs a human review before it ships
settings-permissions-no-iommu = Kusahau kifaa kunakiacha kimeunganishwa hadi kitakapochomolewa; wakati ujao kitaulizwa tena.

# Heading of the line on the Thunderbolt and USB4 card that lists the devices.
settings-permissions-asked-before = Huulizwa kabla kifaa kipya hakijaunganishwa

# Under the heading above.
settings-permissions-forget-one = Sahau kimoja ili kiulizwe tena.

# Red words when the list of allowed Thunderbolt devices could not be read: the reason is { $why }.
settings-permissions-devices-not-read = Vifaa vilivyoruhusiwa havikuweza kusomwa: { $why }

# Shown when no Thunderbolt or USB4 device has been allowed always.
settings-permissions-no-device = Bado hakuna kifaa kinachoweza kuunganishwa bila kuuliza.

# Tip of the button that forgets an allowed Thunderbolt or USB4 device.
# SAFETY: needs a human review before it ships
settings-permissions-forget-device = Sahau kifaa hiki

# Name given to a Thunderbolt or USB4 device that has none.
settings-permissions-a-device = Kifaa cha Thunderbolt

# Under an allowed device's name when its maker is not known.
# SAFETY: needs a human review before it ships
settings-permissions-may-always = Kinaweza kuunganishwa kila mara

# Under an allowed device's name: the maker is { $vendor }.
# SAFETY: needs a human review before it ships
settings-permissions-made-by = Kimetengenezwa na { $vendor }. Kinaweza kuunganishwa kila mara.

# Headline while the list of apps is being read.
settings-permissions-reading-apps = Inasoma kile ambacho kila programu inaweza kutumia…

# Headline while Flatpak is still answering: how many apps are listed.
settings-permissions-reading-each =
    { $n ->
        [one] Inasoma kile ambacho kila moja kati ya { $n } inaweza kutumia…
       *[other] Inasoma kile ambacho kila moja kati ya { $n } inaweza kutumia…
    }

# Headline when no app or plugin is kept in a box of its own.
settings-permissions-no-apps = Hakuna programu wala programu jalizi zilizohifadhiwa kwenye boksi lake lenyewe zilizosakinishwa.

# Headline when exactly one app is kept in a box of its own.
settings-permissions-one-app = Programu moja imehifadhiwa kwenye boksi lake lenyewe na hutumia tu kile kilichoruhusiwa hapa.

# Headline: how many apps and plugins are kept in a box of their own.
settings-permissions-many-apps =
    { $n ->
        [one] Programu au programu jalizi { $n } imehifadhiwa kwenye boksi lake lenyewe, ikitumia tu kile kilichoruhusiwa hapa.
       *[other] Programu na programu jalizi { $n } kila moja imehifadhiwa kwenye boksi lake lenyewe, zikitumia tu kile kilichoruhusiwa hapa.
    }

# Heading of the card for apps from Flathub.
settings-permissions-flathub-apps = Programu za Flathub

# Heading of the card for programs installed in their own folder.
settings-permissions-own-folder = Kwenye folda yao wenyewe

# Heading of the card for plugins.
settings-permissions-plugins = Programu jalizi

# Heading of the card for AppImages.
settings-permissions-appimages = AppImage

# Heading of the card for programs started from Folders.
settings-permissions-from-folders = Zilizoanzishwa kutoka Folda

# Under a kind of app on the Permissions page when none is installed.
settings-permissions-none-installed = Hakuna zilizosakinishwa.

# Under a kind of app on the Permissions page when none has been run.
settings-permissions-none-run = Bado hakuna zilizoendeshwa.

# Help text of the Flathub apps card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-flathub-about = Kila programu ya Flathub huhifadhiwa kwenye boksi lake lenyewe na inaweza kutumia tu kile kilichoruhusiwa hapa. Ikoni iliyojazwa imeruhusiwa; ibofye ili kuibadilisha. Mabadiliko huanza kutumika programu itakapoanzishwa tena.

# Help text of the In their own folder card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-debs-about = Programu zilizosakinishwa kwenye folda yao wenyewe hudhibitiwa kwa chaguo-msingi. Ikoni iliyojazwa imeruhusiwa; ibofye ili kuibadilisha.

# Help text of the Plugins card (the information button).
# SAFETY: needs a human review before it ships
settings-permissions-plugins-about = Programu jalizi hudhibitiwa kwa chaguo-msingi na zinaweza kuruhusiwa tu kile zinachoomba. Programu jalizi inayoendeshwa chinichini huanza tena mara moja na mabadiliko.

# Typing codes card: every short code Trindle swaps for words as you type.
# SAFETY: needs a human review before it ships
settings-permissions-codes = Msimbo wa kuandika

# SAFETY: needs a human review before it ships
settings-permissions-codes-about = Misimbo mifupi ambayo Trindle huibadilisha kuwa maneno unapoandika, kila mmoja pamoja na programu jalizi inayoimiliki. Zima misimbo ya programu jalizi kwa ikoni yake ya duara.

# SAFETY: needs a human review before it ships
settings-permissions-codes-none = Hakuna misimbo inayotumika

# SAFETY: needs a human review before it ships
settings-permissions-codes-none-sub = Programu jalizi iliyoruhusiwa kupanua misimbo huiorodhesha hapa.

# Button on a plugin's row: stops that plugin's codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-off = Zima misimbo ya { $name }

# SAFETY: needs a human review before it ships
settings-permissions-codes-count =
    { $n ->
        [one] Msimbo mmoja, { $id }
       *[other] Misimbo { $n }, { $id }
    }

# A code's second line: what it types and who owns it.
# SAFETY: needs a human review before it ships
settings-permissions-code-types = Huandika "{ $words }" kwa { $name }

# SAFETY: needs a human review before it ships
settings-permissions-codes-more =
    { $n ->
        [one] Msimbo mmoja zaidi unatumika
       *[other] Misimbo { $n } zaidi inatumika
    }

# Line on the typing codes card when the plugins folder could not be read: the list may be missing codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread-line = Folda ya programu jalizi haikuweza kusomwa

# Red words under that line.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread = Folda ya programu jalizi haikuweza kusomwa, kwa hiyo baadhi ya misimbo inaweza kukosekana.

settings-permissions-not-added = Imeendeshwa kutoka Folders, haikuongezwa kwenye Apps

settings-permissions-kind-tip = Aina ya programu



# Heading of the card for programs that are not in a box.
settings-outside-heading = Programu zilizo nje ya boksi

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = Trindle hukagua kila baada ya sekunde chache na kukuambia. Haiwezi kuzizuia programu hizi, na inaweza kukosa moja ya haraka. Programu iliyo kwenye boksi hushikiliwa na boksi lake.

# Label of the switch for the notice about the network.
settings-outside-network = Sema programu inapofikia mtandao

# Label of the switch for the notice about the person's files.
settings-outside-files = Sema programu inapokuwa na faili zako wazi

# Under those two switches.
settings-outside-once = Mara moja kwa kila programu.

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = Sema tena kwa { $name }

# Under a program marked fine for the network.
settings-outside-fine-network = Kufikia mtandao ni sawa.

# Under a program marked fine for the person's files.
settings-outside-fine-files = Kuwa na faili zako wazi ni sawa.

# The line in the card when no program is marked fine.
settings-outside-no-fine = Hakuna programu iliyowekwa alama ya sawa.

# Heading of the card for downloaded files.
settings-downloads-heading = Faili zilizopakuliwa

# Help text of that card (the information button).
settings-downloads-about = Faili kutoka mtandaoni ni ile iliyo kwenye Vipakuliwa, au ile ambayo kivinjari kimeiwekea alama. Programu inayoifungua hupata faili hiyo tu, ya kusomwa tu, bila intaneti na bila folda zako zozote. Hii haihusu kitufe cha Fungua cha kivinjari chenyewe, kinachoanzisha programu yenyewe.

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = Fungua faili zilizopakuliwa kwenye boksi

# Under that switch.
settings-downloads-box-sub = Bila intaneti, na faili hiyo tu, ya kusomwa tu.

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = Fungua faili za { $kind } kama kawaida

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = Faili za { $kind }

# Under a file type's switch.
settings-downloads-normal-sub = Imewashwa: hufunguka kama kawaida, ikiwa na intaneti.

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = Bado hakuna aina. Moja huorodheshwa faili iliyopakuliwa inapofunguka kwenye boksi.

