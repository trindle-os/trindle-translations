
# machine translated (Swahili), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Mipangilio ya Folders

# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Haikuweza kuhifadhiwa.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Haikuweza kuhifadhiwa. Hakuna kilichobadilishwa, kwa sababu { $why }.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Mipangilio ya Folders haikuweza kusomwa, kwa hiyo chaguo za kawaida zinaonyeshwa, na hakuna kinachoweza kubadilishwa hapa hadi isomeke: { $why }.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Vifaa vya hifadhi vinafunguliwa na pete ya Trindle, ambayo haipo kwenye kompyuta hii.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = Folders inapofunguka

# Choice on the settings card: the part about the list.
folders-settings-page-list = Orodha

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Vifaa vya hifadhi

# Choice on the settings card: the part listing kept logins.
# SAFETY: needs a human review before it ships
folders-settings-page-logins = Kuingia kulikohifadhiwa

# Note on the Kept logins part of the settings card.
# SAFETY: needs a human review before it ships
folders-settings-logins-about = Kuingia ulikochagua kukumbukwa hutumwa tu kwa anwani uliyoitumia ndani ya siku 90 zilizopita. Kitufe cha Sahau kinaondoa kimoja.

# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = Hakuna kuingia kulikohifadhiwa.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Inauliza keyring…

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Nyumbani na Za hivi karibuni

# One line under that choice.
folders-settings-start-usual-sub = Nyumbani upande wa kushoto, Za hivi karibuni upande wa kulia.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Mahali kila kidirisha kilipoachwa

# One line under that choice.
folders-settings-start-last-sub = Kila kidirisha kinafunguka kwenye folda kilimokuwa.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Maeneo yaliyowekwa hapa

# One line under that choice.
folders-settings-start-chosen-sub = Unachagua eneo la kila kidirisha hapa chini.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Za hivi karibuni

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Nyumbani

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Hati

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Vilivyopakuliwa

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Picha

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Tupio

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Kidirisha cha kushoto

# One line under the left pane setting.
folders-settings-left-pane-sub = Mahali kidirisha cha kushoto kinapoanzia.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Kidirisha cha kulia

# One line under the right pane setting.
folders-settings-right-pane-sub = Mahali kidirisha cha kulia kinapoanzia.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Chagua mahali kidirisha kinapoanzia

# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
# SAFETY: needs a human review before it ships
folders-settings-forget-failed = { $server } haikuweza kusahauliwa: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Chagua folda nyingine

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Folders inafunguka na { $left } upande wa kushoto na { $right } upande wa kulia.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Folders inafungua kila kidirisha mahali kilipoachwa.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Folders inafunguka na Nyumbani upande wa kushoto na Za hivi karibuni upande wa kulia.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Sehemu ya mipangilio ya Folders

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Folders husoma hili kila inapofunguka. Inafunguka na kidirisha kimoja kinachoonyesha eneo la kushoto; kitufe cha Kimoja na Viwili kwenye upau wake wa zana kinaonyesha vyote viwili.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Safu zilivyo karibu

# Name of the setting for how close the rows sit.
folders-settings-density = Mistari

# One line under the rows setting.
folders-settings-density-sub = Vitu vilivyo karibu kiasi gani, kwenye kila mwonekano.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Visanduku vya kuchagua

# One line under the tick boxes setting.
folders-settings-ticks-sub = Kisanduku kidogo kwenye kila kitu hukiongeza kwenye kilichochaguliwa.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Onyesha viendelezi vya faili

# One line under the file endings setting.
folders-settings-endings-sub = Ikizimwa, report.pdf inaonyeshwa kama report.

# Note under the settings of the list part.
folders-settings-list-note = Viendelezi vikizimwa, kiendelezi cha mwisho cha jina huachwa, isipokuwa pale ambapo hilo lingepotosha: jina lenye viendelezi viwili, programu, au faili ambayo si kile kiendelezi chake kinachosema. Visanduku vya kuchagua vikiwashwa, kisanduku kwenye kichwa cha Jina huchagua vyote au hakuna.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = Sahau { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Fungua vifaa vya hifadhi vikichomekwa

# One line under the drives setting.
folders-settings-drives-sub = Kifaa cha USB kinafunguliwa kikichomekwa.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Kwa vyovyote kiko kwenye utepe wa pembeni, na pete inasema kiko hapo.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Shea

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Unganisha shea tena ninapoingia

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Imezimwa hadi uichague: kuunganisha shea huomba nenosiri la msimamizi kila mara, na shea inayohitaji kuingia hukungoja ubonyeze Unganisha tena.
