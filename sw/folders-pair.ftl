# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Hakuna kitu hapa kinachotofautiana na kidirisha kingine kwa jina, ukubwa au tarehe. Folda hulinganishwa kwa jina tu.
        [one] Kitu 1 hapa hakipo kwenye kidirisha kingine, au kinatofautiana nacho kwa ukubwa au tarehe. Folda hulinganishwa kwa jina tu.
       *[other] Vitu { $n } hapa havipo kwenye kidirisha kingine, au vinatofautiana nacho kwa ukubwa au tarehe. Folda hulinganishwa kwa jina tu.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
