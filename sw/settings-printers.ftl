# machine translated (Swahili), not yet reviewed by a person.

# Sentence at the top of the page when there are no printers.
settings-printers-sum-none = Bado hakuna printa. Zozote zilizopatikana kwenye mtandao wako zimeorodheshwa hapa chini.

# Sentence at the top of the page when the printer used first is paused.
settings-printers-sum-paused = { $name } imesimamishwa, kwa hiyo hakuna kitakachochapishwa nayo kwa sasa.

# Sentence at the top of the page when the printer used first is printing.
settings-printers-sum-printing = { $name } inachapisha.

# Sentence at the top of the page when the printer used first is ready.
settings-printers-sum-ready = Tayari kuchapisha kwenye { $name }.

# Sentence at the top of the page for any other state of the printer used first; the state is a word CUPS gives.
settings-printers-sum-state = { $name } iko katika hali ya { $state }.

# Sentence at the top of the page when one printer is set up and none is chosen to print on first.
settings-printers-sum-one-unchosen = { $name } imeandaliwa; hakuna iliyochaguliwa kuchapisha kwanza.

# Sentence at the top of the page when several printers are set up and none is chosen to print on first.
settings-printers-sum-many-unchosen = Printa { $n } zimeandaliwa; hakuna iliyochaguliwa kuchapisha kwanza.

# Red words under the Print jobs line when a job number is not one CUPS knows.
settings-printers-bad-job = Hiyo si kazi ambayo CUPS inaijua.

# Shown beside a print job after it was cancelled.
# SAFETY: needs a human review before it ships
settings-printers-cancelled = Imeghairiwa

# Red words when CUPS fails and says nothing more.
settings-printers-lpstat-failed = lpstat imeshindwa

# Words in the ring while the network is searched for printers.
settings-printers-searching = Inatafuta

# Words in the ring when the search is finished.
settings-printers-search-done = Imekamilika

# Shown beside a printer after it was made the one used first.
settings-printers-default-now = Sasa ni ya kawaida

# Shown beside a printer after a test page was sent.
settings-printers-sent = Imetumwa

# Shown beside a printer after it was removed.
# SAFETY: needs a human review before it ships
settings-printers-removed = Imeondolewa

# Red words under the By its address line when nothing was typed.
settings-printers-type-address = Andika anwani ya printa kwanza.

# Shown under the By its address line while the printer is added.
settings-printers-adding = Inaongeza...

# Shown beside a printer or the address line after it was added.
settings-printers-added = Imeongezwa

# Shown beside a found printer while a driver is looked for.
settings-printers-finding-driver = Inatafuta kiendeshi chake...

# Heading of a print job in the queue: its number and the printer.
settings-printers-job = Kazi { $number } kwenye { $printer }

# Small line under a print job: who sent it, how big it is and when.
settings-printers-job-sub = { $user }, { $size }, { $when }

# Tip of the cross button that cancels a print job.
# SAFETY: needs a human review before it ships
settings-printers-cancel-job = Ghairi kazi hii

# Heading of the card that lists waiting print jobs.
settings-printers-jobs = Kazi za uchapishaji

# Help text (i button) of the Print jobs card.
settings-printers-jobs-about = Kila kazi inayosubiri kuchapishwa, kwenye printa yoyote, kama ilivyo sasa. Orodha husomwa tena kila baada ya sekunde chache ukurasa huu ukiwa wazi. Msalaba unaghairi kazi; karatasi iliyokwisha kuchapishwa inabaki imechapishwa.

# Line in the Print jobs card when CUPS does not answer.
settings-printers-cups-silent = CUPS haijibu

# Small line under "CUPS is not answering" in the Print jobs card.
settings-printers-queue-unreadable = Foleni haiwezi kusomwa.

# Line in the Print jobs card while the queue is first read, and on the page while it is read.
settings-printers-looking = Inatazama…

# Small line under "Looking…" in the Print jobs card.
settings-printers-queue = Foleni.

# Line in the Print jobs card when no job is waiting.
settings-printers-nothing-waiting = Hakuna kinachosubiri

# Small line under "Nothing waiting".
settings-printers-nothing-waiting-sub = Kazi zinaonekana hapa zinapochapishwa.

# State of a printer shown in its small line when it is paused.
settings-printers-state-paused = Imesimamishwa

# State of a printer shown in its small line when it is idle.
settings-printers-state-idle = Haifanyi kazi

# State of a printer shown in its small line when it is printing.
settings-printers-state-printing = Inachapisha

# Small line under a printer that is the one used first: "Default" and its state.
settings-printers-default-state = Ya kawaida, { $state }

# Tip of the star button that makes a printer the one used first.
settings-printers-make-default = Chapisha kwenye hii kwanza

# Tip of the button that prints a test page.
settings-printers-test-page = Chapisha ukurasa wa jaribio

# Tip of the bin button that removes a printer.
# SAFETY: needs a human review before it ships
settings-printers-remove = Ondoa printa hii

# Line in the Add a printer card when the search needs a program that is missing.
settings-printers-needs-filters = Kutafuta kunahitaji cups-filters

# Small line under it; the command is to be typed as it is.
settings-printers-install-filters = Isakinishe kwa: sudo apt install cups-filters

# Tip of the plus button that adds a printer that was found.
settings-printers-add-found = Ongeza printa hii

# Line in the Add a printer card when the search found nothing new.
settings-printers-nothing-new = Hakuna kipya kilichopatikana

# Small line under "Nothing new found".
settings-printers-nothing-new-sub = Je, imewashwa, na iko kwenye mtandao ule ule?

# Small line under "Looking…" in the Add a printer card.
settings-printers-looking-sub = Zinazojitangaza kwanza, kisha kila mashine kwa zamu.

# Placeholder of the box where a printer's address is typed.
settings-printers-address-placeholder = 192.168.1.50

# Tip of the button that adds the printer whose address was typed.
settings-printers-add-it = Iongeze

# Heading of the line where a printer's address is typed.
settings-printers-by-address = Kwa anwani yake

# Small line under "By its address".
settings-printers-by-address-sub = Kama 192.168.1.50, kwenye skrini yake yenyewe.

# Heading of the card for adding printers.
settings-printers-add-card = Ongeza printa

# Help text (i button) of the Add a printer card.
settings-printers-add-about = Printa zinazojitangaza hutafutwa kwanza, kisha kila mashine kwenye mtandao huulizwa kwa zamu. Printa lazima iwe imewashwa na iwe kwenye mtandao ule ule. Printa zingine hazijitangazi, na mitandao mingine haipitishi tangazo: ongeza kwa anwani yake badala yake, kama 192.168.1.50. Unaweza kuipata kwenye skrini ya printa yenyewe, chini ya mipangilio ya mtandao.

# Name of the page in the list of settings pages.
settings-printers-title = Printa

# Words the settings search looks for on this page (not shown).
settings-printers-keywords = printa chapisha kichanganuzi skana printer print scanner

# Help text at the top of the page.
settings-printers-help = Printa zilizo kwenye mtandao wako hupatikana zenyewe. Bonyeza Ongeza kando ya moja ili kuitumia.

# Headline of the page when printing is not installed.
settings-printers-top-not-installed = Uchapishaji haujasakinishwa kwenye kompyuta hii.

# Headline of the page when printing has not answered yet.
settings-printers-top-looking = Inatazama…

# Headline of the page when the printing service does not answer.
settings-printers-top-silent = Huduma ya uchapishaji haijibu, kwa hiyo hakuna kinachoweza kuchapishwa kwa sasa.

# Heading of the card shown when printing is not installed.
settings-printers-printing = Uchapishaji

# Help text (i button) of that card.
settings-printers-printing-about = Uchapishaji unahitaji CUPS, ambayo haipo kwenye kompyuta hii. Ikishasakinishwa, printa zilizo kwenye mtandao wako hupatikana zenyewe.

# Line in that card.
settings-printers-unavailable = Uchapishaji haupatikani

# Small line under it; the command is to be typed as it is.
settings-printers-install-cups = Isakinishe kwa: sudo apt install cups

# Line in that card.
settings-printers-then-found = Kisha printa hupatikana

# Small line under it.
settings-printers-then-found-sub = Zile zilizo kwenye mtandao wako, zenyewe.

# Small line under "CUPS is not answering" in the Printers card.
settings-printers-service = Huduma ya uchapishaji.

# Line in the Printers card when there are none.
settings-printers-none = Bado hakuna printa

# Small line under "No printers yet".
settings-printers-none-sub = Ongeza moja kando ya hapa.

# Heading of the card that lists the printers.
settings-printers-card = Printa

# Help text (i button) of the Printers card.
settings-printers-card-about = Kila printa iliyoandaliwa kwenye kompyuta hii. Nyota inaifanya printa ya kutumia kwanza; ikoni ya ukurasa inachapisha ukurasa wa jaribio; pipa inaiondoa, ikiuliza mara mbili. Mabadiliko yanahitaji akaunti yako iwe kwenye kundi la lpadmin.

# Red words under a page range box that cannot be used.
printers-bad-range = Kurasa kama 1-3, 5

# Red words under a copies box that cannot be used.
printers-bad-copies = Nakala: 1 hadi 99

# Name of the choice to print on one side of the paper.
printers-sides-one = Upande mmoja

# Name of the choice to print on both sides, turning the page on its long edge.
printers-sides-long = Pande zote, kingo ndefu

# Name of the choice to print on both sides, turning the page on its short edge.
printers-sides-short = Pande zote, kingo fupi

# Name of the A4 paper size.
printers-paper-a4 = A4

# Name of the A3 paper size.
printers-paper-a3 = A3

# Name of the A5 paper size.
printers-paper-a5 = A5

# Name of the US Letter paper size.
printers-paper-letter = Letter

# Name of the US Legal paper size.
printers-paper-legal = Legal

# Name of the choice to print the page upright (portrait).
printers-orientation-portrait = Wima

# Name of the choice to print the page sideways (landscape).
printers-orientation-landscape = Mlalo

# Red words when a printing error is a refusal because the account is not in the lpadmin group.
# SAFETY: needs a human review before it ships
printers-not-allowed = Hairuhusiwi. Akaunti yako inahitaji kuwa kwenye kundi la lpadmin; toka kisha ingia tena likishafanyika.

# Red words when CUPS refuses and gives no reason.
printers-refused = CUPS imekataa.

# Red words when the printer name chosen is not one CUPS accepts.
printers-bad-name = Jina la printa hiyo si moja ambalo CUPS inaruhusu.

# Red words when printing is not installed on the computer.
printers-not-installed = Uchapishaji haujasakinishwa kwenye kompyuta hii.

# Red words when the printer chosen has been removed since.
printers-gone = { $name } haijaandaliwa tena.

# Red words when the printer chosen is paused.
printers-paused = { $name } imesimamishwa.

# Red words when sending the document to CUPS took too long.
printers-too-slow = Hati ilichukua muda mrefu mno kutumwa.

