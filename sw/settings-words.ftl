# machine translated (Swahili), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Maneno yako mwenyewe

# Under the heading.
settings-words-about = Badilisha neno lolote ambalo Trindle linaonyesha, katika lugha yoyote, na ushiriki jedwali kama faili.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Karatasi iliyobadilishwa popote isipokuwa safu yake ya mwisho, au isiyo ya Trindle yenyewe, inakataliwa yote.

# The line that picks which language the boxes are for.
settings-words-language = Lugha

# Under the language line.
settings-words-language-sub = Jedwali hili ni la lugha hii.

# The name of the language list for the screen reader.
settings-words-language-tip = Lugha ya jedwali

# The line that exports the sheet, and its button's tip.
settings-words-export = Pakua karatasi

# Under the export line.
settings-words-export-sub = Kiingereza kushoto, lugha yako kando yake. Badilisha upande wa kulia.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Hifadhi jedwali la maneno

# The line that imports a sheet, and its button's tip.
settings-words-import = Pakia karatasi

# Under the import line.
settings-words-import-sub = Hukaguliwa lote kwanza. Tofauti yoyote haisakinishi chochote.

# Title of the window that asks which sheet to open.
settings-words-import-title = Fungua jedwali la maneno

# Under the import button when a sheet was installed.
settings-words-imported = Limesakinishwa

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Haikuweza kuhifadhiwa

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Imekataliwa: faili ni kubwa mno

# Under the import button: the file is not text.
settings-words-not-text = Imekataliwa: si maandishi matupu

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Imekataliwa: ina herufi zilizofichwa au za udhibiti

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Imekataliwa: mstari mmoja ni mrefu mno

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Imekataliwa: si jedwali la maneno la Trindle

# Under the import button: the sheet is of another version.
settings-words-version = Imekataliwa: ni toleo jingine la jedwali

# Under the import button: the language tag is not usable.
settings-words-bad-language = Imekataliwa: lugha si halali

# Under the import button: the notes at the top were changed.
settings-words-notes = Imekataliwa: sehemu ya juu ya jedwali ilibadilishwa

# Under the import button: lines are missing or extra.
settings-words-count = Imekataliwa: mistari inakosekana au ni ya ziada

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Imekataliwa: ufunguo wa { $key } ulibadilishwa

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Imekataliwa: Kiingereza cha { $key } kilibadilishwa

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Imekataliwa: safu ya { $key } haiko katika umbo sahihi

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Imekataliwa: maneno ya { $key } ni marefu mno

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Imekataliwa: maneno ya { $key } yana herufi zilizofichwa

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Imekataliwa: maneno ya { $key } yana alama za uandishi, kiungo au njia ya faili

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Imekataliwa: vishikilia nafasi vya { $key } vinatofautiana

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Imekataliwa: faili haikuweza kusomwa

# Under the rule on the card: when changed words appear.
settings-words-next-start = Maneno yako yataonekana programu itakapoanzishwa tena.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Imekataliwa: thamani ya ukaguzi hailingani

settings-words-reset = Rudi kwenye maneno ya Trindle

settings-words-reset-sub = Hurudisha lugha hii kama ilivyokuja. Maneno yako huhifadhiwa kwenye faili ya akiba.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Toa karatasi yako

# Under the offer button: who can send and why.
settings-words-offer-sub = Hufungua ukurasa ambapo unaingia Buildmorphic na kuituma. Trindle haitumi kamwe kwa niaba yako.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Anzisha lugha yako mwenyewe

# Under the start line.
settings-words-start-sub = Ipe jina, halisi au la kubuni. Huanza kama Kiingereza na huorodheshwa kama yako.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Jina la lugha yako

# Beside the start line when the language was made.
settings-words-started = Imeanzishwa

# Under the start line: the name is empty or too long.
settings-words-name-length = Tumia herufi 1 hadi 30

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Herufi tu: bila alama za maandishi, njia wala vibambo vilivyofichwa

# Under the start line: another language of your own has this name.
settings-words-name-taken = Tayari una lugha yenye jina hilo

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (yako mwenyewe)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Huondoa lugha hii yako mwenyewe. Maneno yake huhifadhiwa kwenye folda ya akiba.

