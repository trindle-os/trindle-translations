
# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Mandharinyuma

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = mandharinyuma picha onyesho la picha ukuta wallpaper background picture slideshow photo

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Rangi moja, au picha moja, au folda ili picha ibadilike yenyewe kwa wakati unaoweka.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = sekunde 10

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = sekunde 30

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = dakika 1

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = dakika 5

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = dakika 15

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = dakika 30

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = saa 1

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = siku 1

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Jaza skrini

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Ikae, picha nzima ionekane

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = Katikati, ukubwa halisi

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Nyoosha

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Rudia

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = Kwa mpangilio holela

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = Kwa jina la faili

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = Mandharinyuma haikuweza kubadilishwa: programu yake haikuanza.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] picha { $used } kati ya { $all }
       *[other] picha { $used } kati ya { $all }
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = { $folder } haina picha

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] picha { $used } kati ya { $all } zinazokuja na Trindle
       *[other] picha { $used } kati ya { $all } zinazokuja na Trindle
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] picha { $used } kati ya { $all } kutoka { $folder }
       *[other] picha { $used } kati ya { $all } kutoka { $folder }
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, moja ya picha zinazokuja na Trindle

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Rangi moja, iliyowekwa hapa chini.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Hakuna kitu hapo tena. Chagua picha au folda.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Rangi moja, bila picha.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Picha mpya kila { $every }, kutoka picha { $used } kati ya { $all } inayokuja na Trindle.{ $extra }
       *[other] Picha mpya kila { $every }, kutoka picha { $used } kati ya { $all } zinazokuja na Trindle.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Picha mpya kila { $every }, kutoka picha { $used } kati ya { $all } iliyo kwenye { $folder }.{ $extra }
       *[other] Picha mpya kila { $every }, kutoka picha { $used } kati ya { $all } zilizo kwenye { $folder }.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = Folda { $folder } haina picha. Chagua nyingine.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = Folda ina zaidi ya kile Trindle inachokagua, kwa hiyo baadhi ya picha zake huenda zimeachwa.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }, moja ya picha zinazokuja na Trindle.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = Picha moja, { $name }, wakati wote.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = Picha haitumiki. { $why } Ya Trindle yenyewe inaonyeshwa.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = Picha haipo tena. Chagua picha au folda.

# Said in green under a line after its choice was kept.
settings-wallpaper-saved = Imehifadhiwa

# Said in green under the next picture line after the picture changed.
settings-wallpaper-changed = Imebadilishwa

# Small word drawn in the corner of a moving picture's tile.
settings-wallpaper-animated = Inasogea

# Title of the window for choosing a picture.
settings-wallpaper-chooser-title = Chagua picha

# Name of the filter in that window that shows only pictures.
settings-wallpaper-chooser-filter = Picha

# Title of the window for choosing a folder of pictures.
settings-wallpaper-chooser-folder = Chagua folda ya picha

