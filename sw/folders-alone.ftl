
# machine translated (Swahili), not yet reviewed by a person.

# Red note when a folder is shared and Trindle's own helper is not on this computer.
folders-alone-no-share = Kushiriki folda kunahitaji programu msaidizi ya Trindle ambayo haijasakinishwa.

# Note when a Windows share is opened and Trindle's own helper is not on this computer.
folders-alone-no-mount = Kufungua folda ya mtandao ya Windows kunahitaji programu msaidizi ya Trindle ambayo haijasakinishwa.

# Note when an NFS export is opened and Trindle's own helper is not on this computer.
folders-alone-no-nfs = Kufungua folda ya NFS kunahitaji programu msaidizi ya Trindle ambayo haijasakinishwa.

# Red note when the wallpaper is set from Folders and Trindle's wallpaper program is not on this computer.
folders-alone-no-wallpaper = Kuweka mandhari kunahitaji programu ya mandhari ya Trindle, ambayo haijasakinishwa.

# Red note when a folder is opened as administrator and the program that asks for the administrator password is not on this computer.
# SAFETY: needs a human review before it ships
folders-alone-no-root = Kufungua folda kama msimamizi kunahitaji pkexec, ambayo haijasakinishwa.

# Red note when a folder is shared with AI programs and Trindle's program for that is not on this computer.
folders-alone-no-ai = Kushiriki na programu za AI kunahitaji programu ya Trindle ambayo haijasakinishwa.

# Red note when a folder is opened in a terminal and none is installed.
folders-alone-no-terminal = Hakuna terminal iliyosakinishwa ya kufungulia folda hii.
