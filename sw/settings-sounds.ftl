# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Sauti

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = sauti mlio kengele kuanza kuingia kutoka kuzima chaja imechomekwa imeondolewa betri tahadhari kimya yangu maalum ongeza faili wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Sauti ya kila tukio. Ukichagua moja inachezwa, na Zima huweka tukio hilo kimya. Unaweza kuongeza sauti zako mwenyewe kisha kuzichagua kama nyingine zote.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Zima

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Kimya kabisa: hakuna tukio linalotoa sauti.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Kila tukio lina sauti yake.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
        [one] Tukio { $n } kati ya matukio { $total } linatoa sauti; mengine yako kimya.
       *[other] Matukio { $n } kati ya { $total } yanatoa sauti; mengine yako kimya.
    }

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-open = Trindle inafunguka

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-close = Trindle inafungwa

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunrise = Macheo

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-sunset = Machweo

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-rising = Kupanda

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-falling = Kushuka

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-alert = Tahadhari

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-bell = Kengele

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-glass = Kioo

# Name of a sound that comes with Trindle, in the lists of sounds.
settings-sounds-name-pop = Pop

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-login = Kuingia

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-logout = Kutoka, kuwasha upya na kuzima

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-plug = Chaja imechomekwa

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-unplug = Chaja imeondolewa

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-battery = Betri iko chini

# Name of a moment that can make a sound, as the heading of its line and the name of its list.
settings-sounds-moment-notification = Arifa inatokea

# Heading of the logging out line.
settings-sounds-moment-logout-short = Kutoka

# Heading of the notifications line.
settings-sounds-moment-notification-short = Arifa

# Small words under the logging in line.
settings-sounds-moment-login-about = Eneo-kazi linapotokea.

# Small words under the logging out line.
settings-sounds-moment-logout-about = Pia kuwasha upya na kuzima.

# Small words under the charger plugged in line.
settings-sounds-moment-plug-about = Chaja inapochomekwa.

# Small words under the charger unplugged line.
settings-sounds-moment-unplug-about = Chaja inapoondolewa.

# Small words under the battery low line.
settings-sounds-moment-battery-about = Wakati wa kuchaji.

# Small words under the notifications line.
settings-sounds-moment-notification-about = Arifa inapotokea.

# Heading and slider name for the volume of the logging in and out sounds.
settings-sounds-volume-coming = Sauti ya kuingia na kutoka

# Heading and slider name for the volume of notification sounds.
settings-sounds-volume-notifications = Sauti ya arifa

# Heading and slider name for the volume of the charger and battery sounds.
settings-sounds-volume-power = Sauti ya nguvu

# Name of the round button that plays the sound chosen for a moment, or an added sound.
settings-sounds-hear = Isikilize

# Name of the button that opens a window to add sound files.
settings-sounds-add = Ongeza faili za sauti

# Name of the button that opens the folder where added sounds are kept.
settings-sounds-open-folder = Fungua folda zinakohifadhiwa

# Red words under the add sounds line when the folder could not be opened.
settings-sounds-folder-not-opened = Folda haikuweza kufunguliwa.

# Red words under the add sounds line when the folder for added sounds could not be made.
settings-sounds-folder-not-made = Folda ya sauti zako haikuweza kutengenezwa.

# Name of the button that plays the sound being added, when one of the same name is already there.
settings-sounds-hear-new = Sikiliza inayoletwa

# Name of the button that plays the sound already there, when one of the same name is being added.
settings-sounds-hear-old = Sikiliza iliyopo tayari

# Heading of the line for adding sounds.
settings-sounds-add-heading = Ongeza sauti

# Small words under the add sounds line, listing the kinds of file that can be added.
settings-sounds-add-formats = WAV, OGG, Opus, FLAC au MP3.

# Name of the bin button that removes a sound added by the person.
# SAFETY: needs a human review before it ships
settings-sounds-remove = Ondoa sauti hii

# Heading of the line shown when no sounds have been added.
settings-sounds-none-yet = Hakuna iliyoongezwa bado

# Small words under that line.
settings-sounds-none-yet-about = Ongeza moja ili kuichagua kwa tukio lolote.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Sauti hiyo haipo tena kwenye kompyuta hii. Chagua nyingine.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Sauti haikuchezwa. Angalia spika kwenye Sauti ya kompyuta (Audio).

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Chagua faili za sauti

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Sauti

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name } si aina ya sauti ambayo Trindle inaweza kucheza.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = { $name } haikuweza kunakiliwa.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = Imeongezwa { $n }. Ichague kando ya tukio hapo juu.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-sounds-not-replaced = { $name } haikuweza kubadilishwa.

# Green words after one sound took the place of the one there; { $name } is the file name.
# SAFETY: needs a human review before it ships
settings-sounds-replaced-one = { $name } imebadilishwa.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
# SAFETY: needs a human review before it ships
settings-sounds-replaced-some = Zimebadilishwa { $n } kati ya { $total }.

# Red words under a sound's line when it could not be removed.
settings-sounds-not-removed = Haikuweza kuondolewa.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
settings-sounds-not-set-back = Sauti yake iliondolewa, na haikuweza kurudishwa kwenye sauti yake ya asili.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Kuja na kuondoka

# Words behind the i of that card.
settings-sounds-coming-about = Ukichagua sauti inachezwa, na Zima huweka tukio hilo kimya. Kitufe cha duara kando ya kila moja huchezesha sauti iliyochaguliwa sasa. Kila sauti huenda kutoka 0 hadi 100 kwa makumi na huchezwa mara moja ukiachia.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Nguvu

# Words behind the i of that card.
settings-sounds-power-about = Sauti za chaja kuchomekwa na kuondolewa, na za betri kuwa chini. Sauti huenda kutoka 0 hadi 100 kwa makumi na huchezwa mara moja ukiachia.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Sauti zako mwenyewe

# Words behind the i of that card.
settings-sounds-own-about = WAV, OGG, Opus, FLAC au MP3. Hunakiliwa kwenye folda yako mwenyewe, kwa hiyo za asili zinaweza kuhamishwa au kufutwa, kisha kuchaguliwa kando ya tukio lolote kama nyingine. Kuondoa moja hurudisha tukio lolote lililoitumia kwenye sauti yake ya asili.
