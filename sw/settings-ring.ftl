# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Pete

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = vipendwa kizinduzi ukingo bofya kona sauti hotuba madirisha yaliyofunguliwa ubao wa kunakili nakili bandika historia sahau arifa favourites launcher voice clipboard notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Vipendwa vyako viko kuzunguka katikati ya pete. Huchaguliwa kwenye pete yenyewe: bofya kulia programu yoyote kwenye pete ili kuiongeza au kuiondoa, na buruta kipendwa hadi mahali pa kingine ili kubadilisha mpangilio.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = Pete hufunguka ukingoni mwa skrini, na madirisha yako yaliyofunguliwa yako ndani yake.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Mahali vitu vinapofunguka

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Bofya ukingoni mwa skrini

# Small words under that line about the Super key.
settings-ring-open-super = Kitufe cha Super pia huifungua.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] Kipendwa { $n }
       *[other] Vipendwa { $n }
    }

# Small words under the favourites line.
settings-ring-favourites-about = Bofya kulia programu kwenye pete ili kuongeza.

# Title of the card about opening the ring.
settings-ring-opening = Kufungua pete

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Peleka kielekezi ukingoni mwa skrini na ubofye, au bonyeza kitufe cha Super, na pete hufunguka. Vipendwa vyako viko kuzunguka katikati ya pete, na madirisha yako yaliyofunguliwa kwenye duara kuvizunguka: bofya moja ili kuliweka mbele, au bofya kulia kwa vitufe vyake. Bofya kulia programu yoyote kwenye pete ili kuiongeza au kuiondoa.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Zionyeshe zinapofika

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Imezimwa: bado hukusanyika kwenye pete.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Zinakaa kwa muda gani

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Za dharura husubiri kufungwa.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Zinapoonekana

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Kona ambayo zinarundikana kuiacha.

# Title of the card about notifications.
settings-ring-notify-title = Arifa

# Words behind the i of the card about notifications.
settings-ring-notify-about = Programu ikiwa na kitu cha kukuambia, huonekana kwa sekunde chache kisha huondoka. Ikizimwa, hakuna kinachoonekana, na kila kitu bado hukusanywa kwenye duara la arifa kwenye pete. Arifa ya dharura husubiri kufungwa bila kujali kilichochaguliwa hapa, ili onyo lisijiondoe kabla halijasomwa.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = Sahau kilichonakiliwa

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Mistari iliyobandikwa huhifadhiwa.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Vilivyonakiliwa sasa

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] Mstari { $n }, { $pinned } umebandikwa.
       *[other] Mistari { $n }, { $pinned } imebandikwa.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Ubao wa kunakili

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Duara la ubao wa kunakili kwenye pete huhifadhi unachonakili, ili uweze kubandika kitu cha awali. Mistari iliyobandikwa huhifadhiwa kila mara, bila kujali kilichochaguliwa hapa.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Inaongeza sauti; endelea na mengine wakati huo.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Inaondoa zana za kujenga.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Inaondoa sauti.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Udhibiti kwa sauti

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = Imewashwa

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Imezimwa

# Small words under the voice switch.
settings-ring-voice-about = Hueleweka kwenye kompyuta hii tu.

# Heading of the line, and the name of its button, that removes voice.
settings-ring-voice-remove = Ondoa sauti

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Huachia takriban MB 150.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Sauti iko tayari. Zana za kujenga zimebaki.

# Name of the button that removes the build tools voice left behind.
settings-ring-voice-tools-remove = Ondoa zana za kujenga

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Ongeza udhibiti kwa sauti (takriban MB 150)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = Si lazima; takriban MB 150 kuongeza.

# Title of the card about voice.
settings-ring-voice-title = Sauti

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Sema jina la programu, “louder” au “Wi-Fi settings” badala ya kubofya. Gusa katikati ya pete na uzungumze; huacha kusikiliza ukiacha. Hotuba huelewa kwenye kompyuta hii na hakuna kinachotumwa popote. Kuiongeza huchukua takriban MB 150 na dakika chache, na unaweza kuendelea na mengine wakati huo; kuiondoa huondoa injini ya hotuba na modeli yake.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Inaongeza sauti

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Inaondoa zana za kujenga

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Inaondoa sauti

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = Kila kompyuta inapoanzishwa upya

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Baada ya siku moja

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Baada ya wiki moja

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = Baada ya wiki mbili

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Kamwe

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = Onyesha kichwa unapoelekeza

# Small words under that switch.
settings-ring-names-about = Imezimwa: picha tu. Visoma-skrini bado hupata kichwa.

