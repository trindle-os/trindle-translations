# machine translated (Swahili), not yet reviewed by a person.

# Settings' words for a port: it did not start, Trindle switched it off and on once, and a device came up. $port is the port's name.
usbretry-worked = Mlango wa USB { $port } haukuanza, kwa hiyo Trindle iliuzima na kuuwasha mara moja. Kifaa kimeonekana.

# Settings' words for a port: it did not start, Trindle restarted the USB controller, and a device came up. $port is the port's name.
usbretry-worked-controller = Mlango wa USB { $port } haukuanza, kwa hiyo Trindle iliwasha upya kidhibiti chake cha USB. Kifaa kimeonekana.

# Settings' words for a port: it did not start, the USB controller was restarted, and nothing came up. $port is the port's name.
usbretry-nothing-controller = Mlango wa USB { $port } haukuanza. Trindle iliwasha upya kidhibiti chake cha USB na hakuna kilichoonekana. Zima kompyuta kisha uiwashe ili kuurudisha.

# Settings' words for a port: nothing came back after it was switched off and on, and the controller was not restarted. $port is the port's name.
usbretry-nothing = Mlango wa USB { $port } haukurudi baada ya kuanzishwa upya. Zima kompyuta kisha uiwashe ili kuurudisha.
