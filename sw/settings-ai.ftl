
# machine translated (Swahili), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = Programu za AI

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = ai programu claude codex cursor gemini aider wakala uzio sanduku la mchanga faragha folda shiriki ssh funguo tokeni sudo

# Help line at the foot of the AI programs page.
settings-ai-help = Programu za AI za uandishi wa msimbo hufanya kazi ndani ya uzio unaoficha faili zako binafsi. Shiriki folda zinazohitajika tu.

# Headline of the AI programs page.
# SAFETY: needs a human review before it ships
settings-ai-note = Hii huzuia programu za AI zisifikie faili zako binafsi katika matumizi ya kila siku, kwa mfano ikiwa moja imedanganywa kukusanya taarifa za benki yako na kuzituma nje. Ni ulinzi wenye mipaka, si hakikisho: programu iliyodhamiria, hitilafu katika programu za kompyuta, au wewe kukubali ombi au kushiriki folda vinaweza bado kuruhusu kitu kupita.

# Note under the headline of the AI programs page.
settings-ai-inside = Kila kitu ambacho programu ya AI huanzisha, kama programu zilizosakinishwa, hati na programu nyingine, hubaki ndani ya uzio pamoja nayo.

# Red words when a change to the fence could not be made.
settings-ai-not-changed = Haikuweza kubadilishwa.

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = Imehifadhiwa

# Title of the window for choosing a folder to share with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-choose-folder = Chagua folda ya kushiriki na programu za AI

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = Ufunguo haukuweza kutengenezwa.

# Label of the switch that limits the network of AI programs, and heading of its line.
settings-ai-limit-net = Zuia mtandao kwa tovuti zilizoorodheshwa hapa

# Under the Limit the network heading.
settings-ai-limit-net-sub = Imezimwa: mtandao uko wazi. Imewashwa: tovuti zilizo hapa chini tu.

# Tip of the button that removes a site from the list AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-stop-site = Zuia programu za AI kufikia tovuti hii

# Example in the box for typing a site AI programs may reach.
settings-ai-eg-site = mfano api.anthropic.com

# Tip of the button that adds a site AI programs may reach.
# SAFETY: needs a human review before it ships
settings-ai-let-site = Ruhusu programu za AI kufikia tovuti hii

# Heading of the line for adding a site.
settings-ai-add-site = Ongeza tovuti

# Under the Add a site heading.
settings-ai-add-site-sub = Jina lake, au *.example.com kwa kila jina lililo chini yake.

# Heading of the card that limits the network of AI programs.
settings-ai-network = Mtandao

# Help text of the Network card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-network-about = Kwa watumiaji wenye uzoefu. Ikizimwa, programu za AI hutumia mtandao kama wewe. Ikiwashwa, zinaweza kufikia tovuti zilizo hapa chini tu, kupitia miunganisho salama (https), na uzio hauna mtandao wake. Zana za programu lazima zitumie mipangilio ya wakala iliyopewa. Ongeza tovuti ya huduma ya AI, na ya chanzo chochote cha vifurushi kinachohitajika kwa usakinishaji.

# Label of the switch that keeps AI programs inside the fence, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-keep-inside = Weka programu za AI ndani ya uzio

# Under the fence switch when it is on.
# SAFETY: needs a human review before it ships
settings-ai-hides-home = Huficha folda yako ya nyumbani, isipokuwa folda zilizoshirikiwa hapa chini.

# Under the fence switch when it is off.
# SAFETY: needs a human review before it ships
settings-ai-fence-off = Uzio umezimwa. Programu za AI sasa zinaweza kuona kila kitu unachoweza kuona.

# Heading of the card with the fence switch.
settings-ai-the-fence = Uzio

# Help text of The fence card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-fence-about = Mfumo unabaki kuonekana na kutumika kwa programu za AI. Folda yako ya nyumbani inabadilishwa na folda ya nyumbani ya faragha isiyo na kitu ambayo huzitunza kati ya matumizi, ikiwa na folda unazoshiriki tu. Haziwezi kuona programu zako nyingine, kipindi chako, funguo zako au nenosiri zako. Programu iliyoanzishwa kwa njia nyingine isipokuwa kupitia jina lake kwenye orodha hii haiko ndani ya uzio. Ikiwa umesakinisha muunganisho wa msaidizi (trindle-mcp), msaidizi aliyeunganishwa anaweza kusoma haya bila kukuuliza: vichwa vya madirisha yako yaliyo wazi na programu zilizo nyuma yake, programu ulizosakinisha, programu zinazoendeshwa na matumizi yake ya kumbukumbu, kumbukumbu, diski, betri, muda ambao kompyuta imewashwa na hali ya mtandao, mipangilio yako ya Trindle, hadi mistari 500 ya jarida la mfumo kwa huduma yoyote, madokezo yako ya hivi karibuni ya hitilafu, na majina ya vifaa vyako vya sauti, vifaa vya Bluetooth vilivyooanishwa, mitandao ya Wi-Fi iliyo karibu na diski. Huuliza kila mara kabla ya kubadilisha chochote.

# Label of the switch that fences one AI program: its name is { $name }.
# SAFETY: needs a human review before it ships
settings-ai-fence-name = Weka { $name } ndani ya uzio

# Tip of the button that takes one program off the list: its name is { $name }.
settings-ai-take-off = Ondoa { $name } kwenye orodha

# Label of the switch for using a program's existing settings folder: its name is { $name }.
# SAFETY: needs a human review before it ships
settings-ai-own-for = Tumia folda yangu ya mipangilio iliyopo kwa { $name }

# Heading of the line with the switch for using a program's existing settings folder.
# SAFETY: needs a human review before it ships
settings-ai-own = Tumia folda yangu ya mipangilio iliyopo

# Under the existing settings folder heading.
settings-ai-own-sub = Ina mazungumzo ya awali ya programu hii.

# Example in the box for typing the name of an AI program.
settings-ai-eg-program = mfano claude

# Tip of the button that adds an AI program, and heading of its line.
settings-ai-add-program = Ongeza programu

# Under the Add a program heading.
settings-ai-add-program-sub = Andika jina unalolitumia kuianzisha.

# Help text of the AI programs card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-programs-about = Majina haya huanza ndani ya uzio. Tumia folda yangu ya mipangilio iliyopo: ikizimwa, programu huanza na folda mpya ya faragha. Programu huingia zenyewe, ndani: kuingia kwako mwenyewe hakushirikiwi.

# Heading of the line shown when no folder is shared with AI programs.
settings-ai-nothing-shared = Hakuna kinachoshirikiwa

# Under the Nothing is shared heading.
settings-ai-none-seen = Programu za AI haziioni folda zako zozote.

# Label of the switch that lets AI programs only read a shared folder.
# SAFETY: needs a human review before it ships
settings-ai-only-read = Iruhusu kusoma folda hii tu

# Tip of the button that stops sharing a folder with AI programs.
# SAFETY: needs a human review before it ships
settings-ai-make-private = Fanya folda hii iwe ya faragha tena

# Under a shared folder's path, beside the switch that makes it read only.
# SAFETY: needs a human review before it ships
settings-ai-only-read-short = Iruhusu kusoma tu

# Tip of the button that shares a folder, and heading of its line.
# SAFETY: needs a human review before it ships
settings-ai-share-folder = Shiriki folda

# Under the Share a folder heading.
# SAFETY: needs a human review before it ships
settings-ai-share-folder-sub = Inaonekana mahali pale pale, kusoma na kuandika.

# Heading of the card listing folders shared with AI programs.
settings-ai-shared = Zilizoshirikiwa na programu za AI

# Help text of the shared folders card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-shared-about = Faragha dhidi ya programu za AI ndiyo kanuni kwa kila kitu kingine kwenye folda yako ya nyumbani. Folda zilizofichwa, na folda zinazohifadhi funguo, nenosiri au barua pepe, haziwezi kamwe kushirikiwa. Folda iliyoshirikiwa hapa itakuwepo programu itakapoanza tena.

# Tip of the button that removes a computer from the list AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-stop-computer = Zuia programu za AI kufikia kompyuta hii

# Example in the box for typing a computer AI programs may reach by ssh.
settings-ai-eg-computer = mfano nas.local

# Tip of the button that adds a computer AI programs may reach by ssh.
# SAFETY: needs a human review before it ships
settings-ai-let-computer = Ruhusu programu za AI kufikia kompyuta hii

# Heading of the line for adding a computer.
settings-ai-add-computer = Ongeza kompyuta

# Under the Add a computer heading.
settings-ai-add-computer-sub = Andika jina lake.

# Note showing the public key to put on each computer: the key is { $key }.
# SAFETY: needs a human review before it ships
settings-ai-put-key = Weka ufunguo huu kwenye kila kompyuta: { $key }

# Tip of the button that makes a key for AI programs.
settings-ai-make-key = Tengeneza ufunguo

# Heading of the line for making a key for AI programs.
settings-ai-make-key-for = Tengeneza ufunguo kwa ajili ya programu za AI

# Under the Make a key heading.
settings-ai-make-key-sub = Ufunguo tofauti, unaotunzwa nje ya folda wanazoweza kuona.

# Heading of the card listing computers AI programs may reach by ssh.
settings-ai-ssh = Kompyuta wanazoweza kufikia kwa ssh

# Help text of the ssh card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-ssh-about = Ndani ya uzio, ssh huuliza Trindle, ambayo hutumia ufunguo wake yenyewe na kwa kompyuta zilizoorodheshwa hapa tu. Funguo zako mwenyewe haziwahi kuonyeshwa kwa programu za AI.

# Tip of the button that stops giving AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-stop-key = Acha kuzipa programu za AI ufunguo huu

# Under the name of a key that AI programs are given.
settings-ai-given = Imepewa programu za AI

# Example in the box for typing a key to give AI programs: a name, an equals sign and the value.
settings-ai-eg-key = JINA=thamani

# Tip of the button that gives AI programs a key.
# SAFETY: needs a human review before it ships
settings-ai-give-key = Zipe programu za AI ufunguo huu

# Heading of the line for adding a key.
settings-ai-add-key = Ongeza ufunguo

# Under the Add a key heading.
settings-ai-add-key-sub = Umeandikwa kama JINA=thamani.

# Heading of the card listing keys given to AI programs.
# SAFETY: needs a human review before it ships
settings-ai-keys = Funguo zilizopewa programu za AI

# Help text of the keys card (the information button).
# SAFETY: needs a human review before it ships
settings-ai-keys-about = Funguo na tokeni zilizo kwenye kipindi chako haziwafikii kamwe programu za AI. Ufunguo ulioandikwa hapa unapewa, na hapa tu.
