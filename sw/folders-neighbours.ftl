# machine translated (Swahili), not yet reviewed by a person.

# Line on the empty Network page while Folders is still looking for computers.
folders-neighbours-looking = Inatafuta kompyuta kwenye mtandao huu zinazoshiriki folda.

# First line on the empty Network page when nothing was found.
folders-neighbours-none = Hakuna kompyuta zinazoshiriki folda zilizopatikana kwenye mtandao huu.

# Line on the empty Network page saying which ways of looking were used; the variable is both, windows or other.
folders-neighbours-asked =
    { $ways ->
        [both] Folders iliuliza kwa njia ya Windows, na kwa njia ambayo NAS, Mac au Linux hujibu.
        [windows] Folders iliuliza kwa njia ya Windows.
       *[other] Folders iliuliza kwa njia ambayo NAS, Mac au Linux hujibu.
    }

# Line on the empty Network page saying the Windows way could not be asked because Trindle's finder program is missing.
folders-neighbours-no-finder = Njia ya Windows haikuweza kutumika: kitafutaji cha Trindle kwa ajili yake (trindle-wsdd) hakipo kwenye kompyuta hii.

# Line on the empty Network page saying the other way could not be asked because no network card is connected.
folders-neighbours-no-card = Hakuna kadi ya mtandao inayoweza kuulizwa iliyounganishwa; VPN peke yake haibebi maswali ya aina hii.

# Line on the empty Network page saying the network refused the question; the variable is the reason the system gave.
folders-neighbours-refused = Mtandao haukupokea swali ({ $why }).

# Last line on the empty Network page: a quiet computer can still be opened by hand.
folders-neighbours-quiet = Kompyuta isiyojibu, au iliyo nyuma ya ngome ya moto, bado inaweza kufunguliwa kwa jina au anwani yake.
