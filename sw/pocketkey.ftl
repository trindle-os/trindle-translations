# machine translated (Swahili), not yet reviewed by a person.

# The heading when a command wants administrator rights.
# SAFETY: needs a human review before it ships
pk-title-sudo = Endesha hii kama msimamizi?
# The heading when a program wants to change a system setting.
# SAFETY: needs a human review before it ships
pk-title-polkit = Ruhusu mabadiliko haya?
# The heading when a phone is being added.
# SAFETY: needs a human review before it ships
pk-title-pair = Ongeza simu hii?

# Shown when a program asked to change a setting and gave no details.
# SAFETY: needs a human review before it ships
pk-what-polkit = Programu inataka kubadilisha mpangilio wa mfumo.
# The question when a phone is being added. $name is the phone's name, $code the digits both screens show.
# SAFETY: needs a human review before it ships
pk-pair-detail = Je, { $name } inaonyesha msimbo { $code }?

# The small print under the question. $user is the person's login name.
# SAFETY: needs a human review before it ships
pk-note = Ombi hili ni la { $user }. Kama hukuanzisha hili, chagua Hapana.

# The name of the round button that refuses, and the word under it.
# SAFETY: needs a human review before it ships
pk-no = Hapana
# The name of the round button that agrees, and the word under it.
# SAFETY: needs a human review before it ships
pk-yes = Ndiyo

# The title of the window that pairs a phone.
pk-pairing-title = Oanisha simu yako
# Shown while the password box is open.
pk-pairing-waiting-password = Andika nenosiri lako…
# Under the QR code.
pk-pairing-scan = Changanua msimbo huu kwa Pocketkey kwenye simu yako. Huacha kufanya kazi baada ya dakika tatu.
# The picture description of the QR code.
pk-pairing-qr = Msimbo wa QR wa kuoanisha simu yako
# The question under the six numbers. $name is the phone's name.
pk-pairing-same-numbers = Je, { $name } inaonyesha tarakimu sita zile zile?
# The button that stops pairing.
pk-pairing-stop = Acha kuoanisha
# The button that closes the window once pairing has ended.
pk-pairing-close = Funga
# Shown when the phone is paired.
pk-pairing-paired = Simu yako imeoanishwa. Sasa unaweza kuidhinisha maombi kwa simu badala ya kuandika nenosiri lako.
# Shown when the pairing helper could not start.
pk-pairing-not-start = Pocketkey haikuweza kuanza kuoanisha.
# Shown when pairing was stopped.
pk-pairing-stopped = Kuoanisha kumesimama.
# The reasons the Pocketkey service gives for a pairing that did not finish.
pk-pairing-why-ran-out-of-time = Msimbo umeisha muda. Anza kuoanisha tena.
pk-pairing-why-not-confirmed = Pocketkey haikuweza kuthibitisha kwamba misimbo inalingana. Anza kuoanisha tena.
pk-pairing-why-not-saved = Pocketkey haikuweza kuhifadhi kuoanisha.
pk-pairing-why-phone-left = Muunganisho na simu yako umekatika.
pk-pairing-why-link-failed = Pocketkey haikuweza kuunganishwa na simu yako.
pk-pairing-why-bad-keys = Simu yako ilituma taarifa za usalama ambazo Pocketkey haiwezi kutumia.
pk-pairing-why-paired-to-other = Simu hii tayari imeoanishwa na mtu mwingine.
pk-pairing-why-too-many-codes = Misimbo mingi mno isiyo sahihi iliwekwa. Anza kuoanisha tena.
pk-pairing-why-newer-started = Kuoanisha huku kumesimama kwa sababu kuoanisha kwingine kumeanza.
pk-pairing-why-switched-off = Pocketkey imezimwa. Iwashe, kisha jaribu tena.
pk-pairing-why-root = Huwezi kuoanisha simu ukiwa umeingia kama root, akaunti ya msimamizi.
pk-pairing-why-service-stopped = Pocketkey imeacha kufanya kazi.
pk-pairing-why-service-odd = Pocketkey ilipokea jibu lisilotarajiwa.
pk-pairing-why-other = Kuoanisha hakukukamilika.

# The words of Pocketkey's page in Plugins (packaging/plugin/pocketkey.toml).
pk-set-switched-off = Pocketkey imezimwa.
pk-set-no-phone = Bado hujaoanisha simu. Oanisha moja ili itumike badala ya nenosiri lako.
pk-set-password-due = Unahitaji kuandika nenosiri lako tena.
pk-set-paired-near = Simu yako, { $name }, imeoanishwa na iko karibu.
pk-set-paired-away = Simu yako, { $name }, imeoanishwa lakini iko nje ya masafa.
pk-set-on = Tumia simu yangu badala ya nenosiri langu
pk-set-pair = Oanisha simu yako
pk-set-lock-after = Funga skrini baada ya
pk-set-lock-after-sub = Skrini hufungwa simu yako ikiwa nje ya masafa kwa muda huu.
pk-set-10-seconds = Sekunde 10
pk-set-30-seconds = Sekunde 30
pk-set-1-minute = Dakika 1
pk-set-2-minutes = Dakika 2
pk-set-5-minutes = Dakika 5
pk-set-reauth = Niulize nenosiri langu tena baada ya
pk-set-reauth-sub = Muda huhesabiwa tangu mara ya mwisho ulipoandika nenosiri lako kwenye kompyuta hii.
pk-set-never = Kamwe
pk-set-30-minutes = Dakika 30
pk-set-1-hour = Saa 1
pk-set-6-hours = Saa 6
pk-set-1-day = Siku 1
pk-set-forget = Sahau simu hii
pk-set-forget-sub = Simu hii haitaweza tena kuidhinisha maombi kwenye kompyuta hii.


# Under those numbers: where to answer.
pk-pairing-answer-on-screen = Jibu swali linaloonekana kwenye skrini nzima.

pk-pairing-why-needs-password = Unahitaji kuandika nenosiri lako ili kuongeza simu nyingine. Simu yako ya sasa haiwezi kuidhinisha hili. Funga dirisha hili na uanze kuoanisha tena.

pk-set-sudo = Amri za msimamizi na mabadiliko ya mfumo

pk-set-sudo-sub = Chagua kama simu yako ikuulize alama ya kidole au PIN kwanza.

pk-set-sudo-unlocked = Uliza alama ya kidole au PIN isipokuwa simu ilifunguliwa sasa hivi

pk-set-sudo-any = Usiulize kamwe, hata simu ikiwa imefungwa
