# machine translated (Swahili), not yet reviewed by a person.

# The heading when a command wants administrator rights.
# SAFETY: needs a human review before it ships
pk-title-sudo = Endesha hii kama msimamizi?
# The heading when a program wants to change a system setting.
# SAFETY: needs a human review before it ships
pk-title-polkit = Ruhusu mabadiliko haya?
# The heading on the lock screen.
# SAFETY: needs a human review before it ships
pk-title-unlock = Fungua skrini?
# The heading on the login screen.
# SAFETY: needs a human review before it ships
pk-title-login = Ingia?
# The heading when a phone is being added.
# SAFETY: needs a human review before it ships
pk-title-pair = Ongeza simu hii?

# Shown when a command asked for administrator rights and gave no details.
# SAFETY: needs a human review before it ships
pk-what-sudo = Amri inataka haki za msimamizi.
# Shown when a program asked to change a setting and gave no details.
# SAFETY: needs a human review before it ships
pk-what-polkit = Programu inataka kubadilisha mpangilio wa mfumo.
# Shown on the lock screen with no details.
# SAFETY: needs a human review before it ships
pk-what-unlock = Fungua skrini hii.
# Shown on the login screen with no details.
# SAFETY: needs a human review before it ships
pk-what-login = Ingia kwenye kompyuta hii.
# Shown when a phone is being added and no code could be shown.
# SAFETY: needs a human review before it ships
pk-what-pair = Simu inataka kuongezwa.
# The question when a phone is being added. $name is the phone's name, $code the digits both screens show.
# SAFETY: needs a human review before it ships
pk-pair-detail = Je, msimbo kwenye { $name } ni { $code }?

# The small print under the question. $user is the person's login name.
# SAFETY: needs a human review before it ships
pk-note = Imeombwa kwa { $user } kwa kutumia Pocketkey. Kama hukuanzisha hili, chagua Hapana.

# The name of the round button that refuses, and the word under it.
# SAFETY: needs a human review before it ships
pk-no = Hapana
# The name of the round button that agrees, and the word under it.
# SAFETY: needs a human review before it ships
pk-yes = Ndiyo

# The title of the window that pairs a phone.
pk-pairing-title = Oanisha simu yako
# Shown while the password box is open.
pk-pairing-waiting-password = Inasubiri nenosiri lako…
# Under the QR code.
pk-pairing-scan = Changanua hii kwa Pocketkey kwenye simu yako. Inafanya kazi kwa dakika tatu.
# The picture description of the QR code.
pk-pairing-qr = Msimbo wa QR wa kuoanisha simu yako
# The question under the six numbers. $name is the phone's name.
pk-pairing-same-numbers = Je, { $name } inaonyesha namba hizi sita zile zile?
# The button that agrees the numbers match.
# SAFETY: needs a human review before it ships
pk-pairing-match = Zinalingana
# The button that says they do not match.
# SAFETY: needs a human review before it ships
pk-pairing-no-match = Hazilingani
# Shown after the person agreed, until the phone agrees too.
pk-pairing-waiting-phone = Inasubiri simu iseme ndiyo pia…
# The button that stops pairing.
pk-pairing-stop = Acha kuoanisha
# The button that closes the window once pairing has ended.
pk-pairing-close = Funga
# Shown when the phone is paired.
pk-pairing-paired = Imeunganishwa. Simu yako sasa inaweza kujibu badala ya nenosiri lako.
# Shown when the pairing helper could not start.
pk-pairing-not-start = Kuoanisha hakukuweza kuanza.
# Shown when pairing was stopped.
pk-pairing-stopped = Kuoanisha kumesimama.
# The reasons the Pocketkey service gives for a pairing that did not finish.
pk-pairing-why-ran-out-of-time = Muda wa msimbo uliisha.
pk-pairing-why-not-confirmed = Misimbo haikuthibitishwa.
pk-pairing-why-not-saved = Kuoanisha hakukuweza kuhifadhiwa.
pk-pairing-why-phone-left = Simu iliondoka.
pk-pairing-why-link-failed = Kiungo cha simu kimeshindwa.
pk-pairing-why-bad-keys = Simu ilituma funguo zisizoweza kutumika.
pk-pairing-why-paired-to-other = Simu hii imeoanishwa na mtu mwingine.
pk-pairing-why-too-many-codes = Misimbo mingi mno isiyo sahihi.
pk-pairing-why-newer-started = Kuoanisha kwa karibuni zaidi kumeanza.
pk-pairing-why-switched-off = Pocketkey imezimwa.
pk-pairing-why-root = Root haiwezi kuoanisha simu.
pk-pairing-why-service-stopped = Huduma ya Pocketkey imesimama.
pk-pairing-why-service-odd = Huduma ya Pocketkey ilisema kitu kisichotarajiwa.
pk-pairing-why-other = Kuunganisha hakukukamilika.

