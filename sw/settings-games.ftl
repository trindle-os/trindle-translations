# machine translated (Swahili), not yet reviewed by a person.



# The page's name in the side bar.
settings-games-title = Michezo

# Words a search finds the page by.
settings-games-keywords = michezo mchezo kidhibiti games steam proton crackle stutter sound buffer drive library split lock game controller gamepad joystick pad buttons keys change remap swap stick trigger d-pad xbox playstation nintendo

# What the page is for, in the help.
settings-games-help = Mipangilio inayosaidia michezo kuendeshwa vizuri. Steam huweka mipangilio yake yenyewe kwenye Steam. Bonyeza kitufe kwenye kidhibiti nacho kitaenda juu ya orodha, kikiwaka kwenye picha. Kisha bonyeza kitufe cha kibodi ambacho kinapaswa kuwa. Kitufe pia kinaweza kuwa kitufe kingine, au kisiwe chochote, kutoka kwenye orodha yake. Kila kidhibiti huweka mabadiliko yake chenyewe, kwa chapa na modeli yake, na michezo husoma kidhibiti kilichobadilishwa. Escape husimamisha mabadiliko uliyoanzisha.

# The sentence at the top of the page.
settings-games-top = Msaada kwa michezo inayokwaruza, kusuasua au kuhitaji nafasi zaidi.

# Shown beside a switch while the person is asked for the password.
settings-games-waiting = Inasubiri nenosiri...

# The card holding the sound and split-lock switches.
settings-games-smooth = Michezo laini zaidi

# What that card is for.
settings-games-smooth-about = Marekebisho kwa michezo inayokwaruza au kusuasua. Yote mawili yamezimwa mwanzoni.

# The sound switch.
settings-games-sound = Bafa kubwa zaidi ya sauti

# Under the sound switch.
settings-games-sound-sub = Kwa michezo ambayo sauti yake inakwaruza. Sauti hufika kuchelewa kidogo.

# After the sound switch is turned on.
settings-games-sound-done-on = Bafa kubwa imewashwa

# After the sound switch is turned on, when the sound system could not be told at once.
settings-games-sound-next-login = Itawashwa kuanzia kuingia kunakofuata

# After the sound switch is turned off.
settings-games-sound-done-off = Bafa kubwa imezimwa

# The split-lock switch.
settings-games-split = Marekebisho ya kusuasua kwa michezo ya zamani

# Under the split-lock switch.
settings-games-split-sub = Michezo ya zamani husuasua kidogo; programu moja inaweza kupunguza kasi ya zingine.

# After the split-lock switch is turned on.
settings-games-split-done-on = Marekebisho ya kusuasua yamewashwa

# After the split-lock switch is turned off.
settings-games-split-done-off = Marekebisho ya kusuasua yamezimwa

# The games drive card.
settings-games-drive-title = Diski ya michezo

# What that card is for.
settings-games-drive-about = Diski ya pili ya michezo, tayari kila unapowasha.

# A drive with no name of its own.
settings-games-drive-unnamed = Diski

# One drive in the list: its name, size and kind of filesystem.
settings-games-drive-name = { $name }, { $size }, { $fs }

# Under a drive that can be used for games.
settings-games-drive-ready = Tayari kwa michezo

# The button that makes a drive the games drive.
settings-games-drive-use = Tumia kwa michezo

# Under the drive in use for games.
settings-games-drive-in-use = Diski ya michezo, kwenye { $place }

# The button that stops using a drive for games.
settings-games-drive-stop = Acha kutumia kwa michezo

# After a drive is made the games drive.
settings-games-drive-done = Diski ya michezo iko tayari

# After a drive is no longer the games drive.
settings-games-drive-forgotten = Haitumiki tena kwa michezo

# When there is no second drive.
settings-games-drive-none = Hakuna diski ya pili

# Under that.
settings-games-drive-none-sub = Weka au chomeka diski ya pili ili kuhifadhi michezo juu yake.

# When the drives could not be listed.
settings-games-drive-unread = Diski hazikuweza kuorodheshwa

# When Steam could not be let reach the games drive.
settings-games-drive-steam-failed = Steam haikuweza kupewa diski

# How to add the games drive in Steam.
settings-games-drive-steam = Iongeze kwenye Steam

# Under that.
settings-games-drive-steam-sub = Kwenye Steam: Settings, Storage, Add drive.

# Why a Windows-formatted drive cannot be used.
settings-games-drive-windows = Umbizo la Windows: michezo huharibika juu yake. Iumbize kwa Linux.

# Why a locked drive cannot be used.
settings-games-drive-locked = Imefungwa: ifungue kwanza kwenye Diski.

# Why a part that holds no files cannot be used.
settings-games-drive-not-files = Haina faili

# Why an unknown kind of drive cannot be used.
settings-games-drive-unknown = Si umbizo ambalo michezo huendeshwa kutoka kwalo



# The card listing the person's Steam games.
settings-games-steam-title = Michezo ya Steam

# What that card is for.
settings-games-steam-about = Marekebisho kwa michezo mmoja mmoja. Steam lazima iwe imefungwa ili kuyabadilisha.

# Shown, and beside every control, while Steam is open.
settings-games-steam-open = Steam iko wazi

# Under that.
settings-games-steam-open-sub = Funga Steam ili kubadilisha haya.

# Beside a game's controls while the game runs.
settings-games-game-running = Mchezo unaendelea

# Under a game's name.
settings-games-game-sub = Picha zenye nguvu zaidi, Proton ya jamii, kuanza upya. Kuanza upya huhamishia mipangilio ya Windows ya mchezo kwenye Tupio, na michezo iliyohifadhiwa ndani yake huenda pia isipokuwa Steam Cloud ina nakala.

# The switch for a game: use the stronger graphics chip.
settings-games-stronger = Tumia picha zenye nguvu zaidi

# After that switch is turned on.
settings-games-stronger-on = Picha zenye nguvu zaidi zimewashwa

# After that switch is turned off.
settings-games-stronger-off = Picha zenye nguvu zaidi zimezimwa

# The switch for a game: use the community Proton build.
settings-games-proton-one = Tumia Proton ya jamii

# The switch for all games.
settings-games-proton-all = Proton ya jamii kwa michezo yote

# Under that.
settings-games-proton-all-sub = Husakinishwa mara ya kwanza. Kila mchezo unaweza kuchagua.

# While the community Proton build is being installed.
settings-games-proton-installing = Inasakinisha Proton ya jamii...

# After a game or all games are given community Proton.
settings-games-proton-on = Proton ya jamii imechaguliwa

# After the choice is given back to Steam.
settings-games-proton-off = Steam inachagua tena

# When community Proton was not found after installing.
settings-games-proton-missing = Proton ya jamii haikupatikana.

# The button that gives a game a fresh start.
settings-games-fresh = Anza upya

# After a fresh start.
settings-games-fresh-done = Imehamishiwa Tupioni. Steam hutengeneza mpya itakapoanza tena.

# When the game had no Windows setup to move.
settings-games-fresh-none = Hakuna cha kuhamisha

# When no Steam games are installed.
settings-games-none = Hakuna michezo ya Steam iliyopatikana

# Under that.
settings-games-none-sub = Michezo unayosakinisha kwenye Steam huorodheshwa hapa.

