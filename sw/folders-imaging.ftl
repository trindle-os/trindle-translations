
# machine translated (Swahili), not yet reviewed by a person.

# Reason shown when a picture of a kind that cannot be turned is turned.
folders-imaging-no-turn = Folders inaweza kuzungusha picha za JPEG, PNG, WebP na BMP tu

# Reason shown when a picture file could not be read for turning or resizing.
folders-imaging-unreadable = Folders haikuweza kusoma picha

# Reason shown when a resized picture would have to be written in a kind Folders cannot write.
folders-imaging-no-write = Folders haiwezi kuhifadhi aina hii ya picha

# Why a link to a picture is not turned.
folders-imaging-no-turn-link = hiki ni kiungo, kwa hiyo zungusha picha inayolengwa nacho badala yake

# Why a moving picture is not turned.
folders-imaging-no-turn-moving = Folders haizungushi picha zinazosonga, kwa sababu fremu ya kwanza tu ndiyo ingebaki
