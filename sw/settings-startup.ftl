
# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about apps that start at login, in the list and as its heading.
settings-startup-title = Kuanza ukiingia

# Words a person might type into the Settings search to find the start at login page; separate them with spaces.
settings-startup-keywords = autostart startup start login boot anza ingia kiotomatiki washa kuchelewa

# Introduction under the heading of the start at login page, and the words behind the page i.
settings-startup-help = Programu zinazofunguka zenyewe unapoingia. Kuchelewesha huiacha programu isubiri mtandao au programu nyingine kwanza.

# Sentence at the top of the page when no app starts at login.
settings-startup-top-none = Hakuna kinachoanza chenyewe unapoingia.

# Sentence at the top of the page when one app starts at login; { $name } is the app.
settings-startup-top-one = { $name } inaanza yenyewe unapoingia.

# Sentence at the top of the page when several apps start at login; { $n } is how many.
settings-startup-top-many =
    { $n ->
        [one] Programu { $n } inaanza yenyewe unapoingia.
       *[other] Programu { $n } zinaanza zenyewe unapoingia.
    }

# Second sentence at the top of the page, after a space, when apps are kept in the list but switched off; { $n } is how many.
settings-startup-top-off =
    { $n ->
        [one] Nyingine moja imehifadhiwa, imezimwa.
       *[other] Nyingine { $n } zimehifadhiwa, zimezimwa.
    }

# Choice in the delay list: the app starts as soon as someone logs in.
settings-startup-delay-0 = Mara moja

# Choice in the delay list: the app starts a minute after login.
settings-startup-delay-60 = Baada ya dakika moja

# Choice in the delay list: the app starts two minutes after login.
settings-startup-delay-120 = Baada ya dakika 2

# Choice in the delay list; { $n } is the number of seconds to wait after login.
settings-startup-delay-seconds =
    { $n ->
        [one] Baada ya sekunde { $n }
       *[other] Baada ya sekunde { $n }
    }

# Name of the delay list on an app's line; { $name } is the app.
settings-startup-delay-for = Kuchelewesha kwa { $name }

# Name of the switch on an app's line that keeps it from starting at login without removing it.
settings-startup-switch = Ianze ukiingia

# Name of the bin button on an app's line that stops it starting at login.
settings-startup-stop = Acha kuianzisha ukiingia

# Red words under an app's line when it could not be taken off the list.
settings-startup-not-removed = Haikuweza kuondolewa, kwa hiyo bado inaanza ukiingia.

# Red words under the add card when something could not be added.
settings-startup-not-added = Haikuweza kuongezwa.

# Placeholder of the search box above the list of installed apps.
settings-startup-find = Tafuta programu

# Name of the plus button that adds an app or a command to what starts at login.
settings-startup-add-this = Anzisha hii ukiingia

# Red words under an app in the add list when it was removed from the computer meanwhile.
settings-startup-gone = Haikuweza kuongezwa: programu haipo tena kwenye kompyuta.

# Placeholder of the box for typing a command; the example is a command, not translated words.
settings-startup-command-example = k.m. syncthing --no-browser

# Name of the button that opens a window to choose a program on the disk.
settings-startup-browse = Chagua programu kwenye diski

# Heading of the line for adding a command.
settings-startup-command = Amri

# Small words under the command line.
settings-startup-command-about = Kama inavyoandikwa kwenye Terminal, au programu iliyo kwenye diski.

# Red words under the command line when nothing was typed.
settings-startup-command-empty = Andika amri, au chagua programu.

# Title of the window for choosing a program to start at login.
settings-startup-chooser-title = Chagua programu ya kuanza ukiingia

# Heading of the line shown in the list when nothing starts at login.
settings-startup-none-title = Hakuna kinachoanza chenyewe

# Small words under that line.
settings-startup-none-about = Ongeza programu kando ya hapa.

# Title of the card listing what starts at login.
settings-startup-list-title = Inaanza ukiingia

# Words behind the i of the card listing what starts at login.
settings-startup-about = Kila programu inaweza kusubiri kidogo baada ya kuingia, ili mtandao au programu nyingine iwe tayari kwanza. Swichi yake inaiweka hapa bila kuianzisha; pipa linaizuia kabisa isianze ukiingia.

# Added to the words behind the i, after a space, for an app whose command is too long for its line; { $name } is the app and { $command } its command.
settings-startup-runs = { $name } inaendesha: { $command }

# Name of the button that opens the list of installed apps.
settings-startup-open-apps = Chagua kutoka kwenye programu zilizowekwa

# Name of the button that opens the box for typing a command.
settings-startup-open-command = Andika amri, au chagua programu

# Heading of the line for adding an installed app.
settings-startup-app-heading = Programu iliyowekwa

# Small words under that line.
settings-startup-app-about = Chagua moja kutoka kwenye orodha ya programu.

# Heading of the line for adding a command or a program.
settings-startup-cmd-heading = Amri au programu

# Small words under that line.
settings-startup-cmd-about = Imeandikwa, au imechaguliwa kutoka kwenye diski.

# Words behind the i of the Add an app card.
settings-startup-add-about = Chagua kutoka kwenye programu zilizowekwa, au toa amri ya kuendesha, kama ungeiandika kwenye Terminal, au programu iliyochaguliwa kutoka kwenye diski. Inaanza ukiingia mara ijayo, mara moja; muda wa kusubiri unaweza kuchaguliwa mara itakapokuwa kwenye orodha.

# Title of the card for adding an app.
settings-startup-add-title = Ongeza programu
