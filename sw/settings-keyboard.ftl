# machine translated (Swahili), not yet reviewed by a person.

# Name of the Settings page about the keyboard and mouse, in the list and as its heading.
settings-keyboard-title = Kibodi na kipanya

# Words a person might type into the Settings search to find the keyboard page; separate them with spaces.
settings-keyboard-keywords = mpangilio lugha kuandika caps lock kibodi-ya-skrini kitufe pete kipanya touchpad trackpad kielekezi kasi gusa bofya sogeza gurudumu polepole haraka asilia mkono-wa-kushoto programu-jalizi njia-ya-mkato funguo badilisha pindua ctrl escape super alt mac vitufe-vya-pembeni keyd layout language typing on-screen keyboard button ring mouse pointer speed tap click scroll wheel slower faster natural left handed plugin shortcut keys remap change swap side buttons tapped held made by programs

# Introduction under the heading of the keyboard page, and the words behind the page i.
settings-keyboard-help = Kila kitu hapa kinabadilika mara moja. Mpangilio wa pili hubadilishwa kwa Alt na Shift kwa pamoja.

# First sentence at the top of the page; { $layout } is the name of the layout in use.
settings-keyboard-top-typing = Inaandika kwa { $layout }.

# Sentence after it when a second layout is set; { $layout } is the second layout.
settings-keyboard-top-second = Alt na Shift hubadilisha kwenda { $layout }.

# Sentence after it when Caps Lock is set to do nothing.
settings-keyboard-top-caps-nothing = Caps Lock haifanyi chochote.

# Sentence after it when Caps Lock is set to act as another key; { $key } is that key, such as Escape.
settings-keyboard-top-caps-acts = Caps Lock inafanya kazi kama { $key }.

# The key Caps Lock acts as, in the middle of a sentence: a second Ctrl key.
settings-keyboard-caps-as-ctrl = Ctrl nyingine

# The key Caps Lock acts as, in the middle of a sentence.
settings-keyboard-caps-as-escape = Escape

# The key Caps Lock acts as, in the middle of a sentence.
settings-keyboard-caps-as-backspace = Backspace

# Sentence at the top of the page when the list of keyboard layouts is missing.
settings-keyboard-no-list = Orodha ya mipangilio ya kibodi haipo kwenye kompyuta hii.

# Title of the card shown when the list of keyboard layouts is missing.
settings-keyboard-no-list-title = Kibodi

# Heading of the line in that card.
settings-keyboard-no-list-heading = Orodha ya mipangilio ya kibodi haipatikani

# Small words under that line, telling what to install; the command is typed as it is.
settings-keyboard-no-list-about = Isakinishe kwa: sudo apt install xkb-data

# Sentence at the end of the top words when keys or buttons have been changed; { $n } is how many.
settings-keyboard-top-changed =
    { $n ->
        [one] Kitufe kimoja kimebadilishwa.
       *[other] Funguo na vitufe { $n } vimebadilishwa.
    }

# Title of the card with the keyboard layout.
settings-keyboard-layout-title = Mpangilio

# Heading of the layout line, and the name of its list.
settings-keyboard-layout = Mpangilio

# Heading of the variant line, and the name of its list.
settings-keyboard-variant = Aina

# First choice in the list of variants: the layout without a variant.
settings-keyboard-standard = Kawaida

# First choice in the list of second layouts: no second layout.
settings-keyboard-none = Hakuna

# Heading of the line, and the name of its list, for a second layout.
settings-keyboard-switch-to = Badilisha kwenda

# Small words under the second layout line.
settings-keyboard-switch-to-about = Alt na Shift kwa pamoja hubadilisha kati ya hivi viwili.

# Words behind the i of the layout card.
settings-keyboard-layout-about = Kile ambacho kila kitufe kinaandika: mpangilio, na aina yake kama ile isiyo na funguo zilizokufa. Mpangilio wa pili hubadilishwa kwa Alt na Shift kwa pamoja, na kurudishwa kwa njia hiyo hiyo. Yote hubadilika mara moja.

# Green words under a layout line once the new layout is in use.
settings-keyboard-in-use = Inatumika sasa

# Choice in the Caps Lock list: Caps Lock does its own job.
settings-keyboard-caps-key = Caps Lock

# Choice in the Caps Lock list: it acts as a second Ctrl key.
settings-keyboard-caps-ctrl = Ctrl nyingine

# Choice in the Caps Lock list: it acts as Escape.
settings-keyboard-caps-escape = Escape

# Choice in the Caps Lock list: it acts as Backspace.
settings-keyboard-caps-backspace = Backspace

# Choice in the Caps Lock list: it does nothing.
settings-keyboard-caps-nothing = Hakuna

# Heading of the line, and the name of its list, for what Caps Lock acts as.
settings-keyboard-caps-acts-as = Kitufe cha Caps Lock kinafanya kazi kama

# Small words under that line.
settings-keyboard-caps-acts-as-about = Ctrl nyingine, Escape na kadhalika.

# Heading of the line, and name of its switch, for the keyboard button in the ring.
settings-keyboard-ring-button = Kitufe cha kibodi kwenye pete

# Small words under that line.
settings-keyboard-ring-button-about = Kinaleta kibodi kwenye skrini.

# Title of the card with Caps Lock and the ring keyboard button.
settings-keyboard-other-title = Funguo nyingine

# Words behind the i of that card.
settings-keyboard-other-about = Caps Lock inaweza kufanya kazi kama kitufe kingine badala yake, kama Ctrl nyingine au Escape. Kitufe cha kibodi ni kibodi katikati ya pete inayoleta kibodi kwenye skrini, kwa kuandika kwa kipanya au skrini ya kugusa. Kinaonekana pete itakapofunguka mara ijayo.

# Words under a line when a press that was not the person's own changed nothing.
# SAFETY: needs a human review before it ships
settings-keyboard-only-yours = Ni mbonyezo wako mwenyewe tu unaoweza kubadilisha hili.

# Words under the change a key line while it waits for a key or mouse button to be pressed.
settings-keyboard-press-now = Bonyeza kitufe au kitufe cha kipanya cha kubadilisha.

# Words under the change a key line when nothing was pressed in time.
settings-keyboard-nothing-pressed = Hakuna kilichobonyezwa, kwa hiyo hakuna kilichoongezwa.

# Words under a changed key's line asking for what it becomes; the examples are names a person types.
settings-keyboard-type-it = Andika kinachokuwa, kama Escape, Ctrl+C au Nothing.

# Words under the change a key line when the press could not be told apart from another.
settings-keyboard-not-told = Mbonyezo huo haukuweza kutofautishwa. Chagua kitufe kutoka kwenye orodha badala yake.

# Choice in the list of keyboards and mice: the change applies on every one.
settings-keyboard-every-device = Kila kibodi na kipanya

# Small words under a ready-made swap that the person's own change overrides.
settings-keyboard-swap-over = Imebadilishwa pia hapa chini; badiliko hilo ndilo linalotumika.

# Name of the list of keyboards for one changed key; { $key } is the key.
settings-keyboard-which-device = Kibodi au kipanya ambacho { $key } imebadilishwa

# Name of the box for what a changed key becomes; { $key } is the key.
settings-keyboard-becomes = { $key } inakuwa nini

# Name of the bin button that takes a change away.
settings-keyboard-take-away = Ondoa badiliko hili

# Small words under a changed key's line when it changes on every keyboard and mouse.
settings-keyboard-every-device-about = Kwenye kila kibodi na kipanya.

# Small words under a line of a file that was not understood; { $n } is its number and { $why } the reason.
settings-keyboard-line-unused = Mstari { $n } hautumiki: { $why }

# Heading of the line shown when the file of changed keys could not be read.
settings-keyboard-keys-unread = Funguo zilizobadilishwa hazikuweza kusomwa

# Small words under that line; { $why } is the reason.
settings-keyboard-keys-unread-about = Kila kitufe kiko kama kilivyochapishwa hadi ziweze kusomwa: { $why }.

# Name of the list from which a key or button to change is chosen.
settings-keyboard-keys-list = Chagua kitufe cha kubadilisha

# Name of the button that waits for a key or button to be pressed.
settings-keyboard-keys-press = Bonyeza kitufe cha kubadilisha

# Small words under the change a key line.
settings-keyboard-keys-add-about = Kibonyeze, au kichague kutoka kwenye orodha.

# Heading of the line for changing a key or button.
settings-keyboard-keys-add = Badilisha kitufe

# Words under the change a key line when the key chosen is already changed; { $key } is the key.
settings-keyboard-already = { $key } tayari imebadilishwa, hapa chini.

# Title of the card with changed keys and buttons.
settings-keyboard-keys-title = Funguo na vitufe

# Words behind the i of the keys and buttons card; the examples are names a person types.
settings-keyboard-keys-about = Kitufe chochote au kitufe cha kipanya kinaweza kufanya kitu kingine: kitufe kingine, funguo zilizoshikiliwa pamoja kama Ctrl+C, mfuatano wa funguo kama H, I, hakuna kabisa, au kitu kimoja kikibonyezwa na kingine kikishikiliwa, kama Escape ikibonyezwa, Ctrl ikishikiliwa. Inafanya kazi kila mahali kuanzia skrini ya kuingia. Ctrl, Alt na kitufe cha F daima hufikia kiweko cha maandishi, na trindle-settings --keys default ikiandikwa huko hurudisha kila kitufe.

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-ctrl-caps = Badilishana Ctrl na Caps Lock

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-caps-tap = Caps Lock ni Escape ikibonyezwa, Ctrl ikishikiliwa

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-esc-caps = Badilishana Escape na Caps Lock

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-alt-super = Badilishana Alt na Super, kama kwenye kibodi ya Mac

# Name of a ready-made swap of keys, as the heading and switch name of its line.
settings-keyboard-swap-side-copy = Vitufe vya pembeni vya kipanya vinanakili na kubandika

# Small words under a keyboard or mouse a program made, when it counts as the person.
# SAFETY: needs a human review before it ships
settings-keyboard-made-yes = Inahesabiwa kama wewe, kama kibodi iliyochomekwa.

# Small words under a keyboard or mouse a program made, when it does not count as the person.
# SAFETY: needs a human review before it ships
settings-keyboard-made-no = Inaandika na kucheza. Haiwezi kubonyeza vitufe vilivyolindwa.

# Name of the switch that lets a program's keyboard or mouse count as the person; { $name } is its name.
# SAFETY: needs a human review before it ships
settings-keyboard-made-switch = { $name } inahesabiwa kama wewe

# Heading of the line shown when no program has made a keyboard or mouse.
settings-keyboard-made-none = Hakuna hadi sasa

# Small words under that line.
settings-keyboard-made-none-about = Moja inayotengenezwa na programu itaonekana hapa, ili uiruhusu ihesabiwe kama wewe.

# Title of the card about keyboards and mice made by programs.
settings-keyboard-made-title = Kibodi na vipanya vilivyotengenezwa na programu

# Words behind the i of that card.
# SAFETY: needs a human review before it ships
settings-keyboard-made-about = Zana za kubadilisha funguo na vizindua michezo vinaweza kutengeneza kibodi au kipanya chao wenyewe. Funguo na mibofyo yao bado huandika na kucheza, lakini haziwezi kubonyeza vitufe vilivyolindwa, kama Zima au Ruhusu, wala kuandika kwenye swali lililokusudiwa wewe. Washa moja hapa ili iruhusiwe kuhesabiwa kama wewe.

# Name of a game controller that has no name; { $vendor } and { $product } are numbers that identify it.
settings-keyboard-pad-unnamed = Kidhibiti { $vendor }:{ $product }

# Name of the switch for a controller's swap; { $name } is the swap and { $title } the controller.
settings-keyboard-pad-swap-switch = { $name } kwenye { $title }

# Name of the box for what a controller's button does; { $title } is the controller.
settings-keyboard-pad-does = { $title } inafanya nini

# Small words under a controller's changed button; the words Button and what it becomes stand for the two sides of the line typed.
settings-keyboard-pad-type = Iandike kama Kitufe = kinachokuwa.

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-a-b = Badilishana A na B

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-x-y = Badilishana X na Y

# Name of a ready-made swap of a game controller's buttons.
settings-keyboard-pad-swap-stick = Geuza juu na chini ya fimbo ya kulia

# Title of the card with the shortcuts plugins ask for.
settings-keyboard-plugin-title = Njia za mkato za programu-jalizi

# Small words under a plugin shortcut that is not in use; { $plugin } is the plugin and { $why } the reason.
settings-keyboard-plugin-refused = { $plugin }. Haitumiki: { $why }

# Small words under a plugin shortcut; { $plugin } is the plugin. The example is keys a person types.
settings-keyboard-plugin-about = { $plugin }. Andika funguo, kama Ctrl+Alt+S, au chochote kwa kutokuwa na yoyote.

# Name of the box for a plugin shortcut's keys; { $label } is the shortcut.
settings-keyboard-plugin-keys-name = Funguo za { $label }

# Said in green under a plugin shortcut after the keys were kept.
settings-keyboard-plugin-saved = Imehifadhiwa

# Small words under the pointer speed slider when there is a touchpad.
settings-keyboard-both = Touchpad pia.

# Title of the mouse card.
settings-keyboard-mouse-title = Kipanya

# Words behind the i of the mouse card.
settings-keyboard-mouse-about = Kasi ya kielekezi ni umbali ambao kielekezi kinaenda kwa mwendo wa kipanya, na wa touchpad pia. Kasi ya kusogeza ni umbali ambao ukurasa unasogea kwa kila zamu ya gurudumu: Polepole, Kawaida au Haraka, au mahali popote kwenye kitelezi. Kwa kusogeza asilia ukurasa unasogea kama gurudumu linavyozunguka, kama kwenye simu. Mkono wa kushoto hubadilishana vitufe vya kushoto na kulia.

# Heading and slider name for the pointer speed.
settings-keyboard-pointer-speed = Kasi ya kielekezi

# Heading and slider name for the scroll speed of the wheel or the touchpad.
settings-keyboard-scroll-speed = Kasi ya kusogeza

# Small words under the wheel's scroll speed.
settings-keyboard-scroll-wheel-about = Umbali ambao ukurasa unasogea kwa kila zamu ya gurudumu.

# Heading of the natural scrolling switch (the page follows the wheel or fingers).
settings-keyboard-natural = Kusogeza asilia

# Small words under natural scrolling for the mouse wheel.
settings-keyboard-natural-wheel-about = Ukurasa unafuata gurudumu, kama kwenye simu.

# Heading of the switch that swaps the left and right mouse buttons.
settings-keyboard-left-handed = Mkono wa kushoto

# Small words under that switch.
settings-keyboard-left-handed-about = Hubadilishana vitufe vya kushoto na kulia.

# Heading and switch name for the clicking helper.
settings-keyboard-clicker = Msaidizi wa kubofya

# Small words under the clicking helper line.
settings-keyboard-clicker-about = Mibofyo ya kibofyaji cha kusubiri au swichi inahesabiwa kama yako.

# Title of the touchpad card.
settings-keyboard-touchpad-title = Touchpad

# Words behind the i of the touchpad card.
settings-keyboard-touchpad-about = Kasi ya kusogeza ni umbali ambao ukurasa unasogea kwa vidole viwili. Gusa ili kubofya hufanya mguso mwepesi uhesabiwe kama kubofya. Kwa kusogeza asilia ukurasa unasogea kama vidole vyako vinavyoenda, kama kwenye simu. Kuzima wakati wa kuandika huzuia kiganja kinachogusa touchpad kisisogeze kielekezi unapoandika.

# Small words under the touchpad's scroll speed.
settings-keyboard-scroll-touchpad-about = Umbali ambao ukurasa unasogea kwa vidole viwili.

# Heading of the switch that makes a light tap count as a click.
settings-keyboard-tap = Gusa ili kubofya

# Small words under that switch.
settings-keyboard-tap-about = Mguso mwepesi unahesabiwa kama kubofya.

# Small words under natural scrolling for the touchpad.
settings-keyboard-natural-touchpad-about = Ukurasa unafuata vidole vyako, kama kwenye simu.

# Heading of the switch that stops the touchpad moving the pointer while typing.
settings-keyboard-quiet = Imezimwa wakati wa kuandika

# Small words under that switch.
settings-keyboard-quiet-about = Kiganja kinachogusa kinaacha kielekezi kimetulia.

# Choice above a scroll speed slider: slower than normal.
settings-keyboard-pace-slower = Polepole

# Choice above a scroll speed slider: the normal speed.
settings-keyboard-pace-normal = Kawaida

# Choice above a scroll speed slider: faster than normal.
settings-keyboard-pace-faster = Haraka

# Title of the card about USB ports that were switched off and on.
settings-keyboard-usb-title = Milango ya USB

# Words behind the i of that card.
settings-keyboard-usb-about = Mlango wa USB ukishindwa kuanza, Trindle huuzima kisha kuuwasha mara moja kujaribu tena, na kamwe zaidi ya mara moja kwa kila mlango.

# Red words under the keyboard button switch when it could not be kept and its mark could not be taken away again; { $error } is the first problem and { $undo } the second.
settings-keyboard-button-and-mark = { $error }; na alama yake haikuweza kuondolewa tena: { $undo }



# Title of the card with the keys that take a screenshot and show the shortcut list.
settings-keyboard-shortcuts-title = Picha ya skrini na orodha ya njia za mkato

# Name of the shortcut and its line that starts the screenshot.
settings-keyboard-shortcuts-screenshot = Piga picha ya skrini

# Name of the shortcut and its line that shows every shortcut in a list.
settings-keyboard-shortcuts-list = Onyesha orodha ya njia za mkato

# Small words under each of the two shortcuts.
settings-keyboard-shortcuts-about = Andika funguo, au hakuna kama hutaki.

# Tip of the round button that starts the screenshot now.
settings-keyboard-shortcuts-screenshot-tip = Piga picha ya skrini sasa

# Tip of the round button that shows the shortcut list now.
settings-keyboard-shortcuts-list-tip = Onyesha orodha sasa

# Title of the card with the two shortcuts that restart the desktop.
settings-keyboard-restart-title = Anzisha upya eneo-kazi

# Name of the shortcut and its line that restarts the ring and the helper parts only.
settings-keyboard-restart-parts = Anzisha upya pete na sehemu saidizi

# Name of the shortcut and its line that restarts everything, the compositor too.
settings-keyboard-restart-all = Anzisha upya kila kitu

# Small words under each of the two restart shortcuts. The example is keys a person types.
settings-keyboard-restart-about = Andika funguo, kama Ctrl+Alt+Escape, au hakuna kama hutaki.

# Name of the box for a restart shortcut's keys; { $label } is the shortcut.
settings-keyboard-restart-keys-name = Funguo za { $label }

# Tip of the round button that restarts the ring and the helper parts now; open windows are left as they are.
settings-keyboard-restart-parts-tip = Anzisha upya sasa. Madirisha yaliyo wazi yanaachwa kama yalivyo.

# Tip of the round button that asks whether to restart everything now.
settings-keyboard-restart-all-tip = Anzisha upya kila kitu. Huuliza kwanza.

# Said under the line after the parts were restarted.
settings-keyboard-restart-parts-done = Imeanzishwa upya

# Said in red under a restart shortcut whose keys another shortcut has; { $keys } is the keys.
settings-keyboard-restart-clash = { $keys } tayari inatumiwa na njia nyingine ya mkato.

# Said in red under a restart shortcut that could not be kept; { $why } is the reason.
settings-keyboard-restart-not-saved = Haijahifadhiwa: { $why }

