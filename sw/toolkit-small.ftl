# machine translated (Swahili), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Ondoa { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, nyota { $value } kati ya { $max }

# The names of the three boxes of a duration entry.
kit-duration-hours = Saa

kit-duration-minutes = Dakika

kit-duration-seconds = Sekunde

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Hatua { $n } kati ya { $count }

kit-step-back = Rudi

kit-step-next = Endelea

kit-step-finish = Maliza

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Tafuta

kit-find-previous = Linalolingana lililotangulia

kit-find-next = Linalolingana linalofuata

kit-find-none = Hakuna vinavyolingana

kit-find-count = { $at } kati ya { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Mtu mmoja zaidi
       *[other] Watu { $n } zaidi
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Gradienti yenye vituo { $n }

kit-gradient-place = Nafasi ya kituo kilichochaguliwa

kit-gradient-add = Ongeza kituo

kit-gradient-remove = Ondoa kituo

# The "i" button that shows and hides a card's help.
kit-help-show = Onyesha msaada

kit-help-hide = Ficha msaada

