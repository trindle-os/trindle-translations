# machine translated (French), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Anneau

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = favoris lanceur bord clic coin actif voix parole fenêtres ouvertes presse-papiers copier coller historique oublier notifications

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Vos favoris se placent autour du centre de l'anneau. Ils se choisissent sur l'anneau lui-même : faites un clic droit sur une application dans l'anneau pour l'ajouter ou la retirer, et faites glisser un favori à la place d'un autre pour changer l'ordre.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = L'anneau s'ouvre au bord de l'écran, et vos fenêtres ouvertes s'y placent.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Où les choses s'ouvrent

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Cliquer au bord de l'écran

# Small words under that line about the Super key.
settings-ring-open-super = La touche Super l'ouvre aussi.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } favori
        [many] { $n } de favoris
       *[other] { $n } favoris
    }

# Small words under the favourites line.
settings-ring-favourites-about = Faites un clic droit sur une application dans l'anneau pour en ajouter une.

# Title of the card about opening the ring.
settings-ring-opening = Ouverture de l'anneau

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = Déplacez le pointeur au bord de l'écran et cliquez, ou appuyez sur la touche Super, et l'anneau s'ouvre. Vos favoris se placent autour du centre de l'anneau, et vos fenêtres ouvertes dans un anneau autour : cliquez sur l'une pour la mettre au premier plan, ou faites un clic droit dessus pour ses boutons. Faites un clic droit sur une application dans l'anneau pour l'ajouter ou la retirer.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Les afficher à leur arrivée

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Désactivé : elles se rassemblent quand même dans l'anneau.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Combien de temps elles restent

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Les urgentes attendent d'être fermées.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Où elles apparaissent

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Le coin d'où elles s'empilent.

# Title of the card about notifications.
settings-ring-notify-title = Notifications

# Words behind the i of the card about notifications.
settings-ring-notify-about = Quand un programme a quelque chose à vous dire, cela apparaît quelques secondes puis disparaît. Désactivé, rien n'apparaît, et tout est quand même rassemblé dans le cercle des notifications de l'anneau. Une notification urgente attend d'être fermée quel que soit le choix fait ici, pour qu'un avertissement ne puisse pas disparaître avant d'avoir été lu.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
# SAFETY: needs a human review before it ships
settings-ring-clip-forget = Oublier ce qui a été copié

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Les lignes épinglées sont conservées.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Copié maintenant

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n } ligne, { $pinned } épinglée(s).
        [many] { $n } de lignes, { $pinned } épinglée(s).
       *[other] { $n } lignes, { $pinned } épinglée(s).
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Presse-papiers

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Le cercle du presse-papiers dans l'anneau garde ce que vous copiez, pour que vous puissiez coller quelque chose de plus tôt. Les lignes épinglées sont toujours conservées, quel que soit le choix fait ici.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Ajout de la voix ; continuez en attendant.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Retrait des outils de construction.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Retrait de la voix.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Commande vocale

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = Activée

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Désactivée

# Small words under the voice switch.
settings-ring-voice-about = Comprise sur cet ordinateur uniquement.

# Heading of the line, and the name of its button, that removes voice.
# SAFETY: needs a human review before it ships
settings-ring-voice-remove = Retirer la voix

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Libère environ 150 Mo.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Voix prête. Outils de construction conservés.

# Name of the button that removes the build tools voice left behind.
# SAFETY: needs a human review before it ships
settings-ring-voice-tools-remove = Retirer les outils de construction

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Ajouter la commande vocale (environ 150 Mo)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = Facultatif ; environ 150 Mo à ajouter.

# Title of the card about voice.
settings-ring-voice-title = Voix

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Dites le nom d'une application, « plus fort » ou « réglages Wi-Fi » au lieu de cliquer. Touchez le centre de l'anneau et parlez ; il cesse d'écouter quand vous vous arrêtez. La parole est comprise sur cet ordinateur et rien n'est envoyé nulle part. L'ajouter prend environ 150 Mo et quelques minutes, et vous pouvez continuer en attendant ; le retirer supprime le moteur de parole et son modèle.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Ajout de la voix

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Retrait des outils de construction

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Retrait de la voix

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = À chaque redémarrage de l'ordinateur

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Après un jour

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Après une semaine

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = Après deux semaines

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Jamais

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = Afficher le titre au survol

# Small words under that switch.
settings-ring-names-about = Désactivé : seulement l'aperçu. Les lecteurs d'écran reçoivent quand même le titre.
