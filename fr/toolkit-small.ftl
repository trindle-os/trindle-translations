# machine translated (French), not yet reviewed by a person.


# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = Retirer { $name }

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $value } étoiles sur { $max }

# The names of the three boxes of a duration entry.
kit-duration-hours = Heures

kit-duration-minutes = Minutes

kit-duration-seconds = Secondes

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Étape { $n } sur { $count }

kit-step-back = Retour

kit-step-next = Suivant

kit-step-finish = Terminer

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Rechercher

kit-find-previous = Résultat précédent

kit-find-next = Résultat suivant

kit-find-none = Aucun résultat

kit-find-count = { $at } sur { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Une personne de plus
       *[other] { $n } personnes de plus
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = Dégradé de { $n } points

kit-gradient-place = Position du point sélectionné

kit-gradient-add = Ajouter un point

kit-gradient-remove = Retirer le point

# The "i" button that shows and hides a card's help.
kit-help-show = Afficher l’aide

kit-help-hide = Masquer l’aide

