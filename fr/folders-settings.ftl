
# machine translated (French), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Réglages de Dossiers

# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Il n’a pas pu être enregistré.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Il n’a pas pu être enregistré. Rien n’a été modifié, car { $why }.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Les réglages de Dossiers n’ont pas pu être lus, donc les réponses habituelles sont affichées, et rien ici ne peut être modifié tant qu’ils ne peuvent pas l’être : { $why }.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Les disques sont ouverts par l’anneau de Trindle, qui n’est pas sur cet ordinateur.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = À l’ouverture de Dossiers

# Choice on the settings card: the part about the list.
folders-settings-page-list = La liste

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Disques

# SAFETY: needs a human review before it ships
# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Connexions mémorisées

# SAFETY: needs a human review before it ships
# Note on the Kept logins part of the settings card.
folders-settings-logins-about = Une connexion que vous avez choisi de mémoriser n’est envoyée qu’à une adresse où vous l’avez utilisée ces 90 derniers jours. Oublier en retire une.

# SAFETY: needs a human review before it ships
# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = Aucune connexion n’est mémorisée.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Interrogation du trousseau…

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Dossier personnel et Récents

# One line under that choice.
folders-settings-start-usual-sub = Dossier personnel à gauche, Récents à droite.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Là où chaque panneau a été laissé

# One line under that choice.
folders-settings-start-last-sub = Chaque panneau s’ouvre dans le dossier où il était.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Emplacements choisis ici

# One line under that choice.
folders-settings-start-chosen-sub = Vous choisissez un emplacement pour chaque panneau ci-dessous.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Récents

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Dossier personnel

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Documents

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = Téléchargements

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Images

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Corbeille

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Panneau de gauche

# One line under the left pane setting.
folders-settings-left-pane-sub = Où le panneau de gauche démarre.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Panneau de droite

# One line under the right pane setting.
folders-settings-right-pane-sub = Où le panneau de droite démarre.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Choisir où le panneau démarre

# Button of that folder chooser that accepts the folder.
