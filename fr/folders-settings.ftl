# SAFETY: needs a human review before it ships
# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = { $server } n’a pas pu être oublié : { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Choisir un autre dossier

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Dossiers s’ouvre avec { $left } à gauche et { $right } à droite.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Dossiers ouvre chaque panneau là où il a été laissé.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Dossiers s’ouvre avec le dossier personnel à gauche et Récents à droite.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Partie des réglages de Dossiers

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Dossiers lit ceci à chaque ouverture. Il s’ouvre avec un seul panneau affichant l’emplacement de gauche ; le commutateur Simple et Double de sa barre d’outils affiche les deux.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Espacement des lignes

# Name of the setting for how close the rows sit.
folders-settings-density = Lignes

# One line under the rows setting.
folders-settings-density-sub = L’espacement des éléments, dans toutes les vues.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Cases à cocher pour choisir

# One line under the tick boxes setting.
folders-settings-ticks-sub = Une petite case sur chaque élément l’ajoute à la sélection.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Afficher les extensions de fichier

# One line under the file endings setting.
folders-settings-endings-sub = Désactivé, report.pdf est affiché comme report.

# Note under the settings of the list part.
folders-settings-list-note = Avec les extensions désactivées, la dernière extension d’un nom est omise, sauf si cela prêterait à confusion : un nom à deux extensions, un programme, ou un fichier qui n’est pas ce que son extension indique. Avec les cases à cocher, la case de l’en-tête Nom sélectionne tout ou rien.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# SAFETY: needs a human review before it ships
# Tip of the red button that lets a kept login go; { $server } is the computer.
folders-settings-forget = Oublier { $server }

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Ouvrir les disques au branchement

# One line under the drives setting.
folders-settings-drives-sub = Un disque USB est ouvert lorsqu’il est branché.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Dans les deux cas il est dans la barre latérale, et l’anneau indique qu’il est là.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Partages

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
folders-settings-reconnect = Reconnecter les partages à l'ouverture de ma session

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Désactivé tant que vous ne le choisissez pas : monter un partage demande chaque fois le mot de passe de l'administrateur, et un partage qui exige une connexion attend que vous appuyiez sur Reconnecter.
