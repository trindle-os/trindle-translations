# machine translated (French), not yet reviewed by a person.


# The page's name in the side bar.
settings-pads-title = Manettes de jeu

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = Appuyez sur un bouton de la manette pour le modifier.

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = Appuyez maintenant sur la touche pour { $name }.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = Aucune branchée

# Small words under that line.
settings-pads-none-about = Branchez-en une et ses boutons s'affichent ici.

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = Quelle manette

# What the picture is, for the screen reader.
settings-pads-picture = Image de { $title }, chaque bouton s'allumant quand on appuie dessus

# Title of the card of the controller's buttons.
settings-pads-buttons-title = Boutons

# Words behind the i of that card.
settings-pads-buttons-about = Chaque bouton, gâchette et direction des sticks et de la croix directionnelle. Celui sur lequel vous avez appuyé en dernier est en haut. Un bouton changé en touche tape cette touche dans un jeu sans prise en charge des manettes.

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = Changer { $name } en touche

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = Arrêter de changer { $name }

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = Ce que devient { $name }

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = Appuyez sur une touche ou choisissez un bouton

# The next choice in that list: the Escape key.
settings-pads-escape = Touche Échap

# The next choice in that list: nothing at all.
settings-pads-nothing = Rien

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = Croix directionnelle : { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = Stick { $stick } : { $way }

settings-pads-left = gauche

settings-pads-right = droite

settings-pads-up = haut

settings-pads-down = bas

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = Gauche

settings-pads-stick-right = Droit

# Title of the card of the ready-made changes.
settings-pads-quick-title = Changements prêts à l'emploi

# Title of the card of changes that are not one button into another.
settings-pads-other-title = Autres changements

# Words behind the i of that card.
settings-pads-other-about = Sticks inversés, sticks échangés et zones mortes. Saisissez-en un sous la forme Left Stick dead zone = 10%, ou Right Stick Y = inverted.



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = Clavier : { $what }

settings-pads-on-mouse = Souris : { $what }

settings-pads-on-pad = Manette : { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = Clic gauche

settings-pads-right-click = Clic droit

settings-pads-middle-click = Clic central



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = Profils

# Words behind the i of that card.
settings-pads-profiles-about = Un profil est un ensemble de modifications. Standard ne modifie rien, si bien qu'un jeu qui gère lui-même les manettes voit la manette telle quelle. Chaque jeu Steam utilise Standard sauf si vous lui choisissez un profil ici, et le profil change tout seul au lancement de ce jeu. Tout autre jeu concerne les jeux que Steam n'a pas lancés.

# The one switch that turns every controller change off at once.
settings-pads-changes = Modifications de la manette

settings-pads-changes-sub = Désactivé : chaque manette reste telle quelle.

# The game whose profile is shown.
settings-pads-game = Jeu

settings-pads-other-game = Tout autre jeu

settings-pads-game-running = { $name } (en cours)

settings-pads-game-number = Jeu Steam { $n }

# The profile the shown game uses.
settings-pads-profile = Profil

settings-pads-standard = Standard

settings-pads-standard-sub = Aucune modification.

settings-pads-profile-add = Ajouter un profil

settings-pads-profile-remove = Supprimer { $name }

settings-pads-profile-name = Nom du profil

# The name a new profile is given.
settings-pads-profile-new = Profil { $n }

settings-pads-profile-empty = Un profil a besoin d'un nom.

settings-pads-profile-standard = Standard est déjà pris.

settings-pads-profile-taken = Ce nom est déjà pris.

settings-pads-profile-gone = Ce profil n'existe plus.

settings-pads-not-a-game = Ce n'est pas un numéro d'application Steam.

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = Standard ne modifie rien. Ajoutez d'abord un profil.

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = Standard : la manette telle quelle.

settings-pads-top-off = Les modifications de la manette sont désactivées.

