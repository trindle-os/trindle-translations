
# machine translated (French), not yet reviewed by a person.

# Reason given when a file to read or change is a link, not the file itself.
folders-meta-link = c’est un lien, pas un fichier

# Reason given when a photo's notes cannot be read; the cause follows, already written out.
folders-meta-damaged = les détails d’appareil photo de la photo sont endommagés, car { $why }

# Cause of damaged photo notes: a block points outside the notes.
folders-meta-bad-out-of-reach = une partie pointe en dehors des détails

# Cause of damaged photo notes: a block goes beyond the end.
folders-meta-bad-block-past-end = une partie dépasse leur fin

# Cause of damaged photo notes: the notes have no TIFF header.
folders-meta-bad-no-tiff = leur en-tête TIFF est absent

# Cause of damaged photo notes: the notes are much too large.
folders-meta-bad-too-big = ils sont beaucoup trop gros

# Cause of damaged photo notes: the parts of a JPEG photo do not line up.
folders-meta-bad-jpeg-parts = les parties du JPEG ne s’emboîtent pas

# Cause of damaged photo notes: a part of a JPEG photo goes beyond the end.
folders-meta-bad-jpeg-past-end = une partie du JPEG dépasse la fin du fichier

# Cause of damaged photo notes: a part of a PNG photo goes beyond the end.
folders-meta-bad-png-past-end = une partie du PNG dépasse la fin du fichier

# Cause of damaged photo notes: a PNG file holds no picture.
folders-meta-bad-png-empty = le PNG ne contient aucune image

# Reason a photo's date taken is refused: it is not written like the example.
folders-meta-refuse-date = la date de prise de vue doit s’écrire ainsi : 2026:01:02 03:04:05

# Reason a photo's note is refused: it holds a nul character.
folders-meta-refuse-nul = une note ne peut pas contenir de caractère nul

# Reason a photo's way-up setting is refused: it is not from 1 to 8.
folders-meta-refuse-way-up = le réglage de l’orientation d’affichage doit être un nombre de 1 à 8

# Reason a photo's notes are refused: they are too long to fit in a JPEG.
folders-meta-refuse-too-long = les détails d’appareil photo sont trop longs pour tenir dans un JPEG

# Reason notes cannot be changed in a file that is not a JPEG or PNG photo.
folders-meta-only-jpeg-png = les détails d’appareil photo ne peuvent être modifiés que dans les photos JPEG et PNG

# Reason a change to a song or photo was not begun: the drive has no room for the copy.
folders-meta-no-room = il n’y a plus de place sur le disque

# Reason a song's tag is refused: the tag is too big.
folders-meta-tag-too-big = les détails du morceau sont trop volumineux
