# Title of a card on the default apps page.
settings-default-apps-card-internet = Internet

# Words behind the i of a card on the default apps page.
settings-default-apps-card-internet-about = Le programme qui ouvre un lien web cliqué n'importe où, celui qui écrit un e-mail quand on clique sur une adresse, et celui qui ouvre une invitation de calendrier.

# Title of a card on the default apps page.
settings-default-apps-card-files = Fichiers et documents

# Words behind the i of a card on the default apps page.
settings-default-apps-card-files-about = Le programme qui ouvre un dossier, un fichier de texte brut et un document PDF quand vous en ouvrez un depuis Dossiers, le bureau ou une autre application.

# Title of a card on the default apps page.
settings-default-apps-card-media = Images et son

# Words behind the i of a card on the default apps page.
settings-default-apps-card-media-about = Le programme qui ouvre une image, un morceau de musique ou une vidéo quand vous en ouvrez un.

# Sentence at the top of the page when every kind has a program; { $web } is the program that opens web links.
settings-default-apps-all-set-web = Tout a un programme pour l'ouvrir ; { $web } ouvre les liens web.

# Sentence at the top of the page when every kind has a program and the one for web links is not known.
settings-default-apps-all-set = Tout a un programme pour l'ouvrir.

# Sentence at the top of the page when one kind has no program chosen; { $kind } is its name in lower case.
settings-default-apps-one-missing = Rien n'est encore choisi pour ouvrir { $kind }.

# Sentence at the top of the page when several kinds have no program chosen; { $kinds } is their names as a list joined with "or".
settings-default-apps-many-missing = Rien n'est encore choisi pour ouvrir { $kinds }.

# Small words under a kind that no installed program can open.
settings-default-apps-none-installed = Rien d'installé ne peut encore les ouvrir.

# First choice in a list when no program is chosen for that kind yet.
settings-default-apps-not-chosen = Pas encore choisi

# Small words under a kind with a program list; { $n } is how many programs can open it.
settings-default-apps-can-open =
    { $n ->
        [one] Le seul programme qui le peut.
        [many] { $n } de programmes peuvent les ouvrir.
       *[other] { $n } programmes peuvent les ouvrir.
    }

# Said in green under a kind's list after the choice was kept.
settings-default-apps-saved = Enregistré
