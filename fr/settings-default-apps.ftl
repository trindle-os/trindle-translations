# machine translated (French), not yet reviewed by a person.

# Name of the Settings page about default apps, in the list and as its heading.
settings-default-apps-title = Applications par défaut

# Words a person might type into the Settings search to find the default apps page; separate them with spaces.
settings-default-apps-keywords = navigateur courrier e-mail mail fichiers images musique vidéo pdf calendrier ouvrir avec terminal

# Introduction under the heading of the default apps page, and the words behind the page i.
settings-default-apps-help = Le programme qui ouvre les liens web, les e-mails, les images, le calendrier et le reste. Le terminal se choisit dans ~/.config/xdg-terminals.list ; si aucun n'est choisi, Trindle utilise le premier installé.

