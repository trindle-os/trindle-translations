# Name of the Thanks page in the Settings side bar and its title.
settings-thanks-title = Teşekkürler

# Words the Settings search matches the Thanks page by, in lower case.
settings-thanks-keywords = teşekkürler katkıda bulunanlar projeler açık kaynak özgür yazılım bağış bağışlar

# Text behind the info button of the Thanks page.
settings-thanks-help =
    Onları yapan herkese teşekkürler. Biri sizin için önemliyse, kalp sizi bağış kabul ettikleri yere götürür.

# The sentence at the top of the Thanks page; n is how many projects are thanked.
settings-thanks-headline =
    { $n ->
        [one] Trindle, gönüllülerin yaptığı { $n } özgür proje üzerine kuruludur. Teşekkürler.
       *[other] Trindle, çoğu gönüllülerin yaptığı { $n } özgür proje üzerine kuruludur. Teşekkürler.
    }

# Tip of the heart button beside a project that takes donations; name is the project.
settings-thanks-donate = { $name } projesine bağış yap

# Text behind the info button of a card on the Thanks page, for a project whose line is shortened: its name and its full description.
settings-thanks-longer = { $name }: { $what }.

# Heading of the Licences card on the Thanks page.
settings-thanks-licences = Lisanslar

# Quiet line under Trindle in the Licences card.
settings-thanks-trindle-licence = GPL-3.0-or-later altında özgür yazılım.

# First sentence behind the info button of the Licences card.
settings-thanks-licences-about = Trindle'ın başlangıç noktası olan ya da içerdiği her şey kendi lisansını korur.

# One line behind the info button of the Licences card: the work's name and where its licence is read.
settings-thanks-where = { $name }: { $where_read }

# Name of the line in the Licences card that counts the Rust libraries.
settings-thanks-rust = Rust kütüphaneleri

# Quiet line under the Rust libraries while the list of licences is still being read.
settings-thanks-rust-reading = Liste okunuyor.

# Quiet line under the Rust libraries: how many there are and how many are under the commonest licence.
settings-thanks-rust-counts =
    { $total ->
        [one] { $total } Rust kütüphanesi, { $n } tanesi { $licence } altında
       *[other] { $total } Rust kütüphanesi, { $n } tanesi { $licence } altında
    }

# Quiet line under the Rust libraries when the list of licences is not on this computer.
settings-thanks-rust-missing = Liste bu bilgisayarda bulunamadı.

# Tip of the button that opens the full list of licences as a text page.
settings-thanks-open-list = Tam listeyi metin sayfası olarak aç

# Red words under the Rust libraries line when the list could not be opened.
settings-thanks-open-failed = Liste açılamadı.

