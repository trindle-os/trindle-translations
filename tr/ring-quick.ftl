# Line under the Bluetooth page when pairing failed.
ring-quick-bt-not-paired = Eşleşmedi. Eşleştirme kipinde ve yakında mı?

# Line under the Bluetooth page when pairing worked but connecting did not.
ring-quick-bt-paired-not-connected = Eşleşti, ama bağlanmadı. Biraz sonra yeniden deneyin.

