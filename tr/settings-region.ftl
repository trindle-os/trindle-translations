
# machine translated (Turkish), not yet reviewed by a person.

# Name of the Region and language page, in the page list and as its heading.
settings-region-title = Bölge ve dil

# Words people may search for to find the Region and language page, separated by spaces.
settings-region-keywords = dil yerel ayar ülke biçimler tarih para birimi

# Help line at the foot of the Region and language page.
settings-region-help = Dil ve biçimler bir sonraki oturum açışınızda etkili olur.

# Said beside the Language and Formats lists once a choice is saved.
settings-region-later = Görmek için oturumu kapatıp yeniden açın.

# Shown while the page reads the computer.
settings-region-looking = Aranıyor…

# Under Money and paper: the paper and measures the chosen formats use (paper is a4, letter or other; measures is imperial or metric).
settings-region-paper-measures =
    { $paper ->
        [a4] A4 kâğıt
        [letter] Letter kâğıt
       *[other] kâğıt
    }, { $measures ->
        [imperial] inç ve libre
       *[other] metrik ölçüler
    }

# Under Money and paper: { $money } is the money sign and { $paper } the paper and measures.
settings-region-money-and-paper = { $money }, { $paper }

# Under A date and a number: a date and a number written the way the formats chosen write them.
settings-region-date-and-number = { $date } ve { $number }

# Said beside the Add a language line once a language is installed.
settings-region-installed-done = Kuruldu

# Headline when the language and the formats are the same: { $lang } is the language's name.
settings-region-everything-in = Her şey { $lang } dilinde.

# Headline when the formats differ from the language: the names are { $lang } and { $fmt }.
settings-region-menus-in = Menüler { $lang } dilinde; tarihler ve sayılar { $fmt } biçiminde yazılır.

# Headline when a change is saved but waits for the next login: { $words } is the sentence so far.
settings-region-with-wait = { $words } Değişikliği görmek için oturumu kapatıp yeniden açın.

# Said beside the Install another line while a language is made.
settings-region-installing = Kuruluyor

# Name of the list of languages for menus and messages, heading of its line and of the card.
settings-region-language = Dil

# Name of the list of formats and heading of its line.
settings-region-formats = Biçimler

# Help text of the Language card (the information button).
settings-region-language-about = Dil, menülerin ve iletilerin dilidir. Biçimler; tarihlerin, saatlerin, sayıların, paranın, ölçülerin ve kâğıt boyutunun nasıl yazıldığıdır ve başka bir ülkenin düzenini izleyebilir. İkisi de bir sonraki oturum açışınızda etkili olur.

# Under the Language heading.
settings-region-language-sub = Menüler ve iletiler, sonraki oturum açışından itibaren.

# Under the Formats heading.
settings-region-formats-sub = Tarihler, sayılar, para ve kâğıt boyutu.

# Heading of the line that shows a date and a number in the chosen formats.
settings-region-date-number = Tarih ve sayı

# Heading of the line that shows the money and paper of the chosen formats.
settings-region-money-paper = Para ve kâğıt

# Heading of the line that shows the language now in use.
settings-region-in-use = Şu an kullanımda

# Heading of the card for installing another language.
settings-region-add = Dil ekle

# Help text of the Add a language card (the information button).
# SAFETY: needs a human review before it ships
settings-region-add-about = Başka bir dil kurar; böylece menüler veya biçimler için seçilebilir. Yapılması biraz sürer ve bir yöneticinin parolasını gerektirir.

# Heading of the line shown when every language is already installed.
settings-region-all-installed = Her dil zaten kurulu

# Heading of the line saying how many languages are installed.
settings-region-installed = Kurulu

# Under the Installed heading: how many languages are installed.
settings-region-count =
    { $n ->
        [one] { $n } dil kurulu.
       *[other] { $n } dil kurulu.
    }

# Name of the list of languages that can be installed, and heading of its line.
settings-region-install-another = Başkasını kur

# Tip of the button that installs the chosen language.
# SAFETY: needs a human review before it ships
settings-region-install-this = Bu dili kur (parolanızı sorar)

# Under the Install another heading.
# SAFETY: needs a human review before it ships
settings-region-needs-password = Bir yöneticinin parolası gerekir.

# Heading of the line saying how many more languages can be made.
settings-region-ready = Eklemeye hazır

# Under the Ready to add heading: how many more languages can be made.
settings-region-more =
    { $n ->
        [one] Bu bilgisayarın yapabileceği { $n } dil daha.
       *[other] Bu bilgisayarın yapabileceği { $n } dil daha.
    }

settings-region-removing = Kaldırılıyor

settings-region-removed-done = Kaldırıldı

settings-region-remove-language = Bu dili kaldır

settings-region-kept = Bu bilgisayardaki diller

settings-region-kept-about = Burada kurulu tüm diller. Kullanmadıklarını kaldır; kullandığın dil kalır. Yönetici parolasını ister.

settings-region-in-use-stays = Kullanımda, bu yüzden kalır

