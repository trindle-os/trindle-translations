# machine translated (Turkish), not yet reviewed by a person.

# Name of the AI programs page, in the page list, as its heading and on the card listing the programs.
settings-ai-title = Yapay zekâ programları

# Words people may search for to find the AI programs page, separated by spaces.
settings-ai-keywords = yapay zekâ ai programlar claude codex cursor gemini aider ajan çit koruma alanı sandbox özel klasörler paylaş ssh anahtarlar belirteç token sudo

# Help line at the foot of the AI programs page.
settings-ai-help = Yapay zekâ kodlama programları, kişisel dosyalarınızı gizleyen bir koruma alanında çalışır. Yalnızca ihtiyaç duydukları klasörleri paylaşın.

# SAFETY: needs a human review before it ships
# Headline of the AI programs page.
settings-ai-note = Bu, günlük kullanımda yapay zekâ programlarını kişisel dosyalarınızdan uzak tutar; örneğin biri kandırılıp banka dökümlerinizi toplayıp dışarı göndermeye çalışırsa. Sınırlı bir korumadır, garanti değildir: kararlı bir program, bilgisayarın yazılımındaki bir açık ya da sizin bir isteği onaylamanız veya bir klasörü paylaşmanız yine de bir şeyin sızmasına yol açabilir.

# Note under the headline of the AI programs page.
settings-ai-inside = Bir yapay zekâ programının başlattığı her şey, örneğin kurulan programlar, betikler ve diğer programlar, onunla birlikte koruma alanının içinde kalır.

# Red words when a change to the fence could not be made.
settings-ai-not-changed = Değiştirilemedi.

# Said beside a setting on the AI programs page once it is saved.
settings-ai-saved = Kaydedildi

# Title of the window for choosing a folder to share with AI programs.
settings-ai-choose-folder = Yapay zekâ programlarıyla paylaşılacak bir klasör seçin

# Red words when the key for AI programs to reach computers by ssh could not be made.
settings-ai-key-not-made = Anahtar oluşturulamadı.

