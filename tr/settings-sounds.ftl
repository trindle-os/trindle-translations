settings-sounds-none-yet-about = Herhangi bir an için seçmek üzere bir tane ekleyin.

# Red words under a moment's line when its chosen sound file is gone.
settings-sounds-gone = Bu ses artık bu bilgisayarda yok. Başka bir tane seçin.

# Red words under a line when a sound would not play.
settings-sounds-would-not-play = Ses çalınmadı. Ses bölümünde hoparlörleri denetleyin.

# Title of the window for choosing sound files.
settings-sounds-chooser-title = Ses dosyalarını seçin

# Name of the filter in the window for choosing sound files that shows only sounds.
settings-sounds-chooser-filter = Sesler

# Red words under the add sounds line when a chosen file is not a sound; { $name } is the file name.
settings-sounds-not-playable = { $name }, Trindle'ın çalabileceği bir ses türü değil.

# Red words under the add sounds line when a file could not be copied in; { $name } is the file name.
settings-sounds-not-copied = { $name } kopyalanamadı.

# Green words under the add sounds line after sounds were added; { $n } is how many.
settings-sounds-added = { $n } eklendi. Yukarıda bir anın yanından seçin.

# Red words under the question about a sound of the same name when it could not be replaced; { $name } is the file name.
settings-sounds-not-replaced = { $name } değiştirilemedi.

# Green words after one sound took the place of the one there; { $name } is the file name.
settings-sounds-replaced-one = { $name } değiştirildi.

# Green words after several sounds took the place of the ones there; { $n } of { $total } were done.
settings-sounds-replaced-some = { $total } tanesinden { $n } tanesi değiştirildi.

# Red words under a sound's line when it could not be removed.
# SAFETY: needs a human review before it ships
settings-sounds-not-removed = Kaldırılamadı.

# Red words under a moment's line when its sound was removed and the moment could not be set back to its own sound.
# SAFETY: needs a human review before it ships
settings-sounds-not-set-back = Sesi kaldırıldı ve kendi sesine geri döndürülemedi.

# Title of the card with the sounds for logging in and out and notifications.
settings-sounds-coming-title = Geliş ve gidiş

# Words behind the i of that card.
settings-sounds-coming-about = Bir ses seçmek onu çalar, Kapalı o anı sessiz tutar. Her birinin yanındaki yuvarlak düğme şu an seçili sesi çalar. Her ses düzeyi 0'dan 100'e onar onar gider ve bıraktığınızda bir kez çalar.

# Title of the card with the charger and battery sounds.
settings-sounds-power-title = Güç

# Words behind the i of that card.
settings-sounds-power-about = Şarj cihazının takılıp çıkarılması ve pilin azalması için sesler. Ses düzeyi 0'dan 100'e onar onar gider ve bıraktığınızda bir kez çalar.

# Title of the card with the sounds the person added.
settings-sounds-own-title = Kendi sesleriniz

# Words behind the i of that card.
settings-sounds-own-about = WAV, OGG, Opus, FLAC veya MP3. Kendi klasörünüze kopyalanırlar; böylece asıllar taşınabilir veya silinebilir, sonra diğerleri gibi herhangi bir anın yanından seçilebilir. Birini kaldırmak, onu kullanan her anı kendi sesine geri döndürür.

