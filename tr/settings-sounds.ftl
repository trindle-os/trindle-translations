
# machine translated (Turkish), not yet reviewed by a person.

# Name of the Settings page about event sounds, in the list and as its heading.
settings-sounds-title = Sesler

# Words a person might type into the Settings search to find the sounds page; separate them with spaces.
settings-sounds-keywords = ses sesler çan açılış başlangıç oturum aç oturum kapat kapat kapanış şarj cihazı takıldı çıkarıldı pil uyarı bip kapalı sessiz kendi özel ekle dosya wav ogg mp3

# Introduction under the heading of the sounds page, and the words behind the page i.
settings-sounds-help = Her an için ses. Birini seçmek onu çalar, Kapalı o anı sessiz tutar. Kendi seslerinizi ekleyip diğerleri gibi seçebilirsiniz.

# First choice in each moment's list of sounds: that moment makes no sound.
settings-sounds-off = Kapalı

# Sentence at the top of the page when no moment makes a sound.
settings-sounds-top-none = Hepsi sessiz: hiçbir an ses çıkarmıyor.

# Sentence at the top of the page when every moment makes a sound.
settings-sounds-top-all = Her anın bir sesi var.

# Sentence at the top of the page when some moments make a sound; { $n } is how many of the { $total } do.
settings-sounds-top-some =
    { $n ->
        [one] { $total } andan { $n } tanesi ses çıkarıyor; diğerleri sessiz.
       *[other] { $total } andan { $n } tanesi ses çıkarıyor; diğerleri sessiz.
    }

