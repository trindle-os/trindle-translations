# machine translated (Turkish), not yet reviewed by a person.

# The card's heading.
settings-words-heading = Kendi sözcükleriniz

# Under the heading.
settings-words-about = Trindle'ın gösterdiği her sözcüğü istediğiniz dilde değiştirin ve tabloyu dosya olarak paylaşın.

# The first line of the card: what is locked, in plain words.
settings-words-rule = Son sütunu dışında bir yerde değiştirilmiş ya da Trindle'ın kendisine ait olmayan bir sayfa tümüyle reddedilir.

# The line that picks which language the boxes are for.
settings-words-language = Dil

# Under the language line.
settings-words-language-sub = Tablo bu dil içindir.

# The name of the language list for the screen reader.
settings-words-language-tip = Tablonun dili

# The line that exports the sheet, and its button's tip.
settings-words-export = Sayfayı indir

# Under the export line.
settings-words-export-sub = Solda İngilizce, yanında senin dilin. Sağ tarafı değiştir.

# Title of the window that asks where to save the sheet.
settings-words-export-title = Sözcük tablosunu kaydet

# The line that imports a sheet, and its button's tip.
settings-words-import = Sayfayı yükle

# Under the import line.
settings-words-import-sub = Önce bütünüyle denetlenir. Herhangi bir fark hiçbir şey kurmaz.

# Title of the window that asks which sheet to open.
settings-words-import-title = Sözcük tablosu aç

# Under the import button when a sheet was installed.
settings-words-imported = Kuruldu

# Under a box or the export button when the words could not be kept.
settings-words-not-saved = Kaydedilemedi

# Under the import button: the file is bigger than any sheet.
settings-words-too-big = Reddedildi: dosya çok büyük

# Under the import button: the file is not text.
settings-words-not-text = Reddedildi: düz metin değil

# Under the import button: the file holds control or hidden characters.
settings-words-not-plain = Reddedildi: gizli veya denetim karakterleri var

# Under the import button: a line is longer than any line of a sheet.
settings-words-line-long = Reddedildi: bir satır çok uzun

# Under the import button: the file is not a Trindle word sheet.
settings-words-not-mine = Reddedildi: Trindle sözcük tablosu değil

# Under the import button: the sheet is of another version.
settings-words-version = Reddedildi: tablonun başka bir sürümü

# Under the import button: the language tag is not usable.
settings-words-bad-language = Reddedildi: dil geçerli değil

# Under the import button: the notes at the top were changed.
settings-words-notes = Reddedildi: tablonun üst kısmı değiştirilmiş

# Under the import button: lines are missing or extra.
settings-words-count = Reddedildi: satırlar eksik veya fazla

# Under the import button: a key is not the one Trindle has. The key is { $key }.
settings-words-key = Reddedildi: { $key } anahtarı değiştirilmiş

# Under the import button: an English line was changed. The key is { $key }.
settings-words-english = Reddedildi: { $key } için İngilizce metin değiştirilmiş

# Under the import button: a row is not in the right form. The key is { $key }.
settings-words-shape = Reddedildi: { $key } satırı doğru biçimde değil

# Under a box or the import button: the translation is too long. The key is { $key }.
settings-words-long = Reddedildi: { $key } için sözcükler çok uzun

# Under a box or the import button: the translation holds hidden or control characters. The key is { $key }.
settings-words-characters = Reddedildi: { $key } için sözcüklerde gizli karakterler var

# Under a box or the import button: the translation holds markup, a link or a path. The key is { $key }.
settings-words-links = Reddedildi: { $key } için sözcüklerde işaretleme, bağlantı veya yol var

# Under a box or the import button: the translation's placeholders differ from the English. The key is { $key }.
settings-words-placeholders = Reddedildi: { $key } yer tutucuları farklı

# Under the import button: the file cannot be read as a plain file.
settings-words-not-sheet = Reddedildi: dosya okunamadı

# Under the rule on the card: when changed words appear.
settings-words-next-start = Sözcükleriniz bir program bir sonraki açıldığında görünür.

# Under the import button: the check value does not match what Trindle wrote.
settings-words-check-value = Reddedildi: denetim değeri eşleşmiyor

settings-words-reset = Trindle'ın sözcüklerine dön

settings-words-reset-sub = Bu dili geldiği haline getirir. Sözcüklerin bir yedek dosyada saklanır.

# The button that opens the page where a finished sheet is offered for the next version.
settings-words-offer = Sayfanı sun

# Under the offer button: who can send and why.
settings-words-offer-sub = Buildmorphic'e giriş yapıp gönderdiğin bir sayfa açar. Trindle onu senin yerine asla göndermez.

# The line that starts a language of your own, and its button's tip.
settings-words-start = Kendi dilini başlat

# Under the start line.
settings-words-start-sub = Ona bir ad ver, gerçek ya da uydurma. İngilizce olarak başlar ve seninki olarak listelenir.

# Inside the empty name box, and its name for the screen reader.
settings-words-name-tip = Dilinin adı

# Beside the start line when the language was made.
settings-words-started = Başlatıldı

# Under the start line: the name is empty or too long.
settings-words-name-length = 1 ile 30 arasında harf kullan

# Under the start line: the name holds markup, a path or hidden characters.
settings-words-name-plain = Yalnızca harf: biçimlendirme, yol ya da gizli karakter olmaz

# Under the start line: another language of your own has this name.
settings-words-name-taken = Bu adda bir dilin zaten var

# A language of your own in the language lists. { $name } is the name the person gave it.
settings-words-own-label = { $name } (kendi dilin)

# Under the reset line for a language of your own: the button asks twice. Never taken from a sheet.
settings-words-reset-own-sub = Kendi dilini kaldırır. Sözcükleri bir yedek klasöründe saklanır.

