# The count under the search box. $count is how many snippets there are.
snippets-count =
    { $count ->
        [one] 1 hazır metin
       *[other] { $count } hazır metin
    }

# The count under the search box while searching. $shown of $all snippets are found.
snippets-count-found =
    { $all ->
        [one] 1 hazır metinden { $shown } tanesi
       *[other] { $all } hazır metinden { $shown } tanesi
    }

# The version at the foot of the window. $version is its number.
snippets-version = Hazır Metinler { $version }

# Red words when the list for typing expansion could not be written. $why says why.
snippets-publish-failed = Hazır Metinler, yazarken otomatik yerleştirmeyi güncelleyemedi: { $why }

# Under the list for a snippet file that is left alone. $file is its name, $why the reason.
snippets-file-left-alone = Hazır Metinler { $file } dosyasını atladı. { $why }

# Asks whether to import files that would run commands. $files names them.
snippets-risky = { $files }, Espanso ile kullanılırsa bu bilgisayarda komut çalıştırır. İçe aktarılsın mı?

# A small mark in the list for the other triggers a snippet has. $count is how many more.
snippets-more = +{ $count } tane daha

# Said after an import. $count is how many files came in.
snippets-imported =
    { $count ->
        [one] 1 dosya içe aktarıldı.
       *[other] { $count } dosya içe aktarıldı.
    }

# Problem when a folder could not be made. $path names it, $why says why.
snippets-dir-failed = Hazır Metinler { $path } klasörünü oluşturamadı: { $why }

# Why a snippet file could not be read. $file is its name, $why the reason.
snippets-file-unreadable = Hazır Metinler { $file } dosyasını okuyamadı. { $why }

# Problem when nothing was saved because no copy could be kept. $why says why.
snippets-backup-failed = Hiçbir şey kaydedilmedi, çünkü Hazır Metinler dosyanın yedek kopyasını alamadı: { $why }

# Problem when a file could not be written. $path names it, $why says why.
snippets-write-failed = Hazır Metinler { $path } dosyasına yazamadı: { $why }

# Problem when a file could not be read. $why says why.
snippets-read-failed = Hazır Metinler dosyayı okuyamadı: { $why }

# Problem when a file could not be opened. $why says why.
snippets-open-failed = Hazır Metinler dosyayı açamadı: { $why }

# Problem when a snippet could not be saved. $why says why.
snippets-save-failed = Hazır Metinler hazır metni kaydedemedi: { $why }

# Said for a snippet that is shown but not edited. $names are the values it uses.
snippets-odd-uses = Hazır Metinler bu hazır metni gösterebilir ama { $names } kullandığı için düzenleyemez.

# Problem for a file in an import that is too large. $name is its name.
snippets-import-file-large = { $name }, hazır metin dosyası olarak içe aktarılamayacak kadar büyük.

# Why a file is left alone. $line is the line number.
snippets-y-line-indent = Hazır Metinler { $line }. satırdaki girintiyi desteklemiyor.
