# Note after "pick what differs" in the dual view; says how many things here are not in the other pane or differ by size or date.
folders-pair-differing =
    { $n ->
        [0] Burada hiçbir şey diğer bölmeden ad, boyut veya tarih bakımından farklı değil. Alt klasörler yalnızca adlarına göre karşılaştırılır.
        [one] Burada 1 öğe diğer bölmede yok ya da boyut veya tarih bakımından farklı. Alt klasörler yalnızca adlarına göre karşılaştırılır.
       *[other] Burada { $n } öğe diğer bölmede yok ya da boyut veya tarih bakımından farklı. Alt klasörler yalnızca adlarına göre karşılaştırılır.
    }

# Red note when a button of the strip between the panes is used and only one pane shows.
folders-pair-needs-both = Bunun için iki bölme de gerekir. Göstermek için F3 tuşuna basın.

# Red note when the person asks for the same folder in the other pane while the pane shows search results.
folders-pair-no-search = Arama sonuçları diğer bölmede gösterilemez.
