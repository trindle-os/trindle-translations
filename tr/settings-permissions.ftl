settings-permissions-codes-unread-line = Eklentiler klasörü okunamadı

# Red words under that line.
# SAFETY: needs a human review before it ships
settings-permissions-codes-unread = Eklentiler klasörü okunamadı, bu yüzden bazı kodlar eksik olabilir.

settings-permissions-not-added = Folders içinden çalıştırıldı, Apps'e eklenmedi

settings-permissions-kind-tip = Uygulama türü



# Heading of the card for programs that are not in a box.
settings-outside-heading = Kutu dışındaki programlar

# Help text of that card (the information button): what Trindle can and cannot do for them.
settings-outside-about = Trindle birkaç saniyede bir bakar ve size söyler. Bu programları durduramaz ve hızlı olanı kaçırabilir. Kutudaki bir program kutusu tarafından tutulur.

# Label of the switch for the notice about the network.
settings-outside-network = Bir program ağa ulaştığında söyle

# Label of the switch for the notice about the person's files.
settings-outside-files = Bir program dosyalarınızı açık tuttuğunda söyle

# Under those two switches.
settings-outside-once = Her program için bir kez.

# Tip of the round button that makes a program be said again; { $name } is the program.
settings-outside-forget = { $name } için yeniden söyle

# Under a program marked fine for the network.
settings-outside-fine-network = Ağa ulaşması sorun değil.

# Under a program marked fine for the person's files.
settings-outside-fine-files = Dosyalarınızı açık tutması sorun değil.

# The line in the card when no program is marked fine.
settings-outside-no-fine = Hiçbir program sorun yok olarak işaretlenmemiş.

# Heading of the card for downloaded files.
settings-downloads-heading = İndirilen dosyalar

# Help text of that card (the information button).
settings-downloads-about = İnternetten gelen dosya, İndirilenler'deki ya da tarayıcının işaretlediği dosyadır. Onu açan program yalnızca o dosyayı, salt okunur olarak alır; internet ve klasörlerinizden hiçbiri verilmez. Bu, tarayıcının programı kendisinin başlattığı Aç düğmesini kapsamaz.

# Label of the switch that opens downloaded files in a box.
settings-downloads-box = İndirilen dosyaları kutuda aç

# Under that switch.
settings-downloads-box-sub = İnternet yok ve yalnızca o dosya, salt okunur.

# Tip of the switch that opens one type of downloaded file as normal; { $kind } is the type, such as pdf.
settings-downloads-normal = { $kind } dosyalarını normal aç

# Name of a file type in the list; { $kind } is the ending, such as pdf.
settings-downloads-type = { $kind } dosyaları

# Under a file type's switch.
settings-downloads-normal-sub = Açıkken: internetle birlikte normal açılır.

# The line in the card when no downloaded file has been opened in a box yet.
settings-downloads-none = Henüz tür yok. İndirilen bir dosya kutuda açıldığında biri listelenir.

