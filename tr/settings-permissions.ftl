
# machine translated (Turkish), not yet reviewed by a person.

# SAFETY: needs a human review before it ships
# Name of the Permissions page, in the page list and as its heading.
settings-permissions-title = İzinler

# Words people may search for to find the Permissions page, separated by spaces.
settings-permissions-keywords = izinler izin ver gizlilik flatpak flathub korumalı alan sandbox internet ağ dosyalar ses mikrofon kamera bluetooth bildirimler eklentiler deb x11 xwayland eski programlar steam wine java ekran terminal bilgisayar thunderbolt usb4 yuva cihazlar

# SAFETY: needs a human review before it ships
# Help line at the foot of the Permissions page.
settings-permissions-help = Her uygulamanın neyi kullanabileceği. Flathub uygulamaları, kendi klasörüne kurulan programlar ve eklentilerin her biri kendi klasörüne kurulur ve varsayılan olarak kısıtlıdır. Dolu bir simge izin verildiği anlamına gelir; değiştirmek için ona tıklayın. Bir Flathub uygulamasındaki değişiklik uygulama bir sonraki başladığında geçerli olur. İzin verilen Thunderbolt ve USB4 aygıtları her zaman sormadan bağlanır; yeniden sorulması için birini unutun.

# Red words when a permission could not be changed and nothing more is known.
settings-permissions-not-changed = Değiştirilemedi.

# Words beside a plugin when its change was saved but the plugin could not be started again.
settings-permissions-plugin-not-restarted = Kaydedildi, ancak eklenti yeniden başlatılamadı. Değişiklik eklenti bir sonraki başladığında geçerli olur.

# Said beside an app, plugin or switch once a permission change is saved.
settings-permissions-saved = Kaydedildi

# SAFETY: needs a human review before it ships
# Help text of the AppImages card (the information button).
settings-permissions-loose-images = Her AppImage, özel bir ev klasörü olan kendi kutusunda çalışır. Dolu bir simge izin verildiği anlamına gelir; değiştirmek için ona tıklayın. Değişiklik AppImage bir sonraki başladığında geçerli olur.

# SAFETY: needs a human review before it ships
# Help text of the Started from Folders card (the information button).
settings-permissions-loose-programs = Klasörler'den başlatılan programların her biri, özel bir ev klasörü olan kendi kutusunda çalışır. Dolu bir simge izin verildiği anlamına gelir; değiştirmek için ona tıklayın. Değişiklik program bir sonraki başladığında geçerli olur.

# A permission's name and what is true with it off, one after another in a card's help text: { $title } is the permission, { $words } what it means.
settings-permissions-title-and-words = { $title }: { $words }

# SAFETY: needs a human review before it ships
# Under the Allow older programs switch.
settings-permissions-older-why = Her biri diğerlerinden ayrı tutulur. Kapalıyken açılmazlar.

# SAFETY: needs a human review before it ships
# Heading of the card with the switch for older programs.
settings-permissions-older = Eski programlar

# SAFETY: needs a human review before it ships
# Label and tip of the switch that lets older programs open.
settings-permissions-allow-older = Eski programlara izin ver

# Help text on the Thunderbolt and USB4 card when the ports only carry screens.
settings-permissions-lets-in-screens = Bu bağlantı noktaları yalnızca ekran taşır; bu yüzden hiçbir aygıt bu bilgisayarın belleğine ulaşamaz ve sorulacak bir şey yoktur.

# Help text on the Thunderbolt and USB4 card when the ports only carry USB and screens.
settings-permissions-lets-in-usb = Bu bağlantı noktaları yalnızca USB ve ekran taşır; bu yüzden hiçbir aygıt bu bilgisayarın belleğine ulaşamaz ve sorulacak bir şey yoktur.

# SAFETY: needs a human review before it ships
# Help text on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-lets-in-all = Bu bağlantı noktaları her aygıtın kendiliğinden bağlanmasına izin verir; bu yüzden sorulacak bir şey yoktur. Bu, bilgisayarın bellenimindeki ayardır.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry screens.
settings-permissions-short-screens = Bu bağlantı noktaları yalnızca ekran taşır.

# Under Nothing to ask on the Thunderbolt and USB4 card, when the ports only carry USB and screens.
settings-permissions-short-usb = Bu bağlantı noktaları yalnızca USB ve ekran taşır.

# SAFETY: needs a human review before it ships
# Under Nothing to ask on the Thunderbolt and USB4 card, when the firmware lets every device in.
settings-permissions-short-firmware = Bellenim her aygıtın bağlanmasına izin verir.

# Under a package's name: its version number is { $v }.
settings-permissions-version = Sürüm { $v }

# Under a plugin's name when it asks for nothing: its version number is { $v }.
settings-permissions-version-asks-nothing = Sürüm { $v }. Hiçbir şey istemez.

# Under a plugin's name: the words so far are { $sub }, then the ports it listens on in { $detail }.
settings-permissions-sub-listen = { $sub }. { $detail }

# Red words when a Thunderbolt or USB4 device could not be forgotten.
settings-permissions-not-forgotten = Unutulamadı.

# Heading of the Thunderbolt and USB4 card.
settings-permissions-thunder = Thunderbolt ve USB4

# SAFETY: needs a human review before it ships
# Help text of the Thunderbolt and USB4 card: { $about } is a further sentence, or nothing.
settings-permissions-thunder-about = İzin verilen Thunderbolt ve USB4 aygıtları her zaman sormadan bağlanır; yeniden sorulması için birini unutun. { $about }

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-ports = Bağlantı noktaları

# Under The ports while the Thunderbolt and USB4 card is read.
settings-permissions-reading-ports = Nelere izin verdikleri okunuyor…

# Heading of a line on the Thunderbolt and USB4 card.
settings-permissions-devices-allowed = İzin verilen aygıtlar

# Under a line of the Thunderbolt and USB4 card while it is read.
settings-permissions-reading = Okunuyor…

# Heading of a line on the Thunderbolt and USB4 card while it is read.
settings-permissions-memory-apart = Ayrı tutulan bellek

# Heading of the line on the Thunderbolt and USB4 card when the computer has no such ports.
settings-permissions-no-ports = Thunderbolt veya USB4 bağlantı noktası yok

# Under the heading when the computer has no Thunderbolt or USB4 ports.
settings-permissions-nothing-to-ask = Bu yüzden sorulacak bir şey yok.

# Under Devices allowed when the computer has no Thunderbolt or USB4 ports.
settings-permissions-none-plug = Yok: bu yolla hiçbir şey takılmaz.

# Heading of the line on the Thunderbolt and USB4 card when the ports let every device in.
settings-permissions-nothing-ask = Sorulacak bir şey yok

# SAFETY: needs a human review before it ships
# Under Devices allowed when the ports let every device in themselves.
settings-permissions-every-one = Hepsi, bağlantı noktalarının kendisi tarafından.

# Help text of the Thunderbolt and USB4 card when the computer keeps devices away from memory.
settings-permissions-iommu = Bu bilgisayar ayrıca aygıtları kendilerine verilmemiş bellekten uzak tutar; bu yüzden risk daha küçüktür. Bir aygıtı unutmak, aygıt çıkarılana kadar bağlı kalmasına yol açar.

# Help text of the Thunderbolt and USB4 card when the computer does not keep devices away from memory.
settings-permissions-no-iommu = Bir aygıtı unutmak, aygıt çıkarılana kadar bağlı kalmasına yol açar; bir dahaki sefere yeniden sorulur.

# Heading of the line on the Thunderbolt and USB4 card that lists the devices.
settings-permissions-asked-before = Yeni bir aygıt bağlanmadan önce sorulur

# Under the heading above.
settings-permissions-forget-one = Yeniden sorulması için birini unutun.

# Red words when the list of allowed Thunderbolt devices could not be read: the reason is { $why }.
settings-permissions-devices-not-read = İzin verilen aygıtlar okunamadı: { $why }

# SAFETY: needs a human review before it ships
# Shown when no Thunderbolt or USB4 device has been allowed always.
settings-permissions-no-device = Henüz hiçbir aygıt sormadan bağlanamaz.

# SAFETY: needs a human review before it ships
# Tip of the button that forgets an allowed Thunderbolt or USB4 device.
settings-permissions-forget-device = Bu aygıtı unut

# Name given to a Thunderbolt or USB4 device that has none.
settings-permissions-a-device = Bir Thunderbolt aygıtı

# SAFETY: needs a human review before it ships
# Under an allowed device's name when its maker is not known.
settings-permissions-may-always = Her zaman bağlanabilir

# SAFETY: needs a human review before it ships
# Under an allowed device's name: the maker is { $vendor }.
settings-permissions-made-by = Üreticisi { $vendor }. Her zaman bağlanabilir.

# Headline while the list of apps is being read.
settings-permissions-reading-apps = Her uygulamanın neyi kullanabileceği okunuyor…

# Headline while Flatpak is still answering: how many apps are listed.
settings-permissions-reading-each =
    { $n ->
        [one] { $n } uygulamanın her birinin neyi kullanabileceği okunuyor…
       *[other] { $n } uygulamanın her birinin neyi kullanabileceği okunuyor…
    }

# Headline when no app or plugin is kept in a box of its own.
settings-permissions-no-apps = Kendi kutusunda tutulan hiçbir uygulama veya eklenti kurulu değil.

# Headline when exactly one app is kept in a box of its own.
settings-permissions-one-app = Bir uygulama kendi kutusunda tutulur ve yalnızca burada izin verilenleri kullanır.

# Headline: how many apps and plugins are kept in a box of their own.
settings-permissions-many-apps =
    { $n ->
        [one] { $n } uygulama veya eklenti kendi kutusunda tutulur ve yalnızca burada izin verilenleri kullanır.
       *[other] { $n } uygulama ve eklentinin her biri kendi kutusunda tutulur ve yalnızca burada izin verilenleri kullanır.
    }

# Heading of the card for apps from Flathub.
settings-permissions-flathub-apps = Flathub uygulamaları

# Heading of the card for programs installed in their own folder.
settings-permissions-own-folder = Kendi klasöründe

# Heading of the card for plugins.
settings-permissions-plugins = Eklentiler

# Heading of the card for AppImages.
settings-permissions-appimages = AppImage'lar

# Heading of the card for programs started from Folders.
settings-permissions-from-folders = Klasörler'den başlatılanlar

# Under a kind of app on the Permissions page when none is installed.
settings-permissions-none-installed = Kurulu yok.

# Under a kind of app on the Permissions page when none has been run.
settings-permissions-none-run = Henüz çalıştırılan yok.

# SAFETY: needs a human review before it ships
# Help text of the Flathub apps card (the information button).
settings-permissions-flathub-about = Flathub uygulamalarının her biri kendi kutusunda tutulur ve yalnızca burada izin verilenleri kullanabilir. Dolu bir simge izin verildiği anlamına gelir; değiştirmek için ona tıklayın. Değişiklik uygulama bir sonraki başladığında geçerli olur.

# SAFETY: needs a human review before it ships
# Help text of the In their own folder card (the information button).
settings-permissions-debs-about = Kendi klasörüne kurulan programlar varsayılan olarak kısıtlıdır. Dolu bir simge izin verildiği anlamına gelir; değiştirmek için ona tıklayın.

# SAFETY: needs a human review before it ships
# Help text of the Plugins card (the information button).
settings-permissions-plugins-about = Eklentiler varsayılan olarak kısıtlıdır ve yalnızca istedikleri şeylere izin verilebilir. Arka planda çalışan bir eklenti değişiklikle birlikte hemen yeniden başlar.

# Typing codes card: every short code Trindle swaps for words as you type.
settings-permissions-codes = Yazma kodları

settings-permissions-codes-about = Trindle'ın siz yazarken sözcüklerle değiştirdiği kısa kodlar, her biri sahibi olan eklentiyle birlikte. Bir eklentinin kodlarını yuvarlak simgesiyle kapatın.

settings-permissions-codes-none = Etkin kod yok

# SAFETY: needs a human review before it ships
settings-permissions-codes-none-sub = Kod açmasına izin verilen bir eklenti, kodları burada listeler.

# Button on a plugin's row: stops that plugin's codes.
# SAFETY: needs a human review before it ships
settings-permissions-codes-off = { $name } kodlarını kapat

settings-permissions-codes-count =
    { $n ->
        [one] Bir kod, { $id }
       *[other] { $n } kod, { $id }
    }

# A code's second line: what it types and who owns it.
settings-permissions-code-types = { $name } için "{ $words }" yazar

settings-permissions-codes-more =
    { $n ->
        [one] Bir kod daha etkin
       *[other] { $n } kod daha etkin
    }

# Line on the typing codes card when the plugins folder could not be read: the list may be missing codes.
