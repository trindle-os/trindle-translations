
# machine translated (Turkish), not yet reviewed by a person.

# Reason given when a file to read or change is a link, not the file itself.
folders-meta-link = bu bir bağlantı, dosya değil

# Reason given when a photo's notes cannot be read; the cause follows, already written out.
folders-meta-damaged = fotoğrafın kamera ayrıntıları bozuk, çünkü { $why }

# Cause of damaged photo notes: a block points outside the notes.
folders-meta-bad-out-of-reach = bir bölümü bunların dışını gösteriyor

# Cause of damaged photo notes: a block goes beyond the end.
folders-meta-bad-block-past-end = bir bölümü sonlarının ötesine uzanıyor

# Cause of damaged photo notes: the notes have no TIFF header.
folders-meta-bad-no-tiff = TIFF başlıkları eksik

# Cause of damaged photo notes: the notes are much too large.
folders-meta-bad-too-big = fazlasıyla büyükler

# Cause of damaged photo notes: the parts of a JPEG photo do not line up.
folders-meta-bad-jpeg-parts = JPEG'in parçaları birbirine uymuyor

# Cause of damaged photo notes: a part of a JPEG photo goes beyond the end.
folders-meta-bad-jpeg-past-end = JPEG'in bir parçası dosyanın sonunun ötesine uzanıyor

# Cause of damaged photo notes: a part of a PNG photo goes beyond the end.
folders-meta-bad-png-past-end = PNG'nin bir parçası dosyanın sonunun ötesine uzanıyor

# Cause of damaged photo notes: a PNG file holds no picture.
folders-meta-bad-png-empty = PNG'nin içinde resim yok

# Reason a photo's date taken is refused: it is not written like the example.
folders-meta-refuse-date = çekilme tarihi 2026:01:02 03:04:05 gibi yazılmalı

# Reason a photo's note is refused: it holds a nul character.
folders-meta-refuse-nul = bir not null karakter içeremez

# Reason a photo's way-up setting is refused: it is not from 1 to 8.
folders-meta-refuse-way-up = fotoğrafın hangi yönde gösterileceği ayarı 1 ile 8 arasında bir sayı olmalı

# Reason a photo's notes are refused: they are too long to fit in a JPEG.
folders-meta-refuse-too-long = kamera ayrıntıları bir JPEG'e sığmayacak kadar uzun

# Reason notes cannot be changed in a file that is not a JPEG or PNG photo.
folders-meta-only-jpeg-png = kamera ayrıntıları yalnızca JPEG ve PNG fotoğraflarda değiştirilebilir

# Reason a change to a song or photo was not begun: the drive has no room for the copy.
folders-meta-no-room = sürücüde boş yer kalmadı

# Reason a song's tag is refused: the tag is too big.
folders-meta-tag-too-big = şarkının bilgileri çok büyük
