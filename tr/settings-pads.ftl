# machine translated (Turkish), not yet reviewed by a person.



# The page's name in the side bar.
settings-pads-title = Oyun kumandaları

# The sentence at the top of the page when a controller is plugged in.
settings-pads-top-idle = Değiştirmek için kumandada bir düğmeye basın.

# The sentence at the top of the page when a button has been pressed; { $name } is the button.
settings-pads-top-picked = Şimdi { $name } için tuşa basın.

# Heading of the line shown when no game controller is plugged in.
settings-pads-none = Takılı kumanda yok

# Small words under that line.
settings-pads-none-about = Bir tane takın, düğmeleri burada gösterilir.

# Name of the list that chooses which controller is shown; { $title } is the one shown now.
settings-pads-which = Hangi kumanda

# What the picture is, for the screen reader.
settings-pads-picture = { $title } resmi, basılan her düğme yanık

# Title of the card of the controller's buttons.
settings-pads-buttons-title = Düğmeler

# Words behind the i of that card.
settings-pads-buttons-about = Her düğme, tetik ve çubukların ve yön tuşlarının her yönü. En son bastığınız en üsttedir. Bir tuşa çevrilen düğme, kumanda desteği olmayan bir oyunda o tuşu yazar.

# Name of the round button that starts changing a button; { $name } is the button.
settings-pads-change = { $name } düğmesini bir tuşa çevir

# Name of the round button that stops changing a button; { $name } is the button.
settings-pads-stop = { $name } düğmesini çevirmeyi bırak

# Name of the list of what a button becomes; { $name } is the button.
settings-pads-choose = { $name } neye dönüşür

# What the list says while a button waits for its key: the clue, and a choice that does nothing.
settings-pads-waiting = Bir tuşa basın ya da bir düğme seçin

# The next choice in that list: the Escape key.
settings-pads-escape = Escape tuşu

# The next choice in that list: nothing at all.
settings-pads-nothing = Hiçbir şey

# Name of a way of the d-pad; { $way } is up, down, left or right.
settings-pads-dpad = Yön tuşu { $way }

# Name of a way of a stick; { $stick } is Left or Right and { $way } is up, down, left or right.
settings-pads-stick-way = { $stick } çubuk { $way }

settings-pads-left = sol

settings-pads-right = sağ

settings-pads-up = yukarı

settings-pads-down = aşağı

# The two sticks, at the start of a name such as Left stick up.
settings-pads-stick-left = Sol

settings-pads-stick-right = Sağ

# Title of the card of the ready-made changes.
settings-pads-quick-title = Hazır değişiklikler

# Title of the card of changes that are not one button into another.
settings-pads-other-title = Diğer değişiklikler

# Words behind the i of that card.
settings-pads-other-about = Ters çevrilmiş çubuklar, yer değiştirmiş çubuklar ve ölü bölgeler. Birini Left Stick dead zone = 10% ya da Right Stick Y = inverted gibi yazın.



# Where a choice in that list comes from; { $what } is the key, mouse button or controller button.
settings-pads-on-keyboard = Klavye: { $what }

settings-pads-on-mouse = Fare: { $what }

settings-pads-on-pad = Oyun kolu: { $what }

# The next choices in that list: the mouse buttons.
settings-pads-left-click = Sol tık

settings-pads-right-click = Sağ tık

settings-pads-middle-click = Orta tık



# Title of the card that chooses a profile for each game.
settings-pads-profiles-title = Profiller

# Words behind the i of that card.
settings-pads-profiles-about = Profil, bir değişiklikler kümesidir. Standart hiçbir şeyi değiştirmez; bu yüzden kendi kumanda desteği olan bir oyun kumandayı olduğu gibi görür. Burada kendisi için bir profil seçmedikçe her Steam oyunu Standart'ı kullanır ve profil, o oyun başlayınca kendiliğinden değişir. Başka herhangi bir oyun, Steam'in başlatmadığı oyunlar içindir.

# The one switch that turns every controller change off at once.
settings-pads-changes = Kumanda değişiklikleri

settings-pads-changes-sub = Kapalıyken her kumanda olduğu gibi kalır.

# The game whose profile is shown.
settings-pads-game = Oyun

settings-pads-other-game = Başka herhangi bir oyun

settings-pads-game-running = { $name } (çalışıyor)

settings-pads-game-number = Steam oyunu { $n }

# The profile the shown game uses.
settings-pads-profile = Profil

settings-pads-standard = Standart

settings-pads-standard-sub = Değişiklik yok.

settings-pads-profile-add = Profil ekle

settings-pads-profile-remove = { $name } profilini kaldır

settings-pads-profile-name = Profil adı

# The name a new profile is given.
settings-pads-profile-new = Profil { $n }

settings-pads-profile-empty = Profilin bir adı olmalı.

settings-pads-profile-standard = Standart adı alınmış.

settings-pads-profile-taken = Bu ad alınmış.

settings-pads-profile-gone = Bu profil artık yok.

settings-pads-not-a-game = Bir Steam uygulama numarası değil.

# Why the buttons cannot be changed while the shown game uses Standard.
settings-pads-standard-why = Standart hiçbir şeyi değiştirmez. Önce bir profil ekleyin.

# The headline while the shown game uses Standard, and while all changes are off.
settings-pads-top-standard = Standart: kumanda olduğu gibi.

settings-pads-top-off = Kumanda değişiklikleri kapalı.

