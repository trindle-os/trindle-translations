# machine translated (Turkish), not yet reviewed by a person.

# Name of the Folders settings card, and the screen reader name of the cog that opens it.
folders-settings-name = Folders ayarları

# Red words under a setting that could not be kept, in short.
folders-settings-not-saved = Kaydedilemedi.

# Red words under a setting that could not be kept; { $why } says why.
folders-settings-not-saved-because = Kaydedilemedi. Hiçbir şey değişmedi, çünkü { $why }.

# Red words at the top of the settings card when the settings file cannot be read; { $why } says why.
folders-settings-not-read = Folders ayarları okunamadı, bu yüzden olağan seçenekler gösteriliyor ve okunana kadar burada hiçbir şey değiştirilemez: { $why }.

# Note on the Drives part of the settings card when the ring is not on this computer.
folders-settings-no-ring = Sürücüleri Trindle'ın halkası açar ve bu bilgisayarda yok.

# Choice on the settings card: the part about how Folders opens.
folders-settings-page-start = Folders açılırken

# Choice on the settings card: the part about the list.
folders-settings-page-list = Liste

# Choice on the settings card: the part about drives.
folders-settings-page-drives = Sürücüler

# Choice on the settings card: the part listing kept logins.
folders-settings-page-logins = Saklanan girişler

# Note on the Kept logins part of the settings card.
folders-settings-logins-about = Hatırlamayı seçtiğiniz bir giriş, yalnızca son 90 günde kullandığınız bir adrese gönderilir. Unut ile bir girişi bırakabilirsiniz.

# Note on the Kept logins part when no login is kept.
folders-settings-no-logins = Saklanan giriş yok.

# Note on the Kept logins part while the keyring is being asked.
folders-settings-logins-wait = Anahtarlığa soruluyor…

# Choice on the settings card, under When Folders opens: Home on the left and Recent on the right.
folders-settings-start-usual = Ev ve Son kullanılanlar

# One line under that choice.
folders-settings-start-usual-sub = Solda Ev, sağda Son kullanılanlar.

# Choice on the settings card, under When Folders opens: each pane opens where it was left.
folders-settings-start-last = Her bölmenin son kaldığı yer

# One line under that choice.
folders-settings-start-last-sub = Her bölme son bulunduğu klasörde açılır.

# Choice on the settings card, under When Folders opens: the person sets a place for each pane.
folders-settings-start-chosen = Burada ayarlanan yerler

# One line under that choice.
folders-settings-start-chosen-sub = Aşağıda her bölme için bir yer seçersiniz.

# Name of a place a pane can start in: the Recent list.
folders-settings-place-recent = Son kullanılanlar

# Name of a place a pane can start in: the home folder.
folders-settings-place-home = Ev

# Name of a place a pane can start in: the Documents folder.
folders-settings-place-documents = Belgeler

# Name of a place a pane can start in: the Downloads folder.
folders-settings-place-downloads = İndirilenler

# Name of a place a pane can start in: the Pictures folder.
folders-settings-place-pictures = Resimler

# Name of a place a pane can start in: the Trash.
folders-settings-place-trash = Çöp kutusu

# Name of the setting for where the left pane starts.
folders-settings-left-pane = Sol bölme

# One line under the left pane setting.
folders-settings-left-pane-sub = Sol bölmenin başladığı yer.

# Name of the setting for where the right pane starts.
folders-settings-right-pane = Sağ bölme

# One line under the right pane setting.
folders-settings-right-pane-sub = Sağ bölmenin başladığı yer.

# Title of the folder chooser that opens from a pane's setting.
folders-settings-choose-title = Bölmenin başlayacağı yeri seçin

# Button of that folder chooser that accepts the folder.
folders-settings-choose-accept = Seç

# Red words under the Kept logins list when a login could not be let go; { $server } is the computer and { $why } says why.
folders-settings-forget-failed = { $server } unutulamadı: { $why }

# Tip of the button beside a pane's place that opens the folder chooser.
folders-settings-choose-another = Başka bir klasör seç

# Sentence on the first part of the settings card when the person sets the places; { $left } and { $right } are the places' names.
folders-settings-opens-chosen = Folders solda { $left }, sağda { $right } ile açılır.

# Sentence on the first part of the settings card when each pane opens where it was left.
folders-settings-opens-last = Folders her bölmeyi son kaldığı yerde açar.

# Sentence on the first part of the settings card for the usual start.
folders-settings-opens-usual = Folders solda Ev, sağda Son kullanılanlar ile açılır.

# Choice tip on the settings card that picks the part to show.
folders-settings-pages-tip = Folders ayarlarının bir bölümü

# Note on the first part of the settings card about when the settings are read.
folders-settings-start-note = Folders bunu her açılışta okur. Sol yeri gösteren tek bölmeyle açılır; araç çubuğundaki Tek ve Çift anahtarı ikisini de gösterir.

# Choice tip for how close the rows sit.
folders-settings-density-tip = Satırların ne kadar sıkışık olduğu

# Name of the setting for how close the rows sit.
folders-settings-density = Satırlar

# One line under the rows setting.
folders-settings-density-sub = Öğelerin birbirine ne kadar yakın durduğu, her görünümde.

# Name of the tick boxes setting, and tip of its switch.
folders-settings-ticks = Seçmek için onay kutuları

# One line under the tick boxes setting.
folders-settings-ticks-sub = Her öğedeki küçük bir kutu, onu seçilenlere ekler.

# Name of the file endings setting, and tip of its switch.
folders-settings-endings = Dosya uzantılarını göster

# One line under the file endings setting.
folders-settings-endings-sub = Kapalıyken report.pdf, report olarak gösterilir.

# Note under the settings of the list part.
folders-settings-list-note = Dosya uzantıları kapalıyken bir adın son uzantısı gösterilmez; yanıltıcı olacağı durumlar hariç: iki uzantılı bir ad, bir program ya da uzantısının söylediği gibi olmayan bir dosya. Onay kutuları açıkken Ad başlığındaki kutu hepsini seçer ya da hiçbirini seçmez.

# Line for a kept login; { $users } are the user names and { $left } says how long it is kept.
folders-settings-login-line = { $users }. { $left }.

# Tip of the red button that lets a kept login go; { $server } is the computer.
# SAFETY: needs a human review before it ships
folders-settings-forget = { $server } girişini unut

# Name of the setting that opens drives when plugged in, and tip of its switch.
folders-settings-drives = Takılınca sürücüleri aç

# One line under the drives setting.
folders-settings-drives-sub = Bir USB bellek takılınca açılır.

# Note on the Drives part when the ring is on this computer.
folders-settings-ring-note = Her durumda kenar çubuğunda yer alır ve halka orada olduğunu söyler.

# Choice on the settings card: the part about network shares.
folders-settings-page-shares = Paylaşımlar

# Name of the setting that mounts remembered network shares at login, and tip of its switch.
# SAFETY: needs a human review before it ships
folders-settings-reconnect = Oturum açtığımda paylaşımları yeniden bağla

# One line under the reconnect setting: why it is off until chosen and what it costs.
# SAFETY: needs a human review before it ships
folders-settings-reconnect-sub = Siz seçene kadar kapalıdır: bir paylaşımı bağlamak her seferinde yöneticinin parolasını ister ve oturum gerektiren bir paylaşım, Yeniden bağla düğmesine basmanızı bekler.
