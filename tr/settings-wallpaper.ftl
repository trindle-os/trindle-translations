# Name of the Settings page about the wallpaper, in the list and as its heading.
settings-wallpaper-title = Duvar kâğıdı

# Words a person might type into the Settings search to find the wallpaper page; separate them with spaces.
settings-wallpaper-keywords = arka plan resim slayt gösterisi fotoğraf

# Introduction under the heading of the wallpaper page, and the words behind the page i.
settings-wallpaper-help = Düz bir renk, tek bir resim ya da belirlediğiniz sürede resmin kendiliğinden değiştiği bir klasör.

# Choice in the list of how long each picture stays.
settings-wallpaper-every-10s = 10 saniye

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30s = 30 saniye

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1m = 1 dakika

# Choice in the list of how long each picture stays.
settings-wallpaper-every-5m = 5 dakika

# Choice in the list of how long each picture stays.
settings-wallpaper-every-15m = 15 dakika

# Choice in the list of how long each picture stays.
settings-wallpaper-every-30m = 30 dakika

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1h = 1 saat

# Choice in the list of how long each picture stays.
settings-wallpaper-every-1d = 1 gün

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fill = Ekranı doldur

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-fit = Sığdır, resmin tamamı görünür

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-center = Ortala, gerçek boyut

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-stretch = Uzat

# Choice in the list of how the picture fits the screen.
settings-wallpaper-fit-tile = Döşe

# Choice in the list of the order pictures change in: at random.
settings-wallpaper-order-shuffle = Karışık

# Choice in the list of the order pictures change in: by file name.
settings-wallpaper-order-name = Dosya adına göre

# Red words when the program that draws the wallpaper would not start.
settings-wallpaper-no-changer = Duvar kâğıdı değiştirilemedi: programı başlamadı.

# Under the large picture, when counting; { $used } of { $all } pictures are used.
settings-wallpaper-count =
    { $all ->
        [one] { $all } resimden { $used } tanesi kullanılıyor
       *[other] { $all } resimden { $used } tanesi kullanılıyor
    }

# Under the large picture; { $folder } is a folder with no pictures in it.
settings-wallpaper-empty-folder = { $folder } içinde resim yok

# Under the large picture, for the pictures that come with Trindle; { $used } of { $all } are used.
settings-wallpaper-count-own =
    { $all ->
        [one] Trindle ile gelen { $all } resimden { $used } tanesi kullanılıyor
       *[other] Trindle ile gelen { $all } resimden { $used } tanesi kullanılıyor
    }

# Under the large picture, for a folder; { $used } of { $all } pictures are used and { $folder } is the folder.
settings-wallpaper-count-folder =
    { $all ->
        [one] { $folder } içindeki { $all } resimden { $used } tanesi kullanılıyor
       *[other] { $folder } içindeki { $all } resimden { $used } tanesi kullanılıyor
    }

# Under the large picture, for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own = { $name }, Trindle ile gelen resimlerden biri

# Under the large picture when there is only a colour.
settings-wallpaper-plain-below = Düz bir renk, aşağıda ayarlanır.

# Under the large picture when the picture or folder has gone.
settings-wallpaper-gone-below = Artık orada bir şey yok. Bir resim ya da klasör seçin.

# Sentence about the wallpaper when it is a plain colour.
settings-wallpaper-plain = Düz bir renk, resim yok.

# Sentence about the wallpaper when Trindle's own pictures change; { $every } is how often, { $used } of { $all } pictures are used and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-own =
    { $all ->
        [one] Her { $every } yeni bir resim, Trindle ile gelen { $all } resimden { $used } tanesi arasından.{ $extra }
       *[other] Her { $every } yeni bir resim, Trindle ile gelen { $all } resimden { $used } tanesi arasından.{ $extra }
    }

# Sentence about the wallpaper when a folder's pictures change; { $every } is how often, { $used } of { $all } pictures are used, { $folder } is the folder's name and { $extra } is any added sentences, each after a space.
settings-wallpaper-changing-folder =
    { $all ->
        [one] Her { $every } yeni bir resim, { $folder } içindeki { $all } resimden { $used } tanesi arasından.{ $extra }
       *[other] Her { $every } yeni bir resim, { $folder } içindeki { $all } resimden { $used } tanesi arasından.{ $extra }
    }

# Sentence about the wallpaper when its folder has no pictures; { $folder } is the folder.
settings-wallpaper-empty-folder-choose = { $folder } klasöründe resim yok. Başka bir tane seçin.

# Added to the sentence about the wallpaper when a folder holds more than Trindle looks through.
settings-wallpaper-more-than-looked-at = Klasör, Trindle'ın taradığından fazlasını içeriyor, bu yüzden bazı resimler dışarıda kalmış olabilir.

# Sentence about the wallpaper for one of Trindle's own pictures; { $name } is its name.
settings-wallpaper-file-own-said = { $name }, Trindle ile gelen resimlerden biri.

# Sentence about the wallpaper for one chosen picture; { $name } is its name, written to read in the middle of a sentence.
settings-wallpaper-file-one = Her zaman tek bir resim: { $name }.

# Sentence about the wallpaper when the chosen picture cannot be used; { $why } is the reason.
settings-wallpaper-file-refused = Resim kullanılmıyor. { $why } Trindle'ın kendi resmi gösteriliyor.

# Sentence about the wallpaper when the picture has gone.
settings-wallpaper-file-gone = Resim artık yok. Bir resim ya da klasör seçin.

