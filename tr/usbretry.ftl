
# machine translated (Turkish), not yet reviewed by a person.

# Settings' words for a port: it did not start, Trindle switched it off and on once, and a device came up. $port is the port's name.
usbretry-worked = { $port } USB bağlantı noktası başlamadı, bu yüzden Trindle onu bir kez kapatıp açtı. Bir aygıt göründü.

# Settings' words for a port: it did not start, Trindle restarted the USB controller, and a device came up. $port is the port's name.
usbretry-worked-controller = { $port } USB bağlantı noktası başlamadı, bu yüzden Trindle USB denetleyicisini yeniden başlattı. Bir aygıt göründü.

# Settings' words for a port: it did not start, the USB controller was restarted, and nothing came up. $port is the port's name.
usbretry-nothing-controller = { $port } USB bağlantı noktası başlamadı. Trindle USB denetleyicisini yeniden başlattı ama hiçbir şey görünmedi. Geri getirmek için bilgisayarı kapatıp açın.

# Settings' words for a port: nothing came back after it was switched off and on, and the controller was not restarted. $port is the port's name.
usbretry-nothing = { $port } USB bağlantı noktası yeniden başlatmadan sonra gelmedi. Geri getirmek için bilgisayarı kapatıp açın.

