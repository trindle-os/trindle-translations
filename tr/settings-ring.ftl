
# machine translated (Turkish), not yet reviewed by a person.

# Name of the Settings page about the ring, in the list and as its heading.
settings-ring-title = Halka

# Words a person might type into the Settings search to find the ring page; separate them with spaces.
settings-ring-keywords = sık kullanılanlar favoriler başlatıcı kenar tıklama köşe ses konuşma pencereler açık pencereler pano kopyala yapıştır geçmiş unut bildirimler

# Introduction under the heading of the ring page, and the words behind the page i.
settings-ring-help = Sık kullanılanlarınız halkanın ortasında yer alır. Bunlar halkanın kendisinde seçilir: eklemek veya kaldırmak için halkadaki herhangi bir uygulamaya sağ tıklayın, sırayı değiştirmek için bir sık kullanılanı başkasının yerine sürükleyin.

# Sentence at the top of the ring page saying how the ring opens.
settings-ring-headline = Halka ekranın kenarında açılır ve açık pencereleriniz içinde yer alır.

# Name of the picture on the ring page that shows where things open.
settings-ring-picture = Nelerin nerede açıldığı

# Heading of the line saying the ring opens by clicking at the screen edge.
settings-ring-open-click = Ekranın kenarına tıklayın

# Small words under that line about the Super key.
settings-ring-open-super = Super tuşu da açar.

# Line saying how many favourites the ring has; { $n } is the number.
settings-ring-favourites =
    { $n ->
        [one] { $n } sık kullanılan
       *[other] { $n } sık kullanılan
    }

# Small words under the favourites line.
settings-ring-favourites-about = Eklemek için halkadaki bir uygulamaya sağ tıklayın.

# Title of the card about opening the ring.
settings-ring-opening = Halkayı açma

# Words behind the i of the card about opening the ring.
settings-ring-opening-about = İşaretçiyi ekranın kenarına götürüp tıklayın ya da Super tuşuna basın, halka açılır. Sık kullanılanlarınız halkanın ortasında, açık pencereleriniz ise çevresindeki bir halkada yer alır: öne getirmek için birine tıklayın ya da düğmeleri için sağ tıklayın. Eklemek veya kaldırmak için halkadaki herhangi bir uygulamaya sağ tıklayın.

# Heading of the switch line, and the spoken name of the switch, for showing notifications as they arrive.
settings-ring-notify-show = Geldikleri anda göster

# Small words under the switch for showing notifications as they arrive.
settings-ring-notify-show-about = Kapalıysa: yine de halkada birikirler.

# Heading of the list line, and the name of the list, for how long a notification stays.
settings-ring-notify-long = Ne kadar kalacakları

# Small words under the list for how long notifications stay.
settings-ring-notify-long-about = Acil olanlar kapatılana kadar bekler.

# Heading of the list line, and the name of the list, for which corner notifications appear in.
settings-ring-notify-where = Nerede görüneceği

# Small words under the list for where notifications appear.
settings-ring-notify-where-about = Bildirimlerin dizildiği köşe.

# Title of the card about notifications.
settings-ring-notify-title = Bildirimler

# Words behind the i of the card about notifications.
settings-ring-notify-about = Bir programın size söyleyecek bir şeyi olduğunda birkaç saniye görünür ve kaybolur. Kapatılırsa hiçbir şey görünmez, her şey yine halkadaki bildirimler dairesinde toplanır. Acil bir bildirim, burada ne seçilmiş olursa olsun kapatılana kadar bekler; böylece bir uyarı okunmadan kaybolmaz.

# Heading of the list line, and the name of the list, for when copied lines are forgotten.
settings-ring-clip-forget = Kopyalananları unut

# Small words under the list for when copied lines are forgotten.
settings-ring-clip-forget-about = Sabitlenen satırlar saklanır.

# Heading of the line saying how many lines the clipboard holds now.
settings-ring-clip-now = Şu an kopyalanan

# Small words under that line; { $n } is how many lines are kept and { $pinned } how many of them are pinned.
settings-ring-clip-count =
    { $n ->
        [one] { $n } satır, { $pinned } sabitlenmiş.
       *[other] { $n } satır, { $pinned } sabitlenmiş.
    }

# Title of the card about the clipboard.
settings-ring-clip-title = Pano

# Words behind the i of the card about the clipboard.
settings-ring-clip-about = Halkadaki pano dairesi kopyaladıklarınızı saklar; böylece daha önceki bir şeyi yapıştırabilirsiniz. Sabitlenen satırlar, burada ne seçilmiş olursa olsun her zaman saklanır.

# Small words under the voice line while voice is being added.
settings-ring-voice-adding = Ses ekleniyor; bu sırada devam edebilirsiniz.

# Small words under the voice line while its build tools are being removed.
settings-ring-voice-removing-tools = Derleme araçları kaldırılıyor.

# Small words under the voice line while voice is being removed.
settings-ring-voice-removing = Ses kaldırılıyor.

# Heading of the voice line, and the spoken name of its switch.
settings-ring-voice-control = Sesli denetim

# Said, in green, under the voice switch after voice is turned on.
settings-ring-voice-onoff-on = Açık

# Said, in green, under the voice switch after voice is turned off.
settings-ring-voice-onoff-off = Kapalı

# Small words under the voice switch.
settings-ring-voice-about = Yalnızca bu bilgisayarda anlaşılır.

# SAFETY: needs a human review before it ships
# Heading of the line, and the name of its button, that removes voice.
settings-ring-voice-remove = Sesi kaldır

# Small words under the line that removes voice.
settings-ring-voice-remove-about = Yaklaşık 150 MB yer açar.

# Words on the line offering to remove the build tools that stayed after voice was added.
settings-ring-voice-tools-left = Ses hazır. Derleme araçları saklandı.

# SAFETY: needs a human review before it ships
# Name of the button that removes the build tools voice left behind.
settings-ring-voice-tools-remove = Derleme araçlarını kaldır

# Name of the button that adds voice control to the computer.
settings-ring-voice-add = Sesli denetimi ekle (yaklaşık 150 MB)

# Small words under the voice line before voice is added.
settings-ring-voice-optional = İsteğe bağlı; eklemek için yaklaşık 150 MB.

# Title of the card about voice.
settings-ring-voice-title = Ses

# Words behind the i of the voice card; the quoted words are examples of what to say.
settings-ring-voice-card-about = Tıklamak yerine bir uygulamanın adını, “daha yüksek” veya “Wi-Fi ayarları” deyin. Halkanın ortasına dokunup konuşun; siz susunca dinlemeyi bırakır. Konuşma bu bilgisayarda anlaşılır ve hiçbir yere bir şey gönderilmez. Eklemek yaklaşık 150 MB ve birkaç dakika sürer, bu sırada devam edebilirsiniz; kaldırmak konuşma motorunu ve modelini siler.

# Words beside the round progress dial while voice is being added.
settings-ring-voice-working-add = Ses ekleniyor

# Words beside the round progress dial while voice build tools are being removed.
settings-ring-voice-working-tools = Derleme araçları kaldırılıyor

# Words beside the round progress dial while voice is being removed.
settings-ring-voice-working-remove = Ses kaldırılıyor

# Choice in the list of when copied lines are forgotten: every time the computer restarts.
settings-ring-forget-reboot = Bilgisayar her yeniden başladığında

# Choice in the list of when copied lines are forgotten: after a day.
settings-ring-forget-day = Bir gün sonra

# Choice in the list of when copied lines are forgotten: after a week.
settings-ring-forget-week = Bir hafta sonra

# Choice in the list of when copied lines are forgotten: after two weeks.
settings-ring-forget-fortnight = İki hafta sonra

# Choice in the list of when copied lines are forgotten: never.
settings-ring-forget-never = Hiçbir zaman

# Heading of the switch line, and the spoken name of the switch, for showing a window's title under its picture when pointing at it in the ring.
settings-ring-names = İşaret edince başlığı göster

# Small words under that switch.
settings-ring-names-about = Kapalıysa: yalnızca anlık görüntü. Ekran okuyucular başlığı yine alır.
