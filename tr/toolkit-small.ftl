# machine translated (Turkish), not yet reviewed by a person.



# The name a screen reader gives a chip that is pressed to take it away. $name is the chip's words.
kit-chip-remove = { $name } öğesini kaldır

# The name a screen reader gives rating stars. $name is what is rated, $value the stars filled, $max all of them.
kit-rating = { $name }, { $max } yıldızdan { $value }

# The names of the three boxes of a duration entry.
kit-duration-hours = Saat

kit-duration-minutes = Dakika

kit-duration-seconds = Saniye

# Wizard pages. $n is the step you are on and $count how many there are.
kit-step-of = Adım { $n } / { $count }

kit-step-back = Geri

kit-step-next = İleri

kit-step-finish = Bitir

# The find bar: the box's name, the buttons' names, and how many matches there are.
kit-find = Bul

kit-find-previous = Önceki eşleşme

kit-find-next = Sonraki eşleşme

kit-find-none = Eşleşme yok

kit-find-count = { $at } / { $count }

# The name a screen reader gives a "+4" box that stands for the people not shown.
kit-more-people =
    { $n ->
        [one] Bir kişi daha
       *[other] { $n } kişi daha
    }

# The gradient editor. The bar's name has $n, how many stops the gradient has.
kit-gradient-bar = { $n } duraklı renk geçişi

kit-gradient-place = Seçilen durağın yeri

kit-gradient-add = Durak ekle

kit-gradient-remove = Durağı kaldır

# The "i" button that shows and hides a card's help.
kit-help-show = Yardımı göster

kit-help-hide = Yardımı gizle

