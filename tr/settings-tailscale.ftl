# machine translated (Turkish), not yet reviewed by a person.

# What a device runs, shown in a device's small line, when it is an iPhone or iPad.
settings-tailscale-system-ios = iPhone veya iPad

# In a device's small line: the device is on the network now.
settings-tailscale-online = şu an çevrimiçi

# In a device's small line: the device has never been seen.
settings-tailscale-not-seen = henüz görülmedi

# In a device's small line: when the device was last online; the date is already written.
settings-tailscale-last-online = son çevrimiçi: { $day }

# SAFETY: needs a human review before it ships
# Shown beside the Use Tailscale switch while the password is asked for, when Tailscale is already installed.
settings-tailscale-waiting = Parola bekleniyor...

# SAFETY: needs a human review before it ships
# Shown beside the Use Tailscale switch while the password is asked for, before Tailscale is installed.
settings-tailscale-waiting-install = Parola bekleniyor, sonra Tailscale kurulacak...

# Shown beside the switch after Tailscale is turned on.
settings-tailscale-done-on = Tailscale açık

# Shown beside the switch after Tailscale is turned off.
settings-tailscale-done-off = Tailscale kapalı

# Shown under the Sign in line once the browser is being opened.
settings-tailscale-opening = Oturum açma sayfası tarayıcınızda açılıyor...

# Red words under the Sign in line when Tailscale could not be started.
settings-tailscale-not-started = Tailscale başlatılamadı.

# Red words under the Sign out line when signing out did not work.
settings-tailscale-sign-out-failed = Tailscale oturumu kapatmadı.

# Headline of the page while Tailscale is being asked how it is.
settings-tailscale-top-asking = Tailscale'e soruluyor…

# Headline of the page when Tailscale is off and not installed.
settings-tailscale-top-not-installed = Tailscale kurulu değil. Kurmak için aşağıdan açın.

# Headline of the page when Tailscale is installed but off.
settings-tailscale-top-off = Tailscale kapalı, bu yüzden bellek kullanmıyor.

# Headline of the page when Tailscale is on but does not answer.
settings-tailscale-top-silent = Tailscale yanıt vermiyor. Hâlâ başlıyor olabilir.

# Headline of the page when connected: the name of the private network and of this computer.
settings-tailscale-top-connected = { $name } olarak { $network } ağına bağlısınız.

# Name used in the headline for the private network when it has no name of its own.
settings-tailscale-network-fallback = Tailscale

# Headline of the page when Tailscale is on and has to be signed in to.
settings-tailscale-top-sign-in = Tailscale açık. Özel ağınıza katılmak için aşağıdan oturum açın.

# Headline of the page for any other state; the state is already written in lower case.
settings-tailscale-top-state = Tailscale durumu: { $state }.

# Name of the page in the list of settings pages.
settings-tailscale-title = Tailscale

# Words the settings search looks for on this page (not shown).
settings-tailscale-keywords = tailscale vpn özel ağ aygıtlar uzak tailnet

# Help text at the top of the page.
settings-tailscale-help = Tailscale, kendi bilgisayarlarınızı ve telefonlarınızı nerede olurlarsa olsunlar tek bir özel ağda birleştirir. Siz açana kadar hiçbir şey kurulmaz ve kapalıyken bellek kullanmaz.

# Small line under the Use Tailscale switch before Tailscale is installed.
settings-tailscale-switch-sub-first = Tailscale'in kendi kaynağından kurar.

# Small line under the Use Tailscale switch once Tailscale is installed.
settings-tailscale-switch-sub = Kapalı: durdurulur, bilgisayarla birlikte başlamaz.

# SAFETY: needs a human review before it ships
# Text of the switch that turns Tailscale on or off, and heading of its line.
settings-tailscale-switch = Tailscale kullan

# SAFETY: needs a human review before it ships
# Help text (i button) of the Tailscale card when Tailscale is off or has not answered.
settings-tailscale-about-plain = İlk açıldığında Tailscale, kendi yazılım kaynağından kurulur ve başlatılır. Arka plan hizmeti açıkken bellek kullanır, bu yüzden yalnızca bu açıkken çalışır. Bu kapalıyken Tailscale durdurulur ve bilgisayarla birlikte başlamaz. Güvenlik duvarı kendi Tailscale aygıtlarınızı içeri alır, geri kalan her şeyi eskisi gibi dışarıda tutar.

# Help text (i button) of the Tailscale card when Tailscale is on but not yet connected.
settings-tailscale-about-sign-in = { settings-tailscale-about-plain } Oturum açmak, Tailscale'in oturum açma sayfasını tarayıcınızda açar. Tüm aygıtlarınızda aynı hesabı kullanın.

# Help text (i button) of the Tailscale card when connected.
settings-tailscale-about-connected = { settings-tailscale-about-plain } Oturumu kapatmak, yeniden oturum açana kadar bu bilgisayarı özel ağınızdan çıkarır.

# Line in the devices card when there are no other devices.
settings-tailscale-no-devices = Henüz başka aygıt yok

# Small line under "No other devices yet".
settings-tailscale-no-devices-sub = Başka bir aygıtta aynı hesapla oturum açın.

# Shown on the devices card while Tailscale is off.
settings-tailscale-waits-off = Aygıtlarınızı görmek için Tailscale'i açın.

# Shown on the devices card while Tailscale has not answered.
settings-tailscale-waits-looking = Aygıtlarınız aranıyor…

# Shown on the devices card when Tailscale needs signing in to.
settings-tailscale-waits-sign-in = Aygıtlarınızı görmek için oturum açın.

# Shown on the devices card when Tailscale is on but not connected.
settings-tailscale-waits-connect = Aygıtlarınızı görmek için bağlanın.

# Small line under this computer when it has no address yet.
settings-tailscale-no-address = Henüz adres yok.

# Small line under this computer: its address on the private network.
settings-tailscale-address = Özel ağınızdaki adresi: { $address }.

# Name of this computer's line when Tailscale gives it no name.
settings-tailscale-this-computer = Bu bilgisayar

# Heading of the line that signs in to Tailscale, and tip of its round button.
settings-tailscale-sign-in = Oturum aç

# Small line under the Sign in line.
settings-tailscale-sign-in-sub = Oturum açma sayfasını tarayıcınızda açar.

# Heading of the line that joins the private network again, and tip of its round button.
settings-tailscale-connect = Bağlan

# Small line under the Connect line.
settings-tailscale-connect-sub = Özel ağınıza yeniden katılır.

# SAFETY: needs a human review before it ships
# Heading of the line that says the firewall lets the person's own devices in.
settings-tailscale-firewall = Kendi aygıtlarınız içeri girer

# SAFETY: needs a human review before it ships
# Small line under that heading.
settings-tailscale-firewall-sub = Geri kalan her şey eskisi gibi dışarıda tutulur.

# SAFETY: needs a human review before it ships
# Heading of the line that signs out, and tip of its button.
settings-tailscale-sign-out = Oturumu kapat

# Small line under the Sign out line.
settings-tailscale-sign-out-sub = Özel ağınızdan ayrılır.

# Heading of the card with the Tailscale switch.
settings-tailscale-card = Tailscale

# Heading of the card that lists the person's devices.
settings-tailscale-devices = Aygıtlarınız

# Help text (i button) of the Your devices card.
settings-tailscale-devices-about = Özel ağınızda oturum açmış her aygıt; ağdaki adresi, ne çalıştırdığı ve son çevrimiçi olduğu zamanla birlikte. Bir tane eklemek için telefonunuza ya da başka bir bilgisayara Tailscale kurun ve aynı hesapla oturum açın.
