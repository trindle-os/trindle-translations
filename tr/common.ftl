# Red words when the keyring will not open without the person's password.
# SAFETY: needs a human review before it ships
common-keyring-locked = Anahtar halkası kilitli. Oturumu kapatıp yeniden açın ya da kilidini açın, sonra tekrar deneyin.

# Red words when this computer has no keyring to keep a login or key in.
common-keyring-missing = Bu bilgisayarda bunu saklayacak bir anahtar halkası yok.

# Red words when the keyring is there and gives no answer in time.
common-keyring-silent = Anahtar halkası zamanında yanıt vermedi.

# Red words when work with the keyring never ended, long after its deadline.
common-keyring-never = Anahtar halkası hiç yanıt vermedi.

# Red words when the turn with the keyring could not be taken. { $why } is the system's reason.
common-keyring-turn-failed = Anahtar halkasıyla sıra alınamadı ({ $why }), bu yüzden ondan hiçbir şey istenmedi.

# Line shown while the keyring has not answered whether it kept or removed a login or key. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-waiting =
    { $action ->
        [removing] Anahtar halkası henüz yanıt vermedi, bu yüzden { $what } şimdilik kaldırılmadı. Anahtar halkası sonunda kaldırırsa bu satır bunu söyler.
       *[other] Anahtar halkası henüz yanıt vermedi, bu yüzden { $what } şimdilik saklanmadı. Anahtar halkası sonunda saklarsa bu satır bunu söyler.
    }

# Line shown when the keyring answered late and did what was asked. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-done =
    { $action ->
        [removing] Anahtar halkası geç yanıt verdi: { $what } kaldırıldı.
       *[other] Anahtar halkası geç yanıt verdi: { $what } saklandı.
    }

# Red words when the keyring never answered. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping".
common-keyring-late-never =
    { $action ->
        [removing] Anahtar halkası hiç yanıt vermedi, bu yüzden { $what } kaldırılmadı.
       *[other] Anahtar halkası hiç yanıt vermedi, bu yüzden { $what } saklanmadı.
    }

# Red words when the keyring answered late and would not do it. { $what } is what is kept, such as "login"; { $action } is "removing" or "keeping"; { $why } is the reason, as a sentence.
common-keyring-late-refused =
    { $action ->
        [removing] Anahtar halkası geç yanıt verdi ve { $what } kaldırılmadı: { $why }
       *[other] Anahtar halkası geç yanıt verdi ve { $what } saklanmadı: { $why }
    }

